---
/**
 * A one-time brand moment right under the main hero: the mark itself,
 * animated with AI from the real logo file (public/logo/lockup-transparent.png)
 * -- chrome pieces assembling into the exact lockup used everywhere else on
 * the site. Contained and modest in width rather than full-bleed, since the
 * point is to be looked at once, not to compete with the page copy below it.
 * Muted + loop, same autoplay-respects-reduced-motion pattern as VideoHero.
 */
import { existsSync } from 'node:fs';
import { join } from 'node:path';

const hasLogoVideo = existsSync(join(process.cwd(), 'public/video/logo-reveal.mp4'));
---
{hasLogoVideo && (
  <section class="logo-reveal">
    <div class="wrap">
      <div class="logo-reveal-stage">
        <video
          class="logo-reveal-media"
          id="logo-reveal-video"
          muted
          playsinline
          loop
          preload="metadata"
          aria-label="Animated Windows by Clearview logo"
        >
          <source src="/video/logo-reveal.webm" type="video/webm" />
          <source src="/video/logo-reveal.mp4" type="video/mp4" />
        </video>
      </div>
    </div>
  </section>
)}

<script>
  function calmLogoReveal() {
    const video = document.getElementById('logo-reveal-video');
    if (!(video instanceof HTMLVideoElement)) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      video.pause();
      return;
    }
    video.play().catch(() => {});
  }

  calmLogoReveal();
  document.addEventListener('astro:page-load', calmLogoReveal);
</script>

<style>
  .logo-reveal {
    background: var(--black);
    padding: var(--space-l) 0;
  }

  .logo-reveal-stage {
    max-width: 640px;
    margin: 0 auto;
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
  }

  .logo-reveal-media {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    background: var(--black);
  }

  @media (max-width: 700px) {
    .logo-reveal {
      padding: var(--space-m) 0;
    }
  }
</style>
