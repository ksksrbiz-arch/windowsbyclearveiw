---
import { site, phoneDigits } from '../data/site';

interface Props {
  extra?: Record<string, unknown>;
}

const { extra } = Astro.props;
const digits = phoneDigits();

const business = {
  '@type': 'HomeAndConstructionBusiness',
  '@id': `${site.url}/#business`,
  name: site.legalName,
  alternateName: site.shortName,
  url: site.url,
  description: site.description,
  areaServed: site.nearby.map((place) => ({
    '@type': 'City',
    name: place.name,
    containedInPlace: {
      '@type': 'State',
      name: place.state,
    },
  })),
  address: {
    '@type': 'PostalAddress',
    addressLocality: site.address.city,
    addressRegion: site.address.region,
    addressCountry: 'US',
  },
  priceRange: '$$',
  knowsAbout: [
    'Replacement windows',
    'New construction windows',
    'Full-frame window replacement',
    'Insert window replacement',
    'Vinyl windows',
  ],
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Window installation',
    itemListElement: [
      {
        '@type': 'Offer',
        itemOffered: {
          '@type': 'Service',
          name: 'Window replacement',
          url: `${site.url}/replacement`,
        },
      },
      {
        '@type': 'Offer',
        itemOffered: {
          '@type': 'Service',
          name: 'New construction window installation',
          url: `${site.url}/new-construction`,
        },
      },
    ],
  },
  ...(digits ? { telephone: `+1${digits}` } : {}),
  ...(site.email ? { email: site.email } : {}),
  // Washington requires the contractor registration number in advertising.
  // Publish it in the markup as soon as site.lniNumber is filled in.
  ...(site.lniNumber
    ? {
        identifier: {
          '@type': 'PropertyValue',
          name: 'WA L&I contractor registration',
          value: site.lniNumber,
        },
      }
    : {}),
  ...(Object.values(site.social).some(Boolean)
    ? { sameAs: Object.values(site.social).filter(Boolean) }
    : {}),
};

// Pages hand in either a single schema.org node (areas, legal) or their own
// `{ '@context', '@graph': [...] }` document (guides, the cost calculator).
// Either way this must end up as ONE flat graph: nesting a page's `@graph`
// document as a second array element — `[business, { '@context', '@graph' }]`
// — used to produce a document Google's structured-data parsers cannot read
// as separate entities. `@context` only needs to appear once, at the top.
function stripContext(node: Record<string, unknown>) {
  const { '@context': _context, ...rest } = node;
  return rest;
}

const extraNodes = extra
  ? Array.isArray(extra['@graph'])
    ? (extra['@graph'] as Record<string, unknown>[]).map(stripContext)
    : [stripContext(extra)]
  : [];

const document =
  extraNodes.length > 0
    ? { '@context': 'https://schema.org', '@graph': [business, ...extraNodes] }
    : { '@context': 'https://schema.org', ...business };
---
<script type="application/ld+json" set:html={JSON.stringify(document)} />
