---
import { site, telHref } from '../data/site';

// Without JS the browser posts straight to the function, which answers with a
// 303 to /estimate/sent. With JS we intercept and swap in the panel below.
---
<form class="estimate-form" method="post" action="/api/estimate" id="estimate-form">
  <div class="hp" aria-hidden="true">
    <label>
      Company
      <input name="company" type="text" tabindex="-1" autocomplete="off" />
    </label>
  </div>

  <!-- Populated just before submit from client-side storage — see
       BaseLayout.astro's trackVisitJourney() and bindEstimate() below.
       Never shown, never required; if storage is unavailable these just
       submit empty and functions/api/estimate.js treats that as normal. -->
  <input type="hidden" name="visitor_id" data-visitor-id />
  <input type="hidden" name="visit_journey" data-visit-journey />

  <fieldset class="field-group">
    <legend>Who is asking?</legend>
    <label class="choice">
      <input type="radio" name="role" value="Homeowner" checked />
      <span>Homeowner — replacing what is there</span>
    </label>
    <label class="choice">
      <input type="radio" name="role" value="Builder / GC" />
      <span>Builder or GC — setting them in a new build</span>
    </label>
  </fieldset>

  <label>
    Name
    <input name="name" type="text" required autocomplete="name" maxlength="120" />
  </label>
  <label>
    Phone
    <input name="phone" type="tel" required autocomplete="tel" maxlength="40" />
  </label>
  <label>
    Email <span class="field-hint">optional, for a written copy</span>
    <input name="email" type="email" autocomplete="email" maxlength="160" />
  </label>
  <label>
    City
    <input name="city" type="text" required autocomplete="address-level2" maxlength="80" />
  </label>
  <label>
    Project notes
    <textarea
      name="notes"
      rows="4"
      maxlength="2000"
      placeholder="Roughly how many windows, which rooms, and anything you have already noticed — fogged glass, drafts, a sill that feels soft."
    ></textarea>
  </label>

  <button class="btn btn-primary" type="submit" data-submit>Send estimate request</button>
  <p class="form-status" data-status role="alert" hidden></p>
  <p class="fine-print">
    We use this to call you back about the work — no lists, no resale, no
    follow-up sequence. We will not text you unless you ask us to. See the{' '}
    <a href="/legal/privacy">privacy policy</a>; submitting this form is a
    request for contact, not a contract (<a href="/legal/terms">terms</a>).
  </p>
</form>

<div class="form-success" data-success hidden>
  <p class="kicker">Received</p>
  <h2>We have the request.</h2>
  <p>
    Mark will follow up, usually the same day. If you would rather talk now, call{' '}
    <a href={telHref()}>{site.phoneDisplay}</a>.
  </p>
</div>

<script>
  function bindEstimate() {
    const form = document.getElementById('estimate-form');
    const status = document.querySelector('[data-status]');
    const success = document.querySelector('[data-success]');
    if (
      !(form instanceof HTMLFormElement) ||
      !(status instanceof HTMLElement) ||
      !(success instanceof HTMLElement)
    ) {
      return;
    }

    // ClientRouter fires astro:page-load after this script already ran, so
    // without a guard the form picks up two submit handlers and sends two leads.
    if (form.dataset.bound === 'true') return;
    form.dataset.bound = 'true';

    // The cost calculator hands a scope over. Prefill the notes so nobody has
    // to describe their project twice.
    const notes = form.querySelector('[name="notes"]');
    if (notes instanceof HTMLTextAreaElement && !notes.value) {
      let scope = new URLSearchParams(window.location.search).get('scope');
      if (!scope) {
        try {
          scope = sessionStorage.getItem('clearview:scope');
        } catch {
          scope = null;
        }
      }
      if (scope) notes.value = scope;
    }

    const button = form.querySelector('[data-submit]');
    const idleLabel = button instanceof HTMLButtonElement ? button.textContent : '';

    // Filled in right before we read the form, not on load, so the visit
    // list is as complete as possible — someone can browse for a while with
    // this page open in a background tab before coming back to submit.
    function populateVisitJourney() {
      try {
        const visitorField = form.querySelector('[data-visitor-id]');
        if (visitorField instanceof HTMLInputElement) {
          visitorField.value = localStorage.getItem('clearview:vid') || '';
        }

        const journeyField = form.querySelector('[data-visit-journey]');
        if (journeyField instanceof HTMLInputElement) {
          let visits = [];
          try {
            visits = JSON.parse(sessionStorage.getItem('clearview:visits') || '[]');
          } catch {
            visits = [];
          }
          let firstTouch = null;
          try {
            firstTouch = JSON.parse(localStorage.getItem('clearview:first_touch') || 'null');
          } catch {
            firstTouch = null;
          }
          journeyField.value = JSON.stringify({ visits, firstTouch });
        }
      } catch {
        // Storage can be unavailable (private browsing, etc.) — never block
        // the actual estimate request over a missing nice-to-have.
      }
    }

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      status.hidden = true;
      populateVisitJourney();
      if (button instanceof HTMLButtonElement) {
        button.disabled = true;
        button.textContent = 'Sending…';
      }

      try {
        const response = await fetch('/api/estimate', {
          method: 'POST',
          headers: { Accept: 'application/json' },
          body: new FormData(form),
        });
        const result = await response.json().catch(() => ({}));
        if (!response.ok) {
          throw new Error(typeof result.error === 'string' ? result.error : 'Could not send.');
        }
        form.hidden = true;
        success.hidden = false;
        success.scrollIntoView({ behavior: 'smooth', block: 'center' });

        // GA4 conversion signal. Pushed here rather than relying on a
        // page-view trigger on /estimate/sent because a successful
        // fetch()-based submission never navigates there — it just swaps
        // this panel in. The no-JS fallback (estimate.js's 303 redirect)
        // still lands on /estimate/sent for real, which pushes the same
        // event itself — see that page.
        try {
          // @ts-expect-error — initialized by the GTM snippet in BaseLayout's <head>.
          window.dataLayer = window.dataLayer || [];
          // @ts-expect-error — see above.
          window.dataLayer.push({ event: 'generate_lead', method: 'estimate_form' });
        } catch {
          // Never let analytics plumbing get in the way of a lead that
          // already succeeded.
        }
      } catch (error) {
        status.hidden = false;
        const reason = error instanceof Error ? error.message : 'Could not send.';
        status.textContent = `${reason} You can always call (564) 208-0801.`;
      } finally {
        if (button instanceof HTMLButtonElement) {
          button.disabled = false;
          button.textContent = idleLabel;
        }
      }
    });
  }

  bindEstimate();
  document.addEventListener('astro:page-load', bindEstimate);
</script>

<style>
  /* ───────────────────────────────────────────────────────────────────────
     The lead form is the only place on the site where a visitor commits to
     anything, so it is worth looking like a considered object rather than a
     stack of default inputs. The fields keep their underline treatment —
     boxed inputs would fight the editorial rules used everywhere else — but
     they get real focus states, room to breathe, and a submit that reads as
     the end of the sequence.
     ─────────────────────────────────────────────────────────────────────── */
  .estimate-form {
    display: grid;
    gap: var(--space-s);
    padding: var(--space-l);
    background: var(--paper-raised);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
  }

  /* Honeypot. Off-screen rather than display:none, which some bots skip. */
  .estimate-form .hp {
    position: absolute;
    left: -9999px;
    height: 0;
    overflow: hidden;
  }

  .estimate-form label {
    display: grid;
    gap: var(--space-3xs);
    font-weight: 500;
    font-size: var(--step--1);
  }

  .estimate-form input,
  .estimate-form textarea {
    border-bottom: 1px solid var(--line-strong);
    padding: 0.7rem 0;
    font-size: var(--step-0);
    font-weight: 400;
    transition: border-color var(--dur-fast) var(--ease);
  }

  .estimate-form input:focus,
  .estimate-form textarea:focus {
    border-bottom-color: var(--accent);
    box-shadow: 0 1px 0 0 var(--accent);
  }

  .field-group {
    border: 0;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    margin: 0;
    padding: var(--space-xs) 0 var(--space-s);
    display: grid;
    gap: var(--space-3xs);
  }

  .field-group legend {
    padding: 0;
    font-weight: 500;
    font-size: var(--step--1);
    margin-bottom: var(--space-3xs);
  }

  .choice {
    display: flex;
    align-items: center;
    gap: var(--space-2xs);
    font-weight: 400;
    cursor: pointer;
    padding: 0.3rem 0;
  }

  .choice input {
    width: auto;
    margin: 0;
    accent-color: var(--accent);
  }

  .field-hint {
    font-weight: 400;
    color: var(--ink-soft);
    font-size: var(--step--2);
  }

  .estimate-form .btn {
    justify-self: start;
    padding: 0.9rem var(--space-l);
    font-size: var(--step-0);
  }

  .form-status {
    margin: 0;
    color: var(--danger);
    border-left: 2px solid var(--danger);
    padding-left: var(--space-2xs);
  }

  /* The confirmation replaces the form in place, so it has to look like a
     destination rather than an error box. */
  .form-success {
    padding: var(--space-l);
    background: var(--paper-raised);
    border: 1px solid color-mix(in srgb, var(--accent) 40%, transparent);
    border-left: 3px solid var(--accent);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-md);
  }

  .form-success .kicker {
    color: var(--accent);
  }

  .form-success h2 {
    margin-top: 0;
    font-size: var(--step-3);
  }

  .form-success p:last-child {
    margin-bottom: 0;
  }

  @media (max-width: 600px) {
    .estimate-form,
    .form-success {
      padding: var(--space-m);
    }

    .estimate-form .btn {
      justify-self: stretch;
    }
  }
</style>
