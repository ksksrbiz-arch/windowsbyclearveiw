---
import { site, telHref } from '../data/site';
import '../styles/estimate-form.css';
---
<form class="estimate-form" method="post" action="/api/estimate" id="estimate-form" enctype="multipart/form-data">
  <div class="hp" aria-hidden="true"><label>Company<input name="company" type="text" tabindex="-1" autocomplete="off" /></label></div>
  <input type="hidden" name="visitor_id" data-visitor-id /><input type="hidden" name="visit_journey" data-visit-journey />
  <fieldset class="field-group"><legend>Who is asking?</legend><label class="choice"><input type="radio" name="role" value="Homeowner" checked /><span>Homeowner — replacing what is there</span></label><label class="choice"><input type="radio" name="role" value="Builder / GC" /><span>Builder or GC — setting them in a new build</span></label></fieldset>
  <label>Name<input name="name" type="text" required autocomplete="name" autocapitalize="words" maxlength="120" aria-describedby="field-error-name" /><span class="field-error" id="field-error-name" data-field-error="name" hidden></span></label>
  <label>Phone<input name="phone" type="tel" required autocomplete="tel" inputmode="tel" placeholder="(360) 555-0123" maxlength="40" pattern="(\+?1[\s.\-]?)?\(?\d{3}\)?[\s.\-]?\d{3}[\s.\-]?\d{4}" title="A 10-digit US phone number, e.g. (360) 555-0123" aria-describedby="field-error-phone" /><span class="field-error" id="field-error-phone" data-field-error="phone" hidden></span></label>
  <label>Email <span class="field-hint">optional, for a written copy</span><input name="email" type="email" autocomplete="email" inputmode="email" maxlength="160" aria-describedby="field-error-email" /><span class="field-error" id="field-error-email" data-field-error="email" hidden></span></label>
  <label>City<input name="city" type="text" required autocomplete="address-level2" autocapitalize="words" maxlength="80" aria-describedby="field-error-city" /><span class="field-error" id="field-error-city" data-field-error="city" hidden></span></label>
  <label>Project notes <span class="field-hint">optional, but it saves a round of back-and-forth</span><span class="field-hint field-hint-prefilled" data-notes-prefilled-hint hidden>Project details carried over from the consultant — edit as needed</span><textarea name="notes" rows="4" maxlength="2000" placeholder="Roughly how many windows, which rooms, and anything you have already noticed — fogged glass, drafts, a sill that feels soft."></textarea></label>
  {site.turnstileSiteKey && <div class="turnstile-slot" data-turnstile data-sitekey={site.turnstileSiteKey}></div>}
  <button class="btn btn-primary" type="submit" data-submit>Send estimate request</button><p class="form-status" data-status role="alert"></p>
  <p class="fine-print">We use this to call you back about the work — no lists, no resale, no follow-up sequence. We will not text you unless you ask us to. See the <a href="/legal/privacy">privacy policy</a>; submitting this form is a request for contact, not a contract (<a href="/legal/terms">terms</a>).</p>
</form>
<div class="form-success" data-success hidden><p class="kicker">Received</p><h2>We have the request.</h2><p>We will follow up, usually the same day. If you would rather talk now, call <a href={telHref()}>{site.phoneDisplay}</a>.</p></div>
{site.turnstileSiteKey && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit" async defer></script>}
<script define:vars={{ phoneDisplay: site.phoneDisplay }}>
function bindEstimate() {
  const form = document.getElementById('estimate-form');
  const status = document.querySelector('[data-status]');
  const success = document.querySelector('[data-success]');
  if (!(form instanceof HTMLFormElement) || !(status instanceof HTMLElement) || !(success instanceof HTMLElement) || form.dataset.bound === 'true') return;
  form.dataset.bound = 'true';

  const params = new URLSearchParams(window.location.search);
  const notes = form.querySelector('[name="notes"]');
  if (notes instanceof HTMLTextAreaElement && !notes.value) {
    const parts = [];
    const home = params.get('home_type');
    const openings = params.get('openings');
    const type = params.get('opening_type');
    const concern = params.get('concern');
    const stage = params.get('stage');
    let savedScope = '';
    try { savedScope = sessionStorage.getItem('clearview:scope') || ''; } catch {}
    const scope = params.has('scope') ? params.get('scope') || '' : savedScope;

    if (home) parts.push(`Home type: ${home}`);
    if (openings) parts.push(`Approximate openings: ${openings}`);
    if (type) parts.push(`Opening type: ${type}`);
    if (concern) parts.push(`Main concern: ${concern}`);
    if (stage) parts.push(`Project stage: ${stage}`);
    if (scope) parts.push(scope.trim().slice(0, 400));

    if (parts.length) {
      notes.value = parts.join('\n');
      const hint = form.querySelector('[data-notes-prefilled-hint]');
      if (hint instanceof HTMLElement) hint.hidden = false;
    }
    if (params.has('scope') || savedScope) {
      try { sessionStorage.removeItem('clearview:scope'); } catch {}
    }
  }

  if (params.get('role') === 'builder') {
    const role = form.querySelector('input[name="role"][value="Builder / GC"]');
    if (role instanceof HTMLInputElement) role.checked = true;
  }
  if (window.history.replaceState && ['home_type', 'openings', 'opening_type', 'concern', 'stage', 'scope', 'role'].some((key) => params.has(key))) {
    window.history.replaceState({}, '', `${window.location.pathname}${window.location.hash}`);
  }

  // Turnstile (only present when a site key is configured). Explicit render so it also works after
  // client-side navigation. Tokens are single use, so the widget is reset after every failed send.
  const slot = form.querySelector('[data-turnstile]');
  let widgetId = null;
  function renderTurnstile(attempts) {
    if (!(slot instanceof HTMLElement) || widgetId !== null) return;
    if (!window.turnstile) {
      if (attempts < 40) setTimeout(() => renderTurnstile(attempts + 1), 250);
      else status.textContent = 'The security check did not load. Please call ' + phoneDisplay + ' instead.';
      return;
    }
    widgetId = window.turnstile.render(slot, {
      sitekey: slot.dataset.sitekey,
      'error-callback': () => { status.textContent = 'The security check could not load. Please call ' + phoneDisplay + ' instead.'; },
    });
  }
  renderTurnstile(0);

  const button = form.querySelector('[data-submit]');
  const idleLabel = button instanceof HTMLButtonElement ? button.textContent : '';
  function clearFieldErrors() {
    form.querySelectorAll('[data-field-error]').forEach((element) => {
      if (element instanceof HTMLElement) { element.hidden = true; element.textContent = ''; }
    });
    form.querySelectorAll('[aria-invalid="true"]').forEach((element) => element.removeAttribute('aria-invalid'));
  }
  function applyFieldErrors(fields) {
    let firstInvalid = null;
    for (const [name, message] of Object.entries(fields || {})) {
      const error = form.querySelector(`[data-field-error="${name}"]`);
      const input = form.querySelector(`[name="${name}"]`);
      if (error instanceof HTMLElement) { error.textContent = message; error.hidden = false; }
      if (input instanceof HTMLElement) { input.setAttribute('aria-invalid', 'true'); firstInvalid ||= input; }
    }
    if (firstInvalid instanceof HTMLElement) firstInvalid.focus();
  }
  form.querySelectorAll('[name]').forEach((element) => {
    if (!(element instanceof HTMLInputElement || element instanceof HTMLTextAreaElement)) return;
    element.addEventListener('input', () => {
      const error = form.querySelector(`[data-field-error="${element.name}"]`);
      if (error instanceof HTMLElement && !error.hidden) { error.hidden = true; error.textContent = ''; }
      element.removeAttribute('aria-invalid');
    });
  });
  function populateVisitJourney() {
    try {
      const visitor = form.querySelector('[data-visitor-id]');
      if (visitor instanceof HTMLInputElement) visitor.value = localStorage.getItem('clearview:vid') || '';
      const journey = form.querySelector('[data-visit-journey]');
      if (journey instanceof HTMLInputElement) {
        let visits = [];
        try { visits = JSON.parse(sessionStorage.getItem('clearview:visits') || '[]'); } catch {}
        let firstTouch = null;
        try { firstTouch = JSON.parse(localStorage.getItem('clearview:first_touch') || 'null'); } catch {}
        journey.value = JSON.stringify({ visits, firstTouch });
      }
    } catch {}
  }
  form.addEventListener('submit', async (event) => {
    event.preventDefault();
    status.textContent = '';
    clearFieldErrors();
    populateVisitJourney();
    if (button instanceof HTMLButtonElement) { button.disabled = true; button.textContent = 'Sending…'; }
    try {
      const response = await fetch('/api/estimate', { method: 'POST', headers: { Accept: 'application/json' }, body: new FormData(form) });
      const result = await response.json().catch(() => null);
      const ok = result !== null && typeof result === 'object' && !Array.isArray(result) && Object.keys(result).length === 1 && result.ok === true;
      if (!response.ok || !ok) {
        if (result && typeof result === 'object' && result.fields && typeof result.fields === 'object') applyFieldErrors(result.fields);
        throw new Error(result && typeof result.error === 'string' ? result.error : 'Could not send.');
      }
      form.hidden = true;
      success.hidden = false;
      success.setAttribute('tabindex', '-1');
      success.focus({ preventScroll: true });
      success.scrollIntoView({ behavior: 'smooth', block: 'center' });
      try { window.dataLayer = window.dataLayer || []; window.dataLayer.push({ event: 'generate_lead', method: 'estimate_form_js' }); } catch {}
    } catch (error) {
      try { if (widgetId !== null && window.turnstile) window.turnstile.reset(widgetId); } catch {}
      status.textContent = error instanceof Error ? error.message : 'Could not send. Please call us instead.';
      if (button instanceof HTMLButtonElement) { button.disabled = false; button.textContent = idleLabel || 'Send estimate request'; }
    }
  });
}
bindEstimate();document.addEventListener('astro:page-load',bindEstimate);
</script>
