---
import { site, telHref } from '../data/site';

const notify = site.email;
---
<form class="estimate-form" method="post" action={`https://formsubmit.co/${notify}`} id="estimate-form">
  <input type="hidden" name="_subject" value="Clearveiw Windows estimate request" />
  <input type="hidden" name="_template" value="table" />
  <input type="hidden" name="_url" value="https://windowsbyclearveiw.com/estimate" />
  <input type="hidden" name="_captcha" value="false" />
  <div class="hp" aria-hidden="true">
    <label>
      Company
      <input name="_honey" type="text" tabindex="-1" autocomplete="off" />
    </label>
  </div>
  <label>
    Name
    <input name="name" type="text" required autocomplete="name" maxlength="120" />
  </label>
  <label>
    Phone
    <input name="phone" type="tel" required autocomplete="tel" maxlength="40" />
  </label>
  <label>
    Email
    <input name="email" type="email" autocomplete="email" maxlength="160" />
  </label>
  <label>
    City
    <input name="city" type="text" required maxlength="80" />
  </label>
  <label>
    Project notes
    <textarea name="notes" rows="4" maxlength="2000" placeholder="Number of windows, replacement or new construction, preferred materials..."></textarea>
  </label>
  <button class="btn btn-primary" type="submit">Send estimate request</button>
  <p class="form-status" data-status hidden></p>
</form>

<div class="form-success" data-success hidden>
  <p class="kicker">Received</p>
  <h2>We have the request.</h2>
  <p>Mark will follow up. If you want to talk now, call <a href={telHref()}>{site.phoneDisplay}</a>.</p>
</div>

<script>
  const form = document.getElementById('estimate-form');
  const status = document.querySelector('[data-status]');
  const success = document.querySelector('[data-success]');
  const notify = 'mark.rotar1000@gmail.com';

  if (form instanceof HTMLFormElement && status instanceof HTMLElement && success instanceof HTMLElement) {
    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      status.hidden = true;
      const button = form.querySelector('button[type="submit"]');
      if (button instanceof HTMLButtonElement) button.disabled = true;

      const payload = new FormData(form);

      try {
        const response = await fetch(`https://formsubmit.co/ajax/${encodeURIComponent(notify)}`, {
          method: 'POST',
          headers: { Accept: 'application/json' },
          body: payload,
        });
        const result = await response.json().catch(() => ({}));
        const message = typeof result.message === 'string' ? result.message : '';

        if (!response.ok || result.success === false) {
          throw new Error(message || 'Could not send.');
        }

        form.hidden = true;
        success.hidden = false;

        if (/activat/i.test(message)) {
          const note = success.querySelector('p:last-of-type');
          if (note) {
            note.textContent =
              'First send from this inbox: check mark.rotar1000@gmail.com (and spam) for a FormSubmit activation link, then click it.';
          }
        }

        fetch('/api/estimate', { method: 'POST', body: payload }).catch(() => {});
      } catch (error) {
        status.hidden = false;
        status.textContent =
          error instanceof Error ? `${error.message} Call (564) 208-0801.` : 'Could not send. Call (564) 208-0801.';
      } finally {
        if (button instanceof HTMLButtonElement) button.disabled = false;
      }
    });
  }
</script>
