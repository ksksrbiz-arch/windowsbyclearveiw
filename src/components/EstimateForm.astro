---
import { site, telHref } from '../data/site';
import '../styles/estimate-form.css';
---
<form class="estimate-form" method="post" action="/api/estimate" id="estimate-form">
  <div class="hp" aria-hidden="true"><label>Company<input name="company" type="text" tabindex="-1" autocomplete="off" /></label></div>
  <input type="hidden" name="visitor_id" data-visitor-id /><input type="hidden" name="visit_journey" data-visit-journey />
  <fieldset class="field-group"><legend>Who is asking?</legend><label class="choice"><input type="radio" name="role" value="Homeowner" checked /><span>Homeowner — replacing what is there</span></label><label class="choice"><input type="radio" name="role" value="Builder / GC" /><span>Builder or GC — setting them in a new build</span></label></fieldset>
  <label>Name<input name="name" type="text" required autocomplete="name" autocapitalize="words" maxlength="120" aria-describedby="field-error-name" /><span class="field-error" id="field-error-name" data-field-error="name" hidden></span></label>
  <label>Phone<input name="phone" type="tel" required autocomplete="tel" inputmode="tel" placeholder="(360) 555-0123" maxlength="40" pattern="(\+?1[\s.-]?)?\(?\d{3}\)?[\s.-]?\d{3}[\s.-]?\d{4}" title="A 10-digit US phone number, e.g. (360) 555-0123" aria-describedby="field-error-phone" /><span class="field-error" id="field-error-phone" data-field-error="phone" hidden></span></label>
  <label>Email <span class="field-hint">optional, for a written copy</span><input name="email" type="email" autocomplete="email" inputmode="email" maxlength="160" aria-describedby="field-error-email" /><span class="field-error" id="field-error-email" data-field-error="email" hidden></span></label>
  <label>City<input name="city" type="text" required autocomplete="address-level2" autocapitalize="words" maxlength="80" aria-describedby="field-error-city" /><span class="field-error" id="field-error-city" data-field-error="city" hidden></span></label>
  <label>Project notes <span class="field-hint">optional, but it saves a round of back-and-forth</span><span class="field-hint field-hint-prefilled" data-notes-prefilled-hint hidden>Project details carried over from the consultant — edit as needed</span><textarea name="notes" rows="4" maxlength="2000" placeholder="Roughly how many windows, which rooms, and anything you have already noticed — fogged glass, drafts, a sill that feels soft."></textarea></label>
  <button class="btn btn-primary" type="submit" data-submit>Send estimate request</button><p class="form-status" data-status role="alert"></p>
  <p class="fine-print">We use this to call you back about the work — no lists, no resale, no follow-up sequence. We will not text you unless you ask us to. See the <a href="/legal/privacy">privacy policy</a>; submitting this form is a request for contact, not a contract (<a href="/legal/terms">terms</a>).</p>
</form>
<div class="form-success" data-success hidden><p class="kicker">Received</p><h2>We have the request.</h2><p>Mark will follow up, usually the same day. If you would rather talk now, call <a href={telHref()}>{site.phoneDisplay}</a>.</p></div>
<script define:vars={{ phoneDisplay: site.phoneDisplay }}>
function bindEstimate(){const form=document.getElementById('estimate-form'),status=document.querySelector('[data-status]'),success=document.querySelector('[data-success]');if(!(form instanceof HTMLFormElement)||!(status instanceof HTMLElement)||!(success instanceof HTMLElement)||form.dataset.bound==='true')return;form.dataset.bound='true';const params=new URLSearchParams(window.location.search),notes=form.querySelector('[name="notes"]');if(notes instanceof HTMLTextAreaElement&&!notes.value){const parts=[];const home=params.get('home_type'),openings=params.get('openings'),type=params.get('opening_type'),concern=params.get('concern'),stage=params.get('stage');if(home)parts.push(`Home type: ${home}`);if(openings)parts.push(`Approximate openings: ${openings}`);if(type)parts.push(`Opening type: ${type}`);if(concern)parts.push(`Main concern: ${concern}`);if(stage)parts.push(`Project stage: ${stage}`);if(parts.length){notes.value=parts.join('\n');const hint=form.querySelector('[data-notes-prefilled-hint]');if(hint instanceof HTMLElement)hint.hidden=false}}if(params.get('role')==='builder'){const r=form.querySelector('input[name="role"][value="Builder / GC"]');if(r instanceof HTMLInputElement)r.checked=true}if(window.history.replaceState&&['home_type','openings','opening_type','concern','stage','scope','role'].some(k=>params.has(k)))window.history.replaceState({},'',`${window.location.pathname}${window.location.hash}`);const button=form.querySelector('[data-submit]'),idleLabel=button instanceof HTMLButtonElement?button.textContent:'';function clearFieldErrors(){form.querySelectorAll('[data-field-error]').forEach(el=>{if(el instanceof HTMLElement){el.hidden=true;el.textContent=''}});form.querySelectorAll('[aria-invalid="true"]').forEach(el=>el.removeAttribute('aria-invalid'))}function applyFieldErrors(fields){let firstInvalid=null;for(const[name,message]of Object.entries(fields||{})){const e=form.querySelector(`[data-field-error="${name}"]`),i=form.querySelector(`[name="${name}"]`);if(e instanceof HTMLElement){e.textContent=message;e.hidden=false}if(i instanceof HTMLElement){i.setAttribute('aria-invalid','true');firstInvalid ||= i}}if(firstInvalid instanceof HTMLElement)firstInvalid.focus()}form.querySelectorAll('[name]').forEach(el=>{if(!(el instanceof HTMLInputElement||el instanceof HTMLTextAreaElement))return;el.addEventListener('input',()=>{const e=form.querySelector(`[data-field-error="${el.name}"]`);if(e instanceof HTMLElement&&!e.hidden){e.hidden=true;e.textContent=''}el.removeAttribute('aria-invalid')})});function populateVisitJourney(){try{const v=form.querySelector('[data-visitor-id]');if(v instanceof HTMLInputElement)v.value=localStorage.getItem('clearview:vid')||'';const j=form.querySelector('[data-visit-journey]');if(j instanceof HTMLInputElement){let visits=[];try{visits=JSON.parse(sessionStorage.getItem('clearview:visits')||'[]')}catch{}let firstTouch=null;try{firstTouch=JSON.parse(localStorage.getItem('clearview:first_touch')||'null')}catch{}j.value=JSON.stringify({visits,firstTouch})}}catch{}}form.addEventListener('submit',async event=>{event.preventDefault();status.textContent='';clearFieldErrors();populateVisitJourney();if(button instanceof HTMLButtonElement){button.disabled=true;button.textContent='Sending…'}try{const response=await fetch('/api/estimate',{method:'POST',headers:{Accept:'application/json'},body:new FormData(form)}),result=await response.json().catch(()=>null),ok=result!==null&&typeof result==='object'&&!Array.isArray(result)&&Object.keys(result).length===1&&result.ok===true;if(!response.ok||!ok){if(result&&typeof result==='object'&&result.fields&&typeof result.fields==='object')applyFieldErrors(result.fields);throw new Error(result&&typeof result.error==='string'?result.error:'Could not send.')}form.hidden=true;success.hidden=false;success.scrollIntoView({behavior:'smooth',block:'center'})}catch(error){status.textContent=error instanceof Error?error.message:'Could not send. Please call us instead.';if(button instanceof HTMLButtonElement){button.disabled=false;button.textContent=idleLabel||'Send estimate request'}}});}
bindEstimate();document.addEventListener('astro:page-load',bindEstimate);
</script>