---
interface Props {
  compact?: boolean;
}
const { compact = false } = Astro.props;
const skyId = compact ? 'brand-sky-compact' : 'brand-sky';
---
<a
  class:list={['brand', compact && 'is-compact']}
  href="/"
  aria-label="Clearveiw Windows home"
>
  <svg class="brand-mark" viewBox="0 0 48 48" aria-hidden="true">
    <rect x="3" y="3" width="42" height="42" rx="4" fill="#f6f1e8" stroke="#122033" stroke-width="2.4" />
    <rect x="7" y="7" width="16.4" height="34" fill={`url(#${skyId})`} />
    <rect x="24.6" y="7" width="16.4" height="34" fill={`url(#${skyId})`} />
    <path d="M16 41c-4-8-2-12 0-16 1 3 3 5 3 9 2-6 4-8 6-8-3 6-2 11-2 15H16Z" fill="#1f6f73" />
    <path d="M11 41c-2-7 0-11 2-15 1 3 2 5 2 9 1-4 3-6 5-6-2 5-1 9-1 12H11Z" fill="#15575a" />
    <path d="M30 41c-3-9-1-13 1-18 1 4 3 6 3 11 2-7 4-9 6-9-3 7-2 12-2 16H30Z" fill="#1f6f73" />
    <path d="M26 41c-2-7 0-10 1-14 1 3 2 5 2 8 2-4 3-6 5-6-2 5-1 9-1 12H26Z" fill="#2a8a86" />
    <path d="M24 3v42M3 24h42" stroke="#122033" stroke-width="2.2" />
    <defs>
      <linearGradient id={skyId} x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#cfe8ea" />
        <stop offset="1" stop-color="#8ec8cb" />
      </linearGradient>
    </defs>
  </svg>
  <span class="brand-type">
    <strong>Clearveiw</strong>
    <span class="brand-sub">Vancouver, WA</span>
  </span>
</a>

<style>
  /* The mark and wordmark travel together, so they are styled here rather
     than by whichever parent happens to contain them. The compact variant is
     the footer's — Astro scoping means a parent cannot reach in to restyle
     these elements, which is the point. */
  .brand {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    text-decoration: none;
    color: var(--on-dark);
  }

  .brand-mark {
    width: 38px;
    height: 38px;
    flex: none;
    display: block;
    transition: transform var(--dur) var(--ease-out);
  }

  .brand:hover .brand-mark {
    transform: translateY(-1px) rotate(-1.5deg);
  }

  .brand-type {
    display: flex;
    flex-direction: column;
    line-height: 1.05;
  }

  .brand-type strong {
    font-family: Outfit, 'Outfit Fallback', system-ui, sans-serif;
    font-size: 1.05rem;
    font-weight: 600;
    letter-spacing: -0.03em;
  }

  .brand-sub {
    font-size: 0.62rem;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--on-dark-faint);
    font-weight: 500;
  }

  .brand.is-compact {
    color: var(--ink);
  }

  .brand.is-compact .brand-mark {
    width: 34px;
    height: 34px;
  }

  .brand.is-compact .brand-sub {
    color: var(--ink-soft);
  }

  @media (max-width: 380px) {
    .brand:not(.is-compact) .brand-sub {
      display: none;
    }
  }
</style>
