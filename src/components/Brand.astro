---
interface Props {
  compact?: boolean;
}
const { compact = false } = Astro.props;
const glassId = compact ? 'brand-glass-compact' : 'brand-glass';
---
<a
  class:list={['brand', compact && 'is-compact']}
  href="/"
  aria-label="Clearveiw Windows home"
>
  <svg class="brand-mark" viewBox="0 0 48 48" aria-hidden="true">
    <rect x="5" y="5" width="38" height="38" rx="9" fill={`url(#${glassId})`} stroke="#122033" stroke-width="2.6" />
    <path d="M24 5v38M5 24h38" stroke="#122033" stroke-width="2.4" stroke-linecap="round" />
    <path d="M27.5 9 L39 20.5" stroke="#f6f1e8" stroke-width="3" stroke-linecap="round" opacity="0.55" />
    <defs>
      <linearGradient id={glassId} x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" stop-color="#d9efec" />
        <stop offset="1" stop-color="#1f6f73" />
      </linearGradient>
    </defs>
  </svg>
  <span class="brand-type">
    <strong>Clearveiw</strong>
    <span class="brand-sub">Vancouver, WA</span>
  </span>
</a>

<style>
  /* The mark and wordmark travel together, so they are styled here rather
     than by whichever parent happens to contain them. The compact variant is
     the footer's — Astro scoping means a parent cannot reach in to restyle
     these elements, which is the point. */
  .brand {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    text-decoration: none;
    color: var(--on-dark);
  }

  .brand-mark {
    width: 38px;
    height: 38px;
    flex: none;
    display: block;
    transition: transform var(--dur) var(--ease-out);
  }

  .brand:hover .brand-mark {
    transform: translateY(-1px) rotate(-1.5deg);
  }

  .brand-type {
    display: flex;
    flex-direction: column;
    line-height: 1.05;
  }

  .brand-type strong {
    font-family: Outfit, 'Outfit Fallback', system-ui, sans-serif;
    font-size: 1.05rem;
    font-weight: 600;
    letter-spacing: -0.03em;
  }

  .brand-sub {
    font-size: 0.62rem;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--on-dark-faint);
    font-weight: 500;
  }

  .brand.is-compact {
    color: var(--ink);
  }

  .brand.is-compact .brand-mark {
    width: 34px;
    height: 34px;
  }

  .brand.is-compact .brand-sub {
    color: var(--ink-soft);
  }

  @media (max-width: 380px) {
    .brand:not(.is-compact) .brand-sub {
      display: none;
    }
  }
</style>
