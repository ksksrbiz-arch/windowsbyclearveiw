---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  image: ImageMetadata;
  alt: string;
  caption: string;
}

const { image, alt, caption } = Astro.props;
---
<figure class="gallery-addition">
  <a href={image.src} target="_blank" rel="noopener noreferrer" aria-label={`View full-resolution photo: ${caption} (opens in a new tab)`}>
    <Image src={image} alt={alt} widths={[320, 480, 720, 960, 1200]} width={1200}
      sizes="(max-width: 560px) 45vw, (max-width: 900px) 46vw, 450px"
      format="webp" quality={82} loading="lazy" decoding="async" />
    <span class="photo-detail" aria-hidden="true">View full photo ↗</span>
  </a>
  <figcaption>{caption}</figcaption>
</figure>

<style>
  .gallery-addition {
    margin: 0;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--paper-raised);
  }
  a {
    position: relative;
    display: block;
    color: var(--on-dark);
  }
  a:focus-visible {
    outline: 3px solid var(--accent);
    outline-offset: -3px;
  }
  img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 4;
    object-fit: cover;
  }
  .photo-detail {
    position: absolute;
    right: 0.6rem;
    bottom: 0.6rem;
    padding: 0.35rem 0.55rem;
    border-radius: var(--radius);
    background: rgb(17 18 20 / 80%);
    font-size: 0.7rem;
  }
  figcaption {
    padding: var(--space-xs);
    color: var(--ink);
    font-size: var(--step--2);
  }
</style>
