---
import { Image } from 'astro:assets';
import { findWork } from '../data/work';

interface Props { guideId: string; }
const { guideId } = Astro.props;

const visuals = {
  'full-frame-vs-insert': {
    workId: 'new-unit-interior',
    kicker: 'REAL INSTALLATION',
    title: 'Start with the opening, not the sales label.',
    body: 'This Clearview job shows a new unit sitting in an existing finished opening. The scope decision is what stays, what comes out, and what has to be rebuilt around it.',
    credit: 'Clearview job photo — new unit in the existing opening.',
  },
  'window-replacement-cost-washington': {
    workId: 'gray-side-slider',
    kicker: 'REAL PROJECT SCOPE',
    title: 'The final number follows the house in front of you.',
    body: 'A finished elevation makes the point better than a generic calculator graphic: window count is only one part of the scope. Access, size, finish, method, and opening condition all change the work.',
    credit: 'Clearview job photo — finished side elevation.',
  },
  'cascade-vs-milgard': {
    workId: 'blue-slider',
    kicker: 'PRODUCT DECISION',
    title: 'Compare the unit you are buying, not the logo alone.',
    body: 'A window brand is only the starting point. The exact line, glass package, U-factor, options, and price on the opening in front of you are what belong on the quote.',
    credit: 'Clearview job photo — finished slider installation.',
  },
  'vinyl-vs-fiberglass-pacific-northwest': {
    workId: 'tan-upper-slider',
    kicker: 'FRAME / OPENING',
    title: 'Material choice gets interesting when the opening gets large.',
    body: 'This is the kind of opening where frame width, span, color, and glass package matter more than a generic material scorecard. The right choice depends on the exact unit and size.',
    credit: 'Clearview job photo — upper-story slider opening.',
  },
} as const;

const visual = visuals[guideId as keyof typeof visuals];
const work = visual ? findWork(visual.workId) : null;
---
{visual && work ? (
  <figure class="guide-visual">
    <div class="guide-visual-media">
      <Image
        src={work.image}
        alt={work.alt}
        widths={[700, 1000, 1400]}
        sizes="(max-width: 800px) 100vw, 62vw"
        format="webp"
        quality={78}
        loading="eager"
        fetchpriority="high"
      />
      <span class="guide-visual-tag">{visual.kicker}</span>
    </div>
    <div class="guide-visual-copy">
      <p class="rule-label">What this visual tells you</p>
      <h2>{visual.title}</h2>
      <p>{visual.body}</p>
      <a href="/gallery" class="guide-visual-link">See more Clearview work <span aria-hidden="true">→</span></a>
    </div>
    <figcaption>{visual.credit}</figcaption>
  </figure>
) : null}

<style>
  .guide-visual {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(18rem, .7fr);
    gap: var(--space-l);
    margin: 0;
  }

  .guide-visual-media {
    position: relative;
    min-height: 25rem;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--paper-sunk);
    box-shadow: var(--shadow-md);
  }

  .guide-visual-media img {
    display: block;
    width: 100%;
    height: 100%;
    min-height: 25rem;
    object-fit: cover;
  }

  .guide-visual-tag {
    position: absolute;
    left: .8rem;
    bottom: .8rem;
    padding: .42rem .55rem;
    background: color-mix(in srgb, var(--ink) 90%, transparent);
    color: var(--paper);
    font-size: 10px;
    font-weight: 800;
    letter-spacing: .11em;
  }

  .guide-visual-copy {
    display: grid;
    align-content: center;
    padding: var(--space-l);
    border: 1px solid var(--line);
    border-left: 3px solid var(--accent);
    background: var(--paper-raised);
  }

  .guide-visual-copy h2 {
    margin: .45rem 0 .7rem;
    font-size: var(--step-3);
    line-height: 1.08;
  }

  .guide-visual-copy p:not(.rule-label) {
    margin: 0;
    color: var(--ink-soft);
    font-size: var(--step--1);
    line-height: 1.55;
  }

  .guide-visual-link {
    display: inline-flex;
    width: fit-content;
    gap: .45rem;
    margin-top: var(--space-m);
    color: var(--accent-ink);
    font-size: var(--step--2);
    font-weight: 750;
    text-decoration: none;
  }

  .guide-visual-link:hover { text-decoration: underline; text-underline-offset: .2em; }

  figcaption {
    grid-column: 1 / -1;
    margin-top: calc(var(--space-s) * -1);
    color: var(--ink-faint);
    font-size: var(--step--2);
  }

  @media (max-width: 900px) {
    .guide-visual { grid-template-columns: 1fr; }
    .guide-visual-copy { padding: var(--space-m); }
    .guide-visual-copy h2 { font-size: var(--step-2); }
    .guide-visual-media,
    .guide-visual-media img { min-height: 20rem; }
  }
</style>
