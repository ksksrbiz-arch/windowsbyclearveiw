---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  image: ImageMetadata;
  alt: string;
  caption?: string;
  kind?: string;
  featured?: boolean;
  /** First tile on a page paints above the fold — skip lazy loading there. */
  eager?: boolean;
}

const { image, alt, caption, kind, featured = false, eager = false } = Astro.props;

// Featured tiles run double width, so ask for a wider source on those.
const widths = featured ? [400, 640, 900] : [280, 400, 560];
const sizes = featured
  ? '(max-width: 800px) 50vw, 620px'
  : '(max-width: 800px) 50vw, 300px';
---
<figure class:list={['work-card', featured && 'is-featured']}>
  <div class="work-media">
    <Image
      src={image}
      alt={alt}
      widths={widths}
      sizes={sizes}
      format="webp"
      quality={72}
      loading={eager ? 'eager' : 'lazy'}
      fetchpriority={eager ? 'high' : undefined}
      decoding={eager ? 'sync' : 'async'}
    />
  </div>
  {(caption || kind) && (
    <figcaption>
      {caption && <span>{caption}</span>}
      {kind && <span class="work-kind">{kind}</span>}
    </figcaption>
  )}
</figure>
