---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { FRAMES, SLOT_SIZES, coverScale, scaleSizes, tileWidths, type FrameName } from '../lib/image-sizes';

interface Props {
  image: ImageMetadata;
  alt: string;
  caption?: string;
  kind?: string;
  /** First tile on a page paints above the fold — skip lazy loading there. */
  eager?: boolean;
  /**
   * How wide this tile actually renders: one of SLOT_SIZES (measured slot widths),
   * not a guess. Grids differ per page and per group, and a `sizes` that
   * under-declares makes the browser pick a smaller file and upscale it.
   */
  sizes?: string;
  /**
   * Shape of the frame. Portrait is the site's standard tile. Use landscape only
   * for a group in which every photo is wider than tall (see `frameForGroup`), so
   * the whole building shows instead of a cropped middle strip.
   */
  frame?: FrameName;
}

const {
  image,
  alt,
  caption,
  kind,
  eager = false,
  // Default suits a three-across grid in the standard wrap. Measured: tiles
  // render at 450px on a 1440px viewport, 397px at 1280px.
  sizes = SLOT_SIZES.threeAcross,
  frame = 'portrait',
} = Astro.props;

// The tile crops its photo to the frame (object-fit: cover). A photo wider than
// the frame is scaled to the frame's height, so the file must be wider than the
// tile by the same factor or the browser stretches a too-small file. A photo
// cropped hard (a landscape shot in a portrait frame) also gets 1600 and 2000px
// candidates; the larger responsive variants come from the 4K sources.
const scale = coverScale(image, FRAMES[frame]);
const slotSizes = scaleSizes(sizes, scale);
const widths = tileWidths(scale);
---
<figure class="work-card" data-frame={frame}>
  <div class="work-media">
    <Image
      src={image}
      alt={alt}
      widths={widths}
      width={450}
      sizes={slotSizes}
      format="webp"
      quality={72}
      loading={eager ? 'eager' : 'lazy'}
      fetchpriority={eager ? 'high' : undefined}
      decoding={eager ? 'sync' : 'async'}
    />
  </div>
  {(caption || kind) && (
    <figcaption>
      {caption && <span class="work-caption">{caption}</span>}
      {kind && <span class="work-kind">{kind}</span>}
    </figcaption>
  )}
</figure>

<style>
  /* Consistent crops, frames and captions keep the project grid cohesive. */
  .work-card {
    margin: 0;
    background: var(--paper-raised);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
    transition: border-color var(--dur) var(--ease), box-shadow var(--dur) var(--ease);
  }

  .work-card:hover {
    border-color: var(--line-strong);
    box-shadow: var(--shadow-md);
  }

  .work-media {
    overflow: hidden;
    background: var(--paper-sunk);
  }

  .work-card img {
    width: 100%;
    /* Astro's <Image> writes the source file's real intrinsic width/height
       as HTML attributes. Those act as a low-priority CSS width/height (not
       "auto"), so aspect-ratio below only takes effect once height is
       explicitly auto -- without this, a source whose pixel dimensions
       aren't already ~3:4 (or are just much larger) renders at its literal
       attribute height instead of the intended box. */
    height: auto;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    transition: transform var(--dur-slow) var(--ease-out);
  }

  /* Keep these ratios in step with FRAMES in src/lib/image-sizes.ts. */
  .work-card[data-frame='landscape'] img {
    aspect-ratio: 4 / 3;
  }

  .work-card[data-frame='square'] img {
    aspect-ratio: 1 / 1;
  }

  .work-card:hover img {
    transform: scale(1.035);
  }

  .work-card figcaption {
    display: flex;
    justify-content: space-between;
    gap: var(--space-2xs);
    align-items: baseline;
    padding: var(--space-2xs) var(--space-xs) var(--space-xs);
    font-size: var(--step--2);
  }

  .work-caption {
    color: var(--ink);
  }

  .work-kind {
    flex: none;
    text-transform: uppercase;
    letter-spacing: var(--tracking-label);
    font-size: var(--step--2);
    font-weight: 500;
    color: var(--accent);
  }

  @media (prefers-reduced-motion: reduce) {
    .work-card img {
      transition: none;
    }
  }
</style>
