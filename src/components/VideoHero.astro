---
import { existsSync } from 'node:fs';
import { Image, getImage } from 'astro:assets';
import { site, telHref } from '../data/site';
import { heroPhoto } from '../data/work';

const hasVideo = existsSync(new URL('../../public/video/hero.mp4', import.meta.url));

// The poster has to be a plain URL, so render one through the image pipeline.
const poster = await getImage({
  src: heroPhoto.image,
  width: 1200,
  format: 'webp',
  quality: 70,
});
---
{hasVideo ? (
  <section class="video-hero">
    <div class="video-stage" aria-hidden="true">
      <video
        class="hero-media"
        id="hero-video"
        poster={poster.src}
        muted
        playsinline
        loop
        autoplay
        preload="metadata"
      >
        <source src="/video/hero.webm" type="video/webm" />
        <source src="/video/hero.mp4" type="video/mp4" />
      </video>
      <div class="video-wash"></div>
    </div>

    <div class="wrap video-copy">
      <p class="kicker">Vancouver, WA &middot; Clark County</p>
      <h1>Clear glass. Tight openings.</h1>
      <p class="lede">
        Replacement and new-construction windows, installed by the person who quoted them.
      </p>
      <p class="hero-actions">
        <a class="btn btn-light" href={telHref()}>Call {site.phoneDisplay}</a>
        <a class="btn btn-ghost btn-on-dark" href="/estimate">Request an estimate</a>
      </p>
    </div>
  </section>
) : (
  <section class="photo-hero">
    <div class="wrap photo-hero-inner">
      <div class="photo-hero-copy">
        <p class="kicker">Vancouver, WA &middot; Clark County</p>
        <h1>Clear glass. Tight openings.</h1>
        <p class="lede">
          {site.shortName} replaces tired windows and sets new ones in Vancouver, Camas,
          Washougal, Battle Ground, Brush Prairie, Ridgefield, and the rest of Clark County.
        </p>
        <p class="hero-actions">
          <a class="btn btn-light" href={telHref()}>Call {site.phoneDisplay}</a>
          <a class="btn btn-ghost btn-on-dark" href="/estimate">Request an estimate</a>
        </p>
        <p class="hero-note">Free measure. A written number before anything comes out of the wall.</p>
        <ul class="trust-strip">
          <li>Owner on the job</li>
          <li>Replacement &amp; new construction</li>
          <li>Vancouver, WA based</li>
          <li>Free written estimate</li>
        </ul>
      </div>
      <figure class="photo-hero-frame">
        <Image
          src={heroPhoto.image}
          alt={heroPhoto.alt}
          widths={[450, 700, 900]}
          sizes="(max-width: 800px) 100vw, 480px"
          format="webp"
          quality={78}
          loading="eager"
          fetchpriority="high"
          decoding="sync"
        />
        <figcaption>After. Clark County replacement.</figcaption>
      </figure>
    </div>
  </section>
)}

<script>
  function calmHero() {
    const video = document.getElementById('hero-video');
    if (!(video instanceof HTMLVideoElement)) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      video.removeAttribute('autoplay');
      video.pause();
    }
  }

  calmHero();
  document.addEventListener('astro:page-load', calmHero);
</script>
