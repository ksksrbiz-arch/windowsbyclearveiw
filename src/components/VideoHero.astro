---
import { existsSync } from 'node:fs';
import { site, telHref } from '../data/site';

const hasVideo = existsSync(new URL('../../public/video/hero.mp4', import.meta.url));
---
<section class="video-hero">
  <div class="video-stage" aria-hidden="true">
    {hasVideo ? (
      <video
        class="hero-media"
        id="hero-video"
        poster="/video/poster.svg"
        muted
        playsinline
        loop
        autoplay
        preload="metadata"
      >
        <source src="/video/hero.webm" type="video/webm" />
        <source src="/video/hero.mp4" type="video/mp4" />
      </video>
    ) : (
      <div class="hero-media hero-fallback">
        <div class="install-scene">
          <span class="scene-frame"></span>
          <span class="scene-sash"></span>
        </div>
      </div>
    )}
    <div class="video-wash"></div>
  </div>

  <div class="wrap video-copy">
    <p class="kicker">Washington window installation</p>
    <h1>If the window is the problem, replacing it is the fix.</h1>
    <p class="lede">
      Drafts, fogged glass, and soft sills are not a cleaning job. {site.shortName} measures,
      orders, and installs replacement windows for Washington homes.
    </p>
    <p class="hero-actions">
      <a class="btn btn-primary" href={telHref()}>{site.phone || 'Get an estimate'}</a>
      <a class="btn btn-ghost btn-on-dark" href="#signs">See if you need new windows</a>
    </p>
    {!hasVideo && (
      <p class="fine-print hero-note">Hero video slot is ready. Add public/video/hero.mp4 when you have a clip.</p>
    )}
  </div>
</section>

<script>
  const video = document.getElementById('hero-video');
  if (video instanceof HTMLVideoElement && window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    video.removeAttribute('autoplay');
    video.pause();
  }
</script>
