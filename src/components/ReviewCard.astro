---
import '../styles/review-cards.css';
import GoogleIcon from './icons/GoogleIcon.astro';
interface Props {
  quote: string;
  name: string;
  city?: string;
  source?: string;
  sourceUrl?: string;
  rating?: number;
}
const { quote, name, city, source = 'Customer', sourceUrl, rating } = Astro.props;
const initials = name.split(/\s+/).filter(Boolean).slice(0, 2).map(part => part[0]).join('');
---
<blockquote class="review-spotlight" data-curated-review data-review-author={name} data-review-text={quote}>
  <div class="review-spotlight-top">
    {rating && <div class="review-rating"><span class="review-stars" role="img" aria-label={`${rating} out of 5 stars`}>{'★'.repeat(rating)}{'☆'.repeat(5 - rating)}</span><span class="review-rating-label">{rating.toFixed(1)} / 5</span></div>}
    <span class="review-source">{source === 'Google' && <GoogleIcon />} {source} review</span>
  </div>
  <span class="review-quote-mark" aria-hidden="true">“</span>
  <p class="review-quote">“{quote}”</p>
  <footer class="review-footer">
    <div class="review-person">
      <span class="review-avatar" aria-hidden="true">{initials}</span>
      <div><strong class="review-name">{name}</strong><span class="review-person-meta">{city ? `${city} · ${source} review` : `${source} review`}</span></div>
    </div>
    {sourceUrl && <a class="review-source-link" href={sourceUrl} target="_blank" rel="noopener noreferrer">View on {source}<span aria-hidden="true">↗</span></a>}
  </footer>
</blockquote>