---
// The real four-color Google "G" — recognizable at a glance next to the
// Facebook mark, the same reasoning FacebookIcon.astro uses for its own
// brand colors instead of a generic line-icon glyph.
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---
<svg
  class={className}
  viewBox="0 0 24 24"
  aria-hidden="true"
  focusable="false"
>
  <path
    fill="#4285F4"
    d="M23.52 12.273c0-.851-.076-1.67-.218-2.455H12v4.645h6.458a5.52 5.52 0 0 1-2.394 3.622v3.01h3.878c2.269-2.09 3.578-5.166 3.578-8.822Z"
  />
  <path
    fill="#34A853"
    d="M12 24c3.24 0 5.956-1.075 7.942-2.905l-3.878-3.01c-1.075.72-2.45 1.146-4.064 1.146-3.125 0-5.77-2.11-6.715-4.946H1.28v3.108C3.256 21.31 7.31 24 12 24Z"
  />
  <path
    fill="#FBBC05"
    d="M5.285 14.285A7.19 7.19 0 0 1 4.909 12c0-.793.136-1.564.376-2.285V6.607H1.28A11.996 11.996 0 0 0 0 12c0 1.936.464 3.769 1.28 5.393l4.005-3.108Z"
  />
  <path
    fill="#EA4335"
    d="M12 4.77c1.762 0 3.344.606 4.588 1.794l3.442-3.442C17.951 1.19 15.236 0 12 0 7.31 0 3.256 2.69 1.28 6.607l4.005 3.108C6.23 6.879 8.875 4.77 12 4.77Z"
  />
</svg>
