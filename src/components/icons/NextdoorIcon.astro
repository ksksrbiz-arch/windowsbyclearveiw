---
// The real Nextdoor mark (green rounded square, white "N") — same reasoning
// as FacebookIcon.astro and GoogleIcon.astro: recognizable at a glance next
// to the other platform marks rather than a generic line-icon glyph.
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---
<svg
  class={className}
  viewBox="0 0 24 24"
  aria-hidden="true"
  focusable="false"
>
  <rect width="24" height="24" rx="6" fill="#8ED500" />
  <path
    fill="#fff"
    d="M7 6.5h2.1l5.4 7.2V6.5H17v11h-2.1l-5.4-7.2v7.2H7v-11Z"
  />
</svg>
