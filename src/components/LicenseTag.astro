---
// A factual disclosure tag for the WA L&I contractor registration number,
// not a trust seal. Washington's RCW 18.27.100 governs what a registered
// contractor may claim in advertising — a registration is a legal permit
// plus a small consumer-protection bond, not a certification or inspection,
// so this deliberately reads as "here is the number" rather than a
// checkmark/shield graphic that would imply more assurance than that.
// Renders nothing when site.lniNumber is unset — see Footer.astro's
// plain-text fallback for that state.
//
// `onDark` swaps to the --accent-2-bright/--black-tested pairing for use
// over the hero's dark background; the default pairing is the
// --accent-2-ink/paper combination already verified at 8.5:1 in
// global.css. Both are existing, already-checked tokens — no new
// contrast pairing invented here.
import { site } from '../data/site';

interface Props {
  onDark?: boolean;
}

const { onDark = false } = Astro.props;
---
{site.lniNumber && (
  <span class:list={['license-tag', { 'is-on-dark': onDark }]}>
    <svg viewBox="0 0 20 20" aria-hidden="true" focusable="false">
      <rect x="2.5" y="4.5" width="15" height="11" rx="1" />
      <line x1="5.5" y1="8" x2="14.5" y2="8" />
      <line x1="5.5" y1="10.5" x2="11.5" y2="10.5" />
      <line x1="5.5" y1="13" x2="9.5" y2="13" />
    </svg>
    <span>WA Contractor Reg. {site.lniNumber}</span>
  </span>
)}

<style>
  .license-tag {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.3rem 0.6rem;
    border-radius: 2px;
    border: 1px solid var(--accent-2-ink);
    background: color-mix(in srgb, var(--accent-2) 12%, var(--paper));
    color: var(--accent-2-ink);
    font-size: var(--step--2);
    font-weight: 600;
    letter-spacing: 0.01em;
    white-space: nowrap;
  }

  .license-tag svg {
    width: 0.95rem;
    height: 0.95rem;
    flex: none;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.4;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* Verified 6.94:1 on --black in global.css — same token, no new pairing. */
  .license-tag.is-on-dark {
    border-color: var(--accent-2-bright);
    background: color-mix(in srgb, var(--accent-2) 22%, black);
    color: var(--accent-2-bright);
  }
</style>
