---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { SLOT_SIZES } from '../lib/image-sizes';

interface Props {
  desktopSrc: ImageMetadata;
  mobileSrc?: ImageMetadata;
  alt: string;
  title?: string;
  description?: string;
  desktopMaxWidth?: string;
  /** The `sizes` of the desktop <img>: how wide it renders above the phone breakpoint. */
  sizes?: string;
}

const { desktopSrc, mobileSrc, alt, title, description, desktopMaxWidth = '100%', sizes = SLOT_SIZES.guideGraphic } = Astro.props;

// Source files come straight out of Canva at several megabytes each. Running
// them through Astro's image pipeline instead of a plain <img> gets them down
// to real web weight (WebP, sized for how large the graphic is ever shown)
// and gives the <img> explicit dimensions so it does not shift the layout
// while it loads.
//
// The graphic is shown up to 1180 px wide, so a laptop at 2x needs 2360 px: one 1400 px file left it
// at 0.59 of what the screen can show. The srcset lets the browser pick; the Canva export is 2000 px
// wide, so 2000 is as sharp as this graphic can get.
const desktop = await getImage({ src: desktopSrc, widths: [1000, 1400, 2000], width: 1400, format: 'webp', quality: 78 });
const mobile = mobileSrc
  ? await getImage({ src: mobileSrc, width: 900, format: 'webp', quality: 78 })
  : null;
---
<figure class="guide-graphic" style={'--desktop-max-width:' + desktopMaxWidth}>
  <picture class="guide-picture">
    {mobile && <source media="(max-width: 760px)" srcset={mobile.src} />}
    <img
      src={desktop.src}
      srcset={desktop.srcSet.attribute}
      sizes={sizes}
      width={desktop.attributes.width}
      height={desktop.attributes.height}
      alt={alt}
      loading="lazy"
      decoding="async"
      class="guide-image"
    />
  </picture>
  {title && <figcaption class="sr-only">{title}</figcaption>}
  {description && <p class="guide-caption">{description}</p>}
</figure>

<style>
  .guide-graphic{margin:0;width:100%}
  .guide-picture{
    display:block;width:100%;max-width:var(--desktop-max-width);margin-inline:auto;
    border:1px solid var(--line);border-radius:var(--radius-lg);
    background:var(--paper-raised);overflow:hidden;box-shadow:var(--shadow-soft)
  }
  .guide-image{display:block;width:100%;height:auto;max-width:100%;object-fit:contain}
  .guide-caption{
    width:min(100%,var(--desktop-max-width));margin:.65rem auto 0;
    color:var(--ink-soft);font-size:var(--step--2);line-height:1.45
  }
  .sr-only{
    position:absolute!important;width:1px;height:1px;padding:0;margin:-1px;
    overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0
  }
  @media(max-width:760px){
    .guide-picture,.guide-caption{max-width:100%}
    .guide-picture{border-radius:14px}
    .guide-image{width:100%;height:auto}
  }
</style>
