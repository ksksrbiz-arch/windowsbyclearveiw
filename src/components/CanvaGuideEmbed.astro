---
interface Props {
  desktopSrc: string;
  mobileSrc?: string;
  alt: string;
  title?: string;
  description?: string;
}

const { desktopSrc, mobileSrc, alt, title, description } = Astro.props;
---
<figure class="guide-graphic">
  <picture class="guide-picture">
    {mobileSrc && <source media="(max-width: 760px)" srcset={mobileSrc} />}
    <img
      src={desktopSrc}
      alt={alt}
      loading="lazy"
      decoding="async"
      class="guide-image"
    />
  </picture>
  {title && <figcaption class="sr-only">{title}</figcaption>}
  {description && <p class="guide-caption">{description}</p>}
</figure>

<style>
  .guide-graphic{margin:0}
  .guide-picture{
    display:block;
    width:100%;
    border:1px solid var(--line);
    border-radius:var(--radius-lg);
    background:var(--paper-raised);
    overflow:hidden;
    box-shadow:var(--shadow-soft)
  }
  .guide-image{
    display:block;
    width:100%;
    height:auto;
    max-width:none;
  }
  .guide-caption{
    margin:.65rem 0 0;
    color:var(--ink-soft);
    font-size:var(--step--2);
    line-height:1.45;
  }
  .sr-only{
    position:absolute!important;
    width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;
    clip:rect(0,0,0,0);white-space:nowrap;border:0
  }
</style>
