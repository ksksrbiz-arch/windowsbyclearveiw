---
/**
 * U-factor and SHGC as two horizontal scales rather than two acronyms. Both
 * numbers appear on every NFRC label Mark hands over, and both are
 * meaningless without a sense of where "good" sits and why the Washington
 * answer is not the same as the Arizona answer.
 */
const uFactor = {
  min: 0.15,
  max: 0.5,
  goodMax: 0.3,
  typical: 0.27,
};

const shgc = {
  min: 0.15,
  max: 0.7,
  // In a heating-dominated climate a higher SHGC is welcome on south glass —
  // the opposite of the advice a hot, sunny climate gives.
  usefulMin: 0.3,
  typical: 0.32,
};

const pct = (value: number, min: number, max: number) =>
  Math.min(100, Math.max(0, ((value - min) / (max - min)) * 100));
---
<figure class="gauge-detail">
  <figcaption class="gauge-heading">Two numbers on every window label</figcaption>

  <div class="gauge-pair">
    <div class="gauge-panel">
      <p class="gauge-title">U-factor</p>
      <p class="gauge-sub">Heat lost through the window — lower is tighter</p>

      <div class="gauge-track" role="img" aria-label={`U-factor scale from ${uFactor.min} to ${uFactor.max}. Washington's better-performing range runs up to about ${uFactor.goodMax}. A typical Clearveiw double-pane install lands around ${uFactor.typical}.`}>
        <div class="gauge-zone gauge-zone-good" style={`width: ${pct(uFactor.goodMax, uFactor.min, uFactor.max)}%`}></div>
        <div class="gauge-mark" style={`left: ${pct(uFactor.typical, uFactor.min, uFactor.max)}%`}>
          <span class="gauge-mark-dot"></span>
          <span class="gauge-mark-label">{uFactor.typical}</span>
        </div>
      </div>
      <div class="gauge-scale">
        <span>{uFactor.min}</span>
        <span>{uFactor.max}</span>
      </div>

      <p class="gauge-note">
        Below about <strong>{uFactor.goodMax}</strong> is the range Washington utility rebates
        usually look for. A typical Clearveiw double-pane, Low-E install lands near
        <strong> {uFactor.typical}</strong>; triple-pane goes lower still.
      </p>
    </div>

    <div class="gauge-panel">
      <p class="gauge-title">SHGC</p>
      <p class="gauge-sub">Solar heat let through — higher means more free heat</p>

      <div class="gauge-track" role="img" aria-label={`SHGC scale from ${shgc.min} to ${shgc.max}. Washington's useful range for passive solar heat starts around ${shgc.usefulMin}. A typical install lands around ${shgc.typical}.`}>
        <div class="gauge-zone gauge-zone-warm" style={`left: ${pct(shgc.usefulMin, shgc.min, shgc.max)}%; width: ${100 - pct(shgc.usefulMin, shgc.min, shgc.max)}%`}></div>
        <div class="gauge-mark" style={`left: ${pct(shgc.typical, shgc.min, shgc.max)}%`}>
          <span class="gauge-mark-dot"></span>
          <span class="gauge-mark-label">{shgc.typical}</span>
        </div>
      </div>
      <div class="gauge-scale">
        <span>{shgc.min}</span>
        <span>{shgc.max}</span>
      </div>

      <p class="gauge-note">
        This is where climate flips the advice: a hot, sunny region wants SHGC low to keep heat
        out. Vancouver wants a little more of it on south-facing glass, since that sun is free
        heat for eight months of the year.
      </p>
    </div>
  </div>
</figure>

<style>
  .gauge-detail {
    margin: 0;
  }

  .gauge-heading {
    display: block;
    margin: 0 0 var(--space-m);
    font-size: var(--step-2);
    font-weight: 600;
    letter-spacing: var(--tracking-display);
    line-height: var(--leading-display);
  }

  .gauge-pair {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-m);
  }

  .gauge-panel {
    padding: var(--space-m);
    background: var(--paper-raised);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
  }

  .gauge-title {
    margin: 0 0 var(--space-3xs);
    font-size: var(--step-1);
    font-weight: 600;
    letter-spacing: -0.015em;
  }

  .gauge-sub {
    margin: 0 0 var(--space-s);
    font-size: var(--step--1);
    color: var(--ink-soft);
  }

  .gauge-track {
    position: relative;
    height: 10px;
    border-radius: 999px;
    background: var(--paper-sunk);
    border: 1px solid var(--line);
    margin: var(--space-m) 0 var(--space-2xs);
  }

  .gauge-zone {
    position: absolute;
    top: 0;
    left: 0;
    height: 100%;
    border-radius: 999px;
  }

  .gauge-zone-good {
    background: color-mix(in srgb, var(--accent) 45%, transparent);
  }

  .gauge-zone-warm {
    background: linear-gradient(90deg, transparent, color-mix(in srgb, var(--accent-bright, var(--accent)) 55%, transparent));
  }

  .gauge-mark {
    position: absolute;
    top: 50%;
    translate: -50% -50%;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.3rem;
  }

  .gauge-mark-dot {
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: var(--ink);
    border: 2px solid var(--paper-raised);
    box-shadow: 0 0 0 1px var(--ink);
  }

  .gauge-mark-label {
    position: absolute;
    top: 18px;
    font-size: var(--step--2);
    font-weight: 600;
    color: var(--ink);
    white-space: nowrap;
  }

  .gauge-scale {
    display: flex;
    justify-content: space-between;
    margin-top: var(--space-m);
    font-size: var(--step--2);
    color: var(--ink-faint);
    letter-spacing: var(--tracking-label);
  }

  .gauge-note {
    margin: var(--space-s) 0 0;
    font-size: var(--step--1);
    color: var(--ink-soft);
  }

  .gauge-note strong {
    color: var(--ink);
  }

  @media (max-width: 800px) {
    .gauge-pair {
      grid-template-columns: 1fr;
    }
  }
</style>
