---
interface Props { heading?: string | null; }
const { heading = 'How double-pane energy-efficient glass works' } = Astro.props;
---
<figure class="glass">
  {heading && <figcaption class="heading">{heading}</figcaption>}
  <p class="intro">Two panes, an insulated space, and a sealed edge work together as one glass unit.</p>

  <div class="glass-wrap">
    <svg viewBox="0 0 1200 620" role="img" aria-label="Cross-section diagram of double-pane insulated glass showing the exterior pane, insulating space, spacer, interior pane, perimeter seal, and simple heat-flow arrows.">
      <defs>
        <linearGradient id="paneA" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" stop-color="#fbffff"/>
          <stop offset=".55" stop-color="#d8eee7"/>
          <stop offset="1" stop-color="#b8d8ce"/>
        </linearGradient>
        <linearGradient id="cavityA" x1="0" y1="0" x2="1" y2="1">
          <stop offset="0" stop-color="#eef7f3"/>
          <stop offset="1" stop-color="#dbe8e1"/>
        </linearGradient>
        <marker id="arrowWarm" markerWidth="12" markerHeight="12" refX="9" refY="4" orient="auto">
          <path d="M0,0 L10,4 L0,8 Z" fill="#c46845"/>
        </marker>
        <marker id="arrowCool" markerWidth="12" markerHeight="12" refX="9" refY="4" orient="auto">
          <path d="M0,0 L10,4 L0,8 Z" fill="#5b8fb2"/>
        </marker>
      </defs>

      <rect width="1200" height="620" fill="#f7f8f5" rx="26"/>

      <text x="118" y="84" font-size="18" font-weight="700" fill="#7d4a42" font-family="Inter,Arial,sans-serif">OUTDOOR</text>
      <text x="1060" y="84" font-size="18" font-weight="700" fill="#2f6f5a" text-anchor="end" font-family="Inter,Arial,sans-serif">INDOOR</text>

      <!-- heat movement -->
      <path d="M126 182 C200 182,220 182,282 182" stroke="#c46845" stroke-width="10" fill="none" marker-end="url(#arrowWarm)" opacity=".75"/>
      <path d="M1074 182 C1000 182,980 182,918 182" stroke="#5b8fb2" stroke-width="10" fill="none" marker-end="url(#arrowCool)" opacity=".58"/>

      <!-- main unit -->
      <rect x="290" y="128" width="620" height="332" rx="10" fill="#fff" stroke="#355247" stroke-width="10"/>
      <rect x="318" y="156" width="86" height="276" rx="4" fill="url(#paneA)" stroke="#75988c" stroke-width="4"/>
      <rect x="792" y="156" width="86" height="276" rx="4" fill="url(#paneA)" stroke="#75988c" stroke-width="4"/>

      <!-- insulating cavity -->
      <rect x="404" y="156" width="388" height="276" rx="3" fill="url(#cavityA)" stroke="#b7c9c0" stroke-width="3"/>
      <rect x="404" y="156" width="14" height="276" fill="#8b9f96" opacity=".55"/>
      <rect x="778" y="156" width="14" height="276" fill="#8b9f96" opacity=".55"/>

      <!-- Low-E indication -->
      <rect x="424" y="158" width="8" height="272" rx="4" fill="#d39c46" opacity=".9"/>
      <text x="438" y="244" font-size="15" font-weight="700" fill="#8f6c28" font-family="Inter,Arial,sans-serif">Low-E surface</text>
      <text x="438" y="266" font-size="13" fill="#75684c" font-family="Inter,Arial,sans-serif">coating can reflect heat</text>

      <!-- cavity label -->
      <text x="598" y="284" text-anchor="middle" font-size="22" font-weight="700" fill="#38564a" font-family="Inter,Arial,sans-serif">INSULATING SPACE</text>
      <text x="598" y="312" text-anchor="middle" font-size="16" fill="#64756e" font-family="Inter,Arial,sans-serif">air or insulating gas</text>

      <!-- spacer and seal -->
      <rect x="398" y="147" width="16" height="294" rx="4" fill="#d9d0bd"/>
      <rect x="786" y="147" width="16" height="294" rx="4" fill="#d9d0bd"/>
      <rect x="304" y="145" width="596" height="12" rx="6" fill="#2d7d63"/>
      <rect x="304" y="429" width="596" height="12" rx="6" fill="#2d7d63"/>

      <!-- callout leaders -->
      <g fill="none" stroke="#2d7d63" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
        <path d="M361 156 V110 H220"/>
        <path d="M404 338 H208 V400"/>
        <path d="M598 432 V505"/>
        <path d="M835 156 V110 H970"/>
        <path d="M800 428 H976 V382"/>
      </g>
      <g fill="#2d7d63">
        <circle cx="361" cy="156" r="6"/><circle cx="404" cy="338" r="6"/><circle cx="598" cy="432" r="6"/><circle cx="835" cy="156" r="6"/><circle cx="800" cy="428" r="6"/>
      </g>

      <!-- callout labels -->
      <g font-family="Inter,Arial,sans-serif">
        <text x="220" y="92" text-anchor="middle" font-size="16" font-weight="700" fill="#233e33">EXTERIOR PANE</text>
        <text x="208" y="424" text-anchor="middle" font-size="16" font-weight="700" fill="#233e33">SPACER</text>
        <text x="598" y="540" text-anchor="middle" font-size="16" font-weight="700" fill="#233e33">PERIMETER SEAL</text>
        <text x="970" y="92" text-anchor="middle" font-size="16" font-weight="700" fill="#233e33">INTERIOR PANE</text>
        <text x="976" y="406" text-anchor="middle" font-size="16" font-weight="700" fill="#233e33">SEALED EDGE</text>
      </g>
    </svg>

    <div class="simple-note">
      <strong>What matters most:</strong>
      <span>The glass unit is a system. The panes, insulating space, spacer, coating, and edge seal all work together.</span>
    </div>
  </div>
</figure>

<style>
  .glass{margin:0}
  .heading{display:block;margin:0 0 .35rem;font-size:var(--step-2);font-weight:650;letter-spacing:var(--tracking-display);line-height:var(--leading-display)}
  .intro{margin:0 0 var(--space-l);max-width:74ch;color:var(--ink-soft);font-size:var(--step--1)}
  .glass-wrap{border:1px solid var(--line);background:#f7f8f5;border-radius:var(--radius-lg);overflow:hidden;box-shadow:var(--shadow-soft)}
  .glass-wrap svg{display:block;width:100%;height:auto}
  .simple-note{display:grid;grid-template-columns:auto 1fr;gap:var(--space-s);margin:0;padding:.85rem 1rem;background:var(--paper-raised);border-left:3px solid var(--accent);font-size:var(--step--1)}
  .simple-note strong{color:var(--ink)}
  .simple-note span{color:var(--ink-soft)}
  @media(max-width:720px){
    .glass-wrap svg{min-width:760px}
    .glass-wrap{overflow-x:auto}
    .simple-note{grid-template-columns:1fr}
  }
</style>
