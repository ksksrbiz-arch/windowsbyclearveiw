---
interface Props { heading?: string | null; }
const { heading = 'How double-pane energy-efficient glass works' } = Astro.props;
---
<figure class="glass-guide">
  {heading && <figcaption class="heading">{heading}</figcaption>}
  <p class="intro">Two panes of glass are separated by an insulated space and sealed around the edge to create one insulated glass unit.</p>

  <div class="desktop-diagram" role="img" aria-label="Cross-section of a double-pane insulated glass unit with exterior pane, insulating space, interior pane, spacer and perimeter seal.">
    <svg viewBox="0 0 1200 640" aria-hidden="true" focusable="false">
      <defs>
        <linearGradient id="cv-g-pane" x1="0" y1="0" x2="1" y2="1">
          <stop offset="0" stop-color="#f9ffff"/>
          <stop offset=".5" stop-color="#d9efe8"/>
          <stop offset="1" stop-color="#b8d8ce"/>
        </linearGradient>
        <linearGradient id="cv-g-cavity" x1="0" y1="0" x2="1" y2="1">
          <stop offset="0" stop-color="#eef7f3"/>
          <stop offset="1" stop-color="#d9e8e1"/>
        </linearGradient>
        <filter id="cv-g-shadow" x="-30%" y="-30%" width="160%" height="160%">
          <feDropShadow dx="0" dy="18" stdDeviation="18" flood-color="#173027" flood-opacity=".12"/>
        </filter>
      </defs>

      <rect width="1200" height="640" rx="28" fill="#f7f8f5"/>
      <text x="84" y="70" fill="#7d4a42" font-family="Inter,Arial,sans-serif" font-size="15" font-weight="750" letter-spacing="2">OUTDOOR</text>
      <text x="1116" y="70" text-anchor="end" fill="#2f6f5a" font-family="Inter,Arial,sans-serif" font-size="15" font-weight="750" letter-spacing="2">INDOOR</text>

      <!-- directional heat cue -->
      <g stroke="#c66f4c" stroke-width="12" stroke-linecap="round" opacity=".72">
        <path d="M92 180 H250"/>
      </g>
      <path d="M240 165 L270 180 L240 195Z" fill="#c66f4c" opacity=".72"/>
      <text x="92" y="215" fill="#7d4a42" font-family="Inter,Arial,sans-serif" font-size="13">heat meets the window</text>

      <!-- main glass unit -->
      <g filter="url(#cv-g-shadow)">
        <rect x="260" y="150" width="680" height="310" rx="18" fill="#fff" stroke="#274439" stroke-width="10"/>
        <rect x="294" y="184" width="92" height="242" rx="6" fill="url(#cv-g-pane)" stroke="#6e9488" stroke-width="4"/>
        <rect x="386" y="184" width="428" height="242" rx="5" fill="url(#cv-g-cavity)" stroke="#bdcec6" stroke-width="3"/>
        <rect x="814" y="184" width="92" height="242" rx="6" fill="url(#cv-g-pane)" stroke="#6e9488" stroke-width="4"/>

        <!-- spacer -->
        <rect x="374" y="174" width="28" height="262" rx="5" fill="#d5cdbb"/>
        <rect x="798" y="174" width="28" height="262" rx="5" fill="#d5cdbb"/>

        <!-- perimeter seal -->
        <rect x="278" y="168" width="644" height="294" rx="12" fill="none" stroke="#2d7d63" stroke-width="10"/>

        <!-- low-e cue -->
        <rect x="407" y="185" width="7" height="240" rx="4" fill="#d39c46"/>
      </g>

      <!-- cavity copy -->
      <text x="600" y="300" text-anchor="middle" fill="#355247" font-family="Inter,Arial,sans-serif" font-size="25" font-weight="750">INSULATING SPACE</text>
      <text x="600" y="328" text-anchor="middle" fill="#60736b" font-family="Inter,Arial,sans-serif" font-size="16">air or insulating gas</text>
      <text x="425" y="220" fill="#886b2a" font-family="Inter,Arial,sans-serif" font-size="13" font-weight="700">Low‑E surface</text>

      <!-- leaders -->
      <g fill="none" stroke="#2d7d63" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
        <path d="M340 184 V120 H170"/>
        <path d="M600 426 V520"/>
        <path d="M860 184 V120 H1040"/>
        <path d="M814 422 H1040 V480"/>
      </g>
      <g fill="#2d7d63">
        <circle cx="340" cy="184" r="6"/>
        <circle cx="600" cy="426" r="6"/>
        <circle cx="860" cy="184" r="6"/>
        <circle cx="814" cy="422" r="6"/>
      </g>

      <g font-family="Inter,Arial,sans-serif" fill="#233e33">
        <text x="170" y="100" text-anchor="middle" font-size="17" font-weight="750">EXTERIOR PANE</text>
        <text x="600" y="552" text-anchor="middle" font-size="17" font-weight="750">INSULATING SPACE</text>
        <text x="1040" y="100" text-anchor="middle" font-size="17" font-weight="750">INTERIOR PANE</text>
        <text x="1040" y="505" text-anchor="middle" font-size="17" font-weight="750">SPACER + EDGE SEAL</text>
      </g>
    </svg>
  </div>

  <div class="mobile-diagram" aria-label="Mobile breakdown of a double-pane insulated glass unit">
    <div class="mobile-unit" aria-hidden="true">
      <div class="outside-label">OUTDOOR</div>
      <div class="heat-arrow"><span></span></div>
      <div class="pane pane-a">EXTERIOR PANE</div>
      <div class="lowe-bar"></div>
      <div class="cavity"><strong>INSULATING SPACE</strong><span>air or insulating gas</span></div>
      <div class="spacer-rail"></div>
      <div class="pane pane-b">INTERIOR PANE</div>
      <div class="seal-rail"></div>
      <div class="inside-label">INDOOR</div>
    </div>
    <div class="mobile-parts">
      <article><span>01</span><div><strong>Exterior pane</strong><p>Faces the weather.</p></div></article>
      <article><span>02</span><div><strong>Insulating space</strong><p>Creates the separation between the panes.</p></div></article>
      <article><span>03</span><div><strong>Interior pane</strong><p>Faces the room side of the home.</p></div></article>
      <article><span>04</span><div><strong>Spacer + edge seal</strong><p>Holds the panes apart and seals the unit around its perimeter.</p></div></article>
    </div>
  </div>

  <div class="note">
    <strong>What matters most:</strong>
    <span>The glass package works as one system. The panes, insulating space, Low‑E coating, spacer and edge seal all play a role.</span>
  </div>
</figure>

<style>
  .glass-guide{margin:0}
  .heading{display:block;margin:0 0 .35rem;font-size:var(--step-2);font-weight:650;letter-spacing:var(--tracking-display);line-height:var(--leading-display)}
  .intro{margin:0 0 var(--space-l);max-width:72ch;color:var(--ink-soft);font-size:var(--step--1)}
  .desktop-diagram{border:1px solid var(--line);background:#f7f8f5;border-radius:var(--radius-lg);overflow:hidden;box-shadow:var(--shadow-soft)}
  .desktop-diagram svg{display:block;width:100%;height:auto}
  .mobile-diagram{display:none}
  .note{display:grid;grid-template-columns:auto 1fr;gap:var(--space-s);margin-top:var(--space-s);padding:.85rem 1rem;border-left:3px solid var(--accent);background:var(--paper-sunk);font-size:var(--step--1)}
  .note strong{color:var(--ink)} .note span{color:var(--ink-soft)}

  @media(max-width:760px){
    .desktop-diagram{display:none}
    .mobile-diagram{display:block}
    .mobile-unit{position:relative;padding:1rem 1rem 1.25rem;border:1px solid var(--line);border-radius:var(--radius-lg);background:linear-gradient(180deg,#eef3f0,#f8faf8);overflow:hidden}
    .outside-label,.inside-label{font-size:10px;font-weight:800;letter-spacing:.12em}
    .outside-label{color:#7d4a42}.inside-label{color:#2f6f5a;text-align:right;margin-top:.55rem}
    .heat-arrow{height:22px;position:relative;margin:.45rem 0 .8rem}
    .heat-arrow::before{content:'';position:absolute;left:0;top:9px;width:70%;height:7px;border-radius:7px;background:#c66f4c}
    .heat-arrow::after{content:'';position:absolute;left:67%;top:4px;border-left:13px solid #c66f4c;border-top:8px solid transparent;border-bottom:8px solid transparent}
    .pane{min-height:62px;display:grid;place-items:center;border:2px solid #688d81;background:linear-gradient(180deg,#f8ffff,#c2ded5);border-radius:8px;font-size:11px;font-weight:800;letter-spacing:.06em;color:#31564a}
    .pane-a{border-bottom:0;border-radius:8px 8px 3px 3px}
    .pane-b{border-top:0;border-radius:3px 3px 8px 8px}
    .cavity{min-height:132px;display:grid;place-items:center;text-align:center;padding:1rem;border-left:3px solid #d0c8b5;border-right:3px solid #d0c8b5;background:linear-gradient(180deg,#edf7f3,#dceae3)}
    .cavity strong{font-size:16px;color:#355247}.cavity span{font-size:12px;color:#65766f}
    .spacer-rail{height:8px;background:#d5cdbb;margin:-3px 22px}
    .seal-rail{height:8px;border-radius:8px;background:#2d7d63;margin:8px 0 0}
    .lowe-bar{width:8px;height:34px;border-radius:4px;background:#d39c46;margin:-48px auto 14px;transform:translateX(-44px)}
    .mobile-parts{display:grid;grid-template-columns:1fr 1fr;gap:var(--space-xs);margin-top:var(--space-s)}
    .mobile-parts article{display:grid;grid-template-columns:26px 1fr;gap:.45rem;padding:.72rem;border:1px solid var(--line);border-radius:12px;background:var(--paper-raised)}
    .mobile-parts article>span{font-size:10px;font-weight:800;color:var(--accent-ink)}
    .mobile-parts strong{font-size:var(--step--1);line-height:1.15}.mobile-parts p{margin:.2rem 0 0;font-size:11px;line-height:1.35;color:var(--ink-soft)}
    .note{grid-template-columns:1fr}
  }
  @media(max-width:420px){
    .mobile-parts{grid-template-columns:1fr}
  }
</style>
