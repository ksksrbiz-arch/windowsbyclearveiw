---
interface Props { heading?: string | null; }
const { heading = 'Insert or full-frame? Follow the existing frame.' } = Astro.props;
---
<figure class="method-explainer">
  {heading && <figcaption class="heading">{heading}</figcaption>}
  <p class="intro">Both methods install a new window. The difference is <strong>how far the existing assembly is opened up</strong>.</p>

  <div class="method-cards">
    <article class="method insert">
      <header><span class="badge">01</span><div><p>INSERT / POCKET</p><h3>The existing frame remains</h3></div></header>
      <div class="drawing" role="img" aria-label="Technical cutaway showing a wall assembly, an existing window frame retained in place, and a new replacement window fitted inside that frame.">
        <div class="material siding"></div><div class="material sheathing"></div><div class="material cavity"></div><div class="material drywall"></div>
        <div class="rough-opening"></div>
        <div class="existing-frame left"></div><div class="existing-frame right"></div><div class="existing-sill"></div>
        <div class="new-unit"><div class="new-glass"></div><div class="new-sash"></div></div>
        <div class="stop top"></div><div class="stop bottom"></div>
        <div class="dimension old-depth"><span>EXISTING FRAME</span><i></i></div>
        <div class="dimension new-depth"><span>NEW UNIT</span><i></i></div>
        <div class="callout keep"><b>KEEP</b><span>frame stays in the opening</span></div>
        <div class="callout fit"><b>FIT</b><span>new unit sits inside it</span></div>
      </div>
      <div class="facts"><div><strong>Scope</strong><span>Window unit replacement inside the existing frame.</span></div><div><strong>Condition</strong><span>Existing frame and opening must be suitable for the method.</span></div></div>
    </article>

    <article class="method full">
      <header><span class="badge">02</span><div><p>FULL-FRAME</p><h3>The old frame is removed to the rough opening</h3></div></header>
      <div class="drawing" role="img" aria-label="Technical cutaway showing the old frame removed, the rough opening exposed, new perimeter flashing installed, and a new full-frame replacement window installed in the opening.">
        <div class="material siding"></div><div class="material sheathing"></div><div class="material cavity"></div><div class="material drywall"></div>
        <div class="rough-opening rough"></div>
        <div class="flash top"></div><div class="flash left"></div><div class="flash right"></div><div class="flash bottom"></div>
        <div class="old-frame-ghost"><span></span><span></span><span></span></div>
        <div class="new-unit full-unit"><div class="new-glass"></div><div class="new-sash"></div><div class="nailing-fin"></div></div>
        <div class="dimension rough-depth"><span>ROUGH OPENING</span><i></i></div>
        <div class="callout remove"><b>REMOVE</b><span>old frame leaves the opening</span></div>
        <div class="callout rebuild"><b>REBUILD</b><span>prepare the opening for the new unit</span></div>
      </div>
      <div class="facts"><div><strong>Scope</strong><span>Frame removal, opening preparation, then new-window installation.</span></div><div><strong>Condition</strong><span>Used when the frame/opening needs reconstruction or a deeper inspection.</span></div></div>
    </article>
  </div>

  <div class="decision"><strong>Same wall. Different depth of work.</strong><span>Insert stays inside the existing frame. Full-frame takes the work back to the rough opening.</span></div>
</figure>

<style>
.method-explainer{margin:0}.heading{display:block;margin:0 0 .35rem;font-size:var(--step-2);font-weight:650;letter-spacing:var(--tracking-display);line-height:var(--leading-display)}.intro{margin:0 0 var(--space-l);max-width:72ch;color:var(--ink-soft);font-size:var(--step--1)}.method-cards{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:var(--space-l)}.method{padding:var(--space-m);border:1px solid var(--line);border-top:4px solid var(--ink);border-radius:var(--radius-lg);background:var(--paper-raised)}.insert{border-top-color:var(--accent)}.full{border-top-color:var(--danger)}.method header{display:grid;grid-template-columns:3rem 1fr;gap:var(--space-s);align-items:center;margin-bottom:var(--space-s)}.badge{display:grid;width:2.8rem;height:2.8rem;place-items:center;border-radius:50%;background:var(--ink);color:var(--paper);font-weight:750}.insert .badge{background:var(--accent)}.full .badge{background:var(--danger)}.method header p{margin:0 0 .15rem;color:var(--ink-faint);font-size:var(--step--2);font-weight:750;letter-spacing:var(--tracking-label)}.method h3{margin:0;font-size:var(--step-1);line-height:1.12}
.drawing{position:relative;min-height:27rem;overflow:hidden;border:1px solid var(--line);border-radius:var(--radius);background:linear-gradient(90deg,color-mix(in srgb,var(--ink) 8%,transparent),var(--paper-sunk) 17%,var(--paper-raised) 50%,var(--paper-sunk) 83%,color-mix(in srgb,var(--ink) 8%,transparent))}.material{position:absolute;top:3.8rem;bottom:2rem;border-top:3px solid var(--line-strong)}.siding{left:3%;width:18%;background:repeating-linear-gradient(0deg,color-mix(in srgb,var(--ink) 11%,transparent) 0 9px,transparent 9px 17px)}.sheathing{left:21%;width:3%;background:color-mix(in srgb,var(--ink) 8%,transparent)}.cavity{right:21%;width:3%;background:color-mix(in srgb,var(--ink) 5%,transparent)}.drywall{right:3%;width:18%;background:repeating-linear-gradient(0deg,color-mix(in srgb,var(--ink) 7%,transparent) 0 12px,transparent 12px 21px)}.rough-opening{position:absolute;left:24%;right:24%;top:5.6rem;bottom:2rem;border:3px solid var(--ink);background:var(--paper-raised)}.existing-frame{position:absolute;top:6.5rem;bottom:3.1rem;width:2.1rem;background:color-mix(in srgb,var(--accent) 24%,var(--paper-raised));border:4px solid var(--accent);z-index:2}.existing-frame.left{left:26%}.existing-frame.right{right:26%}.existing-sill{position:absolute;left:26%;right:26%;bottom:3.1rem;height:2rem;background:color-mix(in srgb,var(--accent) 24%,var(--paper-raised));border:4px solid var(--accent);z-index:2}.new-unit{position:absolute;left:29%;right:29%;top:7.7rem;bottom:5rem;border:4px solid var(--ink);background:var(--paper-raised);z-index:3;box-shadow:0 0 0 4px color-mix(in srgb,var(--paper) 60%,transparent)}.new-unit.full-unit{left:27%;right:27%;top:7rem;bottom:4.5rem}.new-glass{position:absolute;inset:1.7rem;background:color-mix(in srgb,var(--accent-2) 10%,transparent);border:2px solid var(--accent-ink)}.new-sash{position:absolute;inset:1rem;border:2px solid var(--ink-soft)}.new-unit::before,.new-unit::after{content:'';position:absolute;top:50%;left:1rem;right:1rem;height:2px;background:var(--ink-soft);opacity:.7}.new-unit::after{left:50%;top:1rem;bottom:1rem;width:2px;height:auto;right:auto}.nailing-fin{position:absolute;left:-.65rem;right:-.65rem;top:-.65rem;border-top:1rem solid var(--accent);z-index:-1}.stop{position:absolute;left:29%;right:29%;height:.65rem;background:var(--ink);z-index:4}.stop.top{top:7.1rem}.stop.bottom{bottom:4.3rem}.old-frame-ghost{position:absolute;left:12%;top:8rem;width:9rem;height:12rem;z-index:1;transform:rotate(-10deg);opacity:.8}.old-frame-ghost span{position:absolute;background:color-mix(in srgb,var(--danger) 14%,transparent);border:3px dashed var(--danger)}.old-frame-ghost span:nth-child(1){left:0;top:0;bottom:0;width:1.3rem}.old-frame-ghost span:nth-child(2){right:0;top:0;bottom:0;width:1.3rem}.old-frame-ghost span:nth-child(3){left:0;right:0;top:0;height:1.3rem}.old-frame-ghost::after{content:'OLD FRAME';position:absolute;left:0;right:0;bottom:-1.8rem;text-align:center;color:var(--danger);font-size:10px;font-weight:750;letter-spacing:.1em}.flash{position:absolute;background:var(--accent);z-index:4}.flash.top{left:24%;right:24%;top:5.25rem;height:.7rem}.flash.left{left:23.6%;top:5.25rem;bottom:2rem;width:.7rem}.flash.right{right:23.6%;top:5.25rem;bottom:2rem;width:.7rem}.flash.bottom{left:24%;right:24%;bottom:1.7rem;height:.7rem}.dimension{position:absolute;display:flex;align-items:center;gap:.45rem;z-index:5;font-size:9px;font-weight:750;letter-spacing:.09em;color:var(--ink-faint)}.dimension i{display:block;width:4rem;height:1px;background:var(--line-strong)}.old-depth{left:27%;top:4.3rem}.new-depth{right:28%;bottom:3.1rem}.rough-depth{left:31%;top:4.3rem}.callout{position:absolute;z-index:6;display:grid;gap:.2rem;padding:.5rem .65rem;border:1px solid var(--line);border-left:3px solid var(--ink);background:color-mix(in srgb,var(--paper-raised) 96%,transparent);box-shadow:var(--shadow-soft);font-size:var(--step--2);line-height:1.2;max-width:10rem}.callout b{font-size:10px;letter-spacing:.1em}.callout span{color:var(--ink-soft)}.keep{left:4%;top:10rem;border-left-color:var(--accent)}.keep b{color:var(--accent-ink)}.fit{right:4%;bottom:6.2rem}.remove{left:4%;top:10rem;border-left-color:var(--danger)}.remove b{color:var(--danger)}.rebuild{right:4%;bottom:5.4rem;border-left-color:var(--accent)}.rebuild b{color:var(--accent-ink)}.facts{display:grid;grid-template-columns:1fr 1fr;margin-top:var(--space-s);border-top:1px solid var(--line)}.facts div{display:grid;gap:.2rem;padding:var(--space-s)}.facts div+div{border-left:1px solid var(--line)}.facts strong{font-size:var(--step--2);text-transform:uppercase;letter-spacing:var(--tracking-label);color:var(--ink-faint)}.facts span{font-size:var(--step--1);color:var(--ink-soft)}.decision{display:grid;grid-template-columns:auto 1fr;gap:var(--space-s);align-items:baseline;margin-top:var(--space-l);padding:var(--space-s) var(--space-m);border-left:3px solid var(--ink);border-top:1px solid var(--line);border-bottom:1px solid var(--line);background:var(--paper-raised);font-size:var(--step--1)}.decision span{color:var(--ink-soft)}
@media(max-width:900px){.method-cards{grid-template-columns:1fr}}@media(max-width:620px){.drawing{min-height:22rem}.material.siding,.material.drywall{width:14%}.rough-opening{left:18%;right:18%}.existing-frame.left{left:20%}.existing-frame.right{right:20%}.existing-sill{left:20%;right:20%}.new-unit{left:25%;right:25%}.new-unit.full-unit{left:21%;right:21%}.flash.top,.flash.bottom{left:18%;right:18%}.flash.left{left:17.6%}.flash.right{right:17.6%}.callout{position:relative;left:auto!important;right:auto!important;top:auto!important;bottom:auto!important;margin:.45rem;max-width:none}.keep,.remove{margin-top:10rem}.fit,.rebuild{margin-top:.2rem}.dimension{display:none}.facts{grid-template-columns:1fr}.facts div+div{border-left:0;border-top:1px solid var(--line)}.decision{grid-template-columns:1fr;gap:.2rem}}
</style>
