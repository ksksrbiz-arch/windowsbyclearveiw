---
interface Props { heading?: string | null; }
const { heading = 'Insert or full-frame? Follow the existing frame.' } = Astro.props;
---
<figure class="method-explainer">
  {heading && <figcaption class="heading">{heading}</figcaption>}
  <p class="intro">Both methods install a new window. The difference is <strong>what happens to the existing frame and opening</strong>.</p>

  <div class="method-cards">
    <article class="method insert">
      <header><span class="badge">01</span><div><p>INSERT / POCKET</p><h3>Keep the existing frame</h3></div></header>
      <div class="drawing" role="img" aria-label="Wall cross section showing an existing window frame remaining in place while a new window is installed inside it.">
        <div class="layer siding"></div><div class="layer wall"></div><div class="opening">
          <div class="old-frame left"></div><div class="old-frame right"></div><div class="new-unit"><div class="glass-line"></div></div>
        </div>
        <div class="label keep-label"><strong>KEEP</strong><span>existing frame</span></div>
        <div class="label new-label"><strong>NEW</strong><span>window fits inside</span></div>
      </div>
      <div class="facts"><div><strong>What stays</strong><span>Existing frame and most surrounding finish.</span></div><div><strong>What changes</strong><span>The window unit installed inside that frame.</span></div></div>
    </article>

    <article class="method full">
      <header><span class="badge">02</span><div><p>FULL-FRAME</p><h3>Remove the old frame to the opening</h3></div></header>
      <div class="drawing" role="img" aria-label="Wall cross section showing the old window frame removed, the rough opening exposed and a new full-frame window installed into the opening with new perimeter flashing.">
        <div class="layer siding"></div><div class="layer wall"></div><div class="opening rough">
          <div class="flash top"></div><div class="flash left"></div><div class="flash right"></div><div class="flash bottom"></div>
          <div class="new-unit"><div class="glass-line"></div></div>
        </div>
        <div class="label remove-label"><strong>REMOVE</strong><span>old frame</span></div>
        <div class="label opening-label"><strong>OPEN</strong><span>rough opening</span></div>
        <div class="label flash-label"><strong>FLASH</strong><span>new perimeter</span></div>
      </div>
      <div class="facts"><div><strong>What stays</strong><span>The rough opening and structural wall assembly.</span></div><div><strong>What changes</strong><span>Old frame comes out; the opening is prepared for the new unit.</span></div></div>
    </article>
  </div>

  <div class="decision"><strong>The choice is made from the opening condition.</strong><span>Sound frame → insert may fit. Damaged frame or reconstruction → full-frame may be appropriate.</span></div>
</figure>

<style>
.method-explainer{margin:0}.heading{display:block;margin:0 0 .35rem;font-size:var(--step-2);font-weight:650;letter-spacing:var(--tracking-display)}.intro{margin:0 0 var(--space-l);max-width:70ch;color:var(--ink-soft);font-size:var(--step--1)}.method-cards{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:var(--space-l)}.method{padding:var(--space-m);border:1px solid var(--line);border-top:4px solid var(--ink);border-radius:var(--radius-lg);background:var(--paper-raised)}.insert{border-top-color:var(--accent)}.full{border-top-color:var(--danger)}.method header{display:grid;grid-template-columns:3rem 1fr;gap:var(--space-s);align-items:center;margin-bottom:var(--space-s)}.badge{display:grid;width:2.8rem;height:2.8rem;place-items:center;border-radius:50%;background:var(--ink);color:var(--paper);font-weight:750}.insert .badge{background:var(--accent)}.full .badge{background:var(--danger)}.method header p{margin:0 0 .15rem;font-size:var(--step--2);font-weight:700;letter-spacing:var(--tracking-label);color:var(--ink-faint)}.method h3{margin:0;font-size:var(--step-1);line-height:1.12}.drawing{position:relative;min-height:22rem;overflow:hidden;border:1px solid var(--line);border-radius:var(--radius);background:linear-gradient(90deg,var(--paper-sunk) 0,var(--paper-raised) 17%,var(--paper-raised) 83%,var(--paper-sunk) 100%)}.layer{position:absolute;left:7%;right:7%;height:2.8rem;border:1px solid var(--line)}.siding{top:1.5rem;background:color-mix(in srgb,var(--ink) 14%,transparent)}.wall{top:4.3rem;height:15.2rem;background:color-mix(in srgb,var(--ink) 5%,transparent)}.opening{position:absolute;left:23%;right:23%;top:5.8rem;height:12.8rem;border:3px solid var(--ink);background:var(--paper-raised)}.old-frame{position:absolute;top:1rem;bottom:1rem;width:1.8rem;background:color-mix(in srgb,var(--accent) 23%,transparent);border:3px solid var(--accent)}.old-frame.left{left:-.15rem}.old-frame.right{right:-.15rem}.new-unit{position:absolute;top:1.9rem;bottom:1.9rem;left:2rem;right:2rem;border:3px solid var(--ink);background:color-mix(in srgb,var(--paper-raised) 85%,transparent)}.glass-line{position:absolute;inset:1.5rem;border:1px solid var(--accent-ink);background:color-mix(in srgb,var(--accent-2) 10%,transparent)}.rough{border-color:var(--danger);background:color-mix(in srgb,var(--danger) 3%,var(--paper-raised))}.rough .new-unit{left:1.6rem;right:1.6rem}.flash{position:absolute;background:var(--accent);z-index:2}.flash.top{left:-.2rem;right:-.2rem;top:-.2rem;height:.7rem}.flash.left{left:-.2rem;top:-.2rem;bottom:-.2rem;width:.7rem}.flash.right{right:-.2rem;top:-.2rem;bottom:-.2rem;width:.7rem}.flash.bottom{left:-.2rem;right:-.2rem;bottom:-.2rem;height:.7rem}.label{position:absolute;display:grid;gap:.15rem;padding:.55rem .65rem;border:1px solid var(--line);background:color-mix(in srgb,var(--paper-raised) 94%,transparent);box-shadow:var(--shadow-soft);font-size:var(--step--2);line-height:1.15}.label strong{font-size:11px;letter-spacing:.1em}.label span{color:var(--ink-soft)}.keep-label{left:7%;top:9rem;border-left:3px solid var(--accent)}.new-label{right:7%;bottom:2.3rem;border-left:3px solid var(--ink)}.remove-label{left:7%;top:7rem;border-left:3px solid var(--danger)}.opening-label{left:7%;bottom:2.3rem;border-left:3px solid var(--danger)}.flash-label{right:7%;top:9rem;border-left:3px solid var(--accent)}.facts{display:grid;grid-template-columns:1fr 1fr;margin-top:var(--space-s);border-top:1px solid var(--line)}.facts div{display:grid;gap:.2rem;padding:var(--space-s)}.facts div+div{border-left:1px solid var(--line)}.facts strong{font-size:var(--step--2);text-transform:uppercase;letter-spacing:var(--tracking-label);color:var(--ink-faint)}.facts span{font-size:var(--step--1);color:var(--ink-soft)}.decision{display:grid;grid-template-columns:auto 1fr;gap:var(--space-s);align-items:baseline;margin-top:var(--space-l);padding:var(--space-s) var(--space-m);border-left:3px solid var(--ink);border-top:1px solid var(--line);border-bottom:1px solid var(--line);background:var(--paper-raised);font-size:var(--step--1)}.decision span{color:var(--ink-soft)}
@media(max-width:900px){.method-cards{grid-template-columns:1fr}}@media(max-width:620px){.drawing{min-height:18rem}.opening{left:18%;right:18%}.facts{grid-template-columns:1fr}.facts div+div{border-left:0;border-top:1px solid var(--line)}.decision{grid-template-columns:1fr;gap:.2rem}}
</style>
