---
interface Props { heading?: string | null; }
const { heading = 'Window anatomy' } = Astro.props;
---
<figure class="anatomy-guide">
  {heading && <figcaption class="heading">{heading}</figcaption>}
  <p class="intro">The main pieces that make up a modern replacement window.</p>

  <div class="desktop-anatomy" role="img" aria-label="Labeled modern replacement window showing frame, sash, insulated glass, weather seal, lock hardware and spacer.">
    <svg viewBox="0 0 1200 720" aria-hidden="true" focusable="false">
      <defs>
        <linearGradient id="cv-a-glass" x1="0" y1="0" x2="1" y2="1">
          <stop offset="0" stop-color="#f8ffff"/><stop offset=".55" stop-color="#dcefe9"/><stop offset="1" stop-color="#b9d9cf"/>
        </linearGradient>
        <linearGradient id="cv-a-frame" x1="0" y1="0" x2="1" y2="1">
          <stop offset="0" stop-color="#24443a"/><stop offset="1" stop-color="#526b60"/>
        </linearGradient>
        <filter id="cv-a-shadow"><feDropShadow dx="0" dy="18" stdDeviation="18" flood-color="#173027" flood-opacity=".12"/></filter>
      </defs>
      <rect width="1200" height="720" rx="28" fill="#f7f8f5"/>
      <rect x="325" y="70" width="520" height="565" rx="14" fill="#fff" filter="url(#cv-a-shadow)"/>
      <rect x="352" y="98" width="466" height="508" rx="9" fill="url(#cv-a-frame)"/>
      <rect x="386" y="132" width="398" height="440" rx="4" fill="#d8e5df"/>
      <rect x="402" y="148" width="366" height="408" rx="3" fill="#355247"/>
      <rect x="419" y="165" width="332" height="374" rx="2" fill="url(#cv-a-glass)"/>
      <rect x="410" y="344" width="350" height="18" rx="4" fill="#355247"/>
      <rect x="576" y="165" width="18" height="374" rx="4" fill="#355247"/>
      <rect x="401" y="153" width="368" height="8" rx="4" fill="#0d624d"/>
      <rect x="401" y="543" width="368" height="8" rx="4" fill="#0d624d"/>
      <rect x="410" y="160" width="8" height="385" rx="4" fill="#0d624d"/>
      <rect x="752" y="160" width="8" height="385" rx="4" fill="#0d624d"/>
      <rect x="566" y="333" width="38" height="48" rx="9" fill="#d7dfda"/>
      <rect x="576" y="340" width="18" height="30" rx="7" fill="#6f7b75"/>
      <path d="M440 190 L530 190 L470 258 L434 258Z" fill="#fff" opacity=".44"/>
      <path d="M325 185 H176 L140 150" stroke="#2d7d63" stroke-width="3" fill="none" stroke-linecap="round"/>
      <path d="M402 270 H176 L140 302" stroke="#2d7d63" stroke-width="3" fill="none" stroke-linecap="round"/>
      <path d="M752 230 H1000 L1044 192" stroke="#2d7d63" stroke-width="3" fill="none" stroke-linecap="round"/>
      <path d="M760 160 H1000 L1044 104" stroke="#2d7d63" stroke-width="3" fill="none" stroke-linecap="round"/>
      <path d="M760 540 H1000 L1044 505" stroke="#2d7d63" stroke-width="3" fill="none" stroke-linecap="round"/>
      <path d="M604 358 H980 L1044 390" stroke="#2d7d63" stroke-width="3" fill="none" stroke-linecap="round"/>
      <g fill="#2d7d63">
        <circle cx="325" cy="185" r="6"/><circle cx="402" cy="270" r="6"/><circle cx="752" cy="230" r="6"/><circle cx="760" cy="160" r="6"/><circle cx="760" cy="540" r="6"/><circle cx="604" cy="358" r="6"/>
      </g>
      <g font-family="Inter,Arial,sans-serif" fill="#233e33">
        <text x="140" y="125" font-size="17" font-weight="750">FRAME</text>
        <text x="140" y="288" font-size="17" font-weight="750">SASH</text>
        <text x="1044" y="175" text-anchor="end" font-size="17" font-weight="750">WEATHER SEAL</text>
        <text x="1044" y="88" text-anchor="end" font-size="17" font-weight="750">INSULATED GLASS</text>
        <text x="1044" y="492" text-anchor="end" font-size="17" font-weight="750">SPACER</text>
        <text x="1044" y="377" text-anchor="end" font-size="17" font-weight="750">LOCK / HARDWARE</text>
      </g>
    </svg>
  </div>

  <div class="mobile-anatomy">
    <div class="window-card" aria-hidden="true">
      <div class="outer-frame">
        <div class="sash">
          <div class="glass"></div>
          <div class="meeting-rail"></div>
          <div class="lock"></div>
          <div class="seal top"></div>
          <div class="seal bottom"></div>
          <div class="seal left"></div>
          <div class="seal right"></div>
        </div>
      </div>
    </div>
    <div class="parts">
      <article><span>01</span><div><strong>Frame</strong><p>Structural outer boundary.</p></div></article>
      <article><span>02</span><div><strong>Sash</strong><p>Moving section that carries the glass.</p></div></article>
      <article><span>03</span><div><strong>Insulated glass</strong><p>The sealed glass package.</p></div></article>
      <article><span>04</span><div><strong>Weather seal</strong><p>Helps close the moving joint.</p></div></article>
      <article><span>05</span><div><strong>Spacer</strong><p>Separates the glass panes around the edge.</p></div></article>
      <article><span>06</span><div><strong>Lock / hardware</strong><p>Closes and secures the sash.</p></div></article>
    </div>
  </div>
</figure>

<style>
  .anatomy-guide{margin:0}
  .heading{display:block;margin:0 0 .35rem;font-size:var(--step-2);font-weight:650;letter-spacing:var(--tracking-display);line-height:var(--leading-display)}
  .intro{margin:0 0 var(--space-l);max-width:72ch;color:var(--ink-soft);font-size:var(--step--1)}
  .desktop-anatomy{border:1px solid var(--line);background:#f7f8f5;border-radius:var(--radius-lg);overflow:hidden;box-shadow:var(--shadow-soft)}
  .desktop-anatomy svg{display:block;width:100%;height:auto}
  .mobile-anatomy{display:none}
  @media(max-width:760px){
    .desktop-anatomy{display:none}
    .mobile-anatomy{display:block}
    .window-card{border:1px solid var(--line);border-radius:var(--radius-lg);padding:1.5rem;background:linear-gradient(180deg,#eef4f0,#f8faf8);display:grid;place-items:center}
    .outer-frame{width:min(78vw,310px);aspect-ratio:1/1.12;padding:18px;border-radius:14px;background:linear-gradient(135deg,#24443a,#526b60);box-shadow:0 16px 30px rgba(23,48,39,.12)}
    .sash{position:relative;width:100%;height:100%;padding:13px;border-radius:8px;background:#355247}
    .glass{position:absolute;inset:13px;background:linear-gradient(135deg,#f8ffff,#c2dfd6);border-radius:3px}
    .glass::after{content:'';position:absolute;left:12%;top:10%;width:36%;height:22%;background:#fff;opacity:.36;clip-path:polygon(0 0,100% 0,62% 100%,0 100%)}
    .meeting-rail{position:absolute;left:13px;right:13px;top:50%;height:13px;transform:translateY(-50%);background:#355247;border-radius:3px;z-index:2}
    .lock{position:absolute;left:50%;top:50%;width:28px;height:32px;transform:translate(-50%,-50%);border-radius:7px;background:#d6ded9;z-index:3}
    .seal{position:absolute;background:#0d624d;z-index:3;border-radius:5px}
    .seal.top,.seal.bottom{left:10px;right:10px;height:6px}.seal.top{top:8px}.seal.bottom{bottom:8px}
    .seal.left,.seal.right{top:10px;bottom:10px;width:6px}.seal.left{left:8px}.seal.right{right:8px}
    .parts{display:grid;grid-template-columns:1fr 1fr;gap:var(--space-xs);margin-top:var(--space-s)}
    .parts article{display:grid;grid-template-columns:26px 1fr;gap:.45rem;padding:.72rem;border:1px solid var(--line);border-radius:12px;background:var(--paper-raised)}
    .parts article>span{font-size:10px;font-weight:800;color:var(--accent-ink)}
    .parts strong{font-size:var(--step--1);line-height:1.15}.parts p{margin:.2rem 0 0;font-size:11px;line-height:1.35;color:var(--ink-soft)}
  }
  @media(max-width:420px){.parts{grid-template-columns:1fr}}
</style>
