---
interface Props { heading?: string | null; }
const { heading = 'Window anatomy' } = Astro.props;
---
<figure class="anatomy">
  {heading && <figcaption class="heading">{heading}</figcaption>}
  <p class="intro">The parts that make up a modern replacement window.</p>

  <div class="canvas" role="img" aria-label="Labeled diagram of a modern replacement window showing the frame, sash, insulated glass, spacer, weather seal, and lock hardware.">
    <svg viewBox="0 0 1200 720" aria-hidden="true" focusable="false">
      <defs>
        <linearGradient id="glassA" x1="0" y1="0" x2="1" y2="1">
          <stop offset="0" stop-color="#f7fbfa"/>
          <stop offset="0.48" stop-color="#dcefe9"/>
          <stop offset="1" stop-color="#b8d8ce"/>
        </linearGradient>
        <linearGradient id="frameA" x1="0" y1="0" x2="1" y2="1">
          <stop offset="0" stop-color="#20382f"/>
          <stop offset="1" stop-color="#476357"/>
        </linearGradient>
        <filter id="softShadow" x="-30%" y="-30%" width="160%" height="160%">
          <feDropShadow dx="0" dy="18" stdDeviation="18" flood-color="#173027" flood-opacity=".14"/>
        </filter>
      </defs>

      <rect width="1200" height="720" fill="#f7f8f5" rx="26"/>
      <rect x="280" y="72" width="610" height="585" rx="12" fill="#fff" filter="url(#softShadow)"/>

      <!-- frame -->
      <rect x="312" y="104" width="546" height="521" rx="7" fill="url(#frameA)"/>
      <rect x="350" y="142" width="470" height="445" rx="3" fill="#d8e5df"/>
      <!-- sash -->
      <rect x="367" y="159" width="436" height="411" rx="2" fill="#355247"/>
      <rect x="386" y="178" width="398" height="373" rx="1" fill="url(#glassA)"/>

      <!-- central meeting rail / visual division -->
      <rect x="378" y="360" width="414" height="22" rx="3" fill="#355247"/>
      <rect x="576" y="178" width="18" height="373" rx="4" fill="#355247"/>

      <!-- glass highlights -->
      <path d="M408 210 L520 210 L430 310 L400 310 Z" fill="#fff" opacity=".45"/>
      <path d="M625 205 L750 205 L678 280 L622 280 Z" fill="#fff" opacity=".26"/>

      <!-- weather seals -->
      <rect x="371" y="168" width="428" height="8" rx="4" fill="#0c5d49"/>
      <rect x="371" y="543" width="428" height="8" rx="4" fill="#0c5d49"/>
      <rect x="378" y="170" width="8" height="382" rx="4" fill="#0c5d49"/>
      <rect x="791" y="170" width="8" height="382" rx="4" fill="#0c5d49"/>

      <!-- lock -->
      <rect x="565" y="346" width="40" height="48" rx="10" fill="#d7dfda"/>
      <rect x="575" y="353" width="20" height="27" rx="7" fill="#6d7a75"/>
      <circle cx="585" cy="392" r="3.5" fill="#24362f"/>

      <!-- spacer detail inset -->
      <g transform="translate(842 570)">
        <rect width="100" height="52" rx="10" fill="#eef4f0" stroke="#bdd0c7"/>
        <rect x="12" y="14" width="76" height="24" rx="4" fill="#d8d1c1"/>
        <rect x="20" y="20" width="60" height="12" rx="3" fill="#f8f2e6"/>
        <text x="50" y="46" text-anchor="middle" font-size="11" font-family="Inter,Arial,sans-serif" fill="#4e6159">spacer detail</text>
      </g>

      <!-- callout lines -->
      <g stroke="#2d7d63" stroke-width="3" fill="none" stroke-linecap="round" stroke-linejoin="round">
        <path d="M312 175 H190 L155 143"/>
        <path d="M367 260 H190 L155 290"/>
        <path d="M784 240 H1015 L1042 207"/>
        <path d="M793 170 H1015 L1042 116"/>
        <path d="M799 552 H1015 L1042 535"/>
        <path d="M605 371 H980 L1042 395"/>
      </g>

      <!-- callout nodes -->
      <g fill="#2d7d63">
        <circle cx="312" cy="175" r="6"/><circle cx="367" cy="260" r="6"/>
        <circle cx="784" cy="240" r="6"/><circle cx="793" cy="170" r="6"/>
        <circle cx="799" cy="552" r="6"/><circle cx="605" cy="371" r="6"/>
      </g>
    </svg>

    <div class="labels left">
      <div class="label" style="top:9%">
        <span class="eyebrow">01</span>
        <strong>Frame</strong>
        <span>The structural outer boundary of the window.</span>
      </div>
      <div class="label" style="top:35%">
        <span class="eyebrow">02</span>
        <strong>Sash</strong>
        <span>The moving section that carries the glass.</span>
      </div>
    </div>

    <div class="labels right">
      <div class="label" style="top:5%">
        <span class="eyebrow">04</span>
        <strong>Weather seal</strong>
        <span>Sealing surfaces around the moving unit.</span>
      </div>
      <div class="label" style="top:19%">
        <span class="eyebrow">03</span>
        <strong>Insulated glass</strong>
        <span>Two or more panes separated by an insulated space.</span>
      </div>
      <div class="label" style="top:49%">
        <span class="eyebrow">06</span>
        <strong>Lock / hardware</strong>
        <span>Controls the window and helps pull it tight when closed.</span>
      </div>
      <div class="label" style="top:76%">
        <span class="eyebrow">05</span>
        <strong>Spacer</strong>
        <span>Runs around the glass edge and separates the panes.</span>
      </div>
    </div>
  </div>

  <div class="key"><span>See the parts first.</span><span>Then compare how the pieces change from an older window to a modern replacement.</span></div>
</figure>

<style>
  .anatomy{margin:0}
  .heading{display:block;margin:0 0 .35rem;font-size:var(--step-2);font-weight:650;letter-spacing:var(--tracking-display);line-height:var(--leading-display)}
  .intro{margin:0 0 var(--space-l);max-width:74ch;color:var(--ink-soft);font-size:var(--step--1)}
  .canvas{position:relative;border:1px solid var(--line);background:#f7f8f5;border-radius:var(--radius-lg);overflow:hidden;box-shadow:var(--shadow-soft)}
  .canvas svg{display:block;width:100%;height:auto}
  .labels{position:absolute;inset:0;pointer-events:none}
  .labels.left{left:1.5%;right:auto;width:21%}
  .labels.right{left:auto;right:1.5%;width:24%}
  .label{position:absolute;display:grid;gap:.16rem;padding:.72rem .8rem;border:1px solid color-mix(in srgb,var(--accent) 20%,var(--line));border-left:3px solid var(--accent);background:color-mix(in srgb,#fff 94%,transparent);border-radius:10px;box-shadow:0 10px 24px rgba(24,48,39,.06)}
  .label strong{font-size:var(--step-0);line-height:1.08}
  .label span:last-child{font-size:var(--step--2);line-height:1.35;color:var(--ink-soft)}
  .eyebrow{font-size:10px;font-weight:700;letter-spacing:.1em;color:var(--accent-ink)}
  .key{display:grid;grid-template-columns:auto 1fr;gap:var(--space-s);margin-top:var(--space-s);padding:.75rem .9rem;border-left:3px solid var(--accent);background:var(--paper-sunk);font-size:var(--step--1);color:var(--ink-soft)}
  .key span:first-child{font-weight:650;color:var(--ink)}
  @media(max-width:980px){
    .label{padding:.55rem .6rem}
    .label strong{font-size:var(--step--1)}
  }
  @media(max-width:760px){
    .canvas{padding-bottom:0}
    .labels{position:static;width:auto!important;display:grid;grid-template-columns:1fr 1fr;gap:var(--space-xs);padding:var(--space-s)}
    .labels.left,.labels.right{display:contents}
    .label{position:static;box-shadow:none}
    .labels.left .label:nth-child(1){grid-column:1}
    .labels.left .label:nth-child(2){grid-column:2}
    .labels.right .label:nth-child(1){grid-column:1}
    .labels.right .label:nth-child(2){grid-column:2}
    .labels.right .label:nth-child(3){grid-column:1}
    .labels.right .label:nth-child(4){grid-column:2}
    .key{grid-template-columns:1fr}
  }
</style>
