---
/**
 * Vinyl vs fiberglass, drawn as a jamb cross-section rather than a swatch of
 * two colors. The real difference between the materials is wall thickness
 * and how much a frame flexes over a wide span — neither of which a photo of
 * a finished window can show, and both of which are the actual reason one
 * costs more than the other.
 */
interface Props {
  heading?: string | null;
}
const { heading = 'Vinyl and fiberglass, in section' } = Astro.props;
---
<figure class="mat-detail">
  {heading && <figcaption class="mat-heading">{heading}</figcaption>}

  <div class="mat-pair">
    <div class="mat-panel">
      <p class="mat-title">Vinyl</p>
      <p class="mat-sub">Multi-chamber, welded corners</p>

      <svg
        class="mat-svg"
        viewBox="0 0 240 160"
        role="img"
        aria-label="Cross-section of a vinyl window frame: a multi-chambered hollow profile with welded corners, sized for standard openings."
      >
        <rect x="16" y="20" width="60" height="120" class="m-frame-vinyl" rx="3" />
        <line x1="34" y1="30" x2="34" y2="130" class="m-chamber" />
        <line x1="52" y1="30" x2="52" y2="130" class="m-chamber" />
        <line x1="64" y1="30" x2="64" y2="130" class="m-chamber" />

        <rect x="90" y="30" width="16" height="100" class="m-glass-edge" />
        <rect x="106" y="30" width="60" height="100" class="m-glass" />

        <text x="46" y="150" class="m-label">Frame</text>
        <text x="136" y="150" class="m-label">Glass</text>
      </svg>

      <ul class="mat-notes">
        <li><span class="swatch s-vinyl"></span>Hollow chambers trap air, add rigidity</li>
        <li>Lowest cost per opening; the Washington default</li>
        <li>Best on standard-size openings, most colors baked in</li>
      </ul>
    </div>

    <div class="mat-panel">
      <p class="mat-title">Fiberglass</p>
      <p class="mat-sub">Solid pultruded profile</p>

      <svg
        class="mat-svg"
        viewBox="0 0 240 160"
        role="img"
        aria-label="Cross-section of a fiberglass window frame: a thinner, denser pultruded profile with reinforcing ribs, sized for wide or large openings that would flex a vinyl frame."
      >
        <rect x="26" y="20" width="40" height="120" class="m-frame-glass" rx="2" />
        <line x1="38" y1="30" x2="38" y2="130" class="m-rib" />
        <line x1="52" y1="30" x2="52" y2="130" class="m-rib" />

        <rect x="90" y="30" width="16" height="100" class="m-glass-edge" />
        <rect x="106" y="30" width="60" height="100" class="m-glass" />

        <text x="46" y="150" class="m-label">Frame</text>
        <text x="136" y="150" class="m-label">Glass</text>
      </svg>

      <ul class="mat-notes">
        <li><span class="swatch s-glass"></span>Denser material, thinner sightline</li>
        <li>Holds shape over wide sliders and large pictures</li>
        <li>Costs more; paintable rather than color-molded</li>
      </ul>
    </div>
  </div>

  <p class="mat-foot">
    Both hold up in Washington weather. The choice is mostly about span: a wide slider or a tall
    picture window can flex a standard vinyl frame over time, where fiberglass holds its shape.
    On a typical bedroom or bath opening, vinyl is the workhorse for a reason.
  </p>
</figure>

<style>
  .mat-detail {
    margin: 0;
  }

  .mat-heading {
    display: block;
    margin: 0 0 var(--space-m);
    font-size: var(--step-2);
    font-weight: 600;
    letter-spacing: var(--tracking-display);
    line-height: var(--leading-display);
  }

  .mat-pair {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-m);
  }

  .mat-panel {
    padding: var(--space-m);
    background: var(--paper-raised);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
  }

  .mat-title {
    margin: 0 0 var(--space-3xs);
    font-size: var(--step-1);
    font-weight: 600;
    letter-spacing: -0.015em;
  }

  .mat-sub {
    margin: 0 0 var(--space-s);
    font-size: var(--step--1);
    color: var(--ink-soft);
  }

  .mat-svg {
    display: block;
    width: 100%;
    height: auto;
    background: var(--paper-sunk);
    border-radius: var(--radius);
  }

  .m-frame-vinyl {
    fill: color-mix(in srgb, var(--accent) 22%, transparent);
    stroke: var(--ink);
    stroke-width: 2;
  }

  .m-frame-glass {
    fill: color-mix(in srgb, var(--ink) 24%, transparent);
    stroke: var(--ink);
    stroke-width: 2;
  }

  .m-chamber,
  .m-rib {
    stroke: var(--ink-faint);
    stroke-width: 1.3;
  }

  .m-glass-edge {
    fill: color-mix(in srgb, var(--ink) 14%, transparent);
  }

  .m-glass {
    fill: color-mix(in srgb, var(--accent) 8%, transparent);
    stroke: var(--ink-soft);
    stroke-width: 1.3;
  }

  .m-label {
    fill: var(--ink-faint);
    font-family: Outfit, 'Outfit Fallback', system-ui, sans-serif;
    font-size: 8.5px;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-anchor: middle;
    text-transform: uppercase;
  }

  .mat-notes {
    margin: var(--space-s) 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: var(--space-3xs);
    font-size: var(--step--1);
    color: var(--ink-soft);
  }

  .mat-notes li {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
  }

  .swatch {
    width: 0.7rem;
    height: 0.7rem;
    border-radius: 2px;
    flex: none;
    translate: 0 0.1rem;
  }

  .s-vinyl {
    background: color-mix(in srgb, var(--accent) 22%, transparent);
    border: 1.5px solid var(--ink);
  }

  .s-glass {
    background: color-mix(in srgb, var(--ink) 24%, transparent);
    border: 1.5px solid var(--ink);
  }

  .mat-foot {
    margin: var(--space-m) 0 0;
    max-width: var(--measure);
    font-size: var(--step--1);
    color: var(--ink-soft);
  }

  @media (max-width: 800px) {
    .mat-pair {
      grid-template-columns: 1fr;
    }
  }
</style>
