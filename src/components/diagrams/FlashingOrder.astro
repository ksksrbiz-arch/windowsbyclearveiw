---
interface Props { heading?: string | null; }
const { heading = 'Flashing is easier to understand as a sequence.' } = Astro.props;
const steps = [
  ['01','PREP THE OPENING','Expose and prepare the sill before the window goes in.'],
  ['02','BUILD THE SILL','Give incidental water a controlled path back outside.'],
  ['03','TIE IN THE SIDES','Jamb flashing overlaps the sill treatment so water keeps moving down.'],
  ['04','FINISH THE HEAD','The top treatment sheds over the sides; the water path never turns inward.'],
];
---
<figure class="flashing-explainer">
  {heading && <figcaption class="heading">{heading}</figcaption>}
  <p class="intro">Think of the installation as a <strong>drainage assembly</strong>. Each layer has to hand water to the layer below it and ultimately to the exterior.</p>
  <div class="steps">
    {steps.map(([n,title,desc], i) => (
      <article class="step">
        <div class="step-head"><span>{n}</span><div><p>STEP {n}</p><h3>{title}</h3></div></div>
        <div class={`section section-${i + 1}`} aria-label={title} role="img">
          <div class="exterior">EXTERIOR</div><div class="room">ROOM</div>
          <div class="wall-left"></div><div class="wall-right"></div><div class="opening"></div>
          {i === 0 && <><div class="rough-opening"></div><div class="tool-line"></div></>}
          {i >= 1 && <div class="sill-pan"></div>}
          {i >= 2 && <><div class="sill-pan"></div><div class="jamb left"></div><div class="jamb right"></div></>}
          {i === 3 && <div class="head"></div>}
          {i >= 1 && <div class="window"></div>}
          {i >= 1 && <div class="water"></div>}
        </div>
        <p class="desc">{desc}</p>
      </article>
    ))}
  </div>
  <div class="rule"><strong>Read the water path.</strong><span>Down the sides → onto the sill → out to the exterior.</span></div>
</figure>

<style>
.flashing-explainer{margin:0}.heading{display:block;margin:0 0 .35rem;font-size:var(--step-2);font-weight:650;letter-spacing:var(--tracking-display)}.intro{margin:0 0 var(--space-l);max-width:72ch;color:var(--ink-soft);font-size:var(--step--1)}.steps{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:var(--space-s)}.step{padding:var(--space-s);border:1px solid var(--line);background:var(--paper-raised);border-radius:var(--radius-lg)}.step-head{display:grid;grid-template-columns:2.5rem 1fr;gap:var(--space-xs);align-items:center;margin-bottom:var(--space-s)}.step-head>span{display:grid;width:2.35rem;height:2.35rem;place-items:center;border-radius:50%;background:var(--accent);color:var(--paper);font-weight:750}.step-head p{margin:0;font-size:10px;font-weight:700;letter-spacing:.12em;color:var(--ink-faint)}.step-head h3{margin:0;font-size:var(--step-0);line-height:1.12}.section{position:relative;height:17rem;overflow:hidden;border:1px solid var(--line);border-radius:var(--radius);background:linear-gradient(90deg,color-mix(in srgb,var(--ink) 8%,transparent),var(--paper-sunk) 30%,var(--paper-sunk) 70%,color-mix(in srgb,var(--accent) 8%,transparent))}.exterior,.room{position:absolute;top:.8rem;font-size:9px;font-weight:750;letter-spacing:.14em;color:var(--ink-faint)}.exterior{left:.8rem}.room{right:.8rem}.wall-left,.wall-right{position:absolute;top:3rem;bottom:0;width:28%;background:color-mix(in srgb,var(--ink) 14%,transparent);border-top:3px solid var(--line-strong)}.wall-left{left:0}.wall-right{right:0}.opening{position:absolute;left:28%;right:28%;top:3rem;bottom:0;background:var(--paper-raised);border-top:3px solid var(--line-strong)}.rough-opening{position:absolute;left:31%;right:31%;top:4.8rem;bottom:1rem;border:3px dashed var(--danger)}.tool-line{position:absolute;left:27%;right:27%;bottom:2rem;height:3px;background:var(--danger)}.sill-pan{position:absolute;left:25%;right:25%;bottom:1.4rem;height:.75rem;background:var(--accent);transform:skewX(-12deg);box-shadow:0 -.5rem 0 -0.22rem var(--accent)}.window{position:absolute;left:30%;right:30%;top:5rem;bottom:2.7rem;border:4px solid var(--ink);background:color-mix(in srgb,var(--accent-2) 8%,var(--paper-raised))}.window::after{content:'';position:absolute;left:50%;top:0;bottom:0;width:2px;background:var(--ink-soft)}.jamb{position:absolute;top:5rem;bottom:2.6rem;width:.55rem;background:var(--accent);z-index:3}.jamb.left{left:29%}.jamb.right{right:29%}.head{position:absolute;left:29%;right:29%;top:4.7rem;height:.6rem;background:var(--accent);z-index:3}.water{position:absolute;right:12%;top:4rem;width:2.3rem;height:9rem;border-right:5px solid var(--accent-ink);border-bottom:5px solid var(--accent-ink);border-radius:0 0 1.5rem 0;transform:skewX(-10deg)}.water::after{content:'';position:absolute;right:-.65rem;bottom:-.75rem;border-left:.55rem solid transparent;border-right:.55rem solid transparent;border-top:1rem solid var(--accent-ink)}.section-1 .opening{background:color-mix(in srgb,var(--danger) 3%,var(--paper-raised))}.section-4 .water{height:11rem}.desc{margin:var(--space-s) 0 0;color:var(--ink-soft);font-size:var(--step--1)}.rule{display:grid;grid-template-columns:auto 1fr;gap:var(--space-s);align-items:baseline;margin-top:var(--space-l);padding:var(--space-s) var(--space-m);border-left:3px solid var(--accent);border-top:1px solid var(--line);border-bottom:1px solid var(--line);background:var(--paper-raised);font-size:var(--step--1)}.rule span{color:var(--ink-soft)}
@media(max-width:1000px){.steps{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:620px){.steps{grid-template-columns:1fr}.rule{grid-template-columns:1fr;gap:.2rem}}
</style>
