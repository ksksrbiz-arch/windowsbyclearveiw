---
interface Props {
  heading?: string | null;
}
const { heading = 'Window flashing: follow the water path.' } = Astro.props;

const steps = [
  ['01', 'Sill', 'Create the drainage path first. Water that gets into the opening must have a way back out.'],
  ['02', 'Window', 'Set the window into the prepared opening and verify it is plumb, level, and square.'],
  ['03', 'Jambs', 'Side flashing ties into the sill so water moves downward, not behind the wall assembly.'],
  ['04', 'Head', 'The top layer sheds over the sides; the WRB laps over the head treatment.'],
];
---
<figure class="flash-diagram">
  {heading && <figcaption class="diagram-heading">{heading}</figcaption>}
  <p class="diagram-intro">This is a <strong>layering diagram</strong>, not a parts catalog. Start at the bottom and trace how incidental water is directed back to the exterior.</p>

  <div class="flash-board">
    <div class="wall-section">
      <svg viewBox="0 0 980 610" role="img" aria-label="Wall section at a window opening showing a sill drainage layer, window frame, jamb flashing, head flashing, weather resistive barrier, and a blue water path that moves down the sides and exits at the sill.">
        <defs>
          <marker id="water-arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="8" markerHeight="8" orient="auto"><path d="M0 0 L10 5 L0 10 Z" class="water-marker"/></marker>
        </defs>
        <rect x="30" y="30" width="920" height="550" rx="18" class="field"/>

        <!-- wall assembly -->
        <rect x="76" y="92" width="178" height="438" class="exterior-wall"/>
        <rect x="254" y="92" width="36" height="438" class="sheathing"/>
        <rect x="290" y="92" width="48" height="438" class="wrb"/>
        <rect x="338" y="92" width="304" height="438" class="opening-zone"/>
        <rect x="642" y="92" width="48" height="438" class="wrb"/>
        <rect x="690" y="92" width="36" height="438" class="sheathing"/>
        <rect x="726" y="92" width="178" height="438" class="interior-wall"/>

        <!-- window -->
        <rect x="364" y="214" width="252" height="246" rx="5" class="window-frame"/>
        <rect x="386" y="236" width="208" height="202" class="glass"/>
        <line x1="490" y1="236" x2="490" y2="438" class="mullion"/>

        <!-- flashing layers -->
        <path d="M338 458 H642" class="sill-pan"/>
        <path d="M348 460 H632 L610 486 H370 Z" class="sill-return"/>
        <path d="M348 214 V458 H364" class="jamb-flash"/>
        <path d="M632 214 V458 H616" class="jamb-flash"/>
        <path d="M348 214 H632 V240 H616" class="head-flash"/>
        <path d="M324 92 V192 H348" class="wrb-lap"/>
        <path d="M656 192 H676 V92" class="wrb-lap"/>

        <!-- water path -->
        <path d="M768 118 C730 145 708 175 688 210 C670 242 660 274 660 320 C660 373 641 415 622 448 C609 470 596 482 574 489" class="water-path" marker-end="url(#water-arrow)"/>
        <text x="785" y="111" class="water-title">INCIDENTAL WATER</text>
        <text x="785" y="130" class="water-sub">should move down + out</text>

        <!-- numbered anchors -->
        <circle cx="318" cy="476" r="25" class="step-circle accent-circle"/><text x="318" y="484" class="step-number">1</text>
        <circle cx="654" cy="254" r="25" class="step-circle"/><text x="654" y="262" class="step-number">2</text>
        <circle cx="318" cy="335" r="25" class="step-circle accent-circle"/><text x="318" y="343" class="step-number">3</text>
        <circle cx="654" cy="190" r="25" class="step-circle accent-circle"/><text x="654" y="198" class="step-number">4</text>

        <!-- minimal structural labels -->
        <text x="165" y="78" class="zone">EXTERIOR</text>
        <text x="815" y="78" class="zone">ROOM</text>
        <text x="490" y="184" class="assembly-label">WINDOW OPENING</text>
        <text x="490" y="504" class="sill-label">SILL = DRAINAGE PATH</text>
        <text x="490" y="113" class="wrb-label">WRB / WEATHER BARRIER</text>
      </svg>
    </div>

    <ol class="flash-steps">
      {steps.map((step) => (
        <li>
          <span class="step-num">{step[0]}</span>
          <span class="step-copy"><strong>{step[1]}</strong><span>{step[2]}</span></span>
        </li>
      ))}
    </ol>
  </div>

  <div class="flash-principle"><strong>The rule to remember:</strong><span>Every upper layer should shed onto the layer below it, with the drainage path ultimately reaching the exterior.</span></div>
</figure>

<style>
  .flash-diagram{margin:0}.diagram-heading{display:block;margin:0 0 var(--space-2xs);font-size:var(--step-2);font-weight:650;letter-spacing:var(--tracking-display);line-height:var(--leading-display)}.diagram-intro{margin:0 0 var(--space-l);max-width:72ch;color:var(--ink-soft);font-size:var(--step--1)}.diagram-intro strong{color:var(--ink)}
  .flash-board{display:grid;grid-template-columns:minmax(0,1.65fr) minmax(260px,.75fr);gap:var(--space-l);align-items:start}.wall-section{padding:var(--space-xs);border:1px solid var(--line);border-radius:var(--radius-lg);background:var(--paper-raised)}.wall-section svg{display:block;width:100%;height:auto;border-radius:var(--radius);background:var(--paper-sunk)}
  .field{fill:var(--paper-sunk);stroke:var(--line);stroke-width:1.5}.exterior-wall,.interior-wall{fill:color-mix(in srgb,var(--ink) 15%,transparent)}.sheathing{fill:color-mix(in srgb,var(--ink) 8%,transparent)}.wrb{fill:color-mix(in srgb,var(--accent) 10%,transparent)}.opening-zone{fill:color-mix(in srgb,var(--paper-raised) 90%,transparent);stroke:var(--line-strong);stroke-width:2;stroke-dasharray:8 8}.window-frame{fill:var(--paper-raised);stroke:var(--ink);stroke-width:5}.glass{fill:color-mix(in srgb,var(--accent-2) 10%,transparent);stroke:var(--accent-ink);stroke-width:2}.mullion{stroke:var(--ink-soft);stroke-width:2}.sill-pan,.sill-return,.jamb-flash,.head-flash,.wrb-lap{fill:none;stroke:var(--accent);stroke-width:11;stroke-linejoin:miter}.sill-return{fill:color-mix(in srgb,var(--accent) 12%,transparent);stroke-width:7}.head-flash{stroke-width:10}.wrb-lap{stroke-width:7;stroke-dasharray:5 4}.water-path{fill:none;stroke:var(--accent-ink);stroke-width:9;stroke-linecap:round}.water-marker{fill:var(--accent-ink)}
  .step-circle{fill:var(--ink)}.accent-circle{fill:var(--accent)}.step-number{fill:var(--paper);font:750 22px Outfit,system-ui,sans-serif;text-anchor:middle}.zone,.assembly-label,.sill-label,.wrb-label,.water-title,.water-sub{font-family:Outfit,system-ui,sans-serif;text-anchor:middle}.zone{fill:var(--ink-faint);font-size:13px;font-weight:750;letter-spacing:.12em}.assembly-label{fill:var(--ink-faint);font-size:13px;font-weight:700;letter-spacing:.1em}.sill-label,.wrb-label{fill:var(--accent-ink);font-size:13px;font-weight:750;letter-spacing:.09em}.water-title{fill:var(--accent-ink);font-size:13px;font-weight:750;letter-spacing:.1em;text-anchor:start}.water-sub{fill:var(--ink-soft);font-size:11px;font-weight:550;text-anchor:start}
  .flash-steps{margin:0;padding:0;list-style:none;border-top:1px solid var(--line)}.flash-steps li{display:grid;grid-template-columns:2.8rem 1fr;gap:var(--space-s);padding:var(--space-s) 0;border-bottom:1px solid var(--line)}.step-num{width:2.45rem;height:2.45rem;display:grid;place-items:center;border-radius:50%;background:var(--ink);color:var(--paper);font-size:var(--step--2);font-weight:750}.flash-steps li:nth-child(1) .step-num,.flash-steps li:nth-child(3) .step-num,.flash-steps li:nth-child(4) .step-num{background:var(--accent)}.step-copy{display:grid;gap:.2rem}.step-copy strong{font-size:var(--step-0)}.step-copy span{color:var(--ink-soft);font-size:var(--step--1)}
  .flash-principle{display:grid;grid-template-columns:auto 1fr;gap:var(--space-s);align-items:baseline;margin-top:var(--space-l);padding:var(--space-s) var(--space-m);border-left:3px solid var(--accent);background:var(--paper-raised);font-size:var(--step--1)}.flash-principle span{color:var(--ink-soft)}
  @media(max-width:900px){.flash-board{grid-template-columns:1fr}}@media(max-width:600px){.flash-principle{grid-template-columns:1fr;gap:.2rem}}
</style>
