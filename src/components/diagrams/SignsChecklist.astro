---
interface Props {
  heading?: string | null;
}
const { heading = 'Six signs a window may be the problem' } = Astro.props;

const signs = [
  ['01','Draft','Air moves at the lock, stool, or meeting rail.','DRAFTY'],
  ['02','Fogged glass','Haze sits between panes where a cloth cannot reach.','SEALED UNIT'],
  ['03','Hard to operate','Sash sticks, drops, rattles, or will not lock.','HARDWARE / FRAME'],
  ['04','Soft sill','Wood is soft, stained, swollen, or repeatedly wet.','MOISTURE'],
  ['05','Cold room','One room feels cold beside the glass even when the heat is on.','COMFORT'],
  ['06','Rising bills','Tired glass and frames can leave a room harder to heat.','EFFICIENCY'],
];
---
<figure class="signs-diagram">
  {heading && <figcaption class="diagram-heading">{heading}</figcaption>}
  <p class="diagram-intro">You do not need six problems. <strong>Two or three persistent signs in the same room</strong> are enough reason to have the opening looked at.</p>

  <div class="sign-grid">
    {signs.map(([n,title,text,tag], index) => (
      <article class={`sign-card sign-card-${index + 1}`}>
        <div class="sign-top">
          <span class="sign-num">{n}</span>
          <span class="sign-tag">{tag}</span>
        </div>
        <div class="sign-icon" aria-hidden="true">
          {index === 0 && <svg viewBox="0 0 64 64"><path d="M8 24c7-9 14 9 21 0s14 9 21 0"/><path d="M8 39c7-9 14 9 21 0s14 9 21 0"/></svg>}
          {index === 1 && <svg viewBox="0 0 64 64"><circle cx="22" cy="29" r="7"/><circle cx="34" cy="38" r="9"/><circle cx="46" cy="27" r="6"/></svg>}
          {index === 2 && <svg viewBox="0 0 64 64"><rect x="16" y="27" width="32" height="23" rx="4"/><path d="M24 27v-6a8 8 0 0 1 16 0v6"/></svg>}
          {index === 3 && <svg viewBox="0 0 64 64"><path d="M17 17c0 10-9 13-9 23a14 14 0 0 0 28 0c0-10-9-13-9-23"/><path d="M39 29c0 7-6 9-6 16a10 10 0 0 0 20 0c0-7-6-9-6-16"/></svg>}
          {index === 4 && <svg viewBox="0 0 64 64"><path d="M32 10v44"/><path d="M19 23a18 18 0 1 0 26 0"/><path d="M25 28l7 5 7-5"/></svg>}
          {index === 5 && <svg viewBox="0 0 64 64"><path d="M10 47l12-11 9 7 13-17 10 8"/><path d="M43 17h11v11"/></svg>}
        </div>
        <h3>{title}</h3>
        <p>{text}</p>
      </article>
    ))}
  </div>

  <div class="sign-bottom">
    <div><strong>1 sign</strong><span>Watch it.</span></div>
    <div class="active"><strong>2+ signs</strong><span>Worth a measure.</span></div>
    <div><strong>Soft wood / active leak</strong><span>Do not wait on cosmetics.</span></div>
  </div>
</figure>

<style>
  .signs-diagram{margin:0}.diagram-heading{display:block;margin:0 0 var(--space-2xs);font-size:var(--step-2);font-weight:650;letter-spacing:var(--tracking-display)}.diagram-intro{margin:0 0 var(--space-l);max-width:70ch;color:var(--ink-soft);font-size:var(--step--1)}.diagram-intro strong{color:var(--ink)}
  .sign-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:var(--space-xs)}.sign-card{padding:var(--space-m);min-height:220px;border:1px solid var(--line);border-radius:var(--radius-lg);background:var(--paper-raised)}.sign-top{display:flex;justify-content:space-between;align-items:center;gap:var(--space-xs)}.sign-num{font-size:var(--step--2);font-weight:750;letter-spacing:.08em;color:var(--accent-ink)}.sign-tag{padding:.22rem .45rem;border:1px solid var(--line);border-radius:999px;color:var(--ink-faint);font-size:10px;font-weight:650;letter-spacing:.08em}.sign-icon{width:3.5rem;height:3.5rem;margin:var(--space-m) 0 var(--space-s);display:grid;place-items:center;border-radius:var(--radius);background:var(--paper-sunk);color:var(--accent-ink)}.sign-icon svg{width:2rem;height:2rem;fill:none;stroke:currentColor;stroke-width:3;stroke-linecap:round;stroke-linejoin:round}.sign-card-2 .sign-icon{color:var(--danger)}.sign-card-3 .sign-icon{color:var(--ink)}.sign-card-4 .sign-icon{color:var(--danger)}.sign-card-5 .sign-icon{color:var(--accent)}.sign-card-6 .sign-icon{color:var(--accent-ink)}.sign-card h3{margin:0 0 .35rem;font-size:var(--step-0)}.sign-card p{margin:0;color:var(--ink-soft);font-size:var(--step--1);max-width:34ch}.sign-bottom{display:grid;grid-template-columns:repeat(3,1fr);margin-top:var(--space-s);border-top:1px solid var(--line);border-bottom:1px solid var(--line)}.sign-bottom div{display:grid;gap:.15rem;padding:var(--space-s);border-right:1px solid var(--line)}.sign-bottom div:last-child{border-right:0}.sign-bottom strong{font-size:var(--step--1)}.sign-bottom span{color:var(--ink-soft);font-size:var(--step--2)}.sign-bottom .active{background:color-mix(in srgb,var(--accent) 9%,transparent)}
  @media(max-width:850px){.sign-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:560px){.sign-grid,.sign-bottom{grid-template-columns:1fr}.sign-bottom div{border-right:0;border-bottom:1px solid var(--line)}.sign-bottom div:last-child{border-bottom:0}}
</style>
