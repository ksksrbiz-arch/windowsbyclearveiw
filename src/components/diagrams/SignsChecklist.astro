---
/**
 * The six signs from the guide body, laid out as icon callouts flanking a
 * drawn window rather than another wall of paragraphs. Modeled on the kind
 * of "signs it's time" infographic a window company would run as a
 * standalone social asset — badge icon, short label, one line — but built
 * as token-driven inline SVG/HTML so it stays in the site's own palette and
 * needs no image export pipeline. The window art in the middle is
 * decorative (aria-hidden); the six items are real text in a real list, so
 * nothing here depends on the drawing to be understood or to reflow on a
 * narrow screen.
 */
interface Props {
  heading?: string | null;
}
const { heading = 'Six signs, at a glance' } = Astro.props;
---
<figure class="signs-detail">
  {heading && <figcaption class="signs-heading">{heading}</figcaption>}

  <div class="signs-layout">
    <ul class="signs-col signs-col-left">
      <li>
        <span class="signs-badge" aria-hidden="true">
          <svg viewBox="0 0 44 44"><path d="M9 16q4-5 8 0t8 0t8 0" class="si-line" /><path d="M9 24q4-5 8 0t8 0t8 0" class="si-line" /><path d="M9 32q4-5 8 0t8 0t8 0" class="si-line" /></svg>
        </span>
        <span class="signs-text">
          <strong>Drafts at the frame</strong>
          <span>Air moves at the lock, the stool, or the meeting rail.</span>
        </span>
      </li>
      <li>
        <span class="signs-badge" aria-hidden="true">
          <svg viewBox="0 0 44 44"><circle cx="16" cy="20" r="4" class="si-fill" /><circle cx="24" cy="26" r="5.5" class="si-fill" /><circle cx="31" cy="19" r="3.5" class="si-fill" /><circle cx="21" cy="16" r="3" class="si-fill" /></svg>
        </span>
        <span class="signs-text">
          <strong>Fog between the panes</strong>
          <span>Seal has failed inside the glass — cannot wipe it off.</span>
        </span>
      </li>
      <li>
        <span class="signs-badge" aria-hidden="true">
          <svg viewBox="0 0 44 44"><rect x="14" y="20" width="16" height="13" rx="2" class="si-stroke" /><path d="M18 20v-4a4 4 0 0 1 8 0v4" class="si-line" /></svg>
        </span>
        <span class="signs-text">
          <strong>Sash sticks or won't lock</strong>
          <span>Hardware is fighting paint, swelling, or a frame gone out of square.</span>
        </span>
      </li>
    </ul>

    <svg class="signs-window" viewBox="0 0 260 380" aria-hidden="true" focusable="false">
      <rect x="10" y="10" width="240" height="360" rx="6" class="sw-frame" />
      <rect x="30" y="30" width="200" height="150" class="sw-sash" />
      <line x1="130" y1="30" x2="130" y2="180" class="sw-mullion" />
      <line x1="30" y1="105" x2="230" y2="105" class="sw-mullion" />
      <rect x="20" y="188" width="220" height="18" rx="2" class="sw-rail" />
      <rect x="30" y="216" width="200" height="150" class="sw-sash" />
      <line x1="130" y1="216" x2="130" y2="366" class="sw-mullion" />
      <line x1="30" y1="291" x2="230" y2="291" class="sw-mullion" />
      <rect x="120" y="192" width="20" height="10" rx="1.5" class="sw-latch" />
    </svg>

    <ul class="signs-col signs-col-right">
      <li>
        <span class="signs-badge" aria-hidden="true">
          <svg viewBox="0 0 44 44"><path d="M16 12c0 6-6 8-6 14a6 6 0 0 0 12 0c0-6-6-8-6-14Z" class="si-stroke" /><path d="M27 18c0 5-5 7-5 12a5 5 0 0 0 10 0c0-5-5-7-5-12Z" class="si-stroke" /></svg>
        </span>
        <span class="signs-text">
          <strong>Soft or stained sill</strong>
          <span>Water has been getting into the opening.</span>
        </span>
      </li>
      <li>
        <span class="signs-badge" aria-hidden="true">
          <svg viewBox="0 0 44 44"><rect x="19" y="8" width="6" height="20" rx="3" class="si-stroke" /><circle cx="22" cy="32" r="6" class="si-fill" /><line x1="22" y1="14" x2="22" y2="28" class="si-line-thin" /></svg>
        </span>
        <span class="signs-text">
          <strong>One room never matches</strong>
          <span>Cold glass wins even with the furnace running.</span>
        </span>
      </li>
      <li>
        <span class="signs-badge" aria-hidden="true">
          <svg viewBox="0 0 44 44"><path d="M9 28l7-6 6 4 8-9 5 4" class="si-line" fill="none" /><path d="M31 15h6v6" class="si-line" fill="none" /></svg>
        </span>
        <span class="signs-text">
          <strong>The bill keeps climbing</strong>
          <span>Leaky glass is the common leftover once insulation is decent.</span>
        </span>
      </li>
    </ul>
  </div>

  <p class="signs-foot">
    One of these is worth watching. Two or more in the same room is worth a measure — see the
    full list below for how urgent each one really is.
  </p>
</figure>

<style>
  .signs-detail {
    margin: 0;
  }

  .signs-heading {
    display: block;
    margin: 0 0 var(--space-m);
    font-size: var(--step-2);
    font-weight: 600;
    letter-spacing: var(--tracking-display);
    line-height: var(--leading-display);
  }

  .signs-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(140px, 200px) minmax(0, 1fr);
    align-items: center;
    gap: var(--space-l);
  }

  .signs-window {
    width: 100%;
    height: auto;
    justify-self: center;
  }

  .sw-frame {
    fill: var(--paper-raised);
    stroke: var(--ink);
    stroke-width: 3;
  }

  .sw-sash {
    fill: color-mix(in srgb, var(--accent) 14%, transparent);
    stroke: var(--ink-soft);
    stroke-width: 1.5;
  }

  .sw-mullion {
    stroke: var(--ink-soft);
    stroke-width: 2;
  }

  .sw-rail {
    fill: color-mix(in srgb, var(--ink) 16%, transparent);
    stroke: var(--ink);
    stroke-width: 1.5;
  }

  .sw-latch {
    fill: var(--ink);
  }

  .signs-col {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: var(--space-l);
  }

  .signs-col li {
    display: flex;
    align-items: flex-start;
    gap: var(--space-s);
  }

  .signs-col-right li {
    flex-direction: row-reverse;
    text-align: right;
  }

  .signs-badge {
    flex: none;
    width: 3rem;
    height: 3rem;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: var(--paper-raised);
    border: 2px solid var(--accent-ink);
    color: var(--accent-ink);
  }

  .signs-badge svg {
    width: 1.65rem;
    height: 1.65rem;
  }

  .si-line,
  .si-line-thin {
    fill: none;
    stroke: currentColor;
    stroke-width: 2.4;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .si-line-thin {
    stroke-width: 1.8;
  }

  .si-stroke {
    fill: none;
    stroke: currentColor;
    stroke-width: 2.4;
  }

  .si-fill {
    fill: currentColor;
    opacity: 0.75;
  }

  .signs-text {
    display: grid;
    gap: 0.2rem;
  }

  .signs-text strong {
    font-size: var(--step-0);
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .signs-text span {
    font-size: var(--step--1);
    color: var(--ink-soft);
    max-width: 26ch;
  }

  .signs-col-right .signs-text span {
    margin-left: auto;
  }

  .signs-foot {
    margin: var(--space-l) 0 0;
    max-width: var(--measure);
    font-size: var(--step--1);
    color: var(--ink-soft);
  }

  @media (max-width: 800px) {
    .signs-layout {
      grid-template-columns: 1fr;
    }

    .signs-window {
      max-width: 220px;
      order: -1;
      margin: 0 auto var(--space-m);
    }

    .signs-col-right li {
      flex-direction: row;
      text-align: left;
    }

    .signs-col-right .signs-text span {
      margin-left: 0;
    }
  }
</style>
