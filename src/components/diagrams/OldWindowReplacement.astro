---
interface Props { heading?: string | null; }
const { heading = 'Old window → modern replacement' } = Astro.props;
---
<figure class="replacement-guide">
  {heading && <figcaption class="heading">{heading}</figcaption>}
  <p class="intro">Same opening. Very different window system.</p>

  <div class="comparison">
    <article class="side old">
      <header><span>BEFORE</span><h3>Older window</h3></header>
      <div class="illustration" role="img" aria-label="Illustration of an older window assembly with worn framing and perimeter gaps.">
        <svg viewBox="0 0 520 480" aria-hidden="true">
          <defs><linearGradient id="cv-old-frame" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#5a5c56"/><stop offset="1" stop-color="#77736a"/></linearGradient></defs>
          <rect width="520" height="480" fill="#efece5"/>
          <rect x="110" y="56" width="300" height="352" rx="6" fill="url(#cv-old-frame)" stroke="#3d403b" stroke-width="5"/>
          <rect x="136" y="82" width="248" height="300" fill="#d8e4df" stroke="#4a4e49" stroke-width="18"/>
          <rect x="248" y="84" width="18" height="296" fill="#4a4e49"/>
          <rect x="130" y="216" width="260" height="20" fill="#4a4e49"/>
          <circle cx="257" cy="226" r="7" fill="#b9b9ae"/>
          <path d="M86 205 C56 220 56 250 86 265" fill="none" stroke="#a74a45" stroke-width="7" stroke-linecap="round"/>
          <path d="M54 201 C20 223 20 255 54 276" fill="none" stroke="#d06a63" stroke-width="4" stroke-linecap="round"/>
          <path d="M103 392 C130 416 160 427 190 427" fill="none" stroke="#a74a45" stroke-width="7" stroke-linecap="round"/>
          <path d="M330 424 C360 432 390 430 416 414" fill="none" stroke="#a74a45" stroke-width="7" stroke-linecap="round"/>
        </svg>
      </div>
      <div class="points">
        <div><span>01</span><div><strong>Older assembly</strong><p>Worn frame, older glazing and dated hardware.</p></div></div>
        <div><span>02</span><div><strong>Perimeter gaps</strong><p>Air can move through weak seals and joints.</p></div></div>
      </div>
    </article>

    <div class="swap" aria-hidden="true"><span>REPLACE</span><b>→</b></div>

    <article class="side new">
      <header><span>AFTER</span><h3>Modern replacement</h3></header>
      <div class="illustration" role="img" aria-label="Illustration of a modern replacement window with insulated glass and a finished sealed perimeter.">
        <svg viewBox="0 0 520 480" aria-hidden="true">
          <defs>
            <linearGradient id="cv-new-frame" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#24463b"/><stop offset="1" stop-color="#557266"/></linearGradient>
            <linearGradient id="cv-new-glass" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#f7fbfa"/><stop offset=".55" stop-color="#d5ebe4"/><stop offset="1" stop-color="#b8d7cd"/></linearGradient>
          </defs>
          <rect width="520" height="480" fill="#edf4f0"/>
          <rect x="100" y="50" width="320" height="350" rx="8" fill="#dce5df" stroke="#b2c5bc" stroke-width="12"/>
          <rect x="117" y="67" width="286" height="316" rx="4" fill="url(#cv-new-frame)"/>
          <rect x="143" y="93" width="234" height="264" fill="url(#cv-new-glass)"/>
          <rect x="145" y="220" width="230" height="16" rx="4" fill="#355247"/>
          <rect x="251" y="93" width="16" height="264" rx="4" fill="#355247"/>
          <rect x="244" y="218" width="28" height="30" rx="8" fill="#d6ded9"/>
          <path d="M163 112 L230 112 L183 174 L157 174Z" fill="#fff" opacity=".42"/>
          <rect x="99" y="49" width="322" height="352" rx="8" fill="none" stroke="#2d7d63" stroke-width="5" opacity=".6"/>
        </svg>
      </div>
      <div class="points">
        <div><span>01</span><div><strong>Modern insulated glass</strong><p>Two panes separated by an insulated space.</p></div></div>
        <div><span>02</span><div><strong>Tight perimeter</strong><p>New frame and sealing surfaces close the opening.</p></div></div>
        <div><span>03</span><div><strong>Finished replacement</strong><p>A clean, complete unit in the opening.</p></div></div>
      </div>
    </article>
  </div>
</figure>

<style>
  .replacement-guide{margin:0}
  .heading{display:block;margin:0 0 .35rem;font-size:var(--step-2);font-weight:650;letter-spacing:var(--tracking-display);line-height:var(--leading-display)}
  .intro{margin:0 0 var(--space-l);max-width:72ch;color:var(--ink-soft);font-size:var(--step--1)}
  .comparison{display:grid;grid-template-columns:minmax(0,1fr) 92px minmax(0,1fr);align-items:center;gap:var(--space-s)}
  .side{border:1px solid var(--line);border-radius:var(--radius-lg);overflow:hidden;background:var(--paper-raised);box-shadow:var(--shadow-soft)}
  .side header{padding:var(--space-s) var(--space-m);border-bottom:1px solid var(--line)}
  .side header span{display:block;font-size:10px;font-weight:800;letter-spacing:.12em;margin-bottom:.18rem}
  .side header h3{margin:0;font-size:var(--step-1)}
  .old header{color:#7d4a42}.new header{color:var(--accent-ink)}
  .illustration{background:#f7f8f5}
  .illustration svg{display:block;width:100%;height:auto}
  .points{display:grid;gap:.55rem;padding:var(--space-m)}
  .points>div{display:grid;grid-template-columns:26px 1fr;gap:.45rem;padding:.7rem .75rem;border-left:3px solid var(--line-strong);background:var(--paper-sunk)}
  .old .points>div{border-left-color:#a74a45}.new .points>div{border-left-color:var(--accent)}
  .points>div>span{font-size:10px;font-weight:800;color:var(--accent-ink)}
  .points strong{font-size:var(--step--1);line-height:1.15}.points p{margin:.2rem 0 0;font-size:11px;line-height:1.35;color:var(--ink-soft)}
  .swap{display:grid;justify-items:center;gap:.45rem;color:var(--accent-ink);font-size:10px;font-weight:800;letter-spacing:.12em}
  .swap b{display:grid;place-items:center;width:48px;height:48px;border-radius:50%;background:var(--paper-raised);border:1px solid color-mix(in srgb,var(--accent) 40%,var(--line));font-size:25px;box-shadow:var(--shadow-sm)}
  @media(max-width:900px){
    .comparison{grid-template-columns:1fr;gap:var(--space-s)}
    .swap{grid-template-columns:auto auto;justify-content:center;gap:.6rem;padding:.15rem 0}
    .swap b{width:40px;height:40px;font-size:21px}
    .swap b{transform:rotate(90deg)}
  }
</style>
