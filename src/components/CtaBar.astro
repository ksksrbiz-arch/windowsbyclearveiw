---
import { site, telHref } from '../data/site';

interface Props {
  /** Override when a page has a more specific next step than "get measured". */
  heading?: string;
  body?: string;
}

const {
  heading = 'Walk the openings with Mark.',
  body = 'A written estimate after we see the glass, the sills, and the trim — not a number from a photo.',
} = Astro.props;
---
<section class="cta-band">
  <div class="cta-rule" aria-hidden="true"></div>
  <div class="wrap cta-bar">
    <div class="cta-copy">
      <p class="cta-label">Next step</p>
      <strong>{heading}</strong>
      <p>{body}</p>
    </div>
    <div class="cta-actions">
      <a class="cta-phone" href={telHref()}>
        <span class="cta-phone-label">Call Mark</span>
        <span class="cta-phone-number" aria-hidden="true">{site.phoneDisplay}</span>
        <span class="visually-hidden">{site.phoneDisplay}</span>
      </a>
      <a class="btn btn-ghost btn-on-dark cta-secondary" href="/estimate">Request an estimate</a>
    </div>
  </div>
</section>

<style>
  /* ───────────────────────────────────────────────────────────────────────
     This band closes all seventeen pages, so a visitor sees it more than any
     other element on the site. It used to be a thin dark strip with a 13px
     label and two small buttons — the least emphatic thing on the page, in
     the position that should carry the most.

     Now the phone number is the object: set at display size, tappable across
     its whole area, and the only place on the site where the accent becomes
     a surface rather than a line.
     ─────────────────────────────────────────────────────────────────────── */
  .cta-band {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background:
      radial-gradient(
        90% 130% at 88% 0%,
        color-mix(in srgb, var(--accent) 30%, transparent),
        transparent 60%
      ),
      var(--black);
    color: var(--on-dark);
    padding: var(--space-3xl) 0;
  }

  .cta-rule {
    position: absolute;
    inset: 0 0 auto;
    height: 2px;
    background: linear-gradient(90deg, var(--accent-bright), transparent 55%);
  }

  .cta-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-xl);
  }

  .cta-copy {
    min-width: 0;
  }

  .cta-label {
    margin: 0 0 var(--space-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-label);
    font-size: var(--step--2);
    font-weight: 500;
    color: var(--accent-bright);
  }

  .cta-bar strong {
    display: block;
    font-size: var(--step-4);
    font-weight: 600;
    line-height: var(--leading-display);
    letter-spacing: var(--tracking-display);
    margin-bottom: var(--space-xs);
    text-wrap: balance;
  }

  .cta-bar p {
    margin: 0;
    color: var(--on-dark-soft);
    max-width: 36rem;
  }

  .cta-actions {
    display: grid;
    gap: var(--space-xs);
    justify-items: stretch;
    flex: none;
  }

  /* Deliberately not a .btn. On a contractor's site the phone number is the
     conversion, and shrinking it to match a secondary link wastes it. */
  .cta-phone {
    display: grid;
    gap: 0.1rem;
    padding: var(--space-s) var(--space-m);
    border: 1px solid var(--dark-line-strong);
    border-radius: var(--radius-lg);
    background: color-mix(in srgb, var(--accent) 16%, transparent);
    color: var(--on-dark);
    text-decoration: none;
    transition:
      background var(--dur) var(--ease),
      border-color var(--dur) var(--ease),
      transform var(--dur-fast) var(--ease);
  }

  .cta-phone:hover,
  .cta-phone:focus-visible {
    background: color-mix(in srgb, var(--accent) 34%, transparent);
    border-color: var(--accent-bright);
    transform: translateY(-2px);
  }

  .cta-phone-label {
    text-transform: uppercase;
    letter-spacing: var(--tracking-label);
    font-size: var(--step--2);
    font-weight: 500;
    color: var(--on-dark-faint);
  }

  .cta-phone-number {
    font-size: var(--step-2);
    font-weight: 600;
    letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .cta-secondary {
    justify-content: center;
  }

  @media (max-width: 900px) {
    .cta-band {
      padding: var(--space-2xl) 0;
    }

    .cta-bar {
      display: grid;
      gap: var(--space-l);
    }

    .cta-bar strong {
      font-size: var(--step-3);
    }
  }
</style>
