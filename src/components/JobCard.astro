---
interface Props {
  title: string;
  city: string;
  year: number;
  summary: string;
  scope: string;
}

const { title, city, year, summary, scope } = Astro.props;
---
<article class="job">
  <div class="job-thumb" aria-hidden="true"></div>
  <p class="kicker">{city} · {year}</p>
  <h3>{title}</h3>
  <p>{summary}</p>
  <p class="fine-print">{scope}</p>
</article>
