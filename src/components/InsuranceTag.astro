---
// A factual disclosure tag for general liability insurance, not a trust
// seal — same reasoning as LicenseTag.astro. The visible text is
// deliberately short ("Insured"); the real carrier, policy number, and
// per-occurrence limit live in title/aria-label so a hover or long-press
// (and every screen reader) still gets the specific number that makes
// this defensible, rather than the vague "insured" claim Washington
// treats as misleading advertising when paired with "bonded" (see
// HANDOFF.md's 2026-09-22 entry). Renders nothing when site.insurance is
// unset.
import { site } from '../data/site';

interface Props {
  onDark?: boolean;
}

const { onDark = false } = Astro.props;
const insurance = site.insurance;
const detail = insurance
  ? `General liability insured — ${insurance.carrier}, $${insurance.perOccurrence.toLocaleString()} per occurrence / $${insurance.generalAggregate.toLocaleString()} aggregate. Policy ${insurance.policyNumber}.`
  : '';
---
{insurance && (
  <span class:list={['credential-tag', { 'is-on-dark': onDark }]} title={detail} aria-label={detail}>
    <svg viewBox="0 0 20 20" aria-hidden="true" focusable="false">
      <rect x="2.5" y="4.5" width="15" height="11" rx="1" />
      <line x1="5.5" y1="8" x2="14.5" y2="8" />
      <line x1="5.5" y1="10.5" x2="11.5" y2="10.5" />
      <line x1="5.5" y1="13" x2="9.5" y2="13" />
    </svg>
    <span aria-hidden="true">Insured</span>
  </span>
)}

<style>
  .credential-tag {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.3rem 0.6rem;
    border-radius: 2px;
    border: 1px solid var(--accent-2-ink);
    background: color-mix(in srgb, var(--accent-2) 12%, var(--paper));
    color: var(--accent-2-ink);
    font-size: var(--step--2);
    font-weight: 600;
    letter-spacing: 0.01em;
    white-space: nowrap;
  }

  .credential-tag svg {
    width: 0.95rem;
    height: 0.95rem;
    flex: none;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.4;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* Verified 6.94:1 on --black in global.css — same token, no new pairing. */
  .credential-tag.is-on-dark {
    border-color: var(--accent-2-bright);
    background: color-mix(in srgb, var(--accent-2) 22%, black);
    color: var(--accent-2-bright);
  }
</style>
