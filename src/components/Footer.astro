---
import { site } from '../data/site';
import Brand from './Brand.astro';
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="wrap footer-grid">
    <div class="footer-brand">
      <Brand compact />
      <p>Replacement and new-construction windows for Washington homes.</p>
      <p class="fine-print">
        Contractor registration: {site.lniNumber || 'L&I number added before we advertise.'}
      </p>
    </div>
    <div>
      <strong>Work</strong>
      <a href="/replacement">Replacement</a>
      <a href="/new-construction">New construction</a>
      <a href="/process">Process</a>
      <a href="/gallery">Gallery</a>
    </div>
    <div>
      <strong>Learn</strong>
      <a href="/guides/signs-you-need-new-windows">Six signs</a>
      <a href="/guides/fogged-windows">Fogged glass</a>
      <a href="/guides/full-frame-vs-insert">Full-frame vs insert</a>
      <a href="/guides/window-replacement-cost-washington">What it costs</a>
    </div>
    <div>
      <strong>Company</strong>
      <a href="/about">About Mark</a>
      <a href="/areas">Service areas</a>
      <a href="/estimate">Request an estimate</a>
      <p class="fine-print">&copy; {year} {site.legalName}</p>
    </div>
  </div>
</footer>
