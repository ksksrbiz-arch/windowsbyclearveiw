---
import { site } from '../data/site';
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="wrap footer-grid">
    <div>
      <strong>{site.legalName}</strong>
      <p>Window replacement and installation for Washington homes.</p>
      <p class="fine-print">
        Contractor registration: {site.lniNumber || 'Add L&I number before advertising.'}
      </p>
    </div>
    <div>
      <strong>Company</strong><br />
      <a href="/replacement">Replacement</a><br />
      <a href="/process">Process</a><br />
      <a href="/about">About Mark</a><br />
      <a href="/estimate">Request an estimate</a>
    </div>
    <div>
      <strong>Learn</strong><br />
      <a href="/guides">All guides</a><br />
      <a href="/guides/signs-you-need-new-windows">Signs you need new windows</a><br />
      <a href="/guides/fogged-windows">Fogged windows</a><br />
      <a href="/guides/full-frame-vs-insert">Full-frame vs insert</a><br />
      <a href="/guides/window-replacement-cost-washington">What it costs</a>
    </div>
    <div class="fine-print">
      <p>&copy; {year} {site.legalName}. All rights reserved.</p>
      <p>Site: {site.domain}</p>
    </div>
  </div>
</footer>
