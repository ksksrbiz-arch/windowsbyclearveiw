---
import { mailHref, site, telHref } from '../data/site';
import Brand from './Brand.astro';
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="wrap footer-grid">
    <div class="footer-brand">
      <Brand compact />
      <p>Replacement and new-construction windows in Vancouver, WA and surrounding Clark County.</p>
      <p><a href={telHref()}>{site.phoneDisplay}</a></p>
      <p><a href={mailHref()}>{site.email}</a></p>
      <p class="fine-print">
        {site.lniNumber
          ? `WA contractor registration ${site.lniNumber}`
          : 'WA contractor registration number pending — ask Mark for it on the first call.'}
      </p>
    </div>
    <div>
      <strong>Work</strong>
      <a href="/replacement">Replacement</a>
      <a href="/new-construction">New construction</a>
      <a href="/process">Process</a>
      <a href="/gallery">Gallery</a>
    </div>
    <div>
      <strong>Areas</strong>
      <a href="/areas">All areas</a>
      <a href="/areas/vancouver">Vancouver</a>
      <a href="/areas/camas">Camas</a>
      <a href="/areas/battle-ground">Battle Ground</a>
      <a href="/areas/brush-prairie">Brush Prairie</a>
      <a href="/areas/ridgefield">Ridgefield</a>
      <a href="/areas/portland">Portland, OR</a>
    </div>
    <div>
      <strong>Company</strong>
      <a href="/about">About Mark</a>
      <a href="/tools">Free tools</a>
      <a href="/guides">Guides</a>
      <a href="/reviews">Reviews</a>
      <a href="/estimate">Request an estimate</a>
      <p class="fine-print">&copy; {year} {site.legalName}</p>
    </div>
  </div>
</footer>
