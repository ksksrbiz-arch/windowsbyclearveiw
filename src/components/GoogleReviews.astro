---
// Live Google Business Profile reviews for /reviews.
//
// Progressive enhancement: the server renders an empty, hidden section. The
// script below asks /api/google-reviews and only reveals the section if
// Google returned real reviews for the pinned profile. Without JS, without
// configuration, or on any error, the page stays exactly as it was.
//
// Review text is untrusted third-party content: it is written with
// textContent only, so it is never parsed as markup.
import { site } from '../data/site';
import GoogleIcon from './icons/GoogleIcon.astro';
import '../styles/review-cards.css';

const googleUrl = site.social.google;
---
<section
  class="section google-reviews"
  id="google-reviews"
  aria-labelledby="google-reviews-title"
  data-google-reviews
  hidden
>
  <div class="wrap">
    <div class="google-panel">
    <div class="google-panel-header">
      <div>
        <h2 id="google-reviews-title" class="google-heading"><GoogleIcon /> Google reviews</h2>
        <p class="google-business">Clearview windows and trim LLC</p>
        <p class="google-overall-stars" data-gr-stars aria-hidden="true"></p>
        <p class="google-summary" data-gr-summary></p>
      </div>
      <a class="google-write" href={site.social.googleReview || googleUrl} target="_blank" rel="noopener noreferrer">Write a review on Google</a>
    </div>
    <template data-google-mark><GoogleIcon /></template>
    <div class="gr-list" data-gr-list></div>
    <p class="fine-print gr-attribution">
      Reviews shown as written, straight from Google Maps. Only the most relevant
      few are shown here.
      {googleUrl && (
        <>
          {' '}
          <a href={googleUrl} target="_blank" rel="noopener noreferrer">See and leave reviews on Google</a>.
        </>
      )}
    </p>
    </div>
  </div>
</section>

<style>
  .google-reviews[hidden] {
    display: none;
  }

  .gr-list {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
    margin-top: var(--space-l);
  }

  @media (max-width: 900px) {
    .gr-list {
      grid-template-columns: 1fr;
    }
  }

  .gr-attribution {
    margin-top: var(--space-l);
  }

  .gr-list:has(> :only-child) { grid-template-columns: 1fr; max-width: 960px; }
  .google-panel { padding: clamp(1rem, 3vw, 2rem); border: 1px solid #dadce0; border-radius: 20px; background: #fff; color: #202124; box-shadow: 0 8px 30px rgb(32 33 36 / .06); }
  .google-panel-header { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 1.25rem; }
  .google-heading { display: flex; align-items: center; gap: .65rem; font-size: 1.65rem; margin: 0; color: #202124; }
  .google-heading :global(svg) { width: 30px; height: 30px; }
  .google-business { margin: .6rem 0 .3rem; font-weight: 600; }
  .google-summary { margin: 0; font-size: 1rem; color: #5f6368; }
  .google-overall-stars { color: #fbbc04; font-size: 1.5rem; letter-spacing: .08em; margin: .35rem 0; }
  .google-write { border-radius: 24px; background: #1a73e8; color: white; padding: .8rem 1.1rem; font-size: .9rem; font-weight: 600; text-decoration: none; }
  .google-write:hover { background: #1558b0; }
  .gr-attribution { font-size: .8rem; color: #5f6368; }
  .google-panel :global(.gr-review) { display: flex; flex-direction: column; padding: 1.3rem; border: 1px solid #dadce0; border-radius: 12px; background: #fff; color: #202124; box-shadow: none; }
  .google-panel :global(.review-stars) { color: #fbbc04; font-size: 1.2rem; letter-spacing: .08em; }
  .google-panel :global(.review-source) { background: transparent; padding: 0; font-size: .8rem; color: #5f6368; }
  .google-panel :global(.review-source svg) { width: 18px; height: 18px; }
  .google-panel :global(.review-quote-mark) { display: none; }
  .google-panel :global(.review-quote) { font-size: 1rem; line-height: 1.65; letter-spacing: normal; margin: 1.25rem 0; max-width: none; }
  .google-panel :global(.review-footer) { margin-top: auto; border-color: #e8eaed; padding-top: 1rem; }
  .google-panel :global(.review-avatar) { flex-basis: 40px; height: 40px; font-size: .9rem; background: #e8f0fe; color: #185abc; }
  .google-panel :global(.review-name) { font-size: .95rem; }
  .google-panel :global(.review-person-meta) { color: #5f6368; font-size: .75rem; }
  .google-panel :global(.gr-review a) { color: #202124; }
</style>

<script>
  import { getGoogleReviewFeed } from '../lib/google-review-feed';

  type GoogleReview = {
    rating: number;
    text: string;
    author: string;
    authorUrl: string;
    when: string;
  };

  type Feed = {
    status: string;
    rating?: number | null;
    count?: number | null;
    reviews?: GoogleReview[];
  };

  function stars(rating: number): string {
    const n = Math.max(1, Math.min(5, Math.round(rating)));
    return '★'.repeat(n) + '☆'.repeat(5 - n);
  }

  function render(feed: Feed) {
    const root = document.querySelector<HTMLElement>('[data-google-reviews]');
    if (!root || feed.status !== 'ok' || !feed.reviews || feed.reviews.length === 0) return;

    const list = root.querySelector<HTMLElement>('[data-gr-list]');
    const summary = root.querySelector<HTMLElement>('[data-gr-summary]');
    if (!list || !summary) return;

    list.replaceChildren();
    for (const review of feed.reviews) {
      const item = document.createElement('blockquote');
      item.className = 'gr-review review-spotlight';

      const starLine = document.createElement('p');
      starLine.className = 'gr-stars review-stars';
      starLine.setAttribute('role', 'img');
      starLine.setAttribute('aria-label', `${review.rating} out of 5 stars`);
      starLine.textContent = stars(review.rating);

      const text = document.createElement('p');
      text.className = 'gr-text review-quote';
      text.textContent = `“${review.text}”`;

      const footer = document.createElement('footer');
      footer.className = 'review-footer';
      const author = document.createElement('strong');
      author.className = 'gr-author review-name';
      if (review.authorUrl) {
        const link = document.createElement('a');
        link.href = review.authorUrl;
        link.target = '_blank';
        link.rel = 'noopener noreferrer nofollow';
        link.textContent = review.author;
        author.append(link);
      } else {
        author.textContent = review.author;
      }
      const meta = document.createElement('div');
      meta.className = 'review-person-meta';
      meta.textContent = ['Google review', review.when].filter(Boolean).join(' · ');

      const person = document.createElement('div');
      person.className = 'review-person';
      const avatar = document.createElement('span');
      avatar.className = 'review-avatar';
      avatar.setAttribute('aria-hidden', 'true');
      avatar.textContent = review.author.split(/\s+/).filter(Boolean).slice(0, 2).map(part => part[0]).join('');
      const identity = document.createElement('div');
      identity.append(author, meta);
      person.append(avatar, identity);
      footer.append(person);
      const top = document.createElement('div');
      top.className = 'review-spotlight-top';
      const source = document.createElement('span');
      source.className = 'review-source';
      source.textContent = 'Google review';
      const logo = root.querySelector<HTMLTemplateElement>('[data-google-mark]');
      if (logo) source.prepend(logo.content.cloneNode(true));
      const quoteMark = document.createElement('span');
      quoteMark.className = 'review-quote-mark';
      quoteMark.setAttribute('aria-hidden', 'true');
      quoteMark.textContent = '“';
      top.append(starLine, source);
      item.append(top, quoteMark, text, footer);
      list.append(item);
    }

    const parts: string[] = [];
    if (typeof feed.rating === 'number') parts.push(`${feed.rating.toFixed(1)} out of 5`);
    if (typeof feed.count === 'number' && feed.count > 0) {
      parts.push(`${feed.count} Google review${feed.count === 1 ? '' : 's'}`);
    }
    summary.textContent = parts.join(' · ');
    const overallStars = root.querySelector('[data-gr-stars]');
    if (overallStars && typeof feed.rating === 'number') overallStars.textContent = stars(feed.rating);
    summary.hidden = parts.length === 0;

    root.hidden = false;

    // Keep owner-supplied quotes as a fallback, but show a matching live
    // review only once. A feed that omits a curated quote must not erase it.
    const normalize = (value: string) => value.normalize('NFKC').replace(/\s+/g, ' ').trim().toLowerCase();
    document.querySelectorAll<HTMLElement>('[data-curated-review]').forEach((card) => {
      card.hidden = feed.reviews!.some((review) =>
        normalize(review.author) === normalize(card.dataset.reviewAuthor || '') &&
        normalize(review.text) === normalize(card.dataset.reviewText || '')
      );
    });

    // The page's "nothing here yet" copy would now be untrue. Hide it and
    // swap the lede for the accurate one.
    document.querySelectorAll<HTMLElement>('[data-hide-when-google-reviews]').forEach((el) => {
      el.hidden = true;
      el.style.display = 'none';
    });
    document.querySelectorAll<HTMLElement>('[data-lede-google]').forEach((el) => {
      el.textContent = el.dataset.ledeGoogle || el.textContent;
    });
  }

  function loadReviews() {
    if (!document.querySelector('[data-google-reviews]')) return;
    getGoogleReviewFeed()
      .then((feed: Feed | null) => {
        if (feed) render(feed);
      })
      .catch(() => {
        /* Leave the page as the honest default. */
      });
  }
  loadReviews();
  document.addEventListener('astro:page-load', loadReviews);
</script>
