---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { site, telHref } from '../data/site';
const guides=(await getCollection('guides',({data})=>data.published)).sort((a,b)=>a.data.order-b.data.order);
const starters=guides.flatMap(g=>g.data.faq.slice(0,1).map(item=>item.question)).slice(0,4);
const consultantPaths=[['Need new windows','Help me figure out whether I actually need replacement windows.'],['Compare replacement methods','What is the difference between insert and full-frame replacement?'],['Figure out cost','What information do you need to estimate window replacement cost?'],['Choose glass','What glass options make sense for a Pacific Northwest home?'],['New construction','What should I know about windows for a new-construction project?']];
---
<BaseLayout title="Ask a window question" description="Talk with Clearview's project consultant about window replacement, glass, installation, and project planning in Clark County." path="/ask" crumbs={[{name:'Ask',href:'/ask'}]}>
<main class="ask-page">
  <section class="ask-app" data-reveal aria-label="Clearview project consultant">
    <header class="ask-app-head">
      <div class="ask-identity"><div class="ask-avatar" aria-hidden="true">C</div><div><strong>Clearview Consultant</strong><span>Window project guidance</span></div></div>
      <div class="ask-head-actions"><button type="button" data-ask-copy hidden aria-label="Copy conversation">Copy</button><button type="button" data-ask-new hidden>New chat</button></div>
    </header>

    <div class="ask-project-wrap">
      <button type="button" class="ask-project-toggle" data-project-toggle aria-expanded="false"><span class="ask-project-icon">⌁</span><span><strong>Project details</strong><small data-project-status>Optional — add details to make answers more specific</small></span><span class="ask-chevron" aria-hidden="true">⌄</span></button>
      <div class="ask-project-body" data-project-body hidden>
        <div class="ask-choice-group"><span class="ask-choice-label">Home type</span><div class="ask-choices" data-choice-group="homeType"><button type="button" data-choice="Existing home">Existing home</button><button type="button" data-choice="New construction">New construction</button><button type="button" data-choice="Not sure">Not sure</button></div></div>
        <div class="ask-choice-group"><span class="ask-choice-label">Approximate openings</span><div class="ask-choices" data-choice-group="count"><button type="button" data-choice="1">1</button><button type="button" data-choice="2–5">2–5</button><button type="button" data-choice="6–10">6–10</button><button type="button" data-choice="10+">10+</button><button type="button" data-choice="Not sure">Not sure</button></div></div>
        <div class="ask-choice-group"><span class="ask-choice-label">Main concern</span><div class="ask-choices" data-choice-group="concern"><button type="button" data-choice="Drafts">Drafts</button><button type="button" data-choice="Fogged glass">Fogged glass</button><button type="button" data-choice="Damage">Damage</button><button type="button" data-choice="Energy">Energy</button><button type="button" data-choice="Appearance">Appearance</button><button type="button" data-choice="Other">Other</button></div></div>
      </div>
    </div>

    <div class="ask-scroll" data-ask-scroll>
      <div class="ask-transcript" data-transcript role="log" aria-live="polite">
        <div class="ask-welcome" data-welcome>
          <div class="ask-welcome-mark" aria-hidden="true">C</div>
          <h1>What are you working on?</h1>
          <p>Ask about replacement windows, installation, glass, cost, or a new-construction project. You can also show me a photo.</p>
          <div class="ask-starters" data-starters>{starters.map(q=><button type="button" class="ask-chip" data-starter>{q}</button>)}</div>
          <div class="ask-paths" data-paths>{consultantPaths.map(([label,prompt])=><button type="button" class="ask-path" data-path-prompt={prompt}><span>{label}</span><span aria-hidden="true">→</span></button>)}</div>
        </div>
      </div>
      <button type="button" class="ask-scroll-bottom" data-scroll-bottom hidden aria-label="Scroll to latest message">↓</button>
    </div>

    <div class="ask-status" data-ask-status aria-live="polite"></div>
    <div class="ask-next" data-ask-next hidden><span class="ask-next-label">Continue with</span><div class="ask-next-actions" data-ask-next-actions></div></div>
    <div class="ask-handoff" data-ask-handoff hidden><div><strong>Ready to price the project?</strong><span>Your project details can carry into the estimate form. The conversation stays in this chat.</span></div><a class="ask-handoff-btn" href="/estimate" data-ask-handoff-link>Start estimate</a></div>

    <form class="ask-composer" data-ask-form>
      <div class="ask-attachment" data-ask-photo-preview hidden><img data-ask-photo-thumb width="52" height="52" alt="Photo you attached"/><button type="button" data-ask-photo-remove aria-label="Remove photo">×</button></div>
      <div class="ask-composer-box">
        <label class="ask-add" for="ask-photo-input" title="Add a photo"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 7.5h3l1.4-2h5.2l1.4 2H19a2 2 0 0 1 2 2V18a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V9.5a2 2 0 0 1 2-2Z"/><circle cx="12" cy="13.5" r="3.2"/></svg><span>Add photo</span></label>
        <input id="ask-photo-input" data-ask-photo-input type="file" accept="image/png,image/jpeg,image/webp" class="visually-hidden"/>
        <textarea id="ask-input" data-ask-input rows="1" maxlength="500" placeholder="Message Clearview Consultant…" aria-label="Message Clearview Consultant" required></textarea>
        <button type="submit" class="ask-send" data-ask-submit aria-label="Send message"><span>↑</span></button>
      </div>
      <div class="ask-composer-meta"><span>Enter to send · Shift+Enter for new line</span><span data-ask-count>0 / 500</span></div>
      <p class="ask-photo-hint">Photos are optional · JPG, PNG, or WEBP up to 8MB</p>
    </form>
  </section>
  <div class="ask-mobile-human"><a href={telHref()}>Prefer to talk? <strong>Call Mark · {site.phoneDisplay}</strong></a><a href="/estimate">Get a free estimate →</a></div>
</main>
<noscript><section class="section"><div class="wrap"><h2>JavaScript is required for the consultant.</h2><p><a href="/estimate">Request an estimate</a> or call <a href={telHref()}>{site.phoneDisplay}</a>.</p></div></section></noscript>
</BaseLayout>
<script>
type Message={role:'user'|'assistant';content:string};
function initAsk(){
const form=document.querySelector('[data-ask-form]');if(!(form instanceof HTMLFormElement)||form.dataset.bound==='true')return;form.dataset.bound='true';
const input=document.querySelector('[data-ask-input]'),submitBtn=document.querySelector('[data-ask-submit]'),transcript=document.querySelector('[data-transcript]'),scrollEl=document.querySelector('[data-ask-scroll]'),scrollBottom=document.querySelector('[data-scroll-bottom]'),errorEl=document.querySelector('[data-ask-status]'),starters=document.querySelector('[data-starters]'),photoInput=document.querySelector('[data-ask-photo-input]'),photoPreview=document.querySelector('[data-ask-photo-preview]'),photoThumb=document.querySelector('[data-ask-photo-thumb]'),photoRemove=document.querySelector('[data-ask-photo-remove]'),handoff=document.querySelector('[data-ask-handoff]'),handoffLink=document.querySelector('[data-ask-handoff-link]'),next=document.querySelector('[data-ask-next]'),nextActions=document.querySelector('[data-ask-next-actions]'),count=document.querySelector('[data-ask-count]'),projectBody=document.querySelector('[data-project-body]'),projectToggle=document.querySelector('[data-project-toggle]'),projectStatus=document.querySelector('[data-project-status]'),newBtn=document.querySelector('[data-ask-new]'),copyBtn=document.querySelector('[data-ask-copy]'),welcome=document.querySelector('[data-welcome]');
if(!(input instanceof HTMLTextAreaElement)||!(transcript instanceof HTMLElement)||!(scrollEl instanceof HTMLElement))return;const conversation:Message[]=[];let attachedImage:string|null=null;let photoGeneration=0;let lastAnswer='';const project:Record<string,string>={};let controller:AbortController|null=null;
function setStatus(m:string){if(errorEl instanceof HTMLElement)errorEl.textContent=m}
function clearPhoto(){photoGeneration++;attachedImage=null;if(photoInput instanceof HTMLInputElement)photoInput.value='';if(photoPreview instanceof HTMLElement)photoPreview.hidden=true}
function updateProjectStatus(){const n=Object.keys(project).length;if(projectStatus instanceof HTMLElement)projectStatus.textContent=n?`${n} detail${n===1?'':'s'} in this chat`:'Optional — add details to make answers more specific'}
function scrollLatest(smooth=true){requestAnimationFrame(()=>scrollEl.scrollTo({top:scrollEl.scrollHeight,behavior:smooth?'smooth':'auto'}))}
function resizeComposer(){input.style.height='auto';input.style.height=Math.min(input.scrollHeight,160)+'px'}
async function resize(file:File){const b=await createImageBitmap(file),max=1400,s=Math.min(1,max/Math.max(b.width,b.height)),c=document.createElement('canvas');c.width=Math.round(b.width*s);c.height=Math.round(b.height*s);const x=c.getContext('2d');if(!x)throw new Error('Could not read that image.');x.drawImage(b,0,0,c.width,c.height);b.close();return c.toDataURL('image/jpeg',.78)}
if(photoInput instanceof HTMLInputElement)photoInput.addEventListener('change',async()=>{const f=photoInput.files?.[0];if(!f)return;photoGeneration++;const g=photoGeneration;if(!['image/jpeg','image/png','image/webp'].includes(f.type)){setStatus('Please choose a JPG, PNG, or WebP photo.');clearPhoto();return}if(f.size>8*1024*1024){setStatus('That photo is too large — choose one under 8MB.');clearPhoto();return}try{const r=await resize(f);if(g!==photoGeneration)return;attachedImage=r;if(photoThumb instanceof HTMLImageElement)photoThumb.src=r;if(photoPreview instanceof HTMLElement)photoPreview.hidden=false;setStatus('')}catch{if(g===photoGeneration){setStatus('Could not read that photo — try another file.');clearPhoto()}}});if(photoRemove instanceof HTMLElement)photoRemove.addEventListener('click',clearPhoto);
function escapeHtml(value:string){return value.replace(/[&<>\"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','\\':'&#92;','"':'&quot;'}[c]||c))}
function formatInline(value:string){return value.replace(/\*\*(.+?)\*\*/g,'<strong>$1</strong>').replace(/`([^`]+)`/g,'<code>$1</code>')}
function formatAnswer(value:string){const lines=value.trim().split(/\r?\n/),out:string[]=[];let list:string[]=[];const flush=()=>{if(list.length){out.push(`<ul>${list.map(v=>`<li>${v}</li>`).join('')}</ul>`);list=[]}};for(const raw of lines){const line=raw.trim();if(!line){flush();continue}if(/^[-*]\s+/.test(line)){list.push(formatInline(escapeHtml(line.replace(/^[-*]\s+/,''))));continue}flush();if(/^#{2,4}\s+/.test(line))out.push(`<h3>${formatInline(escapeHtml(line.replace(/^#{2,4}\s+/,'')))}</h3>`);else out.push(`<p>${formatInline(escapeHtml(line))}</p>`)}flush();return out.join('')}
function append(role:'user'|'assistant',content:string,sources?:{title:string;url:string}[],photo?:string|null,meta?:string){if(!(transcript instanceof HTMLElement))return;welcome?.remove();const b=document.createElement('article');b.className=`ask-msg ask-msg-${role}`;if(photo){const i=document.createElement('img');i.className='ask-msg-photo';i.src=photo;i.alt='Photo you attached';b.append(i)}if(role==='assistant'){const body=document.createElement('div');body.className='ask-answer';body.innerHTML=formatAnswer(content);b.append(body);const actions=document.createElement('div');actions.className='ask-msg-actions';const c=document.createElement('button');c.type='button';c.textContent='Copy';c.addEventListener('click',()=>navigator.clipboard?.writeText(content));actions.append(c);b.append(actions)}else{const p=document.createElement('p');p.textContent=content;b.append(p)}if(meta){const m=document.createElement('div');m.className='ask-answer-meta';m.textContent=meta;b.append(m)}if(sources?.length){const s=document.createElement('div');s.className='ask-sources';sources.slice(0,4).forEach(v=>{const a=document.createElement('a');a.href=v.url;a.textContent=v.title;a.target='_blank';a.rel='noopener noreferrer';s.append(a)});b.append(s)}transcript.append(b);scrollLatest()}
let typing:HTMLElement|null=null;function showTyping(){if(!(transcript instanceof HTMLElement))return;typing=document.createElement('article');typing.className='ask-msg ask-msg-assistant ask-msg-typing';typing.innerHTML='<span></span><span></span><span></span>';transcript.append(typing);scrollLatest()};function hideTyping(){typing?.remove();typing=null}
function renderNext(items:{label?:string;prompt:string}[]=[]){if(!(next instanceof HTMLElement)||!(nextActions instanceof HTMLElement))return;nextActions.replaceChildren();items.slice(0,3).forEach(item=>{if(!item?.prompt)return;const b=document.createElement('button');b.type='button';b.textContent=(item.label||item.prompt).slice(0,100);b.addEventListener('click',()=>ask(item.prompt));nextActions.append(b)});next.hidden=!nextActions.children.length}
function buildHandoff(){const params=new URLSearchParams();if(project.homeType)params.set('home_type',project.homeType);if(project.count)params.set('openings',project.count);if(project.concern)params.set('concern',project.concern);return params.toString()?`/estimate?${params.toString()}`:'/estimate'}
function showHandoff(){if(!(handoff instanceof HTMLElement)||!(handoffLink instanceof HTMLAnchorElement))return;handoffLink.href=buildHandoff();handoff.hidden=false}
function copyConversation(){const text=conversation.map(m=>`${m.role==='user'?'You':'Clearview'}: ${m.content}`).join('\n\n');if(!text)return;navigator.clipboard?.writeText(text).then(()=>{if(copyBtn instanceof HTMLButtonElement){const old=copyBtn.textContent;copyBtn.textContent='Copied';setTimeout(()=>copyBtn.textContent=old||'Copy',1400)}})}
function reset(){controller?.abort();controller=null;conversation.length=0;lastAnswer='';Object.keys(project).forEach(k=>delete project[k]);document.querySelectorAll('[data-choice]').forEach(b=>b.classList.remove('is-selected'));updateProjectStatus();hideTyping();transcript.innerHTML='';if(welcome)transcript.append(welcome);if(next instanceof HTMLElement)next.hidden=true;if(handoff instanceof HTMLElement)handoff.hidden=true;if(newBtn instanceof HTMLElement)newBtn.hidden=true;if(copyBtn instanceof HTMLElement)copyBtn.hidden=true;clearPhoto();input.value='';resizeComposer();if(count instanceof HTMLElement)count.textContent='0 / 500';setStatus('');scrollLatest(false);input.focus()}
async function ask(question:string){const q=question.trim();if(!q||controller)return;setStatus('');if(newBtn instanceof HTMLElement)newBtn.hidden=false;if(copyBtn instanceof HTMLElement)copyBtn.hidden=false;const photo=attachedImage;append('user',q,undefined,photo);const history=conversation.slice(-6);conversation.push({role:'user',content:q});clearPhoto();if(submitBtn instanceof HTMLButtonElement){submitBtn.disabled=true;submitBtn.setAttribute('aria-label','Stop generating');submitBtn.innerHTML='<span>■</span>';submitBtn.classList.add('is-stop')}input.disabled=true;showTyping();controller=new AbortController();try{const body:Record<string,unknown>={message:q,history,project};if(photo)body.image=photo;const r=await fetch('/ask/api/chat',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify(body),signal:controller.signal});const result=await r.json().catch(()=>({}));if(!r.ok)throw new Error(result.error||'Something went wrong.');hideTyping();const answer=result.answer||'I did not get an answer for that.';lastAnswer=answer;const meta=[result.grounding==='guide'?'Guide-backed':result.grounding==='general'?'General guidance':null,result.photoAnalyzed?'Photo reviewed':null].filter(Boolean).join(' · ');append('assistant',answer,result.sources,undefined,meta);conversation.push({role:'assistant',content:answer});if(result.project&&typeof result.project==='object'){for(const key of ['homeType','count','concern'])if(typeof result.project[key]==='string')project[key]=result.project[key];document.querySelectorAll('[data-choice-group]').forEach(g=>{const key=g.getAttribute('data-choice-group'),value=key?project[key]:'';g.querySelectorAll('[data-choice]').forEach(b=>{if(b instanceof HTMLButtonElement)b.classList.toggle('is-selected',b.dataset.choice===value)})});updateProjectStatus()}renderNext(Array.isArray(result.suggestions)?result.suggestions:[]);if(result.estimateReady||Object.keys(project).length>=2)showHandoff()}catch(e){hideTyping();if(e instanceof DOMException&&e.name==='AbortError')setStatus('Generation stopped.');else setStatus(e instanceof Error?e.message:'Something went wrong. Try again.')}finally{controller=null;if(submitBtn instanceof HTMLButtonElement){submitBtn.disabled=false;submitBtn.setAttribute('aria-label','Send message');submitBtn.innerHTML='<span>↑</span>';submitBtn.classList.remove('is-stop')}input.disabled=false;input.focus();resizeComposer();scrollLatest()}}
document.querySelectorAll('[data-path-prompt]').forEach(e=>e.addEventListener('click',()=>{if(!(e instanceof HTMLButtonElement))return;if(e.dataset.pathPrompt?.includes('show you a photo')){if(photoInput instanceof HTMLInputElement)photoInput.click();return}ask(e.dataset.pathPrompt||'')}));document.querySelectorAll('[data-choice]').forEach(e=>e.addEventListener('click',()=>{if(!(e instanceof HTMLButtonElement))return;const g=e.closest('[data-choice-group]')?.getAttribute('data-choice-group');if(!g)return;project[g]=e.dataset.choice||'';e.parentElement?.querySelectorAll('button').forEach(b=>b.classList.remove('is-selected'));e.classList.add('is-selected');updateProjectStatus();if(Object.keys(project).length>=2&&lastAnswer)showHandoff()}));if(projectToggle instanceof HTMLElement&&projectBody instanceof HTMLElement)projectToggle.addEventListener('click',()=>{const open=projectToggle.getAttribute('aria-expanded')==='true';projectToggle.setAttribute('aria-expanded',String(!open));projectBody.hidden=open});if(newBtn instanceof HTMLElement)newBtn.addEventListener('click',reset);if(copyBtn instanceof HTMLElement)copyBtn.addEventListener('click',copyConversation);if(starters instanceof HTMLElement)starters.querySelectorAll('[data-starter]').forEach(b=>b.addEventListener('click',()=>{if(b instanceof HTMLButtonElement)ask(b.textContent||'')}));form.addEventListener('submit',e=>{e.preventDefault();if(controller){controller.abort();return}const q=input.value.trim();if(!q)return;input.value='';if(count instanceof HTMLElement)count.textContent='0 / 500';resizeComposer();ask(q)});input.addEventListener('input',()=>{resizeComposer();if(count instanceof HTMLElement)count.textContent=`${input.value.length} / 500`});input.addEventListener('keydown',e=>{if(e.key==='Enter'&&!e.shiftKey){e.preventDefault();form.requestSubmit()}});if(scrollBottom instanceof HTMLButtonElement)scrollBottom.addEventListener('click',()=>scrollLatest());scrollEl.addEventListener('scroll',()=>{if(scrollBottom instanceof HTMLElement)scrollBottom.hidden=scrollEl.scrollHeight-scrollEl.scrollTop-scrollEl.clientHeight<220});resizeComposer();updateProjectStatus();
}initAsk();document.addEventListener('astro:page-load',initAsk);
</script>
<style>
.ask-page{background:var(--paper);padding:0 clamp(.75rem,2vw,2rem) clamp(2rem,5vw,4rem)}
.ask-app{width:min(960px,100%);height:calc(100dvh - 86px);min-height:620px;margin:0 auto;display:grid;grid-template-rows:auto auto minmax(0,1fr) auto auto auto;overflow:hidden;background:var(--paper-raised);border-inline:1px solid var(--line);box-shadow:0 8px 40px rgb(0 0 0 / .08)}
.ask-app-head{min-height:64px;padding:.7rem 1rem;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid var(--line);background:color-mix(in srgb,var(--paper-raised) 94%,transparent);position:relative;z-index:3}
.ask-identity{display:flex;align-items:center;gap:.65rem}.ask-identity>div:last-child{display:grid;gap:.05rem}.ask-identity strong{font-size:.95rem}.ask-identity span{font-size:.72rem;color:var(--ink-faint)}.ask-avatar,.ask-welcome-mark{display:grid;place-items:center;border-radius:50%;background:var(--black);color:var(--on-dark);font-weight:700}.ask-avatar{width:34px;height:34px;font-size:.8rem}.ask-head-actions{display:flex;gap:.35rem}.ask-head-actions button{border:0;background:transparent;color:var(--ink-soft);font:inherit;font-size:.8rem;padding:.45rem .6rem;border-radius:999px;cursor:pointer}.ask-head-actions button:hover{background:var(--paper-sunk)}
.ask-project-wrap{border-bottom:1px solid var(--line);background:var(--paper-raised)}.ask-project-toggle{width:100%;border:0;background:transparent;color:inherit;padding:.55rem 1rem;display:grid;grid-template-columns:auto 1fr auto;gap:.55rem;align-items:center;text-align:left;cursor:pointer}.ask-project-icon{width:27px;height:27px;border:1px solid var(--line-strong);border-radius:50%;display:grid;place-items:center;color:var(--ink-faint)}.ask-project-toggle strong{font-size:.76rem}.ask-project-toggle small{display:block;font-size:.68rem;color:var(--ink-faint);margin-top:.08rem}.ask-chevron{font-size:1rem;color:var(--ink-faint);transition:transform .2s}.ask-project-toggle[aria-expanded=true] .ask-chevron{transform:rotate(180deg)}.ask-project-body{padding:.2rem 1rem .8rem;display:grid;gap:.7rem;border-top:1px solid var(--line)}.ask-project-body[hidden]{display:none}.ask-choice-group{display:flex;align-items:center;gap:.5rem;flex-wrap:wrap}.ask-choice-label{font-size:.68rem;font-weight:700;color:var(--ink-faint);min-width:8.5rem}.ask-choices{display:flex;flex-wrap:wrap;gap:.3rem}.ask-choices button,.ask-next-actions button{border:1px solid var(--line-strong);background:transparent;color:inherit;border-radius:999px;padding:.32rem .58rem;font:inherit;font-size:.7rem;cursor:pointer}.ask-choices button.is-selected{background:var(--accent-wash);border-color:var(--accent);font-weight:600}
