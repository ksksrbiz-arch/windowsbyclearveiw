---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { site, telHref } from '../data/site';
const guides=(await getCollection('guides',({data})=>data.published)).sort((a,b)=>a.data.order-b.data.order);
const starters=guides.flatMap(g=>g.data.faq.slice(0,1).map(item=>item.question)).slice(0,5);
const consultantPaths=[['Need new windows','Help me figure out whether I actually need replacement windows.'],['Compare replacement methods','What is the difference between insert and full-frame replacement?'],['Figure out cost','What information do you need to estimate window replacement cost?'],['Choose glass','What glass options make sense for a Pacific Northwest home?'],['New construction','What should I know about windows for a new-construction project?'],['Show me a photo','I want to show you a photo of my window.']];
---
<BaseLayout title="Ask a window question" description="Talk with Clearview's project consultant about window replacement, glass, installation, and project planning in Clark County." path="/ask" crumbs={[{name:'Ask',href:'/ask'}]}>
<section class="page-hero ask-hero"><div class="wrap"><p class="kicker">Clearview project consultant</p><h1>Start with the question you actually have.</h1><p class="lede">Get practical guidance on replacement windows, installation methods, glass, cost, and new construction. Ask in plain English, or show us the window.</p><div class="ask-trust-row"><span>Guide-backed answers</span><span>Photo analysis</span><span>Project handoff</span></div></div></section>
<noscript><section class="section"><div class="wrap ask-noscript"><p class="kicker">JavaScript required</p><h2>This consultant needs JavaScript.</h2><p>For a written answer, <a href="/estimate">request an estimate</a> or call <a href={telHref()}>{site.phoneDisplay}</a>.</p></div></section></noscript>
<section class="section ask-section"><div class="wrap ask-shell" data-reveal><div class="ask-panel">
<div class="ask-panel-head"><div><p class="rule-label">Project consultant</p><h2>What are you trying to figure out?</h2></div><button type="button" class="ask-new" data-ask-new hidden>New conversation</button></div>
<div class="ask-project"><button type="button" class="ask-project-toggle" data-project-toggle aria-expanded="true"><span><strong>Project snapshot</strong><small data-project-status>Give the consultant a little context</small></span><span aria-hidden="true">⌃</span></button><div class="ask-project-body" data-project-body>
<div class="ask-choice-group"><span class="ask-choice-label">Home type</span><div class="ask-choices" data-choice-group="homeType"><button type="button" data-choice="Existing home">Existing home</button><button type="button" data-choice="New construction">New construction</button><button type="button" data-choice="Not sure">Not sure</button></div></div>
<div class="ask-choice-group"><span class="ask-choice-label">Approximate openings</span><div class="ask-choices" data-choice-group="count"><button type="button" data-choice="1">1</button><button type="button" data-choice="2–5">2–5</button><button type="button" data-choice="6–10">6–10</button><button type="button" data-choice="10+">10+</button><button type="button" data-choice="Not sure">Not sure</button></div></div>
<div class="ask-choice-group"><span class="ask-choice-label">Main concern</span><div class="ask-choices" data-choice-group="concern"><button type="button" data-choice="Drafts">Drafts</button><button type="button" data-choice="Fogged glass">Fogged glass</button><button type="button" data-choice="Damage">Damage</button><button type="button" data-choice="Energy">Energy</button><button type="button" data-choice="Appearance">Appearance</button><button type="button" data-choice="Other">Other</button></div></div></div></div>
<div class="ask-paths" data-paths>{consultantPaths.map(([label,prompt])=><button type="button" class="ask-path" data-path-prompt={prompt}><span>{label}</span><span aria-hidden="true">→</span></button>)}</div>
<div class="ask-transcript" data-transcript role="log" aria-live="polite"><div class="ask-msg ask-msg-assistant"><p>Hi — I can help you work through the window decision. Add any project details you know, then choose a starting point or ask in your own words.</p></div></div>
{starters.length>0&&<div class="ask-starters" data-starters><span class="ask-choice-label">Or try a common question</span>{starters.map(q=><button type="button" class="ask-chip" data-starter>{q}</button>)}</div>}<button type="button" class="ask-starters-toggle" data-ask-starters-toggle hidden>Suggested questions</button>
<div class="ask-next" data-ask-next hidden><span class="ask-next-label">Useful next questions</span><div class="ask-next-actions" data-ask-next-actions></div></div>
<p class="ask-error" data-ask-error role="alert"></p><div class="ask-handoff" data-ask-handoff hidden><div><strong>Ready to move this project forward?</strong><span>Your project snapshot and the useful parts of this conversation can carry into the estimate form.</span></div><a class="btn btn-secondary" href="/estimate" data-ask-handoff-link>Start estimate →</a></div>
<form class="ask-form" data-ask-form><div class="ask-photo-row"><label class="ask-photo-btn" for="ask-photo-input"><svg viewBox="0 0 20 20" aria-hidden="true"><path d="M4 6.5h2.4l1-1.5h5.2l1 1.5H16a1 1 0 0 1 1 1V15a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V7.5a1 1 0 0 1 1-1Z"/><circle cx="10" cy="11" r="2.6"/></svg>Add a photo</label><input id="ask-photo-input" data-ask-photo-input type="file" accept="image/png,image/jpeg,image/webp" class="visually-hidden"/><div class="ask-photo-preview" data-ask-photo-preview hidden><img data-ask-photo-thumb width="42" height="42" alt="Photo you attached"/><button type="button" class="ask-photo-remove" data-ask-photo-remove aria-label="Remove photo">×</button></div><span class="ask-photo-hint">JPG, PNG, or WEBP · up to 8MB</span></div><div class="ask-input-row"><label class="visually-hidden" for="ask-input">Your question</label><textarea id="ask-input" data-ask-input rows="2" maxlength="500" placeholder="Ask about your windows, project, or budget…" required></textarea><button class="btn btn-primary" type="submit" data-ask-submit>Ask</button></div><div class="ask-composer-meta"><span>Enter to ask · Shift+Enter for a new line</span><span data-ask-count>0 / 500</span></div></form>
</div><aside class="ask-aside"><div class="ask-aside-card"><p class="rule-label">How this works</p><ol class="ask-steps"><li><strong>Ask</strong><span>Describe the problem in your own words.</span></li><li><strong>Understand</strong><span>Get a practical answer backed by Clearview's guides.</span></li><li><strong>Plan</strong><span>Carry useful context into an estimate.</span></li></ol></div><div class="ask-aside-card"><p class="rule-label">Need a human?</p><p class="ask-phone"><a href={telHref()}>{site.phoneDisplay}</a></p><p>Mark can verify what the consultant cannot see from a photo or chat.</p></div></aside></div></section></BaseLayout>
<script>
type Message={role:'user'|'assistant';content:string};
function initAsk(){
const form=document.querySelector('[data-ask-form]');if(!(form instanceof HTMLFormElement)||form.dataset.bound==='true')return;form.dataset.bound='true';
const input=document.querySelector('[data-ask-input]'),submitBtn=document.querySelector('[data-ask-submit]'),transcript=document.querySelector('[data-transcript]'),errorEl=document.querySelector('[data-ask-error]'),starters=document.querySelector('[data-starters]'),startersToggle=document.querySelector('[data-ask-starters-toggle]'),photoInput=document.querySelector('[data-ask-photo-input]'),photoPreview=document.querySelector('[data-ask-photo-preview]'),photoThumb=document.querySelector('[data-ask-photo-thumb]'),photoRemove=document.querySelector('[data-ask-photo-remove]'),handoff=document.querySelector('[data-ask-handoff]'),handoffLink=document.querySelector('[data-ask-handoff-link]'),next=document.querySelector('[data-ask-next]'),nextActions=document.querySelector('[data-ask-next-actions]'),count=document.querySelector('[data-ask-count]'),projectBody=document.querySelector('[data-project-body]'),projectToggle=document.querySelector('[data-project-toggle]'),projectStatus=document.querySelector('[data-project-status]'),newBtn=document.querySelector('[data-ask-new]');
if(!(input instanceof HTMLTextAreaElement)||!(transcript instanceof HTMLElement))return;const conversation:Message[]=[];let attachedImage:string|null=null;let photoGeneration=0;let lastAnswer='';const project:Record<string,string>={};
function showError(m:string){if(errorEl instanceof HTMLElement)errorEl.textContent=m}function clearPhoto(){photoGeneration++;attachedImage=null;if(photoInput instanceof HTMLInputElement)photoInput.value='';if(photoPreview instanceof HTMLElement)photoPreview.hidden=true}
function saveProject(){try{sessionStorage.setItem('clearview:ask-project',JSON.stringify(project))}catch{}const n=Object.keys(project).length;if(projectStatus instanceof HTMLElement)projectStatus.textContent=n?`${n} project detail${n===1?'':'s'} saved for this visit`:'Give the consultant a little context'}
function restoreProject(){try{const saved=JSON.parse(sessionStorage.getItem('clearview:ask-project')||'{}');Object.assign(project,saved)}catch{}document.querySelectorAll('[data-choice-group]').forEach(g=>{const key=g.getAttribute('data-choice-group');const value=key?project[key]:'';g.querySelectorAll('[data-choice]').forEach(b=>{if(b instanceof HTMLButtonElement)b.classList.toggle('is-selected',b.dataset.choice===value)})});saveProject()}
async function resize(file:File){const b=await createImageBitmap(file),max=1024,s=Math.min(1,max/Math.max(b.width,b.height)),c=document.createElement('canvas');c.width=Math.round(b.width*s);c.height=Math.round(b.height*s);const x=c.getContext('2d');if(!x)throw new Error('Could not read that image.');x.drawImage(b,0,0,c.width,c.height);b.close();return c.toDataURL('image/jpeg',.75)}
if(photoInput instanceof HTMLInputElement)photoInput.addEventListener('change',async()=>{const f=photoInput.files?.[0];if(!f)return;photoGeneration++;const g=photoGeneration;if(!['image/jpeg','image/png','image/webp'].includes(f.type)){showError('Please choose a JPG, PNG, or WebP photo.');clearPhoto();return}if(f.size>8*1024*1024){showError('That photo is too large — try one under 8MB.');clearPhoto();return}try{const r=await resize(f);if(g!==photoGeneration)return;attachedImage=r;if(photoThumb instanceof HTMLImageElement)photoThumb.src=r;if(photoPreview instanceof HTMLElement)photoPreview.hidden=false;if(errorEl instanceof HTMLElement)errorEl.textContent=''}catch{if(g===photoGeneration){showError('Could not read that photo — try a different file.');clearPhoto()}}});if(photoRemove instanceof HTMLElement)photoRemove.addEventListener('click',clearPhoto);
function append(role:'user'|'assistant',content:string,sources?:{title:string;url:string}[],photo?:string|null){if(!(transcript instanceof HTMLElement))return;const b=document.createElement('div');b.className=`ask-msg ask-msg-${role}`;if(photo){const i=document.createElement('img');i.className='ask-msg-photo';i.src=photo;i.alt='Photo you attached';b.append(i)}const p=document.createElement('p');p.textContent=content;b.append(p);if(sources?.length){const s=document.createElement('div');s.className='ask-sources';const label=document.createElement('span');label.textContent='Sources';s.append(label);sources.slice(0,4).forEach(v=>{const a=document.createElement('a');a.href=v.url;a.textContent=v.title;s.append(a)});b.append(s)}transcript.append(b);transcript.scrollTop=transcript.scrollHeight}
let typing:HTMLElement|null=null;function showTyping(){if(!(transcript instanceof HTMLElement))return;typing=document.createElement('div');typing.className='ask-msg ask-msg-assistant ask-msg-typing';const p=document.createElement('p');p.textContent='Reviewing your project…';typing.append(p);transcript.append(typing);transcript.scrollTop=transcript.scrollHeight}function hideTyping(){typing?.remove();typing=null}
function renderNext(items:{label?:string;prompt:string}[]=[]){if(!(next instanceof HTMLElement)||!(nextActions instanceof HTMLElement))return;nextActions.replaceChildren();items.slice(0,3).forEach(item=>{const b=document.createElement('button');b.type='button';b.textContent=item.label||item.prompt;b.addEventListener('click',()=>ask(item.prompt));nextActions.append(b)});next.hidden=!items.length}
function buildHandoff(){const parts=[];if(project.homeType)parts.push(`Home type: ${project.homeType}`);if(project.count)parts.push(`Openings: ${project.count}`);if(project.concern)parts.push(`Main concern: ${project.concern}`);if(lastAnswer)parts.push(`Consultant notes: ${lastAnswer.slice(0,500)}`);return parts.join('\n')}
function showHandoff(){if(!(handoff instanceof HTMLElement)||!(handoffLink instanceof HTMLAnchorElement))return;const scope=buildHandoff();if(!scope)return;try{sessionStorage.setItem('clearview:scope',scope)}catch{}handoffLink.href=`/estimate?scope=${encodeURIComponent(scope.slice(0,900))}`;handoff.hidden=false}
function reset(){conversation.length=0;lastAnswer='';Object.keys(project).forEach(k=>delete project[k]);try{sessionStorage.removeItem('clearview:ask-project')}catch{}document.querySelectorAll('[data-choice]').forEach(b=>b.classList.remove('is-selected'));saveProject();transcript.innerHTML='<div class="ask-msg ask-msg-assistant"><p>Hi — I can help you work through the window decision. Add any project details you know, then choose a starting point or ask in your own words.</p></div>';if(next instanceof HTMLElement)next.hidden=true;if(handoff instanceof HTMLElement)handoff.hidden=true;if(newBtn instanceof HTMLElement)newBtn.hidden=true;if(starters instanceof HTMLElement)starters.hidden=false;if(startersToggle instanceof HTMLElement)startersToggle.hidden=true;input.value='';if(count instanceof HTMLElement)count.textContent='0 / 500';clearPhoto();input.focus()}
async function ask(question:string){if(!question.trim())return;if(errorEl instanceof HTMLElement)errorEl.textContent='';if(starters instanceof HTMLElement)starters.hidden=true;if(startersToggle instanceof HTMLElement)startersToggle.hidden=false;if(newBtn instanceof HTMLElement)newBtn.hidden=false;const photo=attachedImage;append('user',question,undefined,photo);const history=conversation.slice(-6);conversation.push({role:'user',content:question});clearPhoto();if(submitBtn instanceof HTMLButtonElement){submitBtn.disabled=true;submitBtn.textContent='Thinking…'}input.disabled=true;showTyping();try{const r=await fetch('/ask/api/chat',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify(photo?{message:question,history,image:photo,project}:{message:question,history,project})});const result=await r.json().catch(()=>({}));if(!r.ok)throw new Error(result.error||'Something went wrong.');hideTyping();const answer=result.answer||'Sorry — I did not get an answer for that.';lastAnswer=answer;append('assistant',answer,result.sources);conversation.push({role:'assistant',content:answer});renderNext(Array.isArray(result.suggestions)?result.suggestions:[]);if(result.estimateReady)showHandoff()}catch(e){hideTyping();showError(e instanceof Error?e.message:'Something went wrong. Try again in a moment.')}finally{hideTyping();if(submitBtn instanceof HTMLButtonElement){submitBtn.disabled=false;submitBtn.textContent='Ask'}input.disabled=false;input.focus()}}
document.querySelectorAll('[data-path-prompt]').forEach(e=>e.addEventListener('click',()=>{if(!(e instanceof HTMLButtonElement))return;if(e.dataset.pathPrompt?.includes('show you a photo')){if(photoInput instanceof HTMLInputElement)photoInput.click();return}ask(e.dataset.pathPrompt||'')}));document.querySelectorAll('[data-choice]').forEach(e=>e.addEventListener('click',()=>{if(!(e instanceof HTMLButtonElement))return;const g=e.closest('[data-choice-group]')?.getAttribute('data-choice-group');if(!g)return;project[g]=e.dataset.choice||'';e.parentElement?.querySelectorAll('button').forEach(b=>b.classList.remove('is-selected'));e.classList.add('is-selected');saveProject();if(Object.keys(project).length>=2&&lastAnswer)showHandoff()}));if(projectToggle instanceof HTMLElement&&projectBody instanceof HTMLElement)projectToggle.addEventListener('click',()=>{const open=projectToggle.getAttribute('aria-expanded')==='true';projectToggle.setAttribute('aria-expanded',String(!open));projectBody.hidden=open});if(newBtn instanceof HTMLElement)newBtn.addEventListener('click',reset);if(starters instanceof HTMLElement)starters.querySelectorAll('[data-starter]').forEach(b=>b.addEventListener('click',()=>{if(b instanceof HTMLButtonElement)ask(b.textContent||'')}));if(startersToggle instanceof HTMLElement&&starters instanceof HTMLElement)startersToggle.addEventListener('click',()=>{starters.hidden=false;startersToggle.hidden=true});form.addEventListener('submit',e=>{e.preventDefault();const q=input.value.trim();if(!q)return;input.value='';if(count instanceof HTMLElement)count.textContent='0 / 500';ask(q)});input.addEventListener('input',()=>{if(count instanceof HTMLElement)count.textContent=`${input.value.length} / 500`});input.addEventListener('keydown',e=>{if(e.key==='Enter'&&!e.shiftKey){e.preventDefault();form.requestSubmit()}});restoreProject();
}initAsk();document.addEventListener('astro:page-load',initAsk);
</script>
<style>
.ask-hero .lede{max-width:48rem}.ask-trust-row{display:flex;gap:.5rem;flex-wrap:wrap;margin-top:var(--space-m);font-size:var(--step--2);color:var(--ink-soft)}.ask-trust-row span{padding:.35rem .65rem;border:1px solid var(--line);border-radius:999px;background:var(--paper-raised)}.ask-shell{display:grid;grid-template-columns:minmax(0,1fr) 18rem;gap:var(--space-xl);align-items:start}.ask-panel{border:1px solid var(--line);border-radius:var(--radius-lg);background:var(--paper-raised);padding:var(--space-m);display:grid;gap:var(--space-s)}.ask-panel-head{display:flex;justify-content:space-between;gap:var(--space-s);align-items:start}.ask-panel-head h2{margin:.15rem 0 0;font-size:var(--step-2)}.ask-new{border:1px solid var(--line-strong);background:transparent;border-radius:999px;padding:.4rem .75rem;cursor:pointer;font-size:var(--step--2)}.ask-project{border:1px solid var(--line);border-radius:var(--radius);background:var(--paper-sunk)}.ask-project-toggle{width:100%;display:flex;justify-content:space-between;text-align:left;border:0;background:transparent;padding:var(--space-s);cursor:pointer;color:inherit}.ask-project-toggle span:first-child{display:grid;gap:.15rem}.ask-project-toggle small{color:var(--ink-faint);font-size:var(--step--2)}.ask-project-body{padding:0 var(--space-s) var(--space-s);display:grid;gap:var(--space-s)}.ask-project-body[hidden]{display:none}.ask-choice-group{display:grid;gap:.4rem}.ask-choice-label{font-size:var(--step--2);font-weight:600;color:var(--ink-soft)}.ask-choices{display:flex;flex-wrap:wrap;gap:.35rem}.ask-choices button,.ask-next-actions button{border:1px solid var(--line-strong);background:var(--paper-raised);border-radius:999px;padding:.42rem .7rem;font:inherit;font-size:var(--step--2);cursor:pointer}.ask-choices button.is-selected{border-color:var(--accent);background:var(--accent-wash);color:var(--accent-ink);font-weight:600}.ask-paths{display:grid;grid-template-columns:repeat(3,1fr);gap:.5rem}.ask-path{display:flex;justify-content:space-between;gap:.5rem;text-align:left;border:1px solid var(--line);background:transparent;border-radius:var(--radius);padding:.75rem .8rem;font:inherit;font-size:var(--step--1);cursor:pointer}.ask-path:hover,.ask-next-actions button:hover,.ask-chip:hover{background:var(--paper-sunk)}.ask-transcript{display:grid;gap:var(--space-s);max-height:36rem;overflow-y:auto;padding:.25rem;scrollbar-gutter:stable}.ask-msg{max-width:40rem;padding:var(--space-xs) var(--space-s);border-radius:var(--radius);font-size:var(--step--1);line-height:1.55}.ask-msg p{margin:0;white-space:pre-wrap}.ask-msg-assistant{background:var(--paper-sunk);justify-self:start}.ask-msg-user{background:var(--accent-wash);justify-self:end}.ask-sources{margin-top:.65rem;padding-top:.55rem;border-top:1px solid var(--line);display:flex;gap:.4rem;flex-wrap:wrap;align-items:center;font-size:var(--step--2);color:var(--ink-faint)}.ask-sources span{font-weight:700;text-transform:uppercase;letter-spacing:.06em}.ask-sources a{padding:.2rem .45rem;border:1px solid var(--line);border-radius:999px;text-decoration:none}.ask-msg-photo{display:block;width:100%;max-width:14rem;aspect-ratio:4/3;object-fit:cover;border-radius:var(--radius);margin-bottom:var(--space-2xs)}.ask-starters{display:flex;flex-wrap:wrap;gap:.4rem;align-items:center}.ask-starters[hidden],.ask-starters-toggle[hidden],.ask-next[hidden],.ask-handoff[hidden]{display:none}.ask-chip{border:1px solid var(--line-strong);border-radius:999px;padding:.4rem .7rem;background:transparent;cursor:pointer;text-align:left;font-size:var(--step--2)}.ask-starters-toggle{border:0;background:transparent;padding:0;color:var(--ink-soft);text-decoration:underline;cursor:pointer;justify-self:start;font-size:var(--step--2)}.ask-next{border-top:1px solid var(--line);padding-top:var(--space-s);display:grid;gap:.5rem}.ask-next-label{font-size:var(--step--2);font-weight:700;color:var(--ink-faint);text-transform:uppercase;letter-spacing:.08em}.ask-next-actions{display:flex;flex-wrap:wrap;gap:.4rem}.ask-next-actions button{background:transparent}.ask-error{color:var(--danger);border-left:2px solid var(--danger);padding-left:var(--space-2xs);margin:0}.ask-error:empty{display:none}.ask-handoff{display:flex;align-items:center;justify-content:space-between;gap:var(--space-s);padding:var(--space-s);border:1px solid var(--accent);border-radius:var(--radius);background:var(--accent-wash)}.ask-handoff>div{display:grid;gap:.15rem}.ask-handoff span{font-size:var(--step--2);color:var(--ink-soft)}.ask-form{display:grid;gap:.45rem;border-top:1px solid var(--line);padding-top:var(--space-s)}.ask-input-row{display:flex;gap:var(--space-xs);align-items:end}.ask-form textarea{flex:1;resize:vertical;border:1px solid var(--line-strong);border-radius:var(--radius);padding:.7rem;font:inherit;font-size:var(--step-0)}.ask-photo-row{display:flex;align-items:center;gap:.45rem;flex-wrap:wrap}.ask-photo-btn{display:inline-flex;align-items:center;gap:.4rem;border:1px dashed var(--line-strong);border-radius:var(--radius);padding:.45rem .75rem;font-size:var(--step--2);font-weight:500;color:var(--ink-soft);cursor:pointer}.ask-photo-btn svg{width:1rem;height:1rem;fill:none;stroke:currentColor;stroke-width:1.4}.ask-photo-hint,.ask-composer-meta{font-size:var(--step--2);color:var(--ink-faint)}.ask-photo-preview{display:flex;align-items:center;gap:.35rem}.ask-photo-preview img{width:2.6rem;height:2.6rem;object-fit:cover;border-radius:var(--radius);border:1px solid var(--line)}.ask-photo-remove{border:1px solid var(--line-strong);background:transparent;border-radius:999px;width:1.5rem;height:1.5rem;cursor:pointer}.ask-composer-meta{display:flex;justify-content:space-between;gap:1rem}.ask-aside{display:grid;gap:var(--space-s)}.ask-aside-card{border-left:1px solid var(--line);padding-left:var(--space-l)}.ask-phone a{font-size:var(--step-2);font-weight:600}.ask-steps{list-style:none;padding:0;margin:0;display:grid;gap:var(--space-s)}.ask-steps li{display:grid;gap:.15rem}.ask-steps span{font-size:var(--step--2);color:var(--ink-faint)}.ask-noscript{max-width:40rem;padding:var(--space-l);background:var(--paper-raised);border:1px solid var(--line);border-left:3px solid var(--accent);border-radius:var(--radius-lg)}@media(max-width:900px){.ask-shell{grid-template-columns:1fr}.ask-aside{grid-template-columns:1fr 1fr}.ask-aside-card{border-left:0;border-top:1px solid var(--line);padding-left:0;padding-top:var(--space-m)}}@media(max-width:700px){.ask-paths{grid-template-columns:1fr 1fr}.ask-aside{grid-template-columns:1fr}.ask-transcript{max-height:48vh}.ask-handoff{align-items:stretch;flex-direction:column}.ask-handoff .btn{width:100%;text-align:center}}@media(max-width:520px){.ask-paths{grid-template-columns:1fr}.ask-panel{padding:var(--space-s)}.ask-input-row{display:grid;grid-template-columns:1fr}.ask-input-row .btn{width:100%}.ask-composer-meta span:first-child{display:none}}
</style>