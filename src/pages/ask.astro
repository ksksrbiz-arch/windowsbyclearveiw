.ask-msg{width:fit-content;max-width:min(680px,88%);font-size:.92rem;line-height:1.62;animation:ask-in .18s ease-out}.ask-msg-user{justify-self:end;background:var(--black);color:var(--on-dark);padding:.68rem .9rem;border-radius:1.15rem 1.15rem .3rem 1.15rem}.ask-msg-user p{margin:0;white-space:pre-wrap}.ask-msg-assistant{justify-self:start;padding:.15rem 0}.ask-answer{display:grid;gap:.5rem}.ask-answer p{margin:0}.ask-answer h3{font-size:1rem;margin:.35rem 0 0}.ask-answer ul{margin:.05rem 0 .25rem;padding-left:1.25rem}.ask-answer li+li{margin-top:.35rem}.ask-answer code{font-size:.9em;padding:.08rem .25rem;background:var(--paper-sunk);border-radius:.25rem}.ask-msg-actions{margin-top:.5rem;opacity:.7}.ask-msg-actions button{border:0;background:transparent;padding:.2rem .1rem;color:var(--ink-faint);font:inherit;font-size:.68rem;cursor:pointer}.ask-answer-meta{font-size:.67rem;color:var(--ink-faint);margin-top:.55rem}.ask-sources{display:flex;flex-wrap:wrap;gap:.3rem;margin-top:.55rem}.ask-sources a{font-size:.67rem;color:var(--ink-soft);border:1px solid var(--line);border-radius:999px;padding:.25rem .45rem;text-decoration:none}.ask-msg-photo{display:block;max-width:220px;max-height:240px;object-fit:cover;border-radius:.8rem;margin-bottom:.5rem}.ask-msg-typing{display:flex;gap:.25rem;align-items:center;padding:.7rem 0}.ask-msg-typing span{width:6px;height:6px;background:var(--ink-faint);border-radius:50%;animation:ask-dot 1s infinite ease-in-out}.ask-msg-typing span:nth-child(2){animation-delay:.12s}.ask-msg-typing span:nth-child(3){animation-delay:.24s}@keyframes ask-dot{0%,60%,100%{opacity:.25;transform:translateY(0)}30%{opacity:1;transform:translateY(-2px)}}@keyframes ask-in{from{opacity:0;transform:translateY(5px)}to{opacity:1;transform:none}}
