---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { site, telHref } from '../data/site';
import '../styles/ask.css';
const guides=(await getCollection('guides',({data})=>data.published)).sort((a,b)=>a.data.order-b.data.order);
const starters=guides.flatMap(g=>g.data.faq.slice(0,1).map(item=>item.question)).slice(0,4);
const paths=[['Need new windows','Help me figure out whether I actually need replacement windows.'],['Compare methods','What is the difference between insert and full-frame replacement?'],['Figure out cost','What information do you need to estimate window replacement cost?'],['Choose glass','What glass options make sense for a Pacific Northwest home?'],['New construction','What should I know about windows for a new-construction project?']];
---
<BaseLayout title="Ask a window question" description="Talk with Clearview's project consultant about window replacement, glass, installation, and project planning in Clark County." path="/ask" crumbs={[{name:'Ask',href:'/ask'}]}>
<main class="ask-page">
  <section class="ask-app" data-ask-app aria-label="Clearview project consultant">
    <header class="ask-app-head">
      <div class="ask-identity"><div class="ask-avatar" aria-hidden="true">C</div><div><strong>Clearview Consultant</strong><span>Window project guidance</span></div></div>
      <div class="ask-head-actions"><a class="ask-call" href={telHref()}>Call</a><button type="button" data-ask-copy hidden>Copy</button><button type="button" data-ask-new hidden>New chat</button></div>
    </header>
    <div class="ask-project-wrap">
      <button type="button" class="ask-project-toggle" data-project-toggle aria-expanded="false"><span class="ask-project-icon" aria-hidden="true">⌁</span><span><strong>Project details</strong><small data-project-status>Optional — add details to make answers more specific</small></span><span class="ask-chevron" aria-hidden="true">⌄</span></button>
      <div class="ask-project-body" data-project-body hidden>
        <div class="ask-choice-group"><span class="ask-choice-label">Home</span><div class="ask-choices" data-choice-group="homeType"><button type="button" data-choice="Existing home">Existing home</button><button type="button" data-choice="New construction">New construction</button><button type="button" data-choice="Not sure">Not sure</button></div></div>
        <div class="ask-choice-group"><span class="ask-choice-label">Openings</span><div class="ask-choices" data-choice-group="count"><button type="button" data-choice="1">1</button><button type="button" data-choice="2–5">2–5</button><button type="button" data-choice="6–10">6–10</button><button type="button" data-choice="10+">10+</button><button type="button" data-choice="Not sure">Not sure</button></div></div>
        <div class="ask-choice-group"><span class="ask-choice-label">Concern</span><div class="ask-choices" data-choice-group="concern"><button type="button" data-choice="Drafts">Drafts</button><button type="button" data-choice="Fogged glass">Fogged glass</button><button type="button" data-choice="Damage">Damage</button><button type="button" data-choice="Energy">Energy</button><button type="button" data-choice="Appearance">Appearance</button><button type="button" data-choice="Other">Other</button></div></div>
      </div>
    </div>
    <div class="ask-scroll" data-ask-scroll>
      <div class="ask-transcript" data-transcript role="log" aria-live="polite">
        <div class="ask-welcome" data-welcome>
          <div class="ask-welcome-mark" aria-hidden="true">C</div>
          <h1>What are you working on?</h1>
          <p>Ask anything about replacement windows, installation, glass, cost, or a new-construction project.</p>
          <div class="ask-starters" data-starters>{starters.map(q=><button type="button" class="ask-chip" data-starter>{q}</button>)}</div>
          <div class="ask-paths" data-paths>{paths.map(([label,prompt])=><button type="button" class="ask-path" data-path-prompt={prompt}><span>{label}</span><span aria-hidden="true">→</span></button>)}</div>
        </div>
      </div>
      <button type="button" class="ask-scroll-bottom" data-scroll-bottom hidden aria-label="Scroll to latest message">↓</button>
    </div>
    <div class="ask-status" data-ask-status aria-live="polite"></div>
    <div class="ask-next" data-ask-next hidden><span class="ask-next-label">Continue with</span><div class="ask-next-actions" data-ask-next-actions></div></div>
    <div class="ask-handoff" data-ask-handoff hidden><div><strong>Ready to price the project?</strong><span>Your project details will carry into the estimate form.</span></div><a class="ask-handoff-btn" href="/estimate" data-ask-handoff-link>Start estimate</a></div>
    <form class="ask-composer" data-ask-form>
      <div class="ask-attachment" data-ask-photo-preview hidden><img data-ask-photo-thumb width="52" height="52" alt="Attached photo"/><button type="button" data-ask-photo-remove aria-label="Remove photo">×</button></div>
      <div class="ask-composer-box">
        <label class="ask-add" for="ask-photo-input" title="Add a photo"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 7.5h3l1.4-2h5.2l1.4 2H19a2 2 0 0 1 2 2V18a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V9.5a2 2 0 0 1 2-2Z"/><circle cx="12" cy="13.5" r="3.2"/></svg><span>Add photo</span></label>
        <input id="ask-photo-input" data-ask-photo-input type="file" accept="image/png,image/jpeg,image/webp" class="visually-hidden"/>
        <textarea id="ask-input" data-ask-input rows="1" maxlength="500" placeholder="Message Clearview Consultant…" aria-label="Message Clearview Consultant" required></textarea>
        <button type="submit" class="ask-send" data-ask-submit aria-label="Send message"><span>↑</span></button>
      </div>
      <div class="ask-composer-meta"><span>Enter to send · Shift+Enter for new line</span><span data-ask-count>0 / 500</span></div>
    </form>
  </section>
</main>
<noscript><section class="section"><div class="wrap"><h2>JavaScript is required for the consultant.</h2><p><a href="/estimate">Request an estimate</a> or call <a href={telHref()}>{site.phoneDisplay}</a>.</p></div></section></noscript>
</BaseLayout>
<script>
type Message={role:'user'|'assistant';content:string};
function initAsk(){
 const form=document.querySelector('[data-ask-form]');if(!(form instanceof HTMLFormElement)||form.dataset.bound==='true')return;form.dataset.bound='true';
 const app=document.querySelector('[data-ask-app]'),input=document.querySelector('[data-ask-input]'),send=document.querySelector('[data-ask-submit]'),transcript=document.querySelector('[data-transcript]'),scroll=document.querySelector('[data-ask-scroll]'),bottom=document.querySelector('[data-scroll-bottom]'),status=document.querySelector('[data-ask-status]'),photoInput=document.querySelector('[data-ask-photo-input]'),photoPreview=document.querySelector('[data-ask-photo-preview]'),photoThumb=document.querySelector('[data-ask-photo-thumb]'),photoRemove=document.querySelector('[data-ask-photo-remove]'),projectBody=document.querySelector('[data-project-body]'),projectToggle=document.querySelector('[data-project-toggle]'),projectStatusEl=document.querySelector('[data-project-status]'),next=document.querySelector('[data-ask-next]'),nextActions=document.querySelector('[data-ask-next-actions]'),handoff=document.querySelector('[data-ask-handoff]'),handoffLink=document.querySelector('[data-ask-handoff-link]'),newBtn=document.querySelector('[data-ask-new]'),copyBtn=document.querySelector('[data-ask-copy]'),count=document.querySelector('[data-ask-count]');
 if(!(input instanceof HTMLTextAreaElement)||!(transcript instanceof HTMLElement)||!(scroll instanceof HTMLElement))return;
 const conversation:Message[]=[];const project:Record<string,string>={};let attachedImage:string|null=null;let controller:AbortController|null=null;let typing:HTMLElement|null=null;let generation=0;
 const setStatus=(v:string)=>{if(status instanceof HTMLElement)status.textContent=v};
 const resize=()=>{input.style.height='auto';input.style.height=Math.min(input.scrollHeight,160)+'px'};
 const latest=(smooth=true)=>requestAnimationFrame(()=>scroll.scrollTo({top:scroll.scrollHeight,behavior:smooth?'smooth':'auto'}));
 const setHeight=()=>{if(!(app instanceof HTMLElement))return;const vv=window.visualViewport;const top=Math.max(0,app.getBoundingClientRect().top);const h=Math.max(360,(vv?.height||innerHeight)-top);app.style.setProperty('--ask-height',`${Math.round(h)}px`);document.documentElement.style.setProperty('--ask-page-height',`${Math.round(h)}px`)};
 const clearPhoto=()=>{generation++;attachedImage=null;if(photoInput instanceof HTMLInputElement)photoInput.value='';if(photoPreview instanceof HTMLElement)photoPreview.hidden=true};
 const updateProject=()=>{const n=Object.keys(project).length;if(projectStatusEl instanceof HTMLElement)projectStatusEl.textContent=n?`${n} detail${n===1?'':'s'} in this chat`:'Optional — add details to make answers more specific';document.querySelectorAll('[data-choice-group]').forEach(g=>{const key=g.getAttribute('data-choice-group'),val=key?project[key]:'';g.querySelectorAll('[data-choice]').forEach(b=>{if(b instanceof HTMLButtonElement)b.classList.toggle('is-selected',b.dataset.choice===val)})})};
 const esc=(v:string)=>v.replace(/[&<>\"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','\\':'&#92;','"':'&quot;'}[c]||c));
 const answerHtml=(v:string)=>{const out:string[]=[];let list:string[]=[];const flush=()=>{if(list.length){out.push(`<ul>${list.map(x=>`<li>${x}</li>`).join('')}</ul>`);list=[]}};for(const raw of v.trim().split(/\r?\n/)){const line=raw.trim();if(!line){flush();continue}if(/^[-*]\s+/.test(line)){list.push(esc(line.replace(/^[-*]\s+/,'')));continue}flush();out.push(/^#{2,4}\s+/.test(line)?`<h3>${esc(line.replace(/^#{2,4}\s+/,''))}</h3>`:`<p>${esc(line).replace(/\*\*(.+?)\*\*/g,'<strong>$1</strong>').replace(/`([^`]+)`/g,'<code>$1</code>')}</p>`)}flush();return out.join('')};
 const append=(role:'user'|'assistant',content:string,sourceList?:{title:string;url:string}[],photo?:string|null,meta?:string)=>{document.querySelector('[data-welcome]')?.remove();const el=document.createElement('article');el.className=`ask-msg ask-msg-${role}`;if(photo){const im=document.createElement('img');im.className='ask-msg-photo';im.src=photo;im.alt='Attached photo';el.append(im)}if(role==='assistant'){const body=document.createElement('div');body.className='ask-answer';body.innerHTML=answerHtml(content);el.append(body);const actions=document.createElement('div');actions.className='ask-msg-actions';const b=document.createElement('button');b.type='button';b.textContent='Copy';b.onclick=()=>navigator.clipboard?.writeText(content);actions.append(b);el.append(actions)}else{const p=document.createElement('p');p.textContent=content;el.append(p)}if(meta){const m=document.createElement('div');m.className='ask-answer-meta';m.textContent=meta;el.append(m)}if(sourceList?.length){const s=document.createElement('div');s.className='ask-sources';sourceList.slice(0,4).forEach(x=>{const a=document.createElement('a');a.href=x.url;a.textContent=x.title;a.target='_blank';a.rel='noopener noreferrer';s.append(a)});el.append(s)}transcript.append(el);latest()};
 const showTyping=()=>{typing=document.createElement('article');typing.className='ask-msg ask-msg-assistant ask-msg-typing';typing.innerHTML='<span></span><span></span><span></span>';transcript.append(typing);latest()};const hideTyping=()=>{typing?.remove();typing=null};
 const renderNext=(items:{label?:string;prompt:string}[])=>{if(!(next instanceof HTMLElement)||!(nextActions instanceof HTMLElement))return;nextActions.replaceChildren();items.slice(0,3).forEach(item=>{if(!item?.prompt)return;const b=document.createElement('button');b.type='button';b.textContent=(item.label||item.prompt).slice(0,90);b.onclick=()=>ask(item.prompt);nextActions.append(b)});next.hidden=!nextActions.children.length};
 const handoffUrl=()=>{const p=new URLSearchParams();if(project.homeType)p.set('home_type',project.homeType);if(project.count)p.set('openings',project.count);if(project.concern)p.set('concern',project.concern);return p.toString()?`/estimate?${p}`:'/estimate'};
 async function photo(file:File){const my=++generation;if(!['image/jpeg','image/png','image/webp'].includes(file.type)){setStatus('Please choose a JPG, PNG, or WebP photo.');clearPhoto();return}if(file.size>8*1024*1024){setStatus('That photo is too large — choose one under 8MB.');clearPhoto();return}try{const bm=await createImageBitmap(file);const max=1400,s=Math.min(1,max/Math.max(bm.width,bm.height)),c=document.createElement('canvas');c.width=Math.round(bm.width*s);c.height=Math.round(bm.height*s);const ctx=c.getContext('2d');if(!ctx)throw new Error();ctx.drawImage(bm,0,0,c.width,c.height);bm.close();const data=c.toDataURL('image/jpeg',.78);if(my!==generation)return;attachedImage=data;if(photoThumb instanceof HTMLImageElement)photoThumb.src=data;if(photoPreview instanceof HTMLElement)photoPreview.hidden=false;setStatus('')}catch{if(my===generation){setStatus('Could not read that photo — try another file.');clearPhoto()}}}
 async function ask(q0:string){const q=q0.trim();if(!q||controller)return;setStatus('');const photoData=attachedImage;append('user',q,undefined,photoData);conversation.push({role:'user',content:q});clearPhoto();if(newBtn instanceof HTMLElement)newBtn.hidden=false;if(copyBtn instanceof HTMLElement)copyBtn.hidden=false;input.disabled=true;if(send instanceof HTMLButtonElement){send.disabled=false;send.classList.add('is-stop');send.innerHTML='<span>■</span>';send.setAttribute('aria-label','Stop generating')}showTyping();controller=new AbortController();try{const r=await fetch('/ask/api/chat',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({message:q,history:conversation.slice(-11,-1),project,...(photoData?{image:photoData}:{})}),signal:controller.signal});const result=await r.json().catch(()=>({}));if(!r.ok)throw new Error(result.error||'Something went wrong.');hideTyping();const a=result.answer||'I did not get an answer for that.';const meta=[result.grounding==='guide'?'Guide-backed':result.grounding==='general'?'General guidance':null,result.photoAnalyzed?'Photo reviewed':null].filter(Boolean).join(' · ');append('assistant',a,result.sources,undefined,meta);conversation.push({role:'assistant',content:a});if(result.project&&typeof result.project==='object'){for(const key of ['homeType','count','concern'])if(typeof result.project[key]==='string')project[key]=result.project[key];updateProject()}renderNext(Array.isArray(result.suggestions)?result.suggestions:[]);if(result.estimateReady||Object.keys(project).length>=2){if(handoff instanceof HTMLElement)handoff.hidden=false;if(handoffLink instanceof HTMLAnchorElement)handoffLink.href=handoffUrl()}}catch(e){hideTyping();if(e instanceof DOMException&&e.name==='AbortError')setStatus('Generation stopped.');else setStatus(e instanceof Error?e.message:'Something went wrong. Try again.')}finally{controller=null;input.disabled=false;if(send instanceof HTMLButtonElement){send.classList.remove('is-stop');send.innerHTML='<span>↑</span>';send.setAttribute('aria-label','Send message')}resize();latest();input.focus()}}
 if(photoInput instanceof HTMLInputElement)photoInput.onchange=()=>{const f=photoInput.files?.[0];if(f)void photo(f)};photoRemove?.addEventListener('click',clearPhoto);
 document.querySelectorAll('[data-path-prompt]').forEach(e=>e.addEventListener('click',()=>{if(e instanceof HTMLButtonElement)ask(e.dataset.pathPrompt||'')}));document.querySelectorAll('[data-starter]').forEach(e=>e.addEventListener('click',()=>{if(e instanceof HTMLButtonElement)ask(e.textContent||'')}));document.querySelectorAll('[data-choice]').forEach(e=>e.addEventListener('click',()=>{if(!(e instanceof HTMLButtonElement))return;const key=e.closest('[data-choice-group]')?.getAttribute('data-choice-group');if(!key)return;project[key]=e.dataset.choice||'';updateProject();if(Object.keys(project).length>=2&&handoff instanceof HTMLElement&&handoffLink instanceof HTMLAnchorElement){handoff.hidden=false;handoffLink.href=handoffUrl()}}));
 projectToggle?.addEventListener('click',()=>{if(!(projectToggle instanceof HTMLElement)||!(projectBody instanceof HTMLElement))return;const open=projectToggle.getAttribute('aria-expanded')==='true';projectToggle.setAttribute('aria-expanded',String(!open));projectBody.hidden=open});newBtn?.addEventListener('click',()=>location.reload());copyBtn?.addEventListener('click',()=>{const text=conversation.map(m=>`${m.role==='user'?'You':'Clearview'}: ${m.content}`).join('\n\n');navigator.clipboard?.writeText(text)});
 form.addEventListener('submit',e=>{e.preventDefault();if(controller){controller.abort();return}const q=input.value.trim();if(!q)return;input.value='';if(count instanceof HTMLElement)count.textContent='0 / 500';resize();void ask(q)});input.addEventListener('input',()=>{resize();if(count instanceof HTMLElement)count.textContent=`${input.value.length} / 500`});input.addEventListener('keydown',e=>{if(e.key==='Enter'&&!e.shiftKey){e.preventDefault();form.requestSubmit()}});bottom?.addEventListener('click',()=>latest());scroll.addEventListener('scroll',()=>{if(bottom instanceof HTMLElement)bottom.hidden=scroll.scrollHeight-scroll.scrollTop-scroll.clientHeight<220});setHeight();window.addEventListener('resize',setHeight,{passive:true});window.visualViewport?.addEventListener('resize',setHeight,{passive:true});window.visualViewport?.addEventListener('scroll',setHeight,{passive:true});resize();updateProject();
}
initAsk();document.addEventListener('astro:page-load',initAsk);
</script>
