---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { site, telHref } from '../data/site';

// A handful of starter questions pulled from the guides' own FAQ
// frontmatter — real questions we already have real answers for, so the
// first thing a visitor sees is never a guess about what the bot can do.
const guides = (await getCollection('guides', ({ data }) => data.published)).sort(
  (a, b) => a.data.order - b.data.order,
);
const starters = guides
  .flatMap((g) => g.data.faq.slice(0, 1).map((item) => item.question))
  .slice(0, 5);
---

<BaseLayout
  title="Ask a window question"
  description="Ask Clearview's guide assistant about window replacement, methods, glass, and cost in Vancouver, WA."
  path="/ask"
  crumbs={[{ name: 'Ask', href: '/ask' }]}
>
  <section class="page-hero">
    <div class="wrap">
      <p class="kicker">Ask</p>
      <h1>Ask a window question.</h1>
      <p class="lede">
        This is an automated assistant, not Mark — it answers from our own guides and basic
        business info, and it can get things wrong. Nothing here is a formal quote. For a firm
        price, <a href="/estimate">request an estimate</a>.
      </p>
    </div>
  </section>

  <noscript>
    <style>
      .ask-layout {
        display: none;
      }
    </style>
    <section class="section">
      <div class="wrap ask-noscript">
        <p class="kicker">JavaScript required</p>
        <h2>This assistant needs JavaScript.</h2>
        <p>
          It answers as you type, so it cannot run with scripts disabled. For a firm answer right
          now, <a href="/estimate">request a written estimate</a> or call{' '}
          <a href={telHref()}>{site.phoneDisplay}</a> — Mark answers from the truck.
        </p>
      </div>
    </section>
  </noscript>

  <section class="section">
    <div class="wrap ask-layout" data-reveal>
      <div class="ask-panel">
        <div class="ask-transcript" data-transcript role="log" aria-live="polite">
          <div class="ask-msg ask-msg-assistant">
            <p>
              Hi — ask me about window replacement methods, glass, cost, or how we work in Clark
              County. I'll say so if it's something I don't have a good answer for.
            </p>
          </div>
        </div>

        {starters.length > 0 && (
          <>
            <div class="ask-starters" data-starters>
              {starters.map((q) => (
                <button type="button" class="ask-chip" data-starter>{q}</button>
              ))}
            </div>
            <button type="button" class="ask-starters-toggle" data-starters-toggle hidden>
              Suggested questions
            </button>
          </>
        )}

        <p class="ask-error" data-ask-error role="alert"></p>

        <p class="ask-handoff" data-ask-handoff hidden>
          <a href="/estimate" data-ask-handoff-link>Turn this into a written estimate &rarr;</a>
        </p>

        <form class="ask-form" data-ask-form>
          <div class="ask-photo-row">
            <label class="ask-photo-btn" for="ask-photo-input">
              <svg viewBox="0 0 20 20" aria-hidden="true">
                <path d="M4 6.5h2.4l1-1.5h5.2l1 1.5H16a1 1 0 0 1 1 1V15a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V7.5a1 1 0 0 1 1-1Z" />
                <circle cx="10" cy="11" r="2.6" />
              </svg>
              Add a photo of the window
            </label>
            <input
              id="ask-photo-input"
              data-ask-photo-input
              type="file"
              accept="image/png,image/jpeg,image/webp"
              class="visually-hidden"
            />
            <div class="ask-photo-preview" data-ask-photo-preview hidden>
              <img data-ask-photo-thumb width="42" height="42" alt="Photo you attached" />
              <button type="button" class="ask-photo-remove" data-ask-photo-remove aria-label="Remove photo">
                &times;
              </button>
            </div>
            <span class="ask-photo-hint" data-ask-photo-hint>JPG, PNG, or WEBP, up to 8MB</span>
          </div>

          <div class="ask-input-row">
            <label class="visually-hidden" for="ask-input">Your question</label>
            <textarea
              id="ask-input"
              data-ask-input
              rows="2"
              maxlength="500"
              placeholder="e.g. Is insert replacement cheaper than full-frame?"
              required
            ></textarea>
            <button class="btn btn-primary" type="submit" data-ask-submit>Ask</button>
          </div>
        </form>
      </div>

      <aside class="ask-aside">
        <p class="rule-label">Prefer to talk</p>
        <p class="ask-phone"><a href={telHref()}>{site.phoneDisplay}</a></p>
        <p>Mark answers from the truck. This assistant is a shortcut, not a replacement for him.</p>
      </aside>
    </div>
  </section>
</BaseLayout>

<script>
  type Message = { role: 'user' | 'assistant'; content: string };

  function initAsk() {
    const form = document.querySelector('[data-ask-form]');
    if (!(form instanceof HTMLFormElement) || form.dataset.bound === 'true') return;
    form.dataset.bound = 'true';

    const input = document.querySelector('[data-ask-input]');
    const submitBtn = document.querySelector('[data-ask-submit]');
    const transcript = document.querySelector('[data-transcript]');
    const errorEl = document.querySelector('[data-ask-error]');
    const starters = document.querySelector('[data-starters]');
    const startersToggle = document.querySelector('[data-starters-toggle]');
    const photoInput = document.querySelector('[data-ask-photo-input]');
    const photoPreview = document.querySelector('[data-ask-photo-preview]');
    const photoThumb = document.querySelector('[data-ask-photo-thumb]');
    const photoRemove = document.querySelector('[data-ask-photo-remove]');
    const handoff = document.querySelector('[data-ask-handoff]');
    const handoffLink = document.querySelector('[data-ask-handoff-link]');

    if (!(input instanceof HTMLTextAreaElement) || !(transcript instanceof HTMLElement)) return;

    const conversation: Message[] = [];
    // The resized photo attached to the NEXT question, if any. Cleared after
    // every send (successful or not) — a photo describes one turn, not the
    // whole conversation, so it should never silently re-attach to a later
    // unrelated question.
    let attachedImage: string | null = null;
    // Bumped on every selection/removal. resizeToDataUrl runs async — without
    // this, clicking remove (or picking a second photo) while an earlier
    // resize is still in flight lets that stale resize land afterward and
    // silently reattach a photo the visitor already dismissed or replaced.
    let photoGeneration = 0;

    // Phone photos are commonly several MB. Resizing client-side keeps the
    // upload small (Workers AI still has to decode it, and the free daily
    // Neuron allocation is not unlimited) without asking the visitor to do
    // anything but pick a file.
    async function resizeToDataUrl(file: File): Promise<string> {
      const bitmap = await createImageBitmap(file);
      const maxSide = 1024;
      const scale = Math.min(1, maxSide / Math.max(bitmap.width, bitmap.height));
      const canvas = document.createElement('canvas');
      canvas.width = Math.round(bitmap.width * scale);
      canvas.height = Math.round(bitmap.height * scale);
      const ctx = canvas.getContext('2d');
      if (!ctx) throw new Error('Could not read that image.');
      ctx.drawImage(bitmap, 0, 0, canvas.width, canvas.height);
      return canvas.toDataURL('image/jpeg', 0.75);
    }

    function showError(message: string) {
      if (errorEl instanceof HTMLElement) errorEl.textContent = message;
    }

    function clearAttachedPhoto() {
      photoGeneration += 1;
      attachedImage = null;
      if (photoInput instanceof HTMLInputElement) photoInput.value = '';
      if (photoPreview instanceof HTMLElement) photoPreview.hidden = true;
    }

    if (photoInput instanceof HTMLInputElement) {
      photoInput.addEventListener('change', async () => {
        const file = photoInput.files?.[0];
        if (!file) return;
        photoGeneration += 1;
        const thisPhoto = photoGeneration;
        if (!file.type.startsWith('image/')) {
          showError('That file is not a photo — try a JPG, PNG, or WebP.');
          clearAttachedPhoto();
          return;
        }
        if (file.size > 8 * 1024 * 1024) {
          showError('That photo is too large — try one under 8MB.');
          clearAttachedPhoto();
          return;
        }
        try {
          const resized = await resizeToDataUrl(file);
          if (thisPhoto !== photoGeneration) return; // superseded while resizing
          attachedImage = resized;
          if (photoThumb instanceof HTMLImageElement) photoThumb.src = attachedImage;
          if (photoPreview instanceof HTMLElement) photoPreview.hidden = false;
          if (errorEl instanceof HTMLElement) errorEl.textContent = '';
        } catch {
          if (thisPhoto !== photoGeneration) return;
          showError('Could not read that photo — try a different file.');
          clearAttachedPhoto();
        }
      });
    }

    if (photoRemove instanceof HTMLElement) {
      photoRemove.addEventListener('click', clearAttachedPhoto);
    }

    function appendMessage(
      role: 'user' | 'assistant',
      content: string,
      sources?: { title: string; url: string }[],
      photo?: string | null,
    ) {
      if (!(transcript instanceof HTMLElement)) return;
      const bubble = document.createElement('div');
      bubble.className = `ask-msg ask-msg-${role}`;

      if (photo) {
        const img = document.createElement('img');
        img.className = 'ask-msg-photo';
        img.src = photo;
        img.alt = 'Photo you attached';
        bubble.append(img);
      }

      const p = document.createElement('p');
      p.textContent = content;
      bubble.append(p);

      if (sources && sources.length > 0) {
        const sourcesEl = document.createElement('p');
        sourcesEl.className = 'ask-sources';
        sourcesEl.textContent = 'Based on: ';
        sources.forEach((s, i) => {
          if (i > 0) sourcesEl.append(', ');
          const a = document.createElement('a');
          a.href = s.url;
          a.textContent = s.title;
          sourcesEl.append(a);
        });
        bubble.append(sourcesEl);
      }

      transcript.append(bubble);
      transcript.scrollTop = transcript.scrollHeight;
    }

    // A single reusable "typing" bubble, shown for the duration of the
    // request. Its text lives in the aria-live transcript so screen reader
    // users hear that the assistant is working, not just sighted users
    // watching the button — the button's own "Asking…" label alone left
    // both groups guessing on a slow response.
    let typingEl: HTMLElement | null = null;

    function showTyping() {
      if (!(transcript instanceof HTMLElement)) return;
      typingEl = document.createElement('div');
      typingEl.className = 'ask-msg ask-msg-assistant ask-msg-typing';
      const p = document.createElement('p');
      p.textContent = 'Thinking…';
      typingEl.append(p);
      transcript.append(typingEl);
      transcript.scrollTop = transcript.scrollHeight;
    }

    function hideTyping() {
      typingEl?.remove();
      typingEl = null;
    }

    // Cuts at the last word boundary and marks the cut with an ellipsis, so
    // notes handed to the estimate form read as "trimmed" rather than as a
    // sentence that just stops mid-word — which otherwise looks like a bug.
    function truncateForHandoff(text: string, max: number): string {
      if (text.length <= max) return text;
      const cut = text.slice(0, max);
      const lastSpace = cut.lastIndexOf(' ');
      return `${cut.slice(0, lastSpace > 0 ? lastSpace : max)}…`;
    }

    async function ask(question: string) {
      if (!(errorEl instanceof HTMLElement)) return;
      errorEl.textContent = '';
      // Hidden rather than removed, and behind a toggle rather than gone for
      // good — someone three questions in might still want a reminder of
      // what else this can answer.
      if (starters instanceof HTMLElement) starters.hidden = true;
      if (startersToggle instanceof HTMLElement) startersToggle.hidden = false;

      const photo = attachedImage;
      appendMessage('user', question, undefined, photo);
      const history = conversation.slice(-6);
      conversation.push({ role: 'user', content: question });
      clearAttachedPhoto();

      if (submitBtn instanceof HTMLButtonElement) {
        submitBtn.disabled = true;
        submitBtn.textContent = 'Asking…';
      }
      input.disabled = true;
      showTyping();

      try {
        const response = await fetch('/ask/api/chat', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify(photo ? { message: question, history, image: photo } : { message: question, history }),
        });
        const result = await response.json().catch(() => ({}));
        if (!response.ok) throw new Error(result.error || 'Something went wrong.');

        hideTyping();
        const answer = result.answer || "Sorry — I didn't get an answer for that.";
        appendMessage('assistant', answer, result.sources);
        conversation.push({ role: 'assistant', content: answer });

        // A photo turn is the strongest signal yet that this visitor has a
        // real project in front of them — hand the assistant's answer over
        // as the estimate form's starting notes, same mechanism the cost
        // calculator already uses, so nobody has to describe it twice.
        if (photo && handoff instanceof HTMLElement && handoffLink instanceof HTMLAnchorElement) {
          const scope = truncateForHandoff(answer, 400);
          try {
            sessionStorage.setItem('clearview:scope', scope);
          } catch {
            // Private browsing can refuse storage. The query param still works.
          }
          handoffLink.href = `/estimate?scope=${encodeURIComponent(scope)}`;
          handoff.hidden = false;
        }
      } catch (error) {
        errorEl.textContent = error instanceof Error ? error.message : 'Something went wrong. Try again in a moment.';
      } finally {
        hideTyping();
        if (submitBtn instanceof HTMLButtonElement) {
          submitBtn.disabled = false;
          submitBtn.textContent = 'Ask';
        }
        input.disabled = false;
        input.focus();
      }
    }

    form.addEventListener('submit', (event) => {
      event.preventDefault();
      const question = input.value.trim();
      if (!question) return;
      input.value = '';
      ask(question);
    });

    // Enter submits, shift+Enter makes a new line.
    input.addEventListener('keydown', (event) => {
      if (event.key === 'Enter' && !event.shiftKey) {
        event.preventDefault();
        form.requestSubmit();
      }
    });

    if (starters instanceof HTMLElement) {
      starters.querySelectorAll('[data-starter]').forEach((btn) => {
        btn.addEventListener('click', () => {
          if (btn instanceof HTMLButtonElement) ask(btn.textContent || '');
        });
      });
    }

    if (startersToggle instanceof HTMLElement && starters instanceof HTMLElement) {
      startersToggle.addEventListener('click', () => {
        starters.hidden = false;
        startersToggle.hidden = true;
      });
    }
  }

  initAsk();
  document.addEventListener('astro:page-load', initAsk);
</script>

<style>
  .ask-noscript {
    max-width: 40rem;
    padding: var(--space-l);
    background: var(--paper-raised);
    border: 1px solid var(--line);
    border-left: 3px solid var(--accent);
    border-radius: var(--radius-lg);
  }

  .ask-noscript .kicker {
    color: var(--accent);
  }

  .ask-layout {
    display: grid;
    grid-template-columns: 1fr 18rem;
    gap: var(--space-xl);
    align-items: start;
  }

  .ask-panel {
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--paper-raised);
    padding: var(--space-m);
    display: grid;
    gap: var(--space-s);
  }

  .ask-transcript {
    display: grid;
    gap: var(--space-s);
    max-height: 28rem;
    overflow-y: auto;
    padding-right: 0.2rem;
  }

  /* .ask-msg and its children are also built at runtime in the <script>
     below (one bubble per chat turn) — those elements never receive
     Astro's scoping attribute, so these rules have to be :global() or they
     silently only style the one static greeting bubble in the markup. */
  :global(.ask-msg) {
    max-width: 34rem;
    padding: var(--space-xs) var(--space-s);
    border-radius: var(--radius);
    font-size: var(--step--1);
  }

  :global(.ask-msg p) {
    margin: 0;
  }

  :global(.ask-msg-assistant) {
    background: var(--paper-sunk);
    justify-self: start;
  }

  :global(.ask-msg-user) {
    background: var(--accent-wash);
    justify-self: end;
  }

  :global(.ask-sources) {
    margin-top: 0.4rem !important;
    font-size: var(--step--2);
    color: var(--ink-faint);
  }

  :global(.ask-msg-photo) {
    display: block;
    width: 100%;
    max-width: 12rem;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: var(--radius);
    margin-bottom: var(--space-2xs);
  }

  :global(.ask-msg-typing p) {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    color: var(--ink-faint);
  }

  :global(.ask-msg-typing p::after) {
    content: '';
    width: 0.9rem;
    height: 0.3rem;
    background-image: radial-gradient(circle, currentColor 40%, transparent 45%);
    background-size: 0.3rem 0.3rem;
    background-repeat: space no-repeat;
    animation: ask-typing-dots 1.1s ease-in-out infinite;
  }

  @keyframes ask-typing-dots {
    0%,
    100% {
      opacity: 0.35;
    }
    50% {
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.ask-msg-typing p::after) {
      animation: none;
      opacity: 0.7;
    }
  }

  .ask-starters {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs);
  }

  .ask-chip {
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    padding: 0.35rem 0.8rem;
    font-size: var(--step--2);
    background: transparent;
    cursor: pointer;
    text-align: left;
  }

  .ask-chip:hover {
    background: var(--paper-sunk);
  }

  /* Brought back after the chips hide themselves post-first-question — a
     plain text button rather than another chip, so it reads as "bring these
     back" and not as one more suggestion. */
  .ask-starters-toggle {
    border: 0;
    background: transparent;
    padding: 0;
    color: var(--ink-soft);
    font-size: var(--step--2);
    text-decoration: underline;
    text-underline-offset: 0.2em;
    cursor: pointer;
    align-self: start;
  }

  .ask-starters-toggle:hover {
    color: var(--accent-ink);
  }

  /* Empty rather than [hidden] up front, and hidden here via :empty instead
     of the hidden attribute — a role="alert" region needs to already exist
     in the accessibility tree for assistive tech to be watching it, so
     toggling it into existence at the same moment its text is set can race
     and miss the announcement on some screen readers. */
  .ask-error {
    color: var(--danger);
    border-left: 2px solid var(--danger);
    padding-left: var(--space-2xs);
    margin: 0;
  }

  .ask-error:empty {
    display: none;
  }

  .ask-form {
    display: grid;
    gap: var(--space-xs);
  }

  .ask-input-row {
    display: flex;
    gap: var(--space-xs);
    align-items: end;
  }

  .ask-photo-row {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    flex-wrap: wrap;
  }

  .ask-photo-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    border: 1px dashed var(--line-strong);
    border-radius: var(--radius);
    padding: 0.45rem 0.8rem;
    font-size: var(--step--2);
    font-weight: 500;
    color: var(--ink-soft);
    cursor: pointer;
    transition: border-color var(--dur-fast) var(--ease), color var(--dur-fast) var(--ease);
  }

  .ask-photo-btn:hover {
    border-color: var(--accent);
    color: var(--accent-ink);
  }

  .ask-photo-btn svg {
    width: 1rem;
    height: 1rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.4;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* Stated up front rather than only after someone hits the limit — the
     8MB cap and accepted formats used to surface solely as a rejection
     message on a too-big or wrong-type file. */
  .ask-photo-hint {
    font-size: var(--step--2);
    color: var(--ink-faint);
  }

  .ask-photo-preview {
    display: flex;
    align-items: center;
    gap: var(--space-2xs);
  }

  .ask-photo-preview img {
    width: 2.6rem;
    height: 2.6rem;
    object-fit: cover;
    border-radius: var(--radius);
    border: 1px solid var(--line);
  }

  .ask-photo-remove {
    position: relative;
    border: 1px solid var(--line-strong);
    background: transparent;
    border-radius: 999px;
    width: 1.5rem;
    height: 1.5rem;
    line-height: 1;
    cursor: pointer;
    color: var(--ink-soft);
  }

  /* The glyph stays small so it doesn't overpower the thumbnail, but the
     tappable area extends to the ~44px minimum recommended for touch —
     an invisible hit box centered on the visible button rather than
     resizing it. */
  .ask-photo-remove::before {
    content: '';
    position: absolute;
    inset: 50%;
    width: 2.75rem;
    height: 2.75rem;
    transform: translate(-50%, -50%);
  }

  .ask-photo-remove:hover {
    border-color: var(--danger);
    color: var(--danger);
  }

  .ask-handoff {
    margin: 0;
    font-size: var(--step--1);
    font-weight: 500;
  }

  .ask-handoff a {
    color: var(--accent-ink);
  }

  .ask-form textarea {
    flex: 1;
    resize: vertical;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    padding: 0.6rem;
    font: inherit;
    font-size: var(--step-0);
  }

  .ask-aside {
    border-left: 1px solid var(--line);
    padding-left: var(--space-l);
  }

  .ask-phone a {
    font-size: var(--step-2);
    font-weight: 600;
  }

  /* 900px rather than the more common 800px used elsewhere on the site: at
     800 the two-column split was still active right around an iPad's 810px
     logical width, squeezing the 18rem aside against the transcript on
     exactly the device this most needs to read cleanly on. 900px clears
     common tablet widths with real margin. */
  @media (max-width: 900px) {
    .ask-layout {
      grid-template-columns: 1fr;
    }

    .ask-aside {
      border-left: 0;
      border-top: 1px solid var(--line);
      padding-left: 0;
      padding-top: var(--space-m);
    }
  }

  @media (max-width: 640px) {
    .ask-transcript {
      max-height: 16rem;
    }
  }
</style>
