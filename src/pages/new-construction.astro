---
import { getImage } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaBar from '../components/CtaBar.astro';
import FlashingOrder from '../components/diagrams/FlashingOrder.astro';
import WorkCard from '../components/WorkCard.astro';
import { newBuildWork, findWork, workKindLabel } from '../data/work';
import { site, mailHref, telHref } from '../data/site';

const ogPhoto = findWork('new-build-sheathed-garage')!;

// Full-bleed hero background: a real new-construction job.
const heroPhoto = findWork('new-build-tan-corner')!;
const heroBg = await getImage({ src: heroPhoto.image, width: 2400, format: 'webp', quality: 76 });

// Mirrors the numbered list below exactly — if the sequence changes, this
// must change with it, or the markup and the schema will say different
// things. See process.astro for the homeowner-side equivalent.
const sequence = [
  {
    name: 'Plans and schedule',
    text: 'Send plans or the opening schedule. We verify sizes, styles, and count before pricing.',
  },
  {
    name: 'Quote and lead time',
    text: 'Receive one written project price and the manufacturer lead time.',
  },
  {
    name: 'Framing check',
    text: 'We confirm rough openings match the approved schedule before set day.',
  },
  {
    name: 'Window set',
    text: 'We install after sheathing and WRB, ahead of siding or stucco.',
  },
  {
    name: 'Walk-through',
    text: 'We review the openings with your superintendent or PM and release the elevation to the next trade.',
  },
];

const rowSchema = {
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name: 'How Clearview Windows sets windows on a new-construction build',
  description: 'Builder window installation sequence: schedule review, framing check, installation, and walk-through.',
  step: sequence.map((step) => ({
    '@type': 'HowToStep',
    name: step.name,
    text: step.text,
  })),
};

// Same shape as the per-city Service schema in areas/[slug].astro, scoped to
// this service rather than one town. The sitewide hasOfferCatalog entry
// (JsonLd.astro) is just a name + url; this gives the service its own
// describable entity, so it is additive rather than a duplicate.
const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  serviceType: 'New construction window installation',
  name: 'New construction window installation',
  description:
    'Nailing-fin window setting for new Clark County builds, flashed to the rough opening and coordinated with the GC schedule.',
  provider: { '@id': `${site.url}/#business` },
  areaServed: site.nearby.map((place) => ({
    '@type': 'City',
    name: place.name,
    containedInPlace: { '@type': 'State', name: place.state },
  })),
};

const schema = { '@context': 'https://schema.org', '@graph': [serviceSchema, rowSchema] };

const scopeSplit = {
  clearview: [
    'Verify openings against the schedule before ordering',
    'Order units and track manufacturer lead times',
    'Set, shim, and flash the windows',
    'Integrate flashing with the weather-resistive barrier',
    'Walk the openings with your superintendent or PM',
  ],
  builder: [
    'Frame to the approved rough-opening sizes',
    'Complete sheathing and WRB before installation',
    'Provide safe, clear access to each opening',
    'Notify us of schedule or sequence changes',
    'Schedule siding, stucco, or EIFS after the walk-through',
  ],
};

// mailHref() falls back to /estimate when site.email is unset — appending a
// mailto-style query string to that would silently get ignored by
// EstimateForm, dropping the builder role prefill along with it. Route the
// no-email case through ?role=builder instead so the fallback still lands
// where it's supposed to.
const projectInquiryMailto = site.email
  ? mailHref() + `?subject=${encodeURIComponent('New construction project — plans/schedule attached')}` +
    `&body=${encodeURIComponent('Project address or subdivision:\nBuilder / GC company:\nApproximate opening count:\nTarget set date:\n\n(Attach the plan set or window schedule if you have one.)')}`
  : '/estimate?role=builder';
---
<BaseLayout
  title="New construction windows for builders and GCs"
  description="New-construction window installation for Clark County builders. Send plans or a window schedule for project pricing and lead time."
  path="/new-construction"
  crumbs={[{ name: 'New construction', href: '/new-construction' }]}
  ogImageSrc={ogPhoto.image}
  ogImageAlt={ogPhoto.alt}
  schema={schema}
>
  <section class="page-hero page-hero-photo" style={`background-image: linear-gradient(180deg, color-mix(in srgb, var(--black) 58%, transparent), color-mix(in srgb, var(--black) 88%, transparent)), url(${heroBg.src})`}>
    <div class="wrap">
      <p class="kicker">For builders and GCs</p>
      <h1>New-construction window installs for builders and GCs.</h1>
      <p class="lede">
        Nailing-fin windows, installed to your schedule.
      </p>
      <div class="hero-actions">
        <a class="btn btn-light" href={projectInquiryMailto}>Send plans or schedule</a>
        <a class="btn btn-ghost btn-on-dark" href={telHref()}>Call {site.phoneDisplay}</a>
      </div>
      <p class="hero-note">
        Existing-home work? <a href="/replacement">Window replacement</a>. Patio doors?{' '}
        <a href="/sliding-glass-doors">Sliding glass doors</a>.
      </p>
    </div>
    <p class="hero-photo-credit">Clearview job photo — new build with windows set</p>
  </section>

  <section class="section">
    <div class="wrap split" data-reveal>
      <article>
        <p class="rule-label">Installation sequence</p>
        <h2>From plans to set day.</h2>
        <p>
          We verify the opening schedule, provide project pricing and lead time, then install to your sequence.
        </p>
      </article>
      <article>
        <p class="rule-label">Contractor registration</p>
        <p>
          {site.legalName} · WA UBI {site.ubiNumber} · L&amp;I {site.lniNumber}.{' '}
          <a href="https://secure.lni.wa.gov/verify/" target="_blank" rel="noopener noreferrer">
            Verify registration
          </a>.
        </p>
      </article>
    </div>
  </section>

  <section class="section section-sunk" id="schedule">
    <div class="wrap split" data-reveal>
      <article>
        <p class="rule-label">For project pricing</p>
        <h2>Send plans or a window schedule.</h2>
        <p>We price the full scope and flag missing or conflicting specs before ordering.</p>
      </article>
      <article>
        <p class="rule-label">Include</p>
        <ul class="plain-list">
          <li>Opening count, sizes, and styles</li>
          <li>Brand, finish, and required glass or code specs</li>
          <li>Target set date and site contact</li>
        </ul>
        <p class="fine-print">
          <a href="/window-features">Window and glass options</a>
        </p>
      </article>
    </div>
  </section>

  <section class="section">
    <div class="wrap" data-reveal>
      <p class="rule-label">Opening requirements</p>
      <h2>Prep and flashing.</h2>
      <div class="ro-notes">
        <article>
          <h3>Rough opening</h3>
          <p>
            Follow the unit spec. Frame within 1/4&Prime; of square, corner to corner.
          </p>
        </article>
        <article>
          <h3>Weather barrier</h3>
          <p>
            Sheathing and properly lapped WRB must be complete before installation. No bare, unwrapped openings.
          </p>
        </article>
      </div>
      <FlashingOrder heading="Flashing sequence" builder />
    </div>
  </section>

  <section class="section section-sunk">
    <div class="wrap" data-reveal>
      <p class="rule-label">Project sequence</p>
      <h2>From schedule to handoff.</h2>
      <ol class="steps">
        {sequence.map((step) => (
          <li><strong>{step.name}.</strong> {step.text}</li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section">
    <div class="wrap" data-reveal>
      <p class="rule-label">Before set day</p>
      <h2>Site ready. Schedule confirmed.</h2>
      <ul class="plain-list">
        <li>Rough openings match the approved schedule</li>
        <li>Sheathing and WRB are complete; access is clear</li>
        <li>Superintendent or PM is available for schedule changes</li>
        <li>Siding, stucco, or EIFS follows our walk-through</li>
        <li>Openings and flashing are dry on install day</li>
      </ul>
    </div>
  </section>

  <section class="section section-sunk">
    <div class="wrap" data-reveal>
      <p class="rule-label">Scope</p>
      <h2>Clearview / Builder</h2>
      <div class="scope-split">
        <article class="scope-card">
          <h3>Clearview</h3>
          <ul class="plain-list">
            {scopeSplit.clearview.map((item) => <li>{item}</li>)}
          </ul>
        </article>
        <article class="scope-card">
          <h3>Builder / GC</h3>
          <ul class="plain-list">
            {scopeSplit.builder.map((item) => <li>{item}</li>)}
          </ul>
        </article>
      </div>
      <p class="fine-print">
        We price schedule changes and out-of-scope work before proceeding.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="wrap newbuild-band" data-reveal>
      <div>
        <p class="rule-label">Completed work</p>
        <h2>Installed and ready for the next trade.</h2>
        <p class="lede">
          See a recent new-construction installation.
        </p>
        <p class="section-link"><a href="/gallery">More of the work</a></p>
      </div>
      <div class="work-grid work-grid-newbuild">
        {newBuildWork.map((photo) => (
          <WorkCard
            image={photo.image}
            alt={photo.alt}
            caption={photo.caption}
            kind={workKindLabel(photo.kind)}
          />
        ))}
      </div>
    </div>
  </section>

  <section class="section section-sunk" id="project-inquiry">
    <div class="wrap is-narrow" data-reveal>
        <p class="rule-label">Request pricing</p>
        <h2>Send plans or request an estimate.</h2>
      <ol class="steps">
        <li>
          <strong>Email plans or schedule.</strong> Marked-up elevations welcome.
          <a href={projectInquiryMailto}>{site.email}</a>.
        </li>
        <li>
          <strong>Use the form.</strong> Choose "Builder or GC" and add the city, opening count, and target date.
          <a href="/estimate?role=builder">Request pricing</a>.
        </li>
      </ol>
      <p class="fine-print">
        Written price and lead time before ordering.
      </p>
    </div>
  </section>

  <CtaBar
    heading="Price your next window package."
    body="Send the plans or schedule for project pricing and lead time."
    showToolLink={false}
  />
</BaseLayout>

<style>
  /* Full-bleed photo hero, a real Clearview job. */
  .page-hero-photo {
    position: relative;
    background-size: cover;
    background-position: center;
  }

  .hero-photo-credit {
    position: absolute;
    right: var(--space-s);
    bottom: var(--space-2xs);
    margin: 0;
    font-size: var(--step--2);
    color: var(--on-dark-faint);
    opacity: 0.75;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-s);
    margin: var(--space-m) 0 0;
  }

  /* Cross-link to the other service page, set into the dark hero. The global
     `a { color: var(--ink) }` reads as invisible on this background, so the
     link gets its own on-dark treatment rather than inheriting it. */
  .hero-note {
    margin: var(--space-m) 0 0;
    max-width: 44rem;
    font-size: var(--step--1);
    color: var(--on-dark-faint);
  }

  .hero-note a {
    color: var(--on-dark);
    text-decoration: underline;
    text-decoration-color: var(--accent-bright);
    text-underline-offset: 0.2em;
  }

  .hero-note a:hover,
  .hero-note a:focus-visible {
    color: var(--accent-bright);
  }

  /* Two short notes beside the flashing diagram — framing tolerance and wall
     sequence — read better as a pair of cards than as more paragraph text
     competing with the diagram's own callouts below. */
  .ro-notes {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-m);
    margin: var(--space-l) 0 var(--space-xl);
  }

  .ro-notes article {
    padding: var(--space-m);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--paper-raised);
  }

  .ro-notes h3 {
    margin: 0 0 var(--space-2xs);
    font-size: var(--step-1);
  }

  .ro-notes p {
    margin: 0;
    color: var(--ink-soft);
    font-size: var(--step--1);
  }

  /* Same two-card device as window-features.astro's material/brand compare,
     reused for a scope split rather than a binary choice. */
  .scope-split {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-m);
    margin: var(--space-l) 0 var(--space-m);
  }

  .scope-card {
    padding: var(--space-m);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--paper-raised);
  }

  .scope-card h3 {
    margin: 0 0 var(--space-2xs);
    font-size: var(--step-1);
    text-transform: uppercase;
    letter-spacing: var(--tracking-label);
    color: var(--accent-ink);
  }

  .scope-card .plain-list li {
    font-size: var(--step--1);
    color: var(--ink-soft);
  }

  /* A single tall framing shot needs a partner, not a full-width grid row of
     its own — stretched across the page it read as a missing image. */
  .newbuild-band {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 0.7fr);
    gap: var(--space-xl);
    align-items: center;
  }

  @media (max-width: 900px) {
    .newbuild-band {
      grid-template-columns: 1fr;
      gap: var(--space-l);
    }

    .ro-notes,
    .scope-split {
      grid-template-columns: 1fr;
    }
  }
</style>
