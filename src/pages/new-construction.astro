---
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaBar from '../components/CtaBar.astro';
import WorkCard from '../components/WorkCard.astro';
import { newBuildWork } from '../data/work';
---
<BaseLayout
  title="New construction windows"
  description="Window setting for new Clark County builds: flashed openings, nailing-fin units, and a crew that works with your GC."
  path="/new-construction"
  crumbs={[{ name: 'New construction', href: '/new-construction' }]}
>
  <section class="page-hero">
    <div class="wrap">
      <p class="kicker">Services</p>
      <h1>New construction installs</h1>
      <p class="lede">
        Framed opening, housewrap, nailing fin, shims, and a unit that is plumb before the siding
        crew shows up.
      </p>
    </div>
  </section>
  <section class="section">
    <div class="wrap split">
      <article>
        <h2>What we set</h2>
        <p>
          New-construction vinyl and fiberglass with nailing fins, sized to the rough opening.
          We flash the sill, set the unit, and leave you ready for wrap and cladding.
        </p>
        <h2>How it runs</h2>
        <p>
          Confirm openings, confirm lead time, then a scheduled set — not a surprise on a framing
          day. Tell us if you are the GC or the owner so the quote is written for the right person.
        </p>
      </article>
      <article>
        <p class="kicker">Bring to the first call</p>
        <ul class="plain-list">
          <li>Plan or opening schedule</li>
          <li>Window style and finish</li>
          <li>Target set date</li>
          <li>Who is buying: builder or owner</li>
        </ul>
        <p class="fine-print">Ask for a reference on a build we set this season.</p>
      </article>
    </div>
  </section>
  <section class="section section-muted">
    <div class="wrap">
      <p class="kicker">From a framed job</p>
      <h2>Set, flashed, and out of the siding crew&rsquo;s way.</h2>
      <p class="lede">
        Nailing fins taped into the weather barrier, sill flashed, unit plumb. This is what we
        hand back to the builder.
      </p>
      <div class="work-grid work-grid-newbuild">
        {newBuildWork.map((photo) => (
          <WorkCard
            image={photo.image}
            alt={photo.alt}
            caption={photo.caption}
            kind={photo.kind}
          />
        ))}
      </div>
    </div>
  </section>

  <CtaBar />
</BaseLayout>
