---
import { getImage } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaBar from '../components/CtaBar.astro';
import FlashingOrder from '../components/diagrams/FlashingOrder.astro';
import WorkCard from '../components/WorkCard.astro';
import { newBuildWork, findWork, workKindLabel } from '../data/work';
import { site, mailHref, telHref } from '../data/site';

const ogPhoto = findWork('new-build-sheathed-garage')!;

// Full-bleed hero background: a real new-construction job.
const heroPhoto = findWork('new-build-tan-corner')!;
const heroBg = await getImage({ src: heroPhoto.image, width: 2400, format: 'webp', quality: 76 });

// Mirrors the numbered list below exactly — if the sequence changes, this
// must change with it, or the markup and the schema will say different
// things. See process.astro for the homeowner-side equivalent.
const sequence = [
  {
    name: 'Send the schedule',
    text: 'Send the plan set or window schedule. We verify sizes, styles, and quantities before quoting.',
  },
  {
    name: 'Written quote and lead time',
    text: 'Get one written price for the job and the manufacturer lead time for scheduling.',
  },
  {
    name: 'Order placed, framing checked',
    text: 'Before the set date, we confirm the rough openings match the quoted sizes. Changes after ordering can delay the job.',
  },
  {
    name: 'Set day, on your sequence',
    text: 'After sheathing and wrap, we set and flash each window before siding or stucco.',
  },
  {
    name: 'Walk and sign-off',
    text: 'We review each opening with your super or PM and hand the elevation back ready for the next trade.',
  },
];

const rowSchema = {
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name: 'How Clearview Windows sets windows on a new-construction build',
  description: 'The sequence Clearview Windows follows on a builder or GC job, from the opening schedule to the final walk with the site super.',
  step: sequence.map((step) => ({
    '@type': 'HowToStep',
    name: step.name,
    text: step.text,
  })),
};

// Same shape as the per-city Service schema in areas/[slug].astro, scoped to
// this service rather than one town. The sitewide hasOfferCatalog entry
// (JsonLd.astro) is just a name + url; this gives the service its own
// describable entity, so it is additive rather than a duplicate.
const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  serviceType: 'New construction window installation',
  name: 'New construction window installation',
  description:
    'Nailing-fin window setting for new Clark County builds, flashed to the rough opening and coordinated with the GC schedule.',
  provider: { '@id': `${site.url}/#business` },
  areaServed: site.nearby.map((place) => ({
    '@type': 'City',
    name: place.name,
    containedInPlace: { '@type': 'State', name: place.state },
  })),
};

const schema = { '@context': 'https://schema.org', '@graph': [serviceSchema, rowSchema] };

const scopeSplit = {
  clearview: [
    'Measuring every opening against the schedule before ordering, not after',
    'Ordering the units and carrying the manufacturer lead time',
    'Sill pan flashing, setting the unit plumb and square, and shimming it',
    'Jamb and head flashing lapped over the fins in the correct order',
    'Taping the fins into the weather-resistive barrier',
    'A walk-through with your super or PM before we leave the site',
  ],
  builder: [
    'Framing the rough openings to the sizes on the schedule',
    'Sheathing and housewrap (or equivalent WRB) on before we set',
    'A safe, clear path to each opening — no scaffolding or material staged in front of it',
    'Telling us about sequence changes before your set date, not on it',
    'Siding, trim, or stucco crews scheduled after our walk-through, not around us',
  ],
};

// mailHref() falls back to /estimate when site.email is unset — appending a
// mailto-style query string to that would silently get ignored by
// EstimateForm, dropping the builder role prefill along with it. Route the
// no-email case through ?role=builder instead so the fallback still lands
// where it's supposed to.
const projectInquiryMailto = site.email
  ? mailHref() + `?subject=${encodeURIComponent('New construction project — plans/schedule attached')}` +
    `&body=${encodeURIComponent('Project address or subdivision:\nBuilder / GC company:\nApproximate opening count:\nTarget set date:\n\n(Attach the plan set or window schedule if you have one.)')}`
  : '/estimate?role=builder';
---
<BaseLayout
  title="New construction windows for builders and GCs"
  description="Window setting for new Clark County builds: send the plan or window schedule, get a written quote and lead time, and windows set to your sequence."
  path="/new-construction"
  crumbs={[{ name: 'New construction', href: '/new-construction' }]}
  ogImageSrc={ogPhoto.image}
  ogImageAlt={ogPhoto.alt}
  schema={schema}
>
  <section class="page-hero page-hero-photo" style={`background-image: linear-gradient(180deg, color-mix(in srgb, var(--black) 58%, transparent), color-mix(in srgb, var(--black) 88%, transparent)), url(${heroBg.src})`}>
    <div class="wrap">
      <p class="kicker">For builders and GCs</p>
      <h1>New construction window installation for builders and general contractors.</h1>
      <p class="lede">
        Send the plan or window schedule, get a written quote with a lead time attached, and a set
        date your siding crew can actually plan around.
      </p>
      <div class="hero-actions">
        <a class="btn btn-light" href={projectInquiryMailto}>Email the plans or schedule</a>
        <a class="btn btn-ghost btn-on-dark" href={telHref()}>Call {site.phoneDisplay}</a>
      </div>
      <p class="hero-note">
        Homeowner replacing windows in a house that is already standing? See{' '}
        <a href="/replacement">window replacement</a> instead. Setting a patio door on the build?
        See <a href="/sliding-glass-doors">sliding glass doors</a>.
      </p>
    </div>
    <p class="hero-photo-credit">Clearview job photo — new build with windows set</p>
  </section>

  <section class="section">
    <div class="wrap split" data-reveal>
      <article>
        <p class="rule-label">How we work</p>
        <h2>From schedule to set day.</h2>
        <p>
          We verify the schedule, confirm each opening, order the windows, and install to your build sequence.
        </p>
        <p>
          Schedule changes can delay siding and other trades. Let us know early so we can confirm a workable set date.
        </p>
      </article>
      <article>
        <p class="rule-label">The business behind it</p>
        <p>
          {site.legalName} is a Washington-registered LLC (UBI {site.ubiNumber}) and WA L&amp;I contractor
          (registration {site.lniNumber}).{' '}
          <a href="https://secure.lni.wa.gov/verify/" target="_blank" rel="noopener noreferrer">
            Verify our registration
          </a>.
        </p>
      </article>
    </div>
  </section>

  <section class="section section-sunk" id="schedule">
    <div class="wrap split" data-reveal>
      <article>
        <p class="rule-label">What we need from you</p>
        <h2>The window schedule, or the plan set.</h2>
        <p>
          Either works. We confirm sizes, styles, and quantities, flag unclear details, and quote the full job—not a per-window guess.
        </p>
        <p>
          Include any required bedroom egress, tempered glass, or U-factor specifications. We order to the plans and code requirements, not a default spec.
        </p>
      </article>
      <article>
        <p class="rule-label">Bring to the first call</p>
        <ul class="plain-list">
          <li>Plan set or window schedule</li>
          <li>Approximate opening count</li>
          <li>Window style, brand preference if any, and finish</li>
          <li>Target set date and who to coordinate sequence with</li>
        </ul>
        <p class="fine-print">
          Not sure which materials or brands fit the spec? See{' '}
          <a href="/window-features">vinyl vs fiberglass, glass packages, and every style</a>.
        </p>
      </article>
    </div>
  </section>

  <section class="section">
    <div class="wrap" data-reveal>
      <p class="rule-label">The part that decides whether it leaks</p>
      <h2>Rough opening and flashing expectations.</h2>
      <p class="lede">
        Correct opening prep and flashing protect the assembly. Here are the rough-opening requirements and installation sequence.
      </p>
      <div class="ro-notes">
        <article>
          <h3>Opening tolerance</h3>
          <p>
            Follow the ordered unit's rough-opening spec; it varies by product. Keep openings within 1/4&Prime; of square corner-to-corner for a clean install and trim reveal.
          </p>
        </article>
        <article>
          <h3>Sequence at the wall</h3>
          <p>
            Sheathing and housewrap (or another weather-resistive barrier) must be installed and properly lapped before we set. We do not install into bare, unwrapped openings.
          </p>
        </article>
      </div>
      <FlashingOrder />
    </div>
  </section>

  <section class="section section-sunk">
    <div class="wrap" data-reveal>
      <p class="rule-label">In this order, every build</p>
      <h2>The set, start to finish.</h2>
      <ol class="steps">
        {sequence.map((step) => (
          <li><strong>{step.name}.</strong> {step.text}</li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section">
    <div class="wrap" data-reveal>
      <p class="rule-label">Jobsite coordination</p>
      <h2>What has to be true before we set a date.</h2>
      <p class="lede">
        These jobsite conditions help keep the set date on track:
      </p>
      <ul class="plain-list">
        <li>Openings framed to the sizes on the schedule we quoted — not "close enough"</li>
        <li>Sheathing and housewrap on, with a clear path to every opening</li>
        <li>A super or PM we can reach directly if the schedule moves, in either direction</li>
        <li>Siding, stucco, or EIFS scheduled after our walk-through, so nothing gets flashed over a problem</li>
        <li>A rain-day understanding — flashing goes in dry or it does not go in at all</li>
      </ul>
    </div>
  </section>

  <section class="section section-sunk">
    <div class="wrap" data-reveal>
      <p class="rule-label">Scope, in writing</p>
      <h2>What Clearview handles. What the builder handles.</h2>
      <div class="scope-split">
        <article class="scope-card">
          <h3>Clearview</h3>
          <ul class="plain-list">
            {scopeSplit.clearview.map((item) => <li>{item}</li>)}
          </ul>
        </article>
        <article class="scope-card">
          <h3>Builder / GC</h3>
          <ul class="plain-list">
            {scopeSplit.builder.map((item) => <li>{item}</li>)}
          </ul>
        </article>
      </div>
      <p class="fine-print">
        We flag out-of-scope work or openings that differ from the schedule before proceeding.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="wrap newbuild-band" data-reveal>
      <div>
        <p class="rule-label">From a framed job</p>
        <h2>Set, flashed, and out of the siding crew&rsquo;s way.</h2>
        <p class="lede">
          Windows set plumb, sill flashed, and nailing fins integrated with the weather barrier—ready for the next trade.
        </p>
        <p class="section-link"><a href="/gallery">More of the work</a></p>
      </div>
      <div class="work-grid work-grid-newbuild">
        {newBuildWork.map((photo) => (
          <WorkCard
            image={photo.image}
            alt={photo.alt}
            caption={photo.caption}
            kind={workKindLabel(photo.kind)}
          />
        ))}
      </div>
    </div>
  </section>

  <section class="section section-sunk" id="project-inquiry">
    <div class="wrap is-narrow" data-reveal>
      <p class="rule-label">Start a project</p>
      <h2>Send the plans or the schedule. We take it from there.</h2>
      <p>
        Send the plans or use the builder estimate form:
      </p>
      <ol class="steps">
        <li>
          <strong>Email the plans or schedule.</strong> A marked-up elevation works too.
          <a href={projectInquiryMailto}>{site.email}</a> opens with the project details we need.
        </li>
        <li>
          <strong>Prefer the form?</strong> Choose "Builder or GC" and include the city, opening count, and target date.
          <a href="/estimate?role=builder">Open the builder estimate form</a>.
        </li>
      </ol>
      <p class="fine-print">
        We’ll follow up with a written quote and lead time before ordering.
      </p>
    </div>
  </section>

  <CtaBar
    heading="Tell us the opening schedule."
    body="Send the plan or the opening count and we will come back with a set date and a written estimate."
  />
</BaseLayout>

<style>
  /* Full-bleed photo hero, a real Clearview job. */
  .page-hero-photo {
    position: relative;
    background-size: cover;
    background-position: center;
  }

  .hero-photo-credit {
    position: absolute;
    right: var(--space-s);
    bottom: var(--space-2xs);
    margin: 0;
    font-size: var(--step--2);
    color: var(--on-dark-faint);
    opacity: 0.75;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-s);
    margin: var(--space-m) 0 0;
  }

  /* Cross-link to the other service page, set into the dark hero. The global
     `a { color: var(--ink) }` reads as invisible on this background, so the
     link gets its own on-dark treatment rather than inheriting it. */
  .hero-note {
    margin: var(--space-m) 0 0;
    max-width: 44rem;
    font-size: var(--step--1);
    color: var(--on-dark-faint);
  }

  .hero-note a {
    color: var(--on-dark);
    text-decoration: underline;
    text-decoration-color: var(--accent-bright);
    text-underline-offset: 0.2em;
  }

  .hero-note a:hover,
  .hero-note a:focus-visible {
    color: var(--accent-bright);
  }

  /* Two short notes beside the flashing diagram — framing tolerance and wall
     sequence — read better as a pair of cards than as more paragraph text
     competing with the diagram's own callouts below. */
  .ro-notes {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-m);
    margin: var(--space-l) 0 var(--space-xl);
  }

  .ro-notes article {
    padding: var(--space-m);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--paper-raised);
  }

  .ro-notes h3 {
    margin: 0 0 var(--space-2xs);
    font-size: var(--step-1);
  }

  .ro-notes p {
    margin: 0;
    color: var(--ink-soft);
    font-size: var(--step--1);
  }

  /* Same two-card device as window-features.astro's material/brand compare,
     reused for a scope split rather than a binary choice. */
  .scope-split {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-m);
    margin: var(--space-l) 0 var(--space-m);
  }

  .scope-card {
    padding: var(--space-m);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--paper-raised);
  }

  .scope-card h3 {
    margin: 0 0 var(--space-2xs);
    font-size: var(--step-1);
    text-transform: uppercase;
    letter-spacing: var(--tracking-label);
    color: var(--accent-ink);
  }

  .scope-card .plain-list li {
    font-size: var(--step--1);
    color: var(--ink-soft);
  }

  /* A single tall framing shot needs a partner, not a full-width grid row of
     its own — stretched across the page it read as a missing image. */
  .newbuild-band {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 0.7fr);
    gap: var(--space-xl);
    align-items: center;
  }

  @media (max-width: 900px) {
    .newbuild-band {
      grid-template-columns: 1fr;
      gap: var(--space-l);
    }

    .ro-notes,
    .scope-split {
      grid-template-columns: 1fr;
    }
  }
</style>
