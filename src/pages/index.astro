---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import VideoHero from '../components/VideoHero.astro';
import CtaBar from '../components/CtaBar.astro';
import WorkCard from '../components/WorkCard.astro';
import { site } from '../data/site';
import { featuredWork } from '../data/work';
const guides = (await getCollection('guides', ({ data }) => data.published)).sort(
  (a, b) => a.data.order - b.data.order,
);

const signs = [
  {
    title: 'Drafts at a closed window',
    text: 'Air at the lock or stool means the weatherstrip or frame has given up.',
    href: '/guides/signs-you-need-new-windows',
  },
  {
    title: 'Fog between the panes',
    text: 'That haze is a failed sealed unit. Cleaning will not reach it.',
    href: '/guides/fogged-windows',
  },
  {
    title: 'Sashes that fight you',
    text: 'Sticky, dropped, or unlocked sashes often mean the opening is no longer square.',
    href: '/guides/signs-you-need-new-windows',
  },
  {
    title: 'Soft or stained sills',
    text: 'Washington rain finds the weak corner. Soft wood is water in the wall.',
    href: '/guides/signs-you-need-new-windows',
  },
  {
    title: 'A room that never evens out',
    text: 'Cold glass makes a cold chair even when the thermostat is fine.',
    href: '/guides/signs-you-need-new-windows',
  },
  {
    title: 'A bill that does not add up',
    text: 'Windows are a small wall and a large leak. Start with the openings you can feel.',
    href: '/guides/window-replacement-cost-washington',
  },
];
---
<BaseLayout title={site.shortName} description={site.description} path="/">
  <VideoHero />

  <section class="section" id="signs">
    <div class="wrap">
      <p class="kicker">Is it time?</p>
      <h2>Six signs the window is the problem</h2>
      <p class="lede">
        If two of these are true in the same room, a measure is worth a morning. Each card opens
        a short guide.
      </p>
      <div class="cards signs">
        {signs.map((sign, index) => (
          <a class="card sign" href={sign.href}>
            <span class="sign-num">{String(index + 1).padStart(2, '0')}</span>
            <h3>{sign.title}</h3>
            <p>{sign.text}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-muted">
    <div class="wrap">
      <p class="kicker">What actually changes</p>
      <h2>Comfort first. Then the bill. Then the wall.</h2>
      <div class="cards metrics">
        <article class="card">
          <p class="kicker">Comfort</p>
          <h3>Sit next to the glass in January</h3>
          <p>New units raise the inside face of the glass and stop the draft at the lock. The room feels even before anyone talks about U-factor.</p>
        </article>
        <article class="card">
          <p class="kicker">Moisture</p>
          <h3>Fog you cannot wipe is a failed unit</h3>
          <p>Haze between panes means the seal is gone. Room-side sweat is often humidity. We tell those apart on site. <a href="/guides/fogged-windows">How to look</a>.</p>
        </article>
        <article class="card">
          <p class="kicker">Energy</p>
          <h3>Less work for a long heating season</h3>
          <p>Windows are a small share of the wall and a large share of heat loss. Savings are real on tired single-pane. They are modest if the glass is already decent.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap split">
      <div>
        <p class="kicker">How a job runs</p>
        <h2>Measure once. Install clean.</h2>
        <p>Walkthrough, written estimate, openings measured for insert or full-frame, then a crew that leaves the rooms usable.</p>
        <p><a href="/process">See the process</a> · <a href="/guides/full-frame-vs-insert">Insert vs full-frame</a></p>
      </div>
      <ol class="steps">
        <li><strong>Walkthrough.</strong> We look at glass, sills, and trim — not just a count.</li>
        <li><strong>Order.</strong> Each opening is sized for the method that opening needs.</li>
        <li><strong>Install.</strong> Old units out. New units plumb, flashed, and operable.</li>
        <li><strong>Walk the job.</strong> You try every sash. Debris leaves with us.</li>
      </ol>
    </div>
  </section>

  <section class="section section-muted">
    <div class="wrap">
      <p class="kicker">From the truck</p>
      <h2>Recent work</h2>
      <p class="lede">Real openings in Washington houses — not stock. More on the gallery, including install-day shots.</p>
      <div class="work-grid work-grid-home">
        {featuredWork.map((photo) => (
          <WorkCard
            src={photo.src}
            alt={photo.alt}
            caption={photo.caption}
            kind={photo.kind}
          />
        ))}
      </div>
      <p><a href="/gallery">See the full gallery</a></p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <p class="kicker">Learn first</p>
      <h2>Guides for the questions before the call</h2>
      <div class="cards">
        {guides.map((guide) => (
          <article class="card">
            <p class="kicker">{guide.data.topic}</p>
            <h3><a href={`/guides/${guide.id}`}>{guide.data.title}</a></h3>
            <p>{guide.data.description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <CtaBar />
</BaseLayout>
