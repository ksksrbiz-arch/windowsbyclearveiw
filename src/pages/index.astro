---
import { getCollection } from 'astro:content';
import { getImage } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import VideoHero from '../components/VideoHero.astro';
import CtaBar from '../components/CtaBar.astro';
import WorkCard from '../components/WorkCard.astro';
import FacebookIcon from '../components/icons/FacebookIcon.astro';
import { Image } from 'astro:assets';
import { site } from '../data/site';
import { featuredWork, findWork, workKindLabel } from '../data/work';
import slidingDoorsTileSrc from '../assets/hero/sliding-glass-doors.png';

const replacementTile = findWork('stone-craftsman')!;
const newBuildTile = findWork('new-build-sheathed-garage')!;

// The sliding-doors tile has no real installed-job photo yet (see
// sliding-glass-doors.astro), so unlike the two tiles above it borrows the
// same AI-generated hero image that page uses. TODO: swap for a real
// installed-job photo once one exists, same as the other two tiles.
const slidingDoorsTile = await getImage({ src: slidingDoorsTileSrc, width: 900, format: 'webp', quality: 72 });

const serviceLinks = [
  { slug: 'vancouver', label: 'Vancouver' },
  { slug: 'camas', label: 'Camas' },
  { slug: 'washougal', label: 'Washougal' },
  { slug: 'battle-ground', label: 'Battle Ground' },
  { slug: 'brush-prairie', label: 'Brush Prairie' },
  { slug: 'ridgefield', label: 'Ridgefield' },
  { slug: 'la-center', label: 'La Center' },
  { slug: 'woodland', label: 'Woodland' },
  { slug: 'portland', label: 'Portland, OR' },
];
const guides = (await getCollection('guides', ({ data }) => data.published)).sort(
  (a, b) => a.data.order - b.data.order,
);

const signs = [
  {
    title: 'Drafts at a closed window',
    text: 'Air at the lock or stool means the weatherstrip or frame has given up.',
    href: '/guides/signs-you-need-new-windows',
  },
  {
    title: 'Fog between the panes',
    text: 'That haze is a failed sealed unit. Cleaning will not reach it.',
    href: '/guides/fogged-windows',
  },
  {
    title: 'Sashes that fight you',
    text: 'Sticky, dropped, or unlocked sashes often mean the opening is no longer square.',
    href: '/guides/signs-you-need-new-windows',
  },
  {
    title: 'Soft or stained sills',
    text: 'Washington rain finds the weak corner. Soft wood is water in the wall.',
    href: '/guides/signs-you-need-new-windows',
  },
  {
    title: 'A room that is never comfortable',
    text: 'Cold glass makes a cold chair even when the thermostat is fine.',
    href: '/guides/signs-you-need-new-windows',
  },
  {
    title: 'A heating bill that keeps climbing',
    text: 'Windows are a small share of the wall and a large share of the leak.',
    href: '/guides/window-replacement-cost-washington',
  },
];
---
<BaseLayout
  title="Window Replacement in Vancouver, WA"
  description={site.metaDescription}
  path="/"
>
  <VideoHero />

  <section class="section is-airy">
    <div class="wrap" data-reveal>
      <p class="rule-label">Three kinds of work</p>
      <h2>Replace what’s there. Set the new ones. Open up the wall.</h2>
      <p class="lede">Same crew, same standards, every time. Pick the job that’s yours.</p>
      <div class="service-tiles">
        <a class="service-tile" href="/replacement">
          <Image
            src={replacementTile.image}
            alt=""
            widths={[400, 640, 900]}
            sizes="(max-width: 800px) 100vw, 33vw"
            format="webp"
            quality={72}
          />
          <div class="service-tile-copy">
            <p class="kicker">Homeowners</p>
            <h2>Replacement</h2>
            <p>Pull the tired unit. Leave the room usable.</p>
          </div>
        </a>
        <a class="service-tile" href="/new-construction">
          <Image
            src={newBuildTile.image}
            alt=""
            widths={[400, 640, 900]}
            sizes="(max-width: 800px) 100vw, 33vw"
            format="webp"
            quality={72}
          />
          <div class="service-tile-copy">
            <p class="kicker">Builders</p>
            <h2>New construction</h2>
            <p>Flashed openings. Nailing fins. Ready for siding.</p>
          </div>
        </a>
        <a class="service-tile" href="/sliding-glass-doors">
          <img src={slidingDoorsTile.src} alt="" loading="lazy" decoding="async" />
          <div class="service-tile-copy">
            <p class="kicker">Homeowners <span class="tile-badge">Concept imagery</span></p>
            <h2>Sliding glass doors</h2>
            <p>Standard, multi-panel, and French rail patio doors.</p>
          </div>
        </a>
      </div>
    </div>
  </section>

  <section class="section section-sunk" id="signs">
    <div class="wrap" data-reveal>
      <p class="rule-label">Is it time?</p>
      <h2>Six signs the window is the problem</h2>
      <p class="lede">
        If two of these are true in the same room, a measure is worth a morning.
      </p>
      <div class="spec-list">
        {signs.map((sign, index) => (
          <a class="spec" href={sign.href}>
            <span class="spec-num">{String(index + 1).padStart(2, '0')}</span>
            <span>
              <h3>{sign.title}</h3>
              <p>{sign.text}</p>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-dark is-airy" id="what-changes">
    <div class="wrap" data-reveal>
      <p class="rule-label">What actually changes</p>
      <h2>What you’ll notice: comfort, moisture, and the bill.</h2>
      <div class="metric-row">
        <article class="metric">
          <p class="kicker">Comfort</p>
          <h3>Sit next to the glass in January</h3>
          <p>New units raise the inside face of the glass and stop the draft at the lock. The room feels even before anyone talks about U-factor.</p>
        </article>
        <article class="metric">
          <p class="kicker">Moisture</p>
          <h3>Fog you cannot wipe is a failed unit</h3>
          <p>Haze between panes means the seal is gone. Room-side sweat is often humidity. We tell those apart on site — <a href="/guides/fogged-windows">how to spot the difference</a>.</p>
        </article>
        <article class="metric">
          <p class="kicker">Energy</p>
          <h3>Less work for a long heating season</h3>
          <p>Windows are a small share of the wall and a large share of heat loss. Savings are real on tired single-pane. They are modest if the glass is already decent.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap split" data-reveal>
      <div>
        <p class="rule-label">How a job runs</p>
        <h2>Measure once. Install clean.</h2>
        <p>Walkthrough, written estimate, openings measured for insert or full-frame, then a crew that leaves the rooms usable.</p>
        <p><a href="/process">See the process</a> · <a href="/guides/full-frame-vs-insert">Insert vs full-frame</a></p>
      </div>
      <ol class="steps">
        <li><strong>Walkthrough.</strong> We look at glass, sills, and trim — not just a count.</li>
        <li><strong>Order.</strong> Each opening is sized for the method that opening needs.</li>
        <li><strong>Install.</strong> Old units out. New units plumb, flashed, and operable.</li>
        <li><strong>Walk the job.</strong> You try every sash. Debris leaves with us.</li>
      </ol>
    </div>
  </section>

  <section class="section section-sunk is-airy" id="work">
    <div class="wrap is-wide" data-reveal>
      <p class="rule-label">From the truck</p>
      <h2>Recent work</h2>
      <p class="lede">Real openings in Washington houses — not stock.</p>
      <div class="work-grid work-grid-home">
        {featuredWork.map((photo) => (
          <WorkCard
            image={photo.image}
            alt={photo.alt}
            caption={photo.caption}
            kind={workKindLabel(photo.kind)}
          />
        ))}
      </div>
      <p class="section-link"><a href="/gallery">See the full gallery</a></p>
      {site.social.facebook && (
        <p class="section-link">
          <a class="inline-social" href={site.social.facebook} target="_blank" rel="noopener noreferrer">
            <FacebookIcon class="inline-social-icon" />
            New jobs go up on Facebook first
          </a>
        </p>
      )}
      <p class="areas-inline">
        Working in{' '}
        {serviceLinks.map((place, index) => (
          <>
            <a href={`/areas/${place.slug}`}>{place.label}</a>
            {index < serviceLinks.length - 2
              ? ', '
              : index === serviceLinks.length - 2
                ? ', and '
                : '.'}
          </>
        ))}
      </p>
    </div>
  </section>

  <section class="section">
    <div class="wrap" data-reveal>
      <p class="rule-label">Learn first</p>
      <h2>Guides before the call</h2>
      <div class="guide-rows">
        {guides.map((guide) => (
          <a class="guide-row" href={`/guides/${guide.id}`}>
            <span class="kicker">{guide.data.topic}</span>
            <strong>{guide.data.title}</strong>
            <span>{guide.data.description}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <CtaBar />
</BaseLayout>

<style>
  /* ───────────────────────────────────────────────────────────────────────
     Homepage-specific styling. Scoped, so none of it can leak into the
     seventeen other pages that used to share every selector on this site.

     The problem being fixed: eight bands in a row, all paper-coloured, all
     the same padding, all starting with a small grey label. The rhythm now
     alternates surface and density, and each band gets a device of its own.
     ─────────────────────────────────────────────────────────────────────── */

  /* Service tiles ─────────────────────────────────────────────────────── */
  .service-tiles {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-xs);
    margin-top: var(--space-l);
  }

  .service-tile {
    position: relative;
    display: block;
    min-height: clamp(320px, 32vw, 460px);
    border-radius: var(--radius);
    overflow: hidden;
    color: var(--on-dark);
    text-decoration: none;
    background: var(--black);
  }

  .service-tile img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--dur-slow) var(--ease-out);
  }

  .service-tile:hover img,
  .service-tile:focus-visible img {
    transform: scale(1.045);
  }

  .service-tile-copy {
    position: absolute;
    inset: auto 0 0;
    padding: var(--space-2xl) var(--space-m) var(--space-m);
    background: linear-gradient(transparent, rgb(11 12 14 / 0.86) 62%);
  }

  .service-tile .kicker {
    margin-bottom: var(--space-3xs);
    color: var(--accent-bright);
  }

  .service-tile h2 {
    margin: 0 0 var(--space-3xs);
    font-size: var(--step-3);
    color: var(--on-dark);
  }

  .service-tile p {
    margin: 0;
    color: var(--on-dark-soft);
    font-size: var(--step--1);
  }

  .tile-badge {
    display: inline-block;
    margin-left: 0.45rem;
    padding: 0.18rem 0.4rem;
    border: 1px solid color-mix(in srgb, var(--accent-bright) 46%, transparent);
    border-radius: 999px;
    color: var(--on-dark-faint);
    font-size: 0.68em;
    line-height: 1.1;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    vertical-align: 0.12em;
  }

  /* An accent rule that draws in on hover: the only motion on the tile that
     is not the photo, so it reads as an affordance rather than decoration. */
  .service-tile::after {
    content: '';
    position: absolute;
    left: var(--space-m);
    right: var(--space-m);
    bottom: 0;
    height: 2px;
    background: var(--accent-bright);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--dur) var(--ease-out);
  }

  .service-tile:hover::after,
  .service-tile:focus-visible::after {
    transform: scaleX(1);
  }

  /* Six signs ─────────────────────────────────────────────────────────── */
  .spec-list {
    display: grid;
    grid-template-columns: 1fr 1fr;
    margin-top: var(--space-l);
    border-top: 1px solid var(--line);
  }

  .spec {
    position: relative;
    display: grid;
    grid-template-columns: 3.4rem minmax(0, 1fr);
    gap: var(--space-s);
    align-items: start;
    padding: var(--space-m) var(--space-m) var(--space-m) 0;
    border-bottom: 1px solid var(--line);
    text-decoration: none;
    color: inherit;
    transition: background var(--dur-fast) var(--ease);
  }

  .spec:nth-child(even) {
    padding-left: var(--space-m);
    border-left: 1px solid var(--line);
  }

  .spec:hover,
  .spec:focus-visible {
    background: var(--accent-wash);
  }

  /* The numeral is the device for this band. Big, light, and accent-tinted on
     hover — it gives the list a spine that six identical rows never had. */
  .spec-num {
    font-size: var(--step-3);
    font-weight: 600;
    line-height: 1;
    letter-spacing: var(--tracking-display);
    color: var(--ink-numeral);
    transition: color var(--dur-fast) var(--ease);
    font-variant-numeric: tabular-nums;
  }

  .spec:hover .spec-num,
  .spec:focus-visible .spec-num {
    color: var(--accent);
  }

  .spec h3 {
    margin: 0 0 var(--space-3xs);
    font-size: var(--step-1);
  }

  .spec p {
    margin: 0;
    color: var(--ink-soft);
    font-size: var(--step--1);
  }

  /* Metrics, on the dark band ─────────────────────────────────────────── */
  .metric-row {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0;
    margin-top: var(--space-l);
    border-top: 1px solid var(--dark-line-strong);
  }

  .metric {
    padding: var(--space-m) var(--space-m) 0 0;
    border-right: 1px solid var(--dark-line);
  }

  .metric:last-child {
    border-right: 0;
  }

  .metric + .metric {
    padding-left: var(--space-m);
  }

  .metric .kicker {
    color: var(--accent-bright);
  }

  .metric h3 {
    margin: 0 0 var(--space-2xs);
    font-size: var(--step-1);
    color: var(--on-dark);
  }

  .metric p {
    margin: 0;
    color: var(--on-dark-soft);
    font-size: var(--step--1);
  }

  .metric a {
    color: var(--on-dark);
    text-underline-offset: 0.2em;
  }

  /* Guides ────────────────────────────────────────────────────────────── */
  .guide-rows {
    margin-top: var(--space-l);
    border-top: 1px solid var(--line);
  }

  .guide-row {
    display: grid;
    grid-template-columns: 10rem minmax(0, 18rem) minmax(0, 1fr) 2rem;
    gap: var(--space-m);
    align-items: baseline;
    padding: var(--space-m) 0;
    border-bottom: 1px solid var(--line);
    text-decoration: none;
    color: inherit;
    transition: padding-left var(--dur) var(--ease-out), background var(--dur-fast) var(--ease);
  }

  .guide-row:hover,
  .guide-row:focus-visible {
    background: var(--accent-wash);
    padding-left: var(--space-s);
  }

  .guide-row .kicker {
    margin: 0;
    color: var(--ink-faint);
  }

  .guide-row strong {
    font-size: var(--step-1);
    font-weight: 600;
    letter-spacing: -0.015em;
    line-height: 1.2;
  }

  .guide-row > span:last-of-type {
    color: var(--ink-soft);
    font-size: var(--step--1);
  }

  /* A chevron that only exists once the row is a target. */
  .guide-row::after {
    content: '→';
    justify-self: end;
    color: var(--accent);
    opacity: 0;
    transform: translateX(-0.4rem);
    transition: opacity var(--dur) var(--ease), transform var(--dur) var(--ease-out);
  }

  .guide-row:hover::after,
  .guide-row:focus-visible::after {
    opacity: 1;
    transform: none;
  }

  @media (max-width: 900px) {
    .service-tiles,
    .spec-list,
    .metric-row {
      grid-template-columns: 1fr;
    }

    .spec,
    .spec:nth-child(even) {
      padding-left: 0;
      padding-right: 0;
      border-left: 0;
    }

    .spec:hover,
    .spec:focus-visible {
      background: transparent;
    }

    .metric {
      padding: var(--space-m) 0 0;
      border-right: 0;
    }

    .metric + .metric {
      padding-left: 0;
      border-top: 1px solid var(--dark-line);
    }

    .guide-row {
      grid-template-columns: 1fr;
      gap: var(--space-2xs);
      align-items: start;
    }

    .guide-row:hover,
    .guide-row:focus-visible {
      padding-left: 0;
      background: transparent;
    }

    .guide-row::after {
      display: none;
    }
  }
</style>
