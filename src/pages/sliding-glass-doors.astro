---
import { getImage, Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaBar from '../components/CtaBar.astro';
import WorkCard from '../components/WorkCard.astro';
import { pricing } from '../data/pricing';
import { findWork, workKindLabel } from '../data/work';
import { site } from '../data/site';

// Real installed sliding-door jobs, added 2026-09-27 — the OG image and the
// hero background now show actual doors instead of the AI-generated concept
// image and a window photo borrowed for lack of one.
const doorWork = [findWork('gray-siding-white-slider-deck')!, findWork('tan-slider-kitchen-view')!];
const ogPhoto = doorWork[0];

// Full-bleed hero background, cropped from the same real elevation as the
// gallery below (see the "Real installs" section) rather than AI imagery.
const heroBg = await getImage({ src: doorWork[0].image, width: 2400, format: 'webp', quality: 76 });

// The estimator already prices sliding patio doors as their own opening type
// (doors are not brand-specific — see pricing.ts) — reuse that single source
// of truth rather than hand-writing a second number here.
const doorPricing = pricing.openings.find((opening) => opening.id === 'sliding-door')!;
const frenchDoor = pricing.openings.find((opening) => opening.id === 'french-door');

const types = [
  {
    name: 'Standard two-panel slider',
    text: 'One fixed panel, one that slides past it. The most common patio door in Clark County.',
  },
  {
    name: 'Three- and four-panel sliders',
    text: 'Wider openings, either stacking to one side or splitting from the center. More glass, more weight per panel, and a track built to carry it.',
  },
  {
    name: 'French rail (swinging) sliders',
    text: 'Panels that glide on a French-style rail rather than a standard track — a different look at the sill, same sliding operation.',
  },
  {
    name: 'Impact-rated glass',
    text: 'Impact-rated glass is not a common request in Clark County, but a heavier impact-rated glass package can be special-ordered through the same manufacturers.',
  },
];

const considerations = [
  {
    name: 'Like-for-like replacement',
    text: 'The new door goes into the existing opening, with the same width and header. Most patio door jobs are like this: we measure, order, install, and flash the sill. There are no framing changes, and permits are whatever your city already requires for a door replacement.',
  },
  {
    name: 'Widening or enlarging the opening',
    text: 'If you want more glass than the door you have now, such as going from a window to a slider or from a two-panel to a four-panel, the header has to change. That is structural work: a new header sized for the wider span and, in most Clark County jurisdictions, a permit. We work out the header before we quote a number, not after the wall is open.',
  },
  {
    name: 'A new opening on an addition or build',
    text: 'A patio door in a wall that is not built yet is a new-construction install, not a replacement. The rough opening is framed to the door schedule and flashed like any new-construction window. See the full sequence on the new-construction page.',
  },
];

const measuring = [
  {
    name: 'The opening, not the old door',
    text: 'We measure the framed opening itself: width, height, and how square the corners are. The new door is ordered to fit that, not the size printed on the old door’s spec sheet.',
  },
  {
    name: 'Panels and opening width',
    text: 'A wider opening does not automatically mean more panels. Two panels covering 12 feet is a heavier, harder-operating door than four panels covering the same span. We talk through configuration against how you actually want it to open before ordering.',
  },
  {
    name: 'Sill height and the floor transition',
    text: 'The sill sits relative to your finished interior floor and whatever is outside it — a deck, a patio slab, or grade. Get that height wrong and you either trip over a lip walking out or send water back inside during a hard rain. We check it against both sides before the door is ordered.',
  },
  {
    name: 'Clearance for panels and screens',
    text: 'The fixed panel side needs wall or window trim clear of it, and a stacking multi-panel door needs room for the panels to gather at one end. We check furniture placement and adjacent openings at the measure, not after delivery.',
  },
];

const benefits = [
  {
    name: 'Natural light',
    text: 'More glass than any window in the house, in one opening.',
  },
  {
    name: 'Space-saving operation',
    text: 'A slider needs no swing radius. Furniture can sit closer to the opening than it ever could next to a hinged door.',
  },
  {
    name: 'Energy efficiency',
    text: 'The same insulated, Low-E glass packages as our windows, chosen for a Pacific Northwest heating season.',
  },
  {
    name: 'Indoor–outdoor flow',
    text: 'The usual reason to add or replace one: a deck, patio, or backyard that feels like part of the house.',
  },
];

const steps = [
  {
    name: 'Walkthrough and measure',
    text: 'We measure the rough opening and the sill height against both the interior floor and what is outside, and talk through the configuration: what you want from the door, such as light, access, or both.',
  },
  {
    name: 'Written quote and order',
    text: 'You get a written quote for the configuration you picked before anything is ordered. Once you sign off, the door is ordered to your rough opening. Lead times vary by manufacturer and panel count, and we give you the actual lead time, not a guess.',
  },
  {
    name: 'Install day',
    text: 'The old door comes out, or the opening is framed first on a new build or a widened opening. The new door goes in plumb and level, with the sill flashed before trim goes back on. A like-for-like replacement is usually a one-day job; it takes longer if the header changes.',
  },
  {
    name: 'Final walkthrough',
    text: 'We operate every panel with you, check the lock, latch, and screen, haul away debris, and leave the room usable the same day.',
  },
];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  serviceType: 'Sliding glass door installation',
  name: 'Sliding glass door installation',
  description:
    'Sliding glass patio door installation and replacement for Vancouver, WA and Clark County homes — standard, French rail, and multi-panel configurations.',
  provider: { '@id': `${site.url}/#business` },
  areaServed: site.nearby.map((place) => ({
    '@type': 'City',
    name: place.name,
    containedInPlace: { '@type': 'State', name: place.state },
  })),
  offers: {
    '@type': 'Offer',
    priceCurrency: 'USD',
    priceSpecification: {
      '@type': 'PriceSpecification',
      minPrice: doorPricing.low,
      maxPrice: doorPricing.high,
      priceCurrency: 'USD',
    },
  },
};
---
<BaseLayout
  title="Sliding glass door installation"
  description="Sliding glass patio door installation in Vancouver, WA and Clark County: configurations, replacement vs. new opening, sizing, and what install day looks like."
  path="/sliding-glass-doors"
  crumbs={[{ name: 'Sliding glass doors', href: '/sliding-glass-doors' }]}
  ogImageSrc={ogPhoto.image}
  ogImageAlt={ogPhoto.alt}
  schema={schema}
>
  <section class="page-hero page-hero-photo" style={`background-image: linear-gradient(180deg, color-mix(in srgb, var(--black) 58%, transparent), color-mix(in srgb, var(--black) 88%, transparent)), url(${heroBg.src})`}>
    <div class="wrap">
      <p class="kicker">Services</p>
      <h1>Sliding glass door installation in Vancouver, WA</h1>
      <p class="lede">
        We measure the opening in person, install the door level and flashed, and give you a
        written price before anything is ordered.
      </p>
      <div class="hero-actions">
        <a class="btn btn-light" href="/estimate?scope=Sliding%20glass%20door">Get a written quote</a>
        <a class="btn btn-ghost btn-on-dark" href="#configurations">See configurations</a>
      </div>
      <p class="hero-note">
        Looking for a hinged pair instead of a slider? We install French doors too — ask on
        the same call. Replacing a window instead? See <a href="/replacement">window replacement</a>.
      </p>
    </div>
  </section>

  <section class="section" id="configurations">
    <div class="wrap" data-reveal>
      <p class="rule-label">What we install</p>
      <h2>Patio door types we install.</h2>
      <p class="lede">
        A patio door is not a large window. It has bigger glass, heavier panels, and a track that
        has to carry both. These are the types we install.
      </p>
      <div class="style-list">
        {types.map((type) => (
          <article class="style-row">
            <h3>{type.name}</h3>
            <p>{type.text}</p>
          </article>
        ))}
      </div>
      <p class="fine-print">
        Vinyl and fiberglass frames, from the same Cascade and Milgard lines we use for windows.
        Door pricing is not broken out by brand; see the range below.
      </p>
    </div>
  </section>

  <section class="section section-sunk">
    <div class="wrap" data-reveal>
      <p class="rule-label">Start here</p>
      <h2>Replacement, widened opening, or new build?</h2>
      <p class="lede">
        The biggest factor in cost and timeline is not the door. It is whether the wall around it
        changes.
      </p>
      <div class="style-list">
        {considerations.map((item) => (
          <article class="style-row">
            <h3>{item.name}</h3>
            <p>{item.text}</p>
          </article>
        ))}
      </div>
      <p class="section-link">
        <a href="/new-construction">Framing a door into a build going up now? See new construction.</a>
      </p>
    </div>
  </section>

  <section class="section">
    <div class="wrap" data-reveal>
      <p class="rule-label">Before we can give you a price</p>
      <h2>What we measure.</h2>
      <p class="lede">
        A price from a photo is a guess. These four things affect the price, the lead time, or
        both, and we check them in person before anything is ordered.
      </p>
      <div class="style-list">
        {measuring.map((item) => (
          <article class="style-row">
            <h3>{item.name}</h3>
            <p>{item.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-sunk">
    <div class="wrap" data-reveal>
      <p class="rule-label">Why homeowners add one</p>
      <h2>More glass than any window in the house.</h2>
      <div class="compare">
        {benefits.map((benefit) => (
          <article class="compare-card">
            <h3>{benefit.name}</h3>
            <p class="compare-blurb">{benefit.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap split" data-reveal>
      <div>
        <p class="rule-label">Install day</p>
        <h2>How a patio door job runs.</h2>
        <ol class="steps">
          {steps.map((step) => (
            <li><strong>{step.name}.</strong> {step.text}</li>
          ))}
        </ol>
        <p class="section-link">
          <a href="/process">The full process for window installs</a>
        </p>
      </div>
      <dl class="spec-table">
        <div class="spec-pair">
          <dt>Sliding door</dt>
          <dd>{`$${doorPricing.low.toLocaleString('en-US')} – $${doorPricing.high.toLocaleString('en-US')} installed`}</dd>
        </div>
        {frenchDoor && (
          <div class="spec-pair">
            <dt>French door</dt>
            <dd>{`$${frenchDoor.low.toLocaleString('en-US')} – $${frenchDoor.high.toLocaleString('en-US')} installed`}</dd>
          </div>
        )}
        <div class="spec-pair">
          <dt>Materials</dt>
          <dd>Vinyl and fiberglass frames</dd>
        </div>
        <div class="spec-pair">
          <dt>Glass</dt>
          <dd>Double- and triple-pane insulated units, Low-E</dd>
        </div>
        <div class="spec-pair">
          <dt>Configurations</dt>
          <dd>Two-, three-, and four-panel; French rail on request</dd>
        </div>
      </dl>
    </div>
    <div class="wrap" data-reveal>
      <p class="fine-print">
        A range, not a quote — every opening is measured before anything is ordered, and a widened
        opening or a new header adds to the range above. See the{' '}
        <a href="/tools/window-replacement-cost-calculator">free cost estimator</a> to run this
        against the rest of the house.
      </p>
    </div>
  </section>

  <section class="section section-sunk">
    <div class="wrap" data-reveal>
      <p class="rule-label">Real installs</p>
      <h2>Finished patio door installs.</h2>
      <div class="work-grid">
        {doorWork.map((photo) => (
          <WorkCard
            image={photo.image}
            alt={photo.alt}
            caption={photo.caption}
            kind={workKindLabel(photo.kind)}
          />
        ))}
      </div>
      <p class="section-link">
        <a href="/gallery">See the rest of our work</a>
        {site.social.facebook && (
          <>
            {' '}&middot;{' '}
            <a href={site.social.facebook} target="_blank" rel="noopener noreferrer">
              recent jobs on Facebook
            </a>
          </>
        )}
      </p>
    </div>
  </section>

  <CtaBar
    heading="Get a written quote."
    body="We measure the door and the sill, tell you which configuration fits, and write it down before anything is ordered."
  />
</BaseLayout>

<style>
  /* Full-bleed photo hero, cropped from a real installed job — same
     treatment as replacement.astro's. */
  .page-hero-photo {
    position: relative;
    background-size: cover;
    background-position: center;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-s);
    margin: var(--space-m) 0 0;
  }

  .hero-note {
    margin: var(--space-m) 0 0;
    max-width: 44rem;
    font-size: var(--step--1);
    color: var(--on-dark-faint);
  }

  .hero-note a {
    color: var(--on-dark);
    text-decoration: underline;
    text-decoration-color: var(--accent-bright);
    text-underline-offset: 0.2em;
  }

  .hero-note a:hover,
  .hero-note a:focus-visible {
    color: var(--accent-bright);
  }

  /* Same scanning-spine treatment as window-features.astro's style list —
     configurations, considerations, and measuring points all read in order,
     not as interchangeable cards. */
  .style-list {
    margin: var(--space-l) 0 0;
    border-top: 1px solid var(--line);
  }

  .style-row {
    display: grid;
    grid-template-columns: 14rem minmax(0, 1fr);
    gap: var(--space-m);
    align-items: baseline;
    padding: var(--space-s) 0;
    border-bottom: 1px solid var(--line);
  }

  .style-row h3 {
    margin: 0;
    font-size: var(--step-0);
  }

  .style-row p {
    margin: 0;
    color: var(--ink-soft);
    font-size: var(--step--1);
  }

  /* Same benefit-card grid as window-features.astro's material comparison. */
  .compare {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-m);
    margin: var(--space-l) 0 0;
  }

  .compare-card {
    padding: var(--space-m);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--paper-raised);
  }

  .compare-card h3 {
    margin: 0 0 var(--space-2xs);
    font-size: var(--step-1);
  }

  .compare-blurb {
    margin: 0;
    color: var(--ink-soft);
    font-size: var(--step--1);
  }

  /* Same pricing-line table as replacement.astro. */
  .spec-table {
    margin: 0;
  }

  .spec-pair {
    display: grid;
    grid-template-columns: 9rem minmax(0, 1fr);
    gap: var(--space-s);
    padding: var(--space-s) 0;
    border-top: 1px solid var(--line);
  }

  .spec-pair:last-child {
    border-bottom: 1px solid var(--line);
  }

  .spec-pair dt {
    text-transform: uppercase;
    letter-spacing: var(--tracking-label);
    font-size: var(--step--2);
    font-weight: 500;
    color: var(--ink-faint);
  }

  .spec-pair dd {
    margin: 0;
    font-size: var(--step--1);
    font-variant-numeric: tabular-nums;
  }

  .plain-list li {
    margin-bottom: var(--space-2xs);
  }

  @media (max-width: 900px) {
    .style-row {
      grid-template-columns: 1fr;
      gap: var(--space-3xs);
    }

    .compare {
      grid-template-columns: 1fr;
    }

    .spec-pair {
      grid-template-columns: 1fr;
      gap: var(--space-3xs);
    }
  }
</style>
