---
import { getCollection } from 'astro:content';
import { getImage } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CtaBar from '../../components/CtaBar.astro';
import { site } from '../../data/site';
import areasHeroSrc from '../../assets/hero/areas.jpg';

const cities = (await getCollection('cities')).filter((city) => city.data.published);

// Real stock photography of the Cascades, not a specific Clark County job
// site -- same disclosure the other stock and AI hero photos carry.
const heroBg = await getImage({ src: areasHeroSrc, width: 2400, format: 'webp', quality: 76 });
---
<BaseLayout
  title="Service areas"
  description="Window installation in Vancouver, WA and nearby Clark County: Camas, Washougal, Battle Ground, Ridgefield, La Center, and Woodland."
  path="/areas"
  crumbs={[{ name: 'Service areas', href: '/areas' }]}
>
  <section class="page-hero page-hero-photo" style={`background-image: linear-gradient(180deg, color-mix(in srgb, var(--black) 58%, transparent), color-mix(in srgb, var(--black) 88%, transparent)), url(${heroBg.src})`}>
    <div class="wrap">
      <p class="kicker">Service areas</p>
      <h1>Vancouver, WA and nearby</h1>
      <p class="lede">{site.serviceAreaNote}</p>
    </div>
    <p class="hero-photo-credit">Stock photography — not an actual Clearveiw job or job site</p>
  </section>

  <section class="section">
    <div class="wrap" data-reveal>
      <p class="rule-label">{cities.length} towns</p>
      <ul class="area-list">
        {cities.map((city) => (
          <li>
            <a href={`/areas/${city.id}`}>
              <span class="area-region">{city.data.region}</span>
              <strong>{city.data.name}</strong>
              <span class="area-blurb">{city.data.description}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
  <CtaBar
    heading="Not sure if we come out that far?"
    body="Call and ask. Mark will tell you straight rather than book a drive he cannot make work."
  />
</BaseLayout>

<style>
  .page-hero-photo {
    position: relative;
    background-size: cover;
    background-position: center;
  }

  .hero-photo-credit {
    position: absolute;
    right: var(--space-s);
    bottom: var(--space-2xs);
    margin: 0;
    font-size: var(--step--2);
    color: var(--on-dark-faint);
    opacity: 0.75;
  }

  /* A card grid made nine towns look like nine products. An index reads as
     coverage, which is what the page is actually claiming. */
  .area-list {
    margin: var(--space-l) 0 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--line);
  }

  .area-list li {
    border-bottom: 1px solid var(--line);
  }

  .area-list a {
    display: grid;
    grid-template-columns: 8rem minmax(0, 14rem) minmax(0, 1fr);
    gap: var(--space-m);
    align-items: baseline;
    padding: var(--space-m) 0;
    text-decoration: none;
    color: inherit;
    transition: padding-left var(--dur) var(--ease-out), background var(--dur-fast) var(--ease);
  }

  .area-list a:hover,
  .area-list a:focus-visible {
    padding-left: var(--space-s);
    background: var(--accent-wash);
  }

  .area-region {
    text-transform: uppercase;
    letter-spacing: var(--tracking-label);
    font-size: var(--step--2);
    font-weight: 500;
    color: var(--ink-faint);
  }

  .area-list strong {
    font-size: var(--step-2);
    font-weight: 600;
    letter-spacing: var(--tracking-display);
  }

  .area-blurb {
    color: var(--ink-soft);
    font-size: var(--step--1);
  }

  @media (max-width: 900px) {
    .area-list a {
      grid-template-columns: 1fr;
      gap: var(--space-3xs);
    }

    .area-list a:hover,
    .area-list a:focus-visible {
      padding-left: 0;
      background: transparent;
    }
  }
</style>
