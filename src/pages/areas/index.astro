---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CtaBar from '../../components/CtaBar.astro';
import { site } from '../../data/site';

const cities = (await getCollection('cities')).filter((city) => city.data.published);
---
<BaseLayout
  title="Service areas"
  description="Window installation in Vancouver, WA and nearby Clark County: Camas, Washougal, Battle Ground, Ridgefield, La Center, and Woodland."
  path="/areas"
  crumbs={[{ name: 'Service areas', href: '/areas' }]}
>
  <section class="wrap section">
    <p class="kicker">Service areas</p>
    <h1>Vancouver, WA and nearby</h1>
    <p class="lede">{site.serviceAreaNote}</p>
    <div class="cards">
      {cities.map((city) => (
        <article class="card">
          <p class="kicker">{city.data.region}</p>
          <h2><a href={`/areas/${city.id}`}>{city.data.name}</a></h2>
          <p>{city.data.description}</p>
        </article>
      ))}
    </div>
  </section>
  <CtaBar />
</BaseLayout>
