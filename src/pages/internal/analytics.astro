---
import InternalLayout from '../../layouts/InternalLayout.astro';
---
<InternalLayout title="Analytics">
  <div class="an-hero">
    <div>
      <p class="kicker">Website</p>
      <h1>Analytics</h1>
      <p class="lede">Where visitors come from, what they read, and which of them ask for an estimate.</p>
    </div>
    <div class="an-hero-actions"><button class="btn btn-ghost" type="button" data-refresh>Refresh</button></div>
  </div>

  <section class="an-section" aria-labelledby="an-pipe-h">
    <div class="an-head">
      <div><p class="kicker">Your business</p><h2 id="an-pipe-h">Requests to revenue</h2></div>
      <span class="an-meta" data-pipe-window>—</span>
    </div>
    <p class="an-note">Counted from your own quotes, jobs and payments. Requests and quotes are not linked records, so each stage is its own count for the period, not the same customers followed through.</p>
    <div class="an-stats an-stats-5">
      <article class="an-stat"><span>Estimate requests</span><strong data-pipe="leads">—</strong><small>from the website form</small></article>
      <article class="an-stat"><span>Quotes written</span><strong data-pipe="quotes">—</strong><small data-pipe="quotedValue">—</small></article>
      <article class="an-stat"><span>Quotes signed</span><strong data-pipe="signed">—</strong><small data-pipe="signedValue">—</small></article>
      <article class="an-stat"><span>Jobs</span><strong data-pipe="jobs">—</strong><small><span data-pipe="completed">—</span> completed</small></article>
      <article class="an-stat"><span>Collected</span><strong data-pipe="collected">—</strong><small>on jobs from this period</small></article>
    </div>
    <div class="an-grid">
      <article class="an-panel"><h3>Rates</h3><div data-list="pipeRates"></div></article>
      <article class="an-panel"><h3>Needs attention</h3><div data-list="pipeAttention"></div></article>
    </div>
  </section>

  <section class="an-section" aria-labelledby="an-leads-h">
    <div class="an-head">
      <div><p class="kicker">Estimate requests</p><h2 id="an-leads-h">Where leads came from</h2></div>
      <span class="an-meta" data-leads-total>—</span>
    </div>
    <p class="an-note">Counted from the requests in your own database (first visit source), so it works without any analytics account.</p>
    <div class="an-grid">
      <article class="an-panel"><h3>Source</h3><div data-list="leadSources"></div></article>
      <article class="an-panel"><h3>First page visited</h3><div data-list="leadLanding"></div></article>
      <article class="an-panel an-wide"><h3>Requests per week</h3><div data-list="leadWeekly"></div></article>
    </div>
  </section>

  <section class="an-section" aria-labelledby="an-site-h">
    <div class="an-head">
      <div><p class="kicker">Google Analytics</p><h2 id="an-site-h">Site traffic</h2></div>
      <span class="an-meta" data-ga4-state>—</span>
    </div>
    <p class="an-callout" data-ga4-message hidden></p>
    <div class="an-stats" data-ga4-stats hidden>
      <article class="an-stat"><span>Visitors</span><strong data-stat="users28">—</strong><small><span data-stat="users7">—</span> in last 7 days</small></article>
      <article class="an-stat"><span>Sessions</span><strong data-stat="sessions28">—</strong><small><span data-stat="sessions7">—</span> in last 7 days</small></article>
      <article class="an-stat"><span>Page views</span><strong data-stat="pageViews28">—</strong><small><span data-stat="pageViews7">—</span> in last 7 days</small></article>
      <article class="an-stat"><span>Estimate requests</span><strong data-stat="leadEvents28">—</strong><small><span data-stat="leadEvents7">—</span> in last 7 days</small></article>
    </div>
    <p class="an-note" data-ga4-window hidden>Visitors, sessions and page views cover the last 28 days unless noted.</p>
    <div class="an-grid" data-ga4-lists hidden>
      <article class="an-panel"><h3>Where sessions come from</h3><div data-list="channels"></div></article>
      <article class="an-panel"><h3>Most viewed pages</h3><div data-list="topPages"></div></article>
    </div>
  </section>

  <section class="an-section" aria-labelledby="an-tools-h">
    <div class="an-head"><div><p class="kicker">Open in the source</p><h2 id="an-tools-h">Analytics tools</h2></div></div>
    <div class="an-links" data-links>
      <a class="an-link" data-link="ga4" target="_blank" rel="noopener noreferrer"><strong>Google Analytics</strong><span>Full reports</span></a>
      <a class="an-link" data-link="tagManager" target="_blank" rel="noopener noreferrer"><strong>Google Tag Manager</strong><span>Tags and triggers (collects data, has no reports of its own)</span></a>
      <a class="an-link" data-link="searchConsole" target="_blank" rel="noopener noreferrer"><strong>Search Console</strong><span>Search queries and indexing</span></a>
      <a class="an-link" data-link="ahrefsWebmasterTools" target="_blank" rel="noopener noreferrer"><strong>Ahrefs Webmaster Tools</strong><span>Backlinks and site health. The free plan has no API, so it opens in Ahrefs.</span></a>
    </div>
  </section>

  <p class="an-status" data-status role="status">Loading analytics…</p>
</InternalLayout>
<script>
  type Row = { label: string; value: number };
  type Ga4 = {
    status: 'ok' | 'unconfigured' | 'unavailable';
    last7?: Record<string, number>;
    last28?: Record<string, number>;
    topPages?: Row[];
    channels?: Row[];
  };
  type Leads = {
    status: 'ok' | 'unavailable';
    days?: number;
    total?: number;
    sources?: Row[];
    landingPages?: Row[];
    weekly?: { weekOf: string; value: number }[];
  };
  type Pipeline = {
    status: 'ok' | 'unavailable';
    days?: number;
    staleDraftDays?: number;
    leads?: number | null;
    quotes?: { created: number; quotedCents: number; signed: number; signedCents: number; staleDrafts: number; staleDraftCents: number; medianDaysToSign: number | null } | null;
    jobs?: { created: number; completed: number; collectedCents: number | null } | null;
    awaitingJob?: number | null;
    rates?: { quotesPerLead: number | null; signedPerQuote: number | null };
  };
  type Payload = { ga4: Ga4; leads: Leads; pipeline?: Pipeline; links: Record<string, string> };

  const nf = new Intl.NumberFormat('en-US');
  const money = new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD', maximumFractionDigits: 0 });
  const dollars = (cents: number | null | undefined) => (typeof cents === 'number' ? money.format(cents / 100) : '—');
  const count = (value: number | null | undefined) => (typeof value === 'number' ? nf.format(value) : '—');
  const $ = (selector: string) => document.querySelector(selector);

  function renderList(name: string, rows: Row[] | undefined, empty: string) {
    const host = $(`[data-list="${name}"]`);
    if (!(host instanceof HTMLElement)) return;
    host.replaceChildren();
    if (!rows || rows.length === 0) {
      const p = document.createElement('p');
      p.className = 'an-empty';
      p.textContent = empty;
      host.append(p);
      return;
    }
    const max = Math.max(...rows.map((row) => row.value), 1);
    for (const row of rows) {
      const item = document.createElement('div');
      item.className = 'an-row';
      const label = document.createElement('span');
      label.className = 'an-row-label';
      label.textContent = row.label;
      const value = document.createElement('strong');
      value.textContent = nf.format(row.value);
      const bar = document.createElement('i');
      bar.style.width = `${Math.max(2, Math.round((row.value / max) * 100))}%`;
      item.append(label, value, bar);
      host.append(item);
    }
  }

  function setText(selector: string, text: string) {
    const el = $(selector);
    if (el instanceof HTMLElement) el.textContent = text;
  }

  function show(selector: string, visible: boolean) {
    const el = $(selector);
    if (el instanceof HTMLElement) el.hidden = !visible;
  }

  function renderGa4(ga4: Ga4) {
    show('[data-ga4-stats]', false);
    show('[data-ga4-lists]', false);
    show('[data-ga4-window]', false);
    if (ga4.status === 'ok' && ga4.last7 && ga4.last28) {
      setText('[data-ga4-state]', 'Connected');
      show('[data-ga4-message]', false);
      show('[data-ga4-stats]', true);
      show('[data-ga4-lists]', true);
      show('[data-ga4-window]', true);
      for (const key of ['users', 'sessions', 'pageViews', 'leadEvents']) {
        setText(`[data-stat="${key}28"]`, nf.format(ga4.last28[key] ?? 0));
        setText(`[data-stat="${key}7"]`, nf.format(ga4.last7[key] ?? 0));
      }
      renderList('channels', ga4.channels, 'No sessions recorded yet.');
      renderList('topPages', ga4.topPages, 'No page views recorded yet.');
      return;
    }
    show('[data-ga4-message]', true);
    if (ga4.status === 'unconfigured') {
      setText('[data-ga4-state]', 'Not connected');
      setText('[data-ga4-message]', 'Google Analytics is not connected to this page yet. See the Analytics setup section in internal/README.md.');
    } else {
      setText('[data-ga4-state]', 'Unavailable');
      setText('[data-ga4-message]', 'Google Analytics did not respond. Try Refresh in a minute; the lead numbers above are unaffected.');
    }
  }

  function renderTextList(name: string, lines: [string, string][]) {
    const host = $(`[data-list="${name}"]`);
    if (!(host instanceof HTMLElement)) return;
    host.replaceChildren();
    for (const [labelText, valueText] of lines) {
      const item = document.createElement('div');
      item.className = 'an-row';
      const label = document.createElement('span');
      label.className = 'an-row-label';
      label.textContent = labelText;
      const value = document.createElement('strong');
      value.textContent = valueText;
      item.append(label, value);
      host.append(item);
    }
  }

  function renderPipeline(pipe: Pipeline | undefined) {
    if (!pipe || pipe.status !== 'ok') {
      setText('[data-pipe-window]', 'Unavailable');
      renderTextList('pipeRates', [['Business data could not be loaded.', '']]);
      renderTextList('pipeAttention', []);
      return;
    }
    const q = pipe.quotes;
    const j = pipe.jobs;
    const pct = (value: number | null | undefined) => (typeof value === 'number' ? `${value}%` : '—');
    setText('[data-pipe-window]', `Last ${pipe.days ?? 90} days`);
    setText('[data-pipe="leads"]', count(pipe.leads));
    setText('[data-pipe="quotes"]', count(q?.created));
    setText('[data-pipe="quotedValue"]', q ? `${dollars(q.quotedCents)} quoted` : '—');
    setText('[data-pipe="signed"]', count(q?.signed));
    setText('[data-pipe="signedValue"]', q ? `${dollars(q.signedCents)} signed` : '—');
    setText('[data-pipe="jobs"]', count(j?.created));
    setText('[data-pipe="completed"]', count(j?.completed));
    setText('[data-pipe="collected"]', dollars(j?.collectedCents));
    const avgSigned = q && q.signed > 0 ? dollars(Math.round(q.signedCents / q.signed)) : '—';
    renderTextList('pipeRates', [
      ['Quotes written per estimate request', pct(pipe.rates?.quotesPerLead)],
      ['Quotes signed per quote written', pct(pipe.rates?.signedPerQuote)],
      ['Typical days from quote to signature', typeof q?.medianDaysToSign === 'number' ? `${q.medianDaysToSign} days` : '—'],
      ['Average signed quote', avgSigned],
    ]);
    const stale = q?.staleDrafts ?? 0;
    renderTextList('pipeAttention', [
      [`Draft quotes older than ${pipe.staleDraftDays ?? 14} days`, q ? `${nf.format(stale)}${stale ? ` · ${dollars(q.staleDraftCents)}` : ''}` : '—'],
      ['Finalized quotes not yet a job', count(pipe.awaitingJob)],
    ]);
  }

  function renderLeads(leads: Leads) {
    if (leads.status !== 'ok') {
      setText('[data-leads-total]', 'Unavailable');
      renderList('leadSources', [], 'Lead data could not be loaded.');
      renderList('leadLanding', [], 'Lead data could not be loaded.');
      renderList('leadWeekly', [], 'Lead data could not be loaded.');
      return;
    }
    const total = leads.total ?? 0;
    setText('[data-leads-total]', `${nf.format(total)} in the last ${leads.days ?? 90} days`);
    renderList('leadSources', leads.sources, 'No estimate requests yet.');
    renderList('leadLanding', leads.landingPages, 'No estimate requests yet.');
    renderList(
      'leadWeekly',
      (leads.weekly ?? []).map((week) => ({ label: `Week of ${week.weekOf}`, value: week.value })),
      'No estimate requests yet.',
    );
  }

  async function load() {
    setText('[data-status]', 'Loading analytics…');
    try {
      const response = await fetch('/internal/api/analytics', { headers: { accept: 'application/json' } });
      if (response.status === 401 || response.redirected) {
        location.href = '/internal/login?next=/internal/analytics';
        return;
      }
      if (!response.ok) throw new Error('bad status');
      const data = (await response.json()) as Payload;
      renderPipeline(data.pipeline);
      renderLeads(data.leads);
      renderGa4(data.ga4);
      document.querySelectorAll('[data-link]').forEach((el) => {
        const href = data.links?.[(el as HTMLElement).dataset.link || ''];
        if (el instanceof HTMLAnchorElement && typeof href === 'string' && /^https:\/\//.test(href)) el.href = href;
      });
      setText('[data-status]', `Updated ${new Date().toLocaleTimeString()}`);
    } catch {
      setText('[data-status]', 'Could not load analytics. Try Refresh.');
    }
  }

  document.querySelector('[data-refresh]')?.addEventListener('click', load);
  load();
</script>
<style>
  .an-hero{display:flex;justify-content:space-between;align-items:end;gap:var(--space-m);margin-bottom:var(--space-m)}
  .an-hero h1{margin:.08rem 0 .35rem}
  .an-section{margin-bottom:var(--space-l)}
  .an-head{display:flex;justify-content:space-between;align-items:end;gap:var(--space-s);margin-bottom:.4rem}
  .an-head h2{margin:.1rem 0 0}
  .an-meta{font-size:var(--step--2);font-weight:750;color:var(--ink-soft)}
  .an-note{margin:0 0 var(--space-s);color:var(--ink-soft);font-size:var(--step--1)}
  .an-callout{margin:0 0 var(--space-s);padding:.85rem 1rem;border:1px solid var(--line);border-left:3px solid var(--accent);border-radius:var(--radius);background:var(--paper-sunk);font-size:var(--step--1)}
  .an-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:var(--space-s)}
  .an-wide{grid-column:1/-1}
  .an-panel{padding:1rem 1.05rem;border:1px solid var(--line);border-radius:var(--radius-lg);background:var(--paper-raised);box-shadow:var(--shadow-sm)}
  .an-panel h3{margin:0 0 .5rem;font-size:var(--step-0)}
  /* Rows are built by script after load, so Astro's scoped-style attribute is absent; these must be global. */
  :global(.an-row){position:relative;display:flex;justify-content:space-between;gap:.75rem;padding:.55rem 0 .7rem;border-bottom:1px solid var(--line)}
  :global(.an-row:last-child){border-bottom:0}
  :global(.an-row-label){min-width:0;overflow-wrap:anywhere;font-size:var(--step--1)}
  :global(.an-row strong){font-variant-numeric:tabular-nums}
  :global(.an-row i){position:absolute;left:0;bottom:.3rem;height:3px;border-radius:2px;background:var(--accent);opacity:.55}
  :global(.an-empty){margin:0;color:var(--ink-soft);font-size:var(--step--1)}
  .an-stats{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:.65rem;margin-bottom:var(--space-xs)}
  .an-stat{display:grid;gap:.25rem;padding:1rem;border:1px solid var(--line);border-radius:var(--radius-lg);background:var(--paper-raised)}
  .an-stat>span{font-size:var(--step--2);font-weight:750;text-transform:uppercase;letter-spacing:.06em;color:var(--ink-soft)}
  .an-stat strong{font-size:var(--step-3);line-height:1;font-variant-numeric:tabular-nums}
  .an-stat small{color:var(--ink-soft)}
  .an-links{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.65rem}
  .an-link{display:grid;gap:.2rem;padding:.95rem 1rem;border:1px solid var(--line);border-radius:var(--radius-lg);background:var(--paper-raised);color:inherit;text-decoration:none}
  .an-link:hover,.an-link:focus-visible{border-color:var(--accent)}
  .an-link span{color:var(--ink-soft);font-size:var(--step--1)}
  .an-status{color:var(--ink-soft);font-size:var(--step--1)}
  .an-stats-5{grid-template-columns:repeat(5,minmax(0,1fr))}
  @media(max-width:900px){.an-stats-5{grid-template-columns:repeat(2,minmax(0,1fr))}.an-stats{grid-template-columns:repeat(2,minmax(0,1fr))}}
  @media(max-width:720px){.an-hero{align-items:flex-start;flex-direction:column}.an-grid,.an-links{grid-template-columns:1fr}}
  @media(max-width:420px){.an-stats{grid-template-columns:1fr}}
</style>
