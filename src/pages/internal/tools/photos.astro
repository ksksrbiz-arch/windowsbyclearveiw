---
import InternalLayout from '../../../layouts/InternalLayout.astro';
---
<InternalLayout title="Field Photos">
  <div class="tool-head"><div><p class="kicker">Field evidence</p><h1>Job photo log</h1><p class="lede">Capture evidence against the exact job, opening, and installation stage. Nothing is silently uploaded.</p></div><div class="head-actions"><a class="btn btn-ghost" data-field-back href="/internal/jobs">Back to field mode</a><button class="btn btn-ghost" type="button" data-export>Export manifest</button></div></div>
  <section class="context panel"><div class="context-item"><span>Job</span><strong data-job>Not selected</strong></div><div class="context-item"><span>Opening</span><strong data-opening>Project-wide</strong></div><div class="context-item"><span>Stage</span><strong data-stage-label>Before</strong></div><div class="context-count"><strong data-count>0</strong><span>photos</span></div></section>
  <section class="capture panel"><div class="panel-head"><div><p class="kicker">Capture</p><h2>Build the evidence trail</h2></div><span class="muted" data-status role="status">Ready</span></div><div class="capture-controls"><label>Opening<input data-opening-input inputmode="numeric" min="1" max="9999" type="number" placeholder="Project-wide" /></label><div class="stage-picker" role="group" aria-label="Photo stage"><button type="button" data-stage="before">Before</button><button type="button" data-stage="during">During</button><button type="button" data-stage="after">After</button><button type="button" data-stage="issue">Issue</button></div></div><label class="capture-button"><input type="file" data-files accept="image/*" capture="environment" multiple /><span class="capture-icon">＋</span><span><strong>Take / choose photos</strong><small>Use the camera on a phone or select multiple images.</small></span></label><div class="requirements" data-requirements></div></section>
  <section class="photo-panel panel"><div class="panel-head"><div><p class="kicker">Evidence record</p><h2>Captured photos</h2></div><button class="text-button" type="button" data-clear>Clear this job's photos</button></div><div class="photo-grid" data-grid></div><div class="empty" data-empty hidden><strong>No photos for this view.</strong><span>Change the opening/stage filter or capture the first image.</span></div></section>
  <p class="legal-note">Photos remain on this device in local browser storage. Export the manifest and preserve originals according to your normal business recordkeeping process.</p>
</InternalLayout>
<script>
  type Photo={id:string;jobId:string;jobName:string;openingIndex:number|null;stage:string;name:string;mime:string;createdAt:string;note:string;blob:Blob};
  const DB_NAME='clearview-field-tools';const DB_VERSION=2;const STORE='photos';function qs<T extends Element>(s:string){return document.querySelector(s) as T|null};const esc=(v:unknown)=>{const d=document.createElement('div');d.textContent=String(v??'');return d.innerHTML;};
  function openDb():Promise<IDBDatabase>{return new Promise((resolve,reject)=>{const r=indexedDB.open(DB_NAME,DB_VERSION);r.onupgradeneeded=()=>{const db=r.result;if(!db.objectStoreNames.contains(STORE))db.createObjectStore(STORE,{keyPath:'id'});};r.onsuccess=()=>resolve(r.result);r.onerror=()=>reject(r.error||new Error('Could not open local photo storage.'));});}
  function req<T=unknown>(db:IDBDatabase,mode:IDBTransactionMode,fn:(s:IDBObjectStore)=>IDBRequest):Promise<T>{return new Promise((resolve,reject)=>{const tx=db.transaction(STORE,mode);const r=fn(tx.objectStore(STORE));r.onsuccess=()=>resolve(r.result as T);r.onerror=()=>reject(r.error);});}
  function init(){const root=document.querySelector('main');if(!(root instanceof HTMLElement)||root.dataset.bound==='true')return;root.dataset.bound='true';const dbP=openDb().catch(()=>null);const params=new URLSearchParams(location.search);const jobId=(params.get('jobId')||params.get('job')||'').trim();const jobName=params.get('jobName')||'';let openingParam=params.get('opening')||params.get('openingIndex')||'';let stage=params.get('stage')||'before';if(!['before','during','after','issue'].includes(stage))stage='before';const jobEl=qs<HTMLElement>('[data-job]')!,openingEl=qs<HTMLElement>('[data-opening]')!,stageEl=qs<HTMLElement>('[data-stage-label]')!,countEl=qs<HTMLElement>('[data-count]')!,status=qs<HTMLElement>('[data-status]')!,grid=qs<HTMLElement>('[data-grid]')!,empty=qs<HTMLElement>('[data-empty]')!,openingInput=qs<HTMLInputElement>('[data-opening-input]')!,files=qs<HTMLInputElement>('[data-files]')!,requirements=qs<HTMLElement>('[data-requirements]')!;const saved=JSON.parse(localStorage.getItem('clearview:photo-context')||'{}');const activeJob=jobId||saved.jobId||'';openingParam=openingParam||saved.opening||'';stage=saved.stage&&params.get('stage')===null?saved.stage:stage;openingInput.value=openingParam;jobEl.textContent=activeJob||'Not selected';let activeUrls:string[]=[];let renderVersion=0;const openingValue=()=>{const n=Number(openingInput.value);return Number.isInteger(n)&&n>0?n:null;};const persist=()=>localStorage.setItem('clearview:photo-context',JSON.stringify({jobId:activeJob,opening:openingValue()||'',stage}));
    function renderContext(){const n=openingValue();openingEl.textContent=n?`Opening ${String(n).padStart(2,'0')}`:'Project-wide';stageEl.textContent=stage==='issue'?'Issue / documentation':stage[0].toUpperCase()+stage.slice(1);document.querySelectorAll<HTMLButtonElement>('[data-stage]').forEach(b=>{b.classList.toggle('active',b.dataset.stage===stage);b.setAttribute('aria-pressed',String(b.dataset.stage===stage));});persist();}
    async function all(){const db=await dbP;if(!db)return[];return await req<Photo[]>(db,'readonly',s=>s.getAll())||[];}
    async function render(){const version=++renderVersion;const photos=await all();if(version!==renderVersion)return;const n=openingValue();const rows=photos.filter(p=>!activeJob||p.jobId===activeJob).filter(p=>n===null||p.openingIndex===n).filter(p=>p.stage===stage).sort((a,b)=>b.createdAt.localeCompare(a.createdAt));const scoped=photos.filter(p=>!activeJob||p.jobId===activeJob).filter(p=>n===null||p.openingIndex===n);if(version!==renderVersion)return;activeUrls.forEach(URL.revokeObjectURL);activeUrls=[];grid.innerHTML='';countEl.textContent=String(rows.length);empty.hidden=rows.length>0;const counts=scoped.reduce((m,p)=>(m[p.stage]=(m[p.stage]||0)+1,m),{} as Record<string,number>);requirements.innerHTML=n?`<span class="req ${counts.before?'done':''}">Before ${counts.before?'✓':'required'}</span><span class="req ${counts.during?'done':''}">During ${counts.during?'✓':'required'}</span><span class="req ${counts.after?'done':''}">After ${counts.after?'✓':'required'}</span>`:'<span class="req">Select an opening to track opening-specific evidence.</span>';rows.forEach(p=>{const url=URL.createObjectURL(p.blob);activeUrls.push(url);const card=document.createElement('article');card.className='photo-card';card.innerHTML=`<img src="${url}" alt="${esc(p.stage)} photo for ${esc(p.jobId)}"><div class="photo-info"><div class="photo-meta"><span class="stage-tag">${esc(p.stage)}</span><span>${p.openingIndex?`Opening ${String(p.openingIndex).padStart(2,'0')}`:'Project'}</span><time>${new Date(p.createdAt).toLocaleString('en-US',{month:'short',day:'numeric',hour:'numeric',minute:'2-digit'})}</time></div><textarea maxlength="500" placeholder="What does this photo prove?">${esc(p.note)}</textarea><div class="photo-actions"><button type="button" data-save>Save note</button><button type="button" data-delete>Delete</button></div></div>`;card.querySelector('[data-save]')?.addEventListener('click',async()=>{const ta=card.querySelector('textarea');if(!(ta instanceof HTMLTextAreaElement))return;const db=await dbP;if(!db)return;const item=await req<Photo>(db,'readonly',s=>s.get(p.id));if(!item)return;item.note=ta.value.slice(0,500);await req(db,'readwrite',s=>s.put(item));status.textContent='Note saved';});card.querySelector('[data-delete]')?.addEventListener('click',async()=>{const db=await dbP;if(!db)return;if(!confirm('Delete this photo from this device?'))return;await req(db,'readwrite',s=>s.delete(p.id));status.textContent='Photo deleted';render();});grid.append(card);});}
    document.querySelectorAll<HTMLButtonElement>('[data-stage]').forEach(b=>b.addEventListener('click',()=>{stage=b.dataset.stage||'before';renderContext();render();}));openingInput.addEventListener('input',()=>{renderContext();render();});files.addEventListener('change',async()=>{const db=await dbP;if(!db)return;const selected=Array.from(files.files||[]);if(!selected.length)return;const n=openingValue();if(!activeJob){status.textContent='Choose a job before capturing field evidence.';files.value='';return;}let savedCount=0;for(const file of selected){if(!file.type.startsWith('image/'))continue;const photo:Photo={id:crypto.randomUUID(),jobId:activeJob,jobName,openingIndex:n,stage,name:file.name,mime:file.type,createdAt:new Date().toISOString(),note:'',blob:file};await req(db,'readwrite',s=>s.put(photo));savedCount++;}files.value='';status.textContent=`Saved ${savedCount} photo${savedCount===1?'':'s'} on this device`;render();});qs('[data-clear]')?.addEventListener('click',async()=>{const db=await dbP;if(!db)return;if(!confirm(`Clear all stored photos for ${activeJob||'this job'}?`))return;const rows=(await all()).filter(p=>!activeJob||p.jobId===activeJob);for(const p of rows)await req(db,'readwrite',s=>s.delete(p.id));status.textContent='Job photos cleared';render();});qs('[data-export]')?.addEventListener('click',async()=>{const rows=(await all()).filter(p=>!activeJob||p.jobId===activeJob);const manifest={exportedAt:new Date().toISOString(),jobId:activeJob,jobName,photos:rows.map(p=>({id:p.id,name:p.name,openingIndex:p.openingIndex,stage:p.stage,createdAt:p.createdAt,note:p.note,mime:p.mime,size:p.blob.size}))};const blob=new Blob([JSON.stringify(manifest,null,2)],{type:'application/json'});const u=URL.createObjectURL(blob),a=document.createElement('a');a.href=u;a.download=`${(activeJob||'clearview-job').replace(/[^a-z0-9-]+/gi,'-')}-photo-manifest.json`;a.click();setTimeout(()=>URL.revokeObjectURL(u),1000);status.textContent=`Exported ${rows.length} photo records`;});const back=qs<HTMLAnchorElement>('[data-field-back]');if(back&&activeJob)back.href=`/internal/jobs/field?id=${encodeURIComponent(activeJob)}${openingValue()?`&opening=${openingValue()}`:''}`;renderContext();render();}
  init();document.addEventListener('astro:page-load',init);
</script>
<style>
.tool-head{display:flex;justify-content:space-between;align-items:end;gap:1rem;margin-bottom:1rem}.head-actions{display:flex;gap:.5rem;flex-wrap:wrap}.panel{border:1px solid var(--line);border-radius:var(--radius-lg);background:var(--paper-raised);overflow:hidden;box-shadow:var(--shadow-sm)}.context{display:grid;grid-template-columns:1.4fr 1fr 1fr auto;gap:1px;background:var(--line);margin-bottom:1rem}.context-item,.context-count{background:var(--paper-raised);padding:1rem}.context-item{display:grid;gap:.2rem}.context-item span,.context-count span{font-size:.72rem;text-transform:uppercase;letter-spacing:.08em;color:var(--ink-faint);font-weight:750}.context-count{text-align:right;min-width:90px}.context-count strong{font-size:1.8rem;display:block}.capture{padding-bottom:1rem}.panel-head{display:flex;justify-content:space-between;align-items:center;gap:.75rem;padding:1rem 1.1rem;border-bottom:1px solid var(--line)}.panel-head h2{margin:.15rem 0 0;font-size:var(--step-1)}.capture-controls{display:grid;grid-template-columns:180px 1fr;gap:1rem;padding:1rem 1.1rem}.capture-controls label{display:grid;gap:.35rem;font-size:.8rem;font-weight:750}.capture-controls input{width:100%;border:1px solid var(--line-strong);border-radius:var(--radius);padding:.65rem;font:inherit;background:var(--paper);color:var(--ink)}.stage-picker{display:grid;grid-template-columns:repeat(4,1fr);gap:.4rem;align-items:end}.stage-picker button{min-height:44px;border:1px solid var(--line-strong);border-radius:999px;background:var(--paper);color:var(--ink);font:inherit;font-weight:750;cursor:pointer}.stage-picker button.active{background:var(--ink);color:var(--paper)}.capture-button{margin:0 1.1rem;min-height:110px;border:2px dashed var(--line-strong);border-radius:var(--radius-lg);display:flex;align-items:center;justify-content:center;gap:.8rem;padding:1rem;text-align:left;cursor:pointer;background:var(--paper)}.capture-button:hover{border-color:var(--accent);background:var(--accent-wash)}.capture-button input{position:absolute;opacity:0;width:1px;height:1px}.capture-icon{font-size:2rem;font-weight:300}.capture-button span:last-child{display:grid;gap:.2rem}.capture-button small{color:var(--ink-soft)}.requirements{display:flex;flex-wrap:wrap;gap:.4rem;padding:.8rem 1.1rem 0}.req{border:1px solid var(--line);border-radius:999px;padding:.3rem .55rem;font-size:.72rem;font-weight:750;color:var(--ink-soft)}.req.done{border-color:var(--accent);background:var(--accent-wash);color:var(--ink)}.photo-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:.75rem;padding:1rem 1.1rem}.photo-card{border:1px solid var(--line);border-radius:var(--radius);overflow:hidden;background:var(--paper)}.photo-card img{display:block;width:100%;aspect-ratio:4/3;object-fit:cover}.photo-info{padding:.7rem;display:grid;gap:.5rem}.photo-meta{display:flex;align-items:center;gap:.4rem;flex-wrap:wrap;font-size:.72rem;color:var(--ink-faint)}.stage-tag{padding:.25rem .5rem;border-radius:999px;background:var(--accent-wash);color:var(--ink);font-weight:800;text-transform:capitalize}.photo-info textarea{min-height:64px;width:100%;resize:vertical;border:1px solid var(--line-strong);border-radius:var(--radius);padding:.55rem;font:inherit;background:var(--paper);color:var(--ink)}.photo-actions{display:flex;justify-content:space-between;gap:.5rem}.photo-actions button,.text-button{border:0;background:transparent;font:inherit;font-size:.78rem;font-weight:750;color:var(--ink-soft);cursor:pointer;padding:.35rem}.empty{min-height:11rem;display:grid;place-items:center;align-content:center;text-align:center;color:var(--ink-soft);padding:1.5rem}.empty strong{color:var(--ink)}.legal-note{margin-top:.7rem;color:var(--ink-faint);font-size:.72rem}.muted{color:var(--ink-soft);font-size:.78rem}
@media(max-width:800px){.tool-head{align-items:flex-start;flex-direction:column}.context{grid-template-columns:1fr 1fr}.context-count{text-align:left}.capture-controls{grid-template-columns:1fr}.stage-picker{grid-template-columns:repeat(2,1fr)}.photo-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.capture-button{min-height:130px}}@media(max-width:520px){.head-actions,.head-actions .btn{width:100%}.head-actions .btn{text-align:center}.context{grid-template-columns:1fr}.stage-picker button{min-height:48px}.photo-grid{grid-template-columns:1fr}.capture-button{margin:0 .8rem}.panel-head{align-items:flex-start;flex-direction:column}}
</style>
