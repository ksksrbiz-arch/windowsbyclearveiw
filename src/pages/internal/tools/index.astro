---
import InternalLayout from '../../../layouts/InternalLayout.astro';
---
<InternalLayout title="Internal tools">
  <div class="tools-head"><div><p class="kicker">Clearview internal</p><h1>Tools</h1><p class="lede">Field, sales, CRM, and operations utilities built around the way Clearview actually works.</p></div><a class="btn btn-primary" href="/internal/quotes/new">New quote</a></div>

  <section class="mail-test panel" aria-labelledby="mail-test-title">
    <div class="mail-test-copy">
      <p class="kicker">Production check</p>
      <h2 id="mail-test-title">Estimate email delivery</h2>
      <p>Run a controlled message through the same Resend configuration used by the public estimate form. This does not create a customer lead.</p>
    </div>
    <div class="mail-test-action">
      <div class="mail-test-buttons">
        <button class="btn btn-primary" type="button" data-mail-test>Send production test</button>
        <button class="btn btn-ghost" type="button" data-mail-check>Check Resend activity</button>
      </div>
      <p class="mail-test-status" data-mail-status role="status">No test run yet.</p>
    </div>
    <div class="mail-test-results" data-mail-results hidden>
      <div class="mail-result-block"><p class="kicker">Recent Resend sends</p><div data-mail-sends></div></div>
      <div class="mail-result-block"><p class="kicker">Sending domains</p><div data-mail-domains></div></div>
    </div>
  </section>

  <section class="tool-grid" aria-label="Internal tools">
    <a class="tool-card tool-primary" href="/internal/tools/measurements"><span class="tool-icon">⌗</span><div><p class="kicker">Field</p><h2>Window measurements</h2><p>Capture openings, dimensions, quantities, rooms, replacement method, and notes from the job site.</p></div><span class="tool-arrow">Open tool →</span></a>
    <a class="tool-card" href="/internal/quotes/new"><span class="tool-icon">$</span><div><p class="kicker">Sales</p><h2>Smart quote builder</h2><p>Build an editable quote from the price book, add custom work, and finalize or print.</p></div><span class="tool-arrow">Open quote builder →</span></a>
    <a class="tool-card" href="/internal/follow-up"><span class="tool-icon">↗</span><div><p class="kicker">CRM</p><h2>Lead follow-up</h2><p>Turn a lead into a concrete next action with due dates, contact shortcuts, notes, and completion tracking.</p></div><span class="tool-arrow">Open follow-up →</span></a>
    <a class="tool-card" href="/internal/jobs"><span class="tool-icon">✓</span><div><p class="kicker">Operations</p><h2>Job workspace</h2><p>Turn finalized quotes into projects, schedule installation, track progress, and keep crew notes with the job.</p></div><span class="tool-arrow">Open jobs →</span></a>
    <a class="tool-card" href="/internal/jobs"><span class="tool-icon">▣</span><div><p class="kicker">Operations</p><h2>Job prep & closeout</h2><p>Open a job first, then launch its persistent field checklist, quote-material review, staging notes, and closeout workflow.</p></div><span class="tool-arrow">Choose a job →</span></a>
    <a class="tool-card" href="/internal/payments"><span class="tool-icon">◫</span><div><p class="kicker">Closeout</p><h2>Payments & balances</h2><p>Record payment-to-date, see outstanding balances, and reconcile job-level collections internally.</p></div><span class="tool-arrow">Open payments →</span></a>
    <a class="tool-card" href="/internal/schedule"><span class="tool-icon">□</span><div><p class="kicker">Operations</p><h2>Installation schedule</h2><p>See scheduled projects by week and jump directly into the job workspace.</p></div><span class="tool-arrow">Open schedule →</span></a>
    <a class="tool-card" href="/internal/tools/photos"><span class="tool-icon">▧</span><div><p class="kicker">Field</p><h2>Installation photos</h2><p>Capture before, during, after, and issue photos with job IDs, timestamps, and field notes.</p></div><span class="tool-arrow">Open photo log →</span></a>
    <a class="tool-card" href="/internal/leads"><span class="tool-icon">◌</span><div><p class="kicker">CRM</p><h2>Lead workspace</h2><p>Review inbound requests, contact details, attribution, and visitor journeys.</p></div><span class="tool-arrow">Work leads →</span></a>
    <a class="tool-card" href="/internal/ask-logs"><span class="tool-icon">✦</span><div><p class="kicker">Intelligence</p><h2>Ask activity</h2><p>See what prospects are asking the Clearview website assistant before they contact the company.</p></div><span class="tool-arrow">Review Ask →</span></a>
  </section>
  <section class="roadmap panel"><div><p class="kicker">Operating sequence</p><h2>From estimate to completed job</h2><p class="muted">The internal system is built around one continuous record instead of separate disconnected utilities.</p></div><div class="roadmap-flow" aria-label="Workflow roadmap"><span>Lead</span><i>→</i><span>Measure</span><i>→</i><span>Quote</span><i>→</i><span>Sign</span><i>→</i><span>Schedule</span><i>→</i><span>Prep</span><i>→</i><span>Install</span><i>→</i><span>Close</span><i>→</i><span>Collect</span></div></section>
</InternalLayout>
<script>
  function initMailDiagnostics(){
    const sendButton=document.querySelector('[data-mail-test]');
    const checkButton=document.querySelector('[data-mail-check]');
    const status=document.querySelector('[data-mail-status]');
    const results=document.querySelector('[data-mail-results]');
    const sends=document.querySelector('[data-mail-sends]');
    const domains=document.querySelector('[data-mail-domains]');
    if(!(sendButton instanceof HTMLButtonElement)||!(checkButton instanceof HTMLButtonElement)||!(status instanceof HTMLElement)||!(results instanceof HTMLElement)||!(sends instanceof HTMLElement)||!(domains instanceof HTMLElement))return;
    if(sendButton.dataset.bound==='true')return;sendButton.dataset.bound='true';
    const esc=(v)=>{const d=document.createElement('div');d.textContent=String(v??'');return d.innerHTML;};
    function render(data){
      results.hidden=false;
      const emailRows=Array.isArray(data.emails)?data.emails:[];
      sends.innerHTML=emailRows.length?emailRows.map((email)=>`<div class="mail-row"><div><strong>${esc(email.subject||'Untitled')}</strong><small>${esc(email.created_at||'')} · ${esc(email.last_event||'no event reported')}</small></div><code>${esc(email.id||'')}</code></div>`).join(''):'<p class="mail-empty">No recent sent email records returned by Resend.</p>';
      const domainRows=Array.isArray(data.domains)?data.domains:[];
      domains.innerHTML=domainRows.length?domainRows.map((domain)=>`<div class="mail-row"><div><strong>${esc(domain.name||'Unnamed domain')}</strong><small>${esc(domain.region||'')}</small></div><span class="mail-domain-state">${esc(domain.status||'unknown')}</span></div>`).join(''):'<p class="mail-empty">No sending domains returned by Resend.</p>';
    }
    async function check(){
      checkButton.disabled=true;checkButton.textContent='Checking…';status.textContent='Reading Resend activity…';
      try{const response=await fetch('/internal/api/mail-test',{headers:{'cache-control':'no-cache'}});const data=await response.json().catch(()=>({}));if(!response.ok||!data.ok)throw new Error(data.error||`Resend activity check failed (${response.status}).`);render(data);status.textContent=`Resend activity checked · HTTP ${data.emailsStatus}/${data.domainsStatus}`;}
      catch(error){status.textContent=error instanceof Error?error.message:'Resend activity check failed.';}
      finally{checkButton.disabled=false;checkButton.textContent='Check Resend activity';}
    }
    sendButton.addEventListener('click',async()=>{
      if(!window.confirm('Send one controlled production test through the same Resend configuration as the live estimate form?'))return;
      sendButton.disabled=true;checkButton.disabled=true;sendButton.textContent='Sending…';status.textContent='Contacting Resend…';
      try{const response=await fetch('/internal/api/mail-test',{method:'POST',headers:{'content-type':'application/json'},body:'{}'});const data=await response.json().catch(()=>({}));if(!response.ok||!data.ok)throw new Error(`${data.error||'Resend rejected the production mail test.'} (HTTP ${data.resendStatus||response.status})`);status.textContent=`Accepted by Resend · HTTP ${data.resendStatus}${data.messageId?` · ${data.messageId}`:''}`;await check();}
      catch(error){status.textContent=error instanceof Error?error.message:'Production mail test failed.';}
      finally{sendButton.disabled=false;checkButton.disabled=false;sendButton.textContent='Send production test';}
    });
    checkButton.addEventListener('click',check);
  }
  initMailDiagnostics(); document.addEventListener('astro:page-load',initMailDiagnostics);
</script>
<style>
.tools-head{display:flex;justify-content:space-between;align-items:end;gap:var(--space-m);margin-bottom:var(--space-l)}
.mail-test{display:grid;grid-template-columns:minmax(0,1.4fr) minmax(19rem,.9fr);gap:var(--space-l);padding:var(--space-m);margin-bottom:var(--space-l);border-color:color-mix(in srgb,var(--accent) 30%,var(--line));background:linear-gradient(135deg,var(--paper-raised),var(--accent-wash))}
.mail-test h2{margin:.15rem 0 .35rem;font-size:var(--step-2)}.mail-test p:not(.kicker){margin:0;color:var(--ink-soft);max-width:54ch}.mail-test-action{display:grid;align-content:center;gap:.65rem}.mail-test-buttons{display:flex;gap:.5rem;flex-wrap:wrap}.mail-test-buttons .btn{min-height:2.75rem}.mail-test-status{font-size:var(--step--2);color:var(--ink-soft);word-break:break-word}.mail-test-results{grid-column:1/-1;border-top:1px solid var(--line);padding-top:var(--space-s);display:grid;grid-template-columns:1fr 1fr;gap:var(--space-l)}.mail-result-block{min-width:0}.mail-row{display:flex;justify-content:space-between;gap:var(--space-m);align-items:start;padding:.6rem 0;border-bottom:1px solid var(--line)}.mail-row:last-child{border-bottom:0}.mail-row div{min-width:0}.mail-row strong,.mail-row small{display:block}.mail-row small{margin-top:.15rem;color:var(--ink-soft);font-size:var(--step--2)}.mail-row code{font-size:.68rem;color:var(--ink-faint);word-break:break-all;text-align:right}.mail-domain-state{font-size:var(--step--2);font-weight:800;text-transform:uppercase;letter-spacing:.05em}.mail-empty{font-size:var(--step--2);color:var(--ink-soft)}
.tool-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:var(--space-s)}.tool-card{display:grid;grid-template-columns:auto 1fr;gap:var(--space-s);padding:var(--space-m);border:1px solid var(--line);border-radius:var(--radius);background:var(--paper-raised);color:inherit;text-decoration:none;min-height:13rem;transition:transform 120ms ease,box-shadow 120ms ease,border-color 120ms ease}.tool-card:hover,.tool-card:focus-visible{border-color:var(--line-strong);transform:translateY(-1px);box-shadow:var(--shadow-sm);outline:none}.tool-primary{border-color:color-mix(in srgb,var(--accent) 40%,var(--line))}.tool-icon{width:2.4rem;height:2.4rem;border-radius:.8rem;display:grid;place-items:center;background:var(--ink);color:var(--on-dark);font-weight:800}.tool-primary .tool-icon{background:var(--accent)}.tool-card h2{margin:.15rem 0 .35rem;font-size:var(--step-1)}.tool-card p:not(.kicker){margin:0;color:var(--ink-soft);max-width:42rem}.tool-arrow{grid-column:2;align-self:end;font-size:var(--step--1);font-weight:700}.roadmap{margin-top:var(--space-l);padding:var(--space-m)}.roadmap h2{margin:.15rem 0 .35rem;font-size:var(--step-1)}.roadmap-flow{display:flex;flex-wrap:wrap;gap:.5rem;align-items:center;margin-top:var(--space-m)}.roadmap-flow span{border:1px solid var(--line);border-radius:999px;padding:.45rem .7rem;font-size:var(--step--2);font-weight:700;background:var(--paper)}.roadmap-flow i{color:var(--ink-faint);font-style:normal}
@media(max-width:800px){.mail-test{grid-template-columns:1fr}.mail-test-results{grid-template-columns:1fr}.mail-test-buttons{display:grid;grid-template-columns:1fr}.mail-test-buttons .btn{width:100%}}
@media(max-width:700px){.tools-head{align-items:flex-start;flex-direction:column}.tool-grid{grid-template-columns:1fr}.mail-row{gap:.75rem;flex-direction:column}.mail-row code{display:block;text-align:left}}
@media(prefers-reduced-motion:reduce){.tool-card{transition:none}}
</style>
