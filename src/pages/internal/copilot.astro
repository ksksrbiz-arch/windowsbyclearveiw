---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Operations Copilot" noindex>
  <main class="copilot-shell">
    <section class="hero">
      <div>
        <p class="eyebrow">CLEARVIEW INTERNAL</p>
        <h1>Operations Copilot</h1>
        <p class="lede">Ask operational questions. Copilot routes each request through the deterministic ICM layer and keeps business state read-only.</p>
      </div>
      <a class="back" href="/internal/">Command Center</a>
    </section>

    <section class="panel" aria-label="Operations Copilot">
      <div id="messages" class="messages" aria-live="polite">
        <div class="welcome"><strong>Ready.</strong><span>Try “What needs attention today?” or “Analyze the latest lead.”</span></div>
      </div>
      <form id="copilot-form">
        <label for="message">Ask Copilot</label>
        <div class="composer">
          <textarea id="message" name="message" maxlength="1000" rows="3" placeholder="Ask about leads, jobs, evidence, procedures, or today's operations…" required></textarea>
          <button type="submit">Send</button>
        </div>
        <p id="status" class="status" role="status"></p>
      </form>
    </section>
  </main>
</BaseLayout>

<style>
  :global(body){background:#071018;color:#eaf3f7}.copilot-shell{max-width:1100px;margin:0 auto;padding:8rem 1.25rem 5rem}.hero{display:flex;justify-content:space-between;gap:2rem;align-items:end;margin-bottom:2rem}.eyebrow{letter-spacing:.18em;font-size:.72rem;opacity:.7}.hero h1{font-size:clamp(2.2rem,6vw,4.5rem);margin:.3rem 0}.lede{max-width:720px;color:#a9bbc5}.back{color:inherit;text-decoration:none;border:1px solid #35505e;border-radius:999px;padding:.7rem 1rem;white-space:nowrap}.panel{border:1px solid #263b46;border-radius:24px;background:#0c1820;overflow:hidden;box-shadow:0 20px 70px rgba(0,0,0,.25)}.messages{min-height:430px;max-height:62vh;overflow:auto;padding:1.25rem}.welcome,.message{display:flex;flex-direction:column;gap:.4rem;padding:1rem 1.1rem;border-radius:16px;margin-bottom:.75rem;background:#12232d}.message.user{margin-left:12%;background:#172d38}.message .meta{font-size:.72rem;text-transform:uppercase;letter-spacing:.08em;opacity:.55}.message p{white-space:pre-wrap;margin:0;line-height:1.55}.composer{display:flex;gap:.75rem;align-items:stretch}.panel form{border-top:1px solid #263b46;padding:1rem}.panel label{display:block;font-size:.8rem;margin-bottom:.45rem;opacity:.75}.panel textarea{flex:1;resize:vertical;min-width:0;border:1px solid #35505e;border-radius:14px;background:#071018;color:inherit;padding:.9rem;font:inherit}.panel button{align-self:stretch;border:0;border-radius:14px;padding:0 1.25rem;font-weight:700;cursor:pointer}.status{min-height:1.2em;font-size:.78rem;color:#9fb3bc}.status.error{color:#ffb5b5}@media(max-width:700px){.copilot-shell{padding-top:6rem}.hero{align-items:start;flex-direction:column}.composer{flex-direction:column}.panel button{min-height:48px}.message.user{margin-left:0}}
</style>

<script>
  function bindCopilot() {
    const form = document.querySelector('#copilot-form');
    const messages = document.querySelector('#messages');
    const input = document.querySelector('#message');
    const status = document.querySelector('#status');
    if (!(form instanceof HTMLFormElement) || !(messages instanceof HTMLElement) || !(input instanceof HTMLTextAreaElement) || !(status instanceof HTMLElement)) return;
    if (form.dataset.bound === 'true') return;
    form.dataset.bound = 'true';
    const history = [];
    const add = (role, text, meta='') => {
      const el = document.createElement('div');
      el.className = `message ${role}`;
      if (meta) { const m = document.createElement('div'); m.className='meta'; m.textContent=meta; el.appendChild(m); }
      const p = document.createElement('p'); p.textContent=text; el.appendChild(p); messages.appendChild(el); messages.scrollTop=messages.scrollHeight;
    };
    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const message = input.value.trim();
      if (!message) return;
      add('user', message);
      input.value=''; input.disabled=true; form.querySelector('button').disabled=true; status.textContent='Thinking…'; status.className='status';
      try {
        const response = await fetch('/internal/api/copilot', {method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({message,history})});
        const data = await response.json().catch(()=>({}));
        if (!response.ok) throw new Error(data.error || 'Copilot request failed.');
        add('assistant', data.answer || 'No response returned.', `${data.route || 'advisor'} · ${data.provider || 'degraded'}${data.degraded ? ' · VERIFY' : ''}`);
        history.push({role:'user',content:message},{role:'assistant',content:String(data.answer || '')});
        while(history.length>10) history.shift();
        status.textContent = data.degraded ? 'AI is unavailable; verify against the underlying records.' : '';
      } catch (error) {
        status.textContent = error instanceof Error ? error.message : 'Request failed.'; status.className='status error';
      } finally { input.disabled=false; form.querySelector('button').disabled=false; input.focus(); }
    });
  }
  document.addEventListener('astro:page-load', bindCopilot);
  bindCopilot();
</script>
