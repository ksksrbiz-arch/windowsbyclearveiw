---
import InternalLayout from '../../../layouts/InternalLayout.astro';
---
<InternalLayout title="Field Mode">
  <div class="field-head">
    <div>
      <p class="kicker">Field execution · opening mode</p>
      <h1 data-title>Field mode</h1>
      <p class="lede" data-subtitle>One opening at a time. Verify it. Build it. Prove it.</p>
    </div>
    <div class="actions">
      <a class="btn btn-ghost" data-job-link href="/internal/jobs">Job workspace</a>
      <a class="btn btn-ghost" data-photos href="#">All photos</a>
    </div>
  </div>

  <p class="error" data-error hidden role="alert"></p>
  <section class="stop-card" data-stop hidden>
    <strong>STOP · No job Build Plan snapshot</strong>
    <p>This job does not have an attached production snapshot. Do not execute from the live quote/build-plan editor.</p>
    <a class="btn btn-primary btn-small" data-plan-link href="#">Open Build Plan</a>
  </section>

  <main class="field-shell" data-shell hidden>
    <section class="field-progress panel">
      <div class="progress-top">
        <div><span class="kicker">Job progress</span><strong data-overall>0 / 0 openings complete</strong></div>
        <div class="overall-bar"><span data-overall-bar></span></div>
      </div>
      <div class="opening-strip" data-strip></div>
    </section>

    <section class="field-grid">
      <section class="panel primary-panel">
        <div class="panel-head">
          <div>
            <p class="kicker">Current opening</p>
            <h2 data-heading>Opening 1</h2>
            <p class="muted" data-opening-meta>—</p>
          </div>
          <div class="opening-nav">
            <button class="btn btn-ghost btn-small" data-prev type="button">← Previous</button>
            <span data-position>1 / 1</span>
            <button class="btn btn-primary btn-small" data-next type="button">Next →</button>
          </div>
        </div>

        <div class="opening-identity">
          <div class="identity-number" data-number>01</div>
          <div><strong data-product>Quoted opening</strong><span data-type>Type VERIFY</span></div>
          <span class="verify-badge">FIELD VERIFY</span>
        </div>

        <div class="spec-grid">
          <div><span>Dimensions</span><strong data-dimensions>VERIFY on site</strong></div>
          <div><span>Quantity</span><strong data-quantity>1</strong></div>
          <div><span>Existing condition</span><strong data-condition>VERIFY on site</strong></div>
          <div><span>Install method</span><strong data-method>VERIFY against product instructions</strong></div>
        </div>

        <div class="sequence">
          <article><b>01 · VERIFY</b><p>Confirm product, type, dimensions, method, and field condition before removal.</p><label><input type="checkbox" data-gate="Verify"> <span>I verified the opening.</span></label></article>
          <article><b>02 · REMOVE</b><p>Protect the work area, remove the existing unit, and document concealed conditions.</p><label><input type="checkbox" data-gate="Remove"> <span>Removal and inspection complete.</span></label></article>
          <article><b>03 · PREP</b><p>Prepare the opening and establish the actual water-management path.</p><label><input type="checkbox" data-gate="Prep"> <span>Opening is prepared.</span></label></article>
          <article><b>04 · INSTALL</b><p>Set and secure the unit using the selected manufacturer's current instructions.</p><label><input type="checkbox" data-gate="Install"> <span>Unit installed and secured.</span></label></article>
          <article><b>05 · FLASH / SEAL</b><p>Complete required flashing, WRB transitions, air sealing, insulation, and finish work for the actual assembly.</p><label><input type="checkbox" data-gate="Flash / Seal"> <span>Flashing / sealing complete.</span></label></article>
          <article><b>06 · OPERATE</b><p>Check fit, alignment, operation, finish, and visible water-management conditions.</p><label><input type="checkbox" data-gate="Operate"> <span>Operation and fit verified.</span></label></article>
          <article><b>07 · PHOTOGRAPH</b><p>Capture before, installation-progress, and after evidence using the job photo workflow.</p><label><input type="checkbox" data-gate="Photograph"> <span>Opening photos captured.</span></label><a class="photo-link" data-opening-photos href="#">Open photo tool →</a></article>
          <article class="complete-card"><b>08 · COMPLETE</b><p>Close this opening only after the prior gates are checked.</p><label><input type="checkbox" data-gate="Complete"> <span>Opening complete.</span></label></article>
        </div>

        <div class="field-note">
          <label><strong>Opening notes</strong><textarea data-notes rows="4" maxlength="3000" placeholder="Actual field condition, measurements, concealed damage, exceptions, customer requests…"></textarea></label>
          <button class="btn btn-primary" type="button" data-save-note>Save opening note</button>
          <span class="save-state" data-save-state>Saved to job checklist</span>
        </div>
      </section>

      <aside class="side-stack">
        <section class="panel decision-panel">
          <div class="panel-head"><div><p class="kicker">Safety rail</p><h2>Before you proceed</h2></div></div>
          <div class="safety-list">
            <div><strong>VERIFY means VERIFY</strong><p>Do not turn a product-specific placeholder into an assumed specification.</p></div>
            <div><strong>Stop for concealed damage</strong><p>Record unexpected conditions in the opening notes and escalate before proceeding.</p></div>
            <div><strong>Evidence matters</strong><p>Photos and checklist state should agree with the actual completed opening.</p></div>
          </div>
        </section>
        <section class="panel plan-panel">
          <div class="panel-head"><div><p class="kicker">Snapshot</p><h2>Production source</h2></div></div>
          <div class="plan-facts"><span><strong data-plan-version>—</strong><small>Build Plan</small></span><span><strong data-verify-count>—</strong><small>VERIFY items</small></span></div>
          <a class="plan-open" data-plan-link-2 href="#">Open approved plan →</a>
        </section>
      </aside>
    </section>
  </main>
</InternalLayout>
<script>
  type GateItem={id:number;section:string;label:string;checked:number;notes:string|null};
  let job:any=null;let plan:any=null;let gates:GateItem[]=[];let openings:any[]=[];let index=0;let currentSection='';
  const qs=<T extends Element>(s:string)=>document.querySelector(s) as T|null;
  const esc=(v:any)=>{const d=document.createElement('div');d.textContent=String(v??'');return d.innerHTML;};
  const sectionFor=(i:number)=>`Opening ${String(i+1).padStart(2,'0')}`;
  const getOpeningGates=()=>{const section=sectionFor(index);return gates.filter(g=>g.section===section).sort((a,b)=>a.id-b.id);};
  const currentComplete=()=>getOpeningGates().find(g=>g.label==='Complete');
  const canNavigateTo=(target:number)=>{if(target<=index)return true;if(Number(currentComplete()?.checked)===1)return true;showError('Complete the current opening before moving to the next opening.');return false;};
  function render(){if(!job||!plan)return;const opening=openings[index]||{};currentSection=sectionFor(index);const gateRows=getOpeningGates();
    qs('[data-title]')!.textContent=job.customer_name||job.id;qs('[data-subtitle]')!.textContent=`${job.id}${job.customer_city?` · ${job.customer_city}`:''}`;qs('[data-heading]')!.textContent=`Opening ${index+1}`;qs('[data-opening-meta]')!.textContent=`${job.id} · ${opening.openingType||'Type VERIFY'} · ${opening.installationMethod||'Method VERIFY'}`;qs('[data-position]')!.textContent=`${openings.length?index+1:0} / ${openings.length}`;qs('[data-number]')!.textContent=String(index+1).padStart(2,'0');qs('[data-product]')!.textContent=opening.product||opening.sourceItemLabel||'Quoted opening';qs('[data-type]')!.textContent=opening.openingType||'Type VERIFY';qs('[data-dimensions]')!.textContent=opening.dimensions||'VERIFY on site';qs('[data-quantity]')!.textContent=String(Number(opening.quantity)||1);qs('[data-condition]')!.textContent=opening.existingCondition||'VERIFY on site';qs('[data-method]')!.textContent=opening.installationMethod||'VERIFY against product instructions';
    const notes=qs<HTMLTextAreaElement>('[data-notes]'),photo=qs<HTMLAnchorElement>('[data-opening-photos]');const noteItem=gateRows.find(g=>g.label==='Verify')||null;if(notes)notes.value=noteItem?.notes||'';if(photo)photo.href=`/internal/tools/photos?jobId=${encodeURIComponent(job.id)}`;
    document.querySelectorAll<HTMLInputElement>('[data-gate]').forEach(input=>{const item=gateRows.find(g=>g.label===input.dataset.gate);input.checked=Number(item?.checked)===1;input.disabled=Boolean(item&&input.dataset.gate==='Complete'&&gateRows.some(g=>g.label!=='Complete'&&Number(g.checked)!==1));});
    qs<HTMLButtonElement>('[data-prev]')!.disabled=index<=0;qs<HTMLButtonElement>('[data-next]')!.disabled=index>=openings.length-1||Number(currentComplete()?.checked)!==1;qs('[data-plan-version]')!.textContent=String(plan?.version||'—');qs('[data-verify-count]')!.textContent=String(Array.isArray(plan?.verify)?plan.verify.length:0);
    const doneOpenings=openings.reduce((n,_,i)=>{const gs=gates.filter(g=>g.section===sectionFor(i));return n+(Number(gs.find(g=>g.label==='Complete')?.checked)===1?1:0)},0);qs('[data-overall]')!.textContent=`${doneOpenings} / ${openings.length} openings complete`;const bar=qs<HTMLElement>('[data-overall-bar]');if(bar)bar.style.width=`${openings.length?Math.round(doneOpenings/openings.length*100):0}%`;
    const strip=qs('[data-strip]');if(strip)strip.innerHTML=openings.map((o:any,i:number)=>{const section=sectionFor(i);const complete=gates.find(g=>g.section===section&&g.label==='Complete');const blocked=i>index&&Number(currentComplete()?.checked)!==1;return `<button type="button" class="strip-item ${i===index?'active':''} ${Number(complete?.checked)===1?'done':''}" data-opening-index="${i}" ${blocked?'disabled':''}><strong>${String(i+1).padStart(2,'0')}</strong><span>${esc(o.product||o.openingType||'Opening')}</span></button>`}).join('');
    document.querySelectorAll<HTMLButtonElement>('[data-opening-index]').forEach(el=>el.addEventListener('click',()=>{const target=Number(el.dataset.openingIndex);if(canNavigateTo(target)){index=target;render();}}));
  }
  async function patchGate(input:HTMLInputElement){const item=gates.find(g=>g.section===currentSection&&g.label===input.dataset.gate);if(!item)return;input.disabled=true;try{const body:any={checked:input.checked};if(item.label==='Verify'){const note=qs<HTMLTextAreaElement>('[data-notes]');body.notes=note?.value||'';}const r=await fetch(`/internal/api/job-checklist?id=${encodeURIComponent(item.id)}`,{method:'PATCH',headers:{'content-type':'application/json'},body:JSON.stringify(body)});const d=await r.json().catch(()=>({}));if(!r.ok)throw new Error(d.error||'Could not save field gate.');item.checked=input.checked?1:0;if(body.notes!==undefined)item.notes=body.notes;render();}catch(e){input.checked=!input.checked;showError(e instanceof Error?e.message:'Could not save field gate.');}finally{input.disabled=false;}}
  async function init(){const id=new URLSearchParams(location.search).get('id'),error=qs<HTMLElement>('[data-error]');if(!id){showError('No job id in the URL.');return;}try{const[jr,cr]=await Promise.all([fetch(`/internal/api/jobs?id=${encodeURIComponent(id)}`,{headers:{'cache-control':'no-cache'}}),fetch(`/internal/api/job-checklist?jobId=${encodeURIComponent(id)}`,{headers:{'cache-control':'no-cache'}})]);const jd=await jr.json().catch(()=>({})),cd=await cr.json().catch(()=>({}));if(!jr.ok)throw new Error(jd.error||'Could not load this job.');if(!cr.ok)throw new Error(cd.error||'Could not load field checklist.');job=jd.job;plan=jd.buildPlan;gates=cd.items||[];if(!plan){qs<HTMLElement>('[data-stop]')!.hidden=false;const link=qs<HTMLAnchorElement>('[data-plan-link]'),link2=qs<HTMLAnchorElement>('[data-plan-link-2]');if(job.quote_id){const href=`/internal/quotes/build-plan?quoteId=${encodeURIComponent(job.quote_id)}`;if(link)link.href=href;if(link2)link2.href=href;}return;}openings=Array.isArray(plan.openings)?plan.openings:[];qs<HTMLElement>('[data-shell]')!.hidden=false;const jobLink=qs<HTMLAnchorElement>('[data-job-link]'),photos=qs<HTMLAnchorElement>('[data-photos]'),planLink=qs<HTMLAnchorElement>('[data-plan-link-2]');if(jobLink)jobLink.href=`/internal/jobs/view?id=${encodeURIComponent(job.id)}`;if(photos)photos.href=`/internal/tools/photos?jobId=${encodeURIComponent(job.id)}`;if(planLink&&job.quote_id)planLink.href=`/internal/quotes/build-plan?quoteId=${encodeURIComponent(job.quote_id)}`;render();document.querySelectorAll<HTMLInputElement>('[data-gate]').forEach(input=>input.addEventListener('change',()=>patchGate(input)));}catch(e){showError(e instanceof Error?e.message:'Could not load field mode.');}}
  function showError(message:string){const error=qs<HTMLElement>('[data-error]');if(error){error.hidden=false;error.textContent=message;}}
  qs('[data-prev]')?.addEventListener('click',()=>{index=Math.max(0,index-1);render();});qs('[data-next]')?.addEventListener('click',()=>{const target=Math.min(openings.length-1,index+1);if(canNavigateTo(target)){index=target;render();}});qs('[data-save-note]')?.addEventListener('click',async()=>{const note=qs<HTMLTextAreaElement>('[data-notes]');const item=gates.find(g=>g.section===currentSection&&g.label==='Verify');if(!note||!item)return;const button=qs<HTMLButtonElement>('[data-save-note]');if(button){button.disabled=true;button.textContent='Saving…';}try{const r=await fetch(`/internal/api/job-checklist?id=${encodeURIComponent(item.id)}`,{method:'PATCH',headers:{'content-type':'application/json'},body:JSON.stringify({checked:Boolean(item.checked),notes:note.value})});if(!r.ok)throw new Error('Could not save opening note.');item.notes=note.value;const state=qs('[data-save-state]');if(state)state.textContent=`Saved ${new Date().toLocaleTimeString('en-US',{hour:'numeric',minute:'2-digit'})}`;}catch(e){showError(e instanceof Error?e.message:'Could not save opening note.');}finally{if(button){button.disabled=false;button.textContent='Save opening note';}}});
  init();
</script>
<style>
.field-head{display:flex;justify-content:space-between;align-items:end;gap:var(--space-m);margin-bottom:var(--space-m)}.actions{display:flex;gap:.45rem;flex-wrap:wrap}.btn-small{padding:.45rem .7rem}.panel{border:1px solid var(--line);border-radius:var(--radius-lg);background:var(--paper-raised);overflow:hidden;box-shadow:var(--shadow-sm)}.stop-card{margin-bottom:var(--space-m);padding:1rem 1.1rem;border:1px solid var(--danger);border-radius:var(--radius);background:color-mix(in srgb,var(--danger) 7%,transparent)}.stop-card strong{display:block;color:var(--danger)}.stop-card p{color:var(--ink-soft);max-width:68ch}.field-progress{padding:1rem 1.1rem;margin-bottom:var(--space-m)}.progress-top{display:grid;grid-template-columns:auto minmax(10rem,1fr);gap:1rem;align-items:end}.progress-top>div:first-child{display:grid;gap:.15rem}.progress-top strong{font-size:1.05rem}.overall-bar{height:.48rem;background:var(--line);border-radius:999px;overflow:hidden}.overall-bar span{display:block;width:0;height:100%;background:var(--accent);transition:width .2s ease}.opening-strip{display:grid;grid-template-columns:repeat(auto-fit,minmax(6.2rem,1fr));gap:.45rem;margin-top:1rem}.strip-item{border:1px solid var(--line);background:var(--paper);border-radius:var(--radius);padding:.6rem;text-align:left;cursor:pointer;display:grid;gap:.15rem;min-width:0}.strip-item strong{font-size:.75rem}.strip-item span{font-size:.7rem;color:var(--ink-soft);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.strip-item.active{border-color:var(--accent);box-shadow:inset 0 0 0 1px var(--accent)}.strip-item.done{background:var(--accent-wash)}.strip-item:disabled{opacity:.45;cursor:not-allowed}.field-grid{display:grid;grid-template-columns:minmax(0,1.65fr) minmax(18rem,.7fr);gap:var(--space-m)}.panel-head{padding:var(--space-m);border-bottom:1px solid var(--line);display:flex;justify-content:space-between;align-items:end;gap:var(--space-s)}.panel-head h2{margin:.12rem 0 0;font-size:var(--step-1)}.opening-nav{display:flex;align-items:center;gap:.45rem;white-space:nowrap}.opening-nav span{font-size:var(--step--2);color:var(--ink-faint)}.opening-identity{display:flex;align-items:center;gap:.8rem;padding:var(--space-m)}.identity-number{display:grid;place-items:center;width:3rem;height:3rem;border-radius:50%;background:var(--black);color:var(--on-dark);font-weight:850}.opening-identity>div:nth-child(2){display:grid;gap:.12rem;flex:1}.opening-identity>div:nth-child(2) span{color:var(--ink-soft);font-size:.82rem}.verify-badge{padding:.35rem .55rem;border-radius:999px;background:var(--accent-wash);color:var(--accent-ink);font-size:.68rem;font-weight:850;letter-spacing:.06em}.spec-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:1px;background:var(--line);border-block:1px solid var(--line)}.spec-grid div{background:var(--paper);padding:.85rem}.spec-grid span{display:block;color:var(--ink-faint);font-size:.68rem;text-transform:uppercase;letter-spacing:.06em}.spec-grid strong{display:block;margin-top:.25rem;font-size:.9rem}.sequence{display:grid;grid-template-columns:repeat(2,1fr);gap:.65rem;padding:var(--space-m)}.sequence article{border:1px solid var(--line);border-radius:var(--radius);padding:.85rem;background:var(--paper)}.sequence article.complete-card{border-color:var(--accent);background:var(--accent-wash)}.sequence b{font-size:.7rem;letter-spacing:.06em}.sequence p{font-size:.8rem;color:var(--ink-soft);line-height:1.45;margin:.3rem 0 .55rem}.sequence label{display:flex;gap:.45rem;align-items:flex-start;font-size:.8rem;font-weight:700}.sequence input{width:1.05rem;height:1.05rem;accent-color:var(--accent);margin-top:.1rem}.photo-link{display:inline-block;margin:.6rem 0 0 1.5rem;font-size:.75rem;color:var(--accent-ink)}.field-note{border-top:1px solid var(--line);padding:var(--space-m);display:grid;gap:.6rem}.field-note label{display:grid;gap:.4rem}.field-note textarea{width:100%;border:1px solid var(--line-strong);border-radius:var(--radius);background:var(--paper);color:var(--ink);padding:.7rem;font:inherit;resize:vertical}.field-note .save-state{color:var(--ink-faint);font-size:.72rem}.side-stack{display:grid;gap:var(--space-m);align-content:start}.safety-list{padding:0 var(--space-m) var(--space-m)}.safety-list div{padding:.75rem 0;border-bottom:1px solid var(--line)}.safety-list p{margin:.2rem 0 0;color:var(--ink-soft);font-size:.8rem;line-height:1.45}.plan-facts{display:grid;grid-template-columns:repeat(2,1fr);gap:1px;background:var(--line);margin-bottom:.5rem}.plan-facts span{background:var(--paper);padding:var(--space-m);display:grid;gap:.1rem}.plan-facts strong{font-size:1.25rem}.plan-facts small{color:var(--ink-faint)}.plan-open{display:block;padding:0 var(--space-m) var(--space-m);color:var(--accent-ink);font-weight:700;font-size:.8rem}.error{padding:.8rem;border-left:2px solid var(--danger);background:color-mix(in srgb,var(--danger) 8%,transparent);margin-bottom:var(--space-m)}.muted{color:var(--ink-soft)}@media(max-width:900px){.field-grid{grid-template-columns:1fr}.progress-top{grid-template-columns:1fr}.sequence{grid-template-columns:1fr}}@media(max-width:650px){.field-head{align-items:flex-start;flex-direction:column}.field-head .actions{width:100%}.field-head .actions .btn{flex:1;justify-content:center}.opening-strip{grid-template-columns:repeat(4,1fr)}.opening-nav{width:100%;justify-content:space-between}.opening-identity{align-items:flex-start;flex-wrap:wrap}.verify-badge{margin-left:3.8rem;margin-top:-.45rem}.sequence{padding:.85rem}.spec-grid{grid-template-columns:1fr}}@media(max-width:420px){.opening-strip{grid-template-columns:repeat(3,1fr)}}
</style>