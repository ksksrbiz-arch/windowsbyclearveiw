---
import InternalLayout from '../../../layouts/InternalLayout.astro';
---
<InternalLayout title="Field Mode">
  <div class="field-head"><div><p class="kicker">ClearView Command Center · Field execution</p><h1 data-title>Field mode</h1><p class="lede" data-subtitle>One opening at a time. Verify it. Build it. Prove it.</p></div><div class="actions"><a class="btn btn-ghost" data-job-link href="/internal/jobs">Job workspace</a><a class="btn btn-ghost" data-photos href="#">Photo log</a></div></div>
  <p class="error" data-error hidden role="alert"></p>
  <section class="stop-card" data-stop hidden><strong>STOP · No production snapshot attached</strong><p>This job cannot be executed from a live quote/build-plan editor. Attach the approved Build Plan snapshot first.</p><a class="btn btn-primary btn-small" data-plan-link href="#">Open Build Plan</a></section>
  <main class="field-shell" data-shell hidden>
    <section class="mobile-status panel" aria-live="polite"><div><span>Current opening</span><strong data-mobile-status>01 · Ready</strong></div><span class="status-dot" data-status-dot></span></section>
    <section class="field-progress panel"><div class="progress-top"><div><span class="kicker">Job progress</span><strong data-overall>0 / 0 openings complete</strong></div><div class="overall-track"><span data-overall-bar></span></div></div><div class="opening-strip" data-strip></div></section>
    <section class="field-grid">
      <section class="panel primary-panel">
        <div class="panel-head opening-head"><div><p class="kicker">Current opening</p><h2 data-heading>Opening 1</h2><p class="muted" data-opening-meta>—</p></div><div class="opening-nav"><button class="btn btn-ghost btn-small" data-prev type="button">← Previous</button><span data-position>1 / 1</span><button class="btn btn-primary btn-small" data-next type="button">Next →</button></div></div>
        <div class="opening-identity"><div class="identity-number" data-number>01</div><div><strong data-product>Quoted opening</strong><span data-type>Type VERIFY</span></div><span class="verify-badge">FIELD VERIFY</span></div>
        <div class="spec-grid"><div><span>Quoted dimensions</span><strong data-dimensions>VERIFY on site</strong></div><div><span>Quantity</span><strong data-quantity>1</strong></div><div><span>Existing condition</span><strong data-condition>VERIFY on site</strong></div><div><span>Install method</span><strong data-method>VERIFY against product instructions</strong></div></div>
        <section class="evidence-card"><div class="section-title"><div><p class="kicker">01 · Field evidence</p><h3>Measure the actual opening</h3></div><span class="saved-pill" data-evidence-state>Not saved</span></div><div class="measurement-grid"><label>Width <span>in</span><input data-measure="width" inputmode="decimal" type="number" min="0" max="9999" step="0.01" placeholder="—"></label><label>Height <span>in</span><input data-measure="height" inputmode="decimal" type="number" min="0" max="9999" step="0.01" placeholder="—"></label><label>Depth <span>in</span><input data-measure="depth" inputmode="decimal" type="number" min="0" max="9999" step="0.01" placeholder="—"></label><label>Sill / seat <span>in</span><input data-measure="sill" inputmode="decimal" type="number" min="0" max="9999" step="0.01" placeholder="—"></label></div><p class="helper">These are field observations, not a replacement for the manufacturer's installation requirements.</p></section>
        <section class="evidence-card"><div class="section-title"><div><p class="kicker">02 · Exceptions</p><h3>Unexpected condition?</h3></div><span class="exception-indicator" data-exception-indicator>Clear</span></div><div class="exception-grid"><label>Status<select data-exception><option value="none">No exception</option><option value="open">Open — stop / escalate</option><option value="punchlist">Punch list — finish later</option><option value="resolved">Resolved — documented</option></select></label><label>What happened<textarea data-exception-notes rows="3" maxlength="5000" placeholder="Concealed damage, rot, framing variance, water path, customer request, material shortage…"></textarea></label></div></section>
        <section class="evidence-card"><div class="section-title"><div><p class="kicker">03 · Materials</p><h3>Actual material usage</h3></div><button class="text-button" data-add-material type="button">+ Add material</button></div><div class="materials" data-materials></div><p class="helper">Record actual usage when it matters for replenishment, cost tracking, or closeout.</p></section>
        <section class="evidence-card"><div class="section-title"><div><p class="kicker">04 · Notes</p><h3>Opening record</h3></div></div><textarea class="big-note" data-notes rows="4" maxlength="5000" placeholder="Actual field condition, customer requests, concealed conditions, installation observations…"></textarea></section>
        <div class="evidence-actions"><span class="save-state" data-save-state>Changes are local until saved.</span><button class="btn btn-primary" data-save-evidence type="button">Save opening record</button></div>
        <section class="sequence"><div class="section-title"><div><p class="kicker">05 · Execution gates</p><h3>Do the work in order</h3></div><span class="gate-summary" data-gate-summary>0 / 8</span></div>
          <article data-gate-card="Verify"><div class="gate-num">01</div><div><b>VERIFY</b><p>Confirm product, type, field dimensions, method, and condition before removal.</p></div><label class="gate-check"><input type="checkbox" data-gate="Verify"><span>Verified</span></label></article>
          <article data-gate-card="Remove"><div class="gate-num">02</div><div><b>REMOVE</b><p>Protect the work area, remove the existing unit, and inspect concealed conditions.</p></div><label class="gate-check"><input type="checkbox" data-gate="Remove"><span>Removal complete</span></label></article>
          <article data-gate-card="Prep"><div class="gate-num">03</div><div><b>PREP</b><p>Prepare the opening and establish the actual water-management path.</p></div><label class="gate-check"><input type="checkbox" data-gate="Prep"><span>Prepared</span></label></article>
          <article data-gate-card="Install"><div class="gate-num">04</div><div><b>INSTALL</b><p>Set and secure the unit using the selected manufacturer's current instructions.</p></div><label class="gate-check"><input type="checkbox" data-gate="Install"><span>Installed</span></label></article>
          <article data-gate-card="Flash / Seal"><div class="gate-num">05</div><div><b>FLASH / SEAL</b><p>Complete flashing, WRB transitions, air sealing, insulation, drainage, and finish work for the actual assembly.</p></div><label class="gate-check"><input type="checkbox" data-gate="Flash / Seal"><span>Sealed</span></label></article>
          <article data-gate-card="Operate"><div class="gate-num">06</div><div><b>OPERATE</b><p>Check fit, alignment, operation, locks/hardware, finish, and visible water-management conditions.</p></div><label class="gate-check"><input type="checkbox" data-gate="Operate"><span>Passed</span></label></article>
          <article data-gate-card="Photograph"><div class="gate-num">07</div><div><b>PHOTOGRAPH</b><p data-photo-copy>Capture before, during, and after evidence for this opening. If an evidence exception exists, document it.</p><a class="photo-link" data-opening-photos href="#">Open opening photo log →</a></div><label class="gate-check"><input type="checkbox" data-gate="Photograph"><span>Evidence complete</span></label></article>
          <article class="complete-card" data-gate-card="Complete"><div class="gate-num">08</div><div><b>COMPLETE</b><p>Close only when every prior gate is complete and no open exception remains.</p></div><label class="gate-check"><input type="checkbox" data-gate="Complete"><span>Close opening</span></label></article>
        </section>
      </section>
      <aside class="side-stack">
        <section class="panel decision-panel"><div class="panel-head"><div><p class="kicker">Safety rail</p><h2>Before you proceed</h2></div></div><div class="safety-list"><div><strong>VERIFY means VERIFY</strong><p>Never turn a placeholder into an assumed specification.</p></div><div><strong>Stop for concealed damage</strong><p>Record unexpected conditions and escalate before proceeding.</p></div><div><strong>Evidence must agree</strong><p>Checklist state, field record, and photos should describe the same opening.</p></div></div></section>
        <section class="panel plan-panel"><div class="panel-head"><div><p class="kicker">Production source</p><h2>Approved snapshot</h2></div></div><div class="plan-facts"><span><strong data-plan-version>—</strong><small>Build Plan</small></span><span><strong data-verify-count>—</strong><small>VERIFY items</small></span></div><a class="plan-open" data-plan-link-2 href="#">Open approved plan →</a></section>
        <section class="panel photo-status-panel"><div class="panel-head"><div><p class="kicker">Photo evidence</p><h2>This opening</h2></div></div><div class="photo-counts"><span data-photo-count="before"><b>0</b><small>Before</small></span><span data-photo-count="during"><b>0</b><small>During</small></span><span data-photo-count="after"><b>0</b><small>After</small></span></div><a class="btn btn-primary photo-launch" data-opening-photos-2 href="#">Capture opening photos</a></section>
      </aside>
    </section>
  </main>
  <nav class="mobile-nav" data-mobile-nav hidden><button type="button" data-mobile-prev>←</button><span data-mobile-position>1 / 1</span><button type="button" data-mobile-next>Next →</button></nav>
</InternalLayout>

<script>
  type Gate={id:number;section:string;label:string;checked:number;notes:string|null};
  type Evidence={id?:number;opening_index:number;measurements:any;notes:string;exception_status:string;exception_notes:string;materialUsage:any;photoSummary:any};
  let job:any=null,plan:any=null,gates:Gate[]=[],evidence:Evidence[]=[],openings:any[]=[],index=0,currentSection='';
  function qs<T extends Element>(s:string){return document.querySelector(s) as T|null};
  const esc=(v:unknown)=>{const d=document.createElement('div');d.textContent=String(v??'');return d.innerHTML;};
  const sectionFor=(i:number)=>`Opening ${String(i+1).padStart(2,'0')}`;
  const openingGates=()=>gates.filter(g=>g.section===sectionFor(index)).sort((a,b)=>a.id-b.id);
  const currentEvidence=()=>evidence.find(e=>Number(e.opening_index)===index)||{opening_index:index,measurements:{},notes:'',exception_status:'none',exception_notes:'',materialUsage:{},photoSummary:{}};
  const fmt=(v:any)=>typeof v==='object'&&v!==null?Object.entries(v).map(([k,x])=>`${k}: ${x}`).join(' · '):String(v??'—');
  function showError(message:string){const el=qs<HTMLElement>('[data-error]');if(el){el.hidden=false;el.textContent=message;window.scrollTo({top:0,behavior:'smooth'});}}
  function photoDb(){return new Promise<IDBDatabase|null>((resolve)=>{const r=indexedDB.open('clearview-field-tools',2);r.onsuccess=()=>resolve(r.result);r.onerror=()=>resolve(null);});}
  function photoRows(db:IDBDatabase):Promise<any[]>{return new Promise(resolve=>{const tx=db.transaction('photos','readonly'),r=tx.objectStore('photos').getAll();r.onsuccess=()=>resolve(r.result||[]);r.onerror=()=>resolve([]);});}
  async function refreshPhotos(){const db=await photoDb();if(!db)return;const rows=await photoRows(db);const mine=rows.filter(p=>p.jobId===job?.id&&Number(p.openingIndex)===index);const counts={before:0,during:0,after:0,issue:0};mine.forEach(p=>{if(counts[p.stage as keyof typeof counts]!==undefined)counts[p.stage as keyof typeof counts]++;});for(const key of ['before','during','after']){const el=qs<HTMLElement>(`[data-photo-count="${key}"] b`);if(el)el.textContent=String(counts[key as keyof typeof counts]);}const summary=qs('[data-photo-copy]');if(summary)summary.textContent=`${counts.before?'✓':''} Before · ${counts.during?'✓':''} During · ${counts.after?'✓':''} After. Capture all three, or document an explicit evidence exception.`;const ev=currentEvidence();ev.photoSummary=counts;}
  function renderEvidence(){const ev=currentEvidence();document.querySelectorAll<HTMLInputElement>('[data-measure]').forEach(i=>i.value=ev.measurements?.[i.dataset.measure||'']??'');const notes=qs<HTMLTextAreaElement>('[data-notes]');if(notes)notes.value=ev.notes||'';const ex=qs<HTMLSelectElement>('[data-exception]');if(ex)ex.value=ev.exception_status||'none';const exn=qs<HTMLTextAreaElement>('[data-exception-notes]');if(exn)exn.value=ev.exception_notes||'';const ind=qs<HTMLElement>('[data-exception-indicator]');if(ind){ind.textContent=ev.exception_status==='none'?'Clear':ev.exception_status==='open'?'OPEN':ev.exception_status==='punchlist'?'PUNCH LIST':'RESOLVED';ind.className=`exception-indicator ${ev.exception_status}`;}const box=qs<HTMLElement>('[data-materials]');if(box){box.innerHTML='';const usage=ev.materialUsage||{};const entries=Object.entries(usage);(entries.length?entries:[['',0]]).forEach(([name,qty])=>addMaterialRow(box,String(name),Number(qty),false));}const state=qs<HTMLElement>('[data-evidence-state]');if(state)state.textContent=ev.id?'Saved':'Not saved';}
  function addMaterialRow(box:HTMLElement,name:string,qty:number,focus=true){const row=document.createElement('div');row.className='material-row';row.innerHTML=`<input data-material-name maxlength="80" placeholder="Material / item" value="${esc(name)}"><input data-material-qty inputmode="decimal" type="number" min="0" max="100000" step="0.01" placeholder="Qty" value="${qty||''}"><button type="button" aria-label="Remove material">×</button>`;row.querySelector('button')?.addEventListener('click',()=>row.remove());box.append(row);if(focus)(row.querySelector('input') as HTMLInputElement)?.focus();}
  function collectEvidence():Evidence{const ev=currentEvidence();const measurements:any={};document.querySelectorAll<HTMLInputElement>('[data-measure]').forEach(i=>{if(i.value.trim()!=='')measurements[i.dataset.measure||'']=Number(i.value);});const materialUsage:any={};document.querySelectorAll<HTMLElement>('.material-row').forEach(row=>{const name=(row.querySelector('[data-material-name]') as HTMLInputElement)?.value.trim();const qty=Number((row.querySelector('[data-material-qty]') as HTMLInputElement)?.value);if(name&&Number.isFinite(qty)&&qty>=0)materialUsage[name]=qty;});return {...ev,opening_index:index,measurements,notes:qs<HTMLTextAreaElement>('[data-notes]')?.value.slice(0,5000)||'',exception_status:qs<HTMLSelectElement>('[data-exception]')?.value||'none',exception_notes:qs<HTMLTextAreaElement>('[data-exception-notes]')?.value.slice(0,5000)||'',materialUsage};}
  async function saveEvidence(silent=false){const button=qs<HTMLButtonElement>('[data-save-evidence]');if(button)button.disabled=true;try{const payload=collectEvidence();const db=await photoDb();if(db){const rows=await photoRows(db),mine=rows.filter(p=>p.jobId===job?.id&&Number(p.openingIndex)===index),counts={before:0,during:0,after:0,issue:0};mine.forEach(p=>{if(counts[p.stage as keyof typeof counts]!==undefined)counts[p.stage as keyof typeof counts]++;});payload.photoSummary=counts;}const r=await fetch(`/internal/api/job-evidence?jobId=${encodeURIComponent(job.id)}`,{method:'PATCH',headers:{'content-type':'application/json'},body:JSON.stringify(payload)});const d=await r.json().catch(()=>({}));if(!r.ok)throw new Error(d.error||'Could not save opening record.');const saved=d.evidence;const pos=evidence.findIndex(e=>e.opening_index===index);if(pos>=0)evidence[pos]=saved;else evidence.push(saved);const state=qs<HTMLElement>('[data-evidence-state]');if(state)state.textContent='Saved';const saveState=qs<HTMLElement>('[data-save-state]');if(saveState)saveState.textContent=`Saved ${new Date().toLocaleTimeString('en-US',{hour:'numeric',minute:'2-digit'})}`;if(!silent)refreshPhotos();}catch(e){showError(e instanceof Error?e.message:'Could not save opening record.');}finally{if(button)button.disabled=false;}}
  function canMove(target:number){if(target<=index)return true;const complete=openingGates().find(g=>g.label==='Complete');if(Number(complete?.checked)===1)return true;showError('Complete the current opening before moving to the next opening.');return false;}
  function render(){if(!job||!plan)return;currentSection=sectionFor(index);const o=openings[index]||{},gs=openingGates();qs('[data-title]')!.textContent=job.customer_name||job.id;qs('[data-subtitle]')!.textContent=`${job.id}${job.customer_city?` · ${job.customer_city}`:''}`;qs('[data-heading]')!.textContent=`Opening ${index+1}`;qs('[data-opening-meta]')!.textContent=`${job.id} · ${o.openingType||'Type VERIFY'} · ${o.installationMethod||'Method VERIFY'}`;qs('[data-position]')!.textContent=`${index+1} / ${openings.length}`;qs('[data-number]')!.textContent=String(index+1).padStart(2,'0');qs('[data-product]')!.textContent=o.product||o.sourceItemLabel||'Quoted opening';qs('[data-type]')!.textContent=o.openingType||'Type VERIFY';qs('[data-dimensions]')!.textContent=fmt(o.dimensions)||'VERIFY on site';qs('[data-quantity]')!.textContent=String(Number(o.quantity)||1);qs('[data-condition]')!.textContent=o.existingCondition||'VERIFY on site';qs('[data-method]')!.textContent=o.installationMethod||'VERIFY against product instructions';qs('[data-plan-version]')!.textContent=String(plan.version||'—');qs('[data-verify-count]')!.textContent=String(Array.isArray(plan.verify)?plan.verify.length:0);const complete=gs.find(g=>g.label==='Complete');const done=gs.filter(g=>Number(g.checked)===1).length;qs('[data-gate-summary]')!.textContent=`${done} / 8`;qs('[data-mobile-status]')!.textContent=`${String(index+1).padStart(2,'0')} · ${Number(complete?.checked)===1?'Complete':done?'In progress':'Ready'}`;qs('[data-status-dot]')!.className=`status-dot ${Number(complete?.checked)===1?'done':done?'working':''}`;document.querySelectorAll<HTMLInputElement>('[data-gate]').forEach(input=>{const item=gs.find(g=>g.label===input.dataset.gate);input.checked=Number(item?.checked)===1;input.disabled=Boolean(item&&input.dataset.gate==='Complete'&&gs.some(g=>g.label!=='Complete'&&Number(g.checked)!==1));const card=input.closest('[data-gate-card]');card?.classList.toggle('done',input.checked);card?.classList.toggle('locked',!input.checked&&Boolean(item&&input.dataset.gate!=='Verify'&&gs.findIndex(g=>g.label===input.dataset.gate)>0&&Number(gs[gs.findIndex(g=>g.label===input.dataset.gate)-1]?.checked)!==1));});qs<HTMLButtonElement>('[data-prev]')!.disabled=index<=0;qs<HTMLButtonElement>('[data-next]')!.disabled=index>=openings.length-1||Number(complete?.checked)!==1;qs('[data-mobile-position]')!.textContent=`${index+1} / ${openings.length}`;qs<HTMLButtonElement>('[data-mobile-prev]')!.disabled=index<=0;qs<HTMLButtonElement>('[data-mobile-next]')!.disabled=index>=openings.length-1||Number(complete?.checked)!==1;const doneOpenings=openings.reduce((n,_,i)=>n+(Number(gates.find(g=>g.section===sectionFor(i)&&g.label==='Complete')?.checked)===1?1:0),0);qs('[data-overall]')!.textContent=`${doneOpenings} / ${openings.length} openings complete`;const bar=qs<HTMLElement>('[data-overall-bar]');if(bar)bar.style.width=`${openings.length?Math.round(doneOpenings/openings.length*100):0}%`;const strip=qs('[data-strip]');if(strip)strip.innerHTML=openings.map((x:any,i:number)=>{const c=gates.find(g=>g.section===sectionFor(i)&&g.label==='Complete');return `<button type="button" class="strip-item ${i===index?'active':''} ${Number(c?.checked)===1?'done':''}" data-opening-index="${i}"><strong>${String(i+1).padStart(2,'0')}</strong><span>${esc(x.product||x.openingType||'Opening')}</span></button>`}).join('');document.querySelectorAll<HTMLButtonElement>('[data-opening-index]').forEach(b=>b.addEventListener('click',()=>{const target=Number(b.dataset.openingIndex);if(canMove(target)){index=target;render();}}));const photoLinks=[qs<HTMLAnchorElement>('[data-opening-photos]'),qs<HTMLAnchorElement>('[data-opening-photos-2]')];photoLinks.forEach(a=>{if(a)a.href=`/internal/tools/photos?jobId=${encodeURIComponent(job.id)}&opening=${index+1}&stage=before`;});renderEvidence();refreshPhotos();}
  async function patchGate(input:HTMLInputElement){const item=gates.find(g=>g.section===currentSection&&g.label===input.dataset.gate);if(!item)return;input.disabled=true;try{if(input.checked&&input.dataset.gate==='Photograph')await saveEvidence(true);const r=await fetch(`/internal/api/job-checklist?id=${encodeURIComponent(item.id)}`,{method:'PATCH',headers:{'content-type':'application/json'},body:JSON.stringify({checked:input.checked,notes:item.label==='Verify'?(qs<HTMLTextAreaElement>('[data-notes]')?.value||item.notes||''):item.notes||''})});const d=await r.json().catch(()=>({}));if(!r.ok)throw new Error(d.error||'Could not save field gate.');item.checked=input.checked?1:0;render();if(input.checked&&input.dataset.gate==='Complete'&&index<openings.length-1)setTimeout(()=>{index+=1;render();},220);}catch(e){input.checked=!input.checked;showError(e instanceof Error?e.message:'Could not save field gate.');}finally{input.disabled=false;}}
  async function init(){const id=new URLSearchParams(location.search).get('id');if(!id){showError('No job id in the URL.');return;}try{const[jr,cr,er]=await Promise.all([fetch(`/internal/api/jobs?id=${encodeURIComponent(id)}`,{headers:{'cache-control':'no-cache'}}),fetch(`/internal/api/job-checklist?jobId=${encodeURIComponent(id)}`,{headers:{'cache-control':'no-cache'}}),fetch(`/internal/api/job-evidence?jobId=${encodeURIComponent(id)}`,{headers:{'cache-control':'no-cache'}})]);const jd=await jr.json().catch(()=>({})),cd=await cr.json().catch(()=>({})),ed=await er.json().catch(()=>({}));if(!jr.ok)throw new Error(jd.error||'Could not load this job.');if(!cr.ok)throw new Error(cd.error||'Could not load field checklist.');job=jd.job;plan=jd.buildPlan;gates=cd.items||[];evidence=ed.evidence||[];if(!plan){qs<HTMLElement>('[data-stop]')!.hidden=false;const l=qs<HTMLAnchorElement>('[data-plan-link]');if(l&&job.quote_id)l.href=`/internal/quotes/build-plan?quoteId=${encodeURIComponent(job.quote_id)}`;return;}openings=Array.isArray(plan.openings)?plan.openings:[];if(!openings.length)throw new Error('The approved Build Plan contains no openings.');const requested=Number(new URLSearchParams(location.search).get('opening'));if(Number.isInteger(requested)&&requested>=1&&requested<=openings.length)index=requested-1;qs<HTMLElement>('[data-shell]')!.hidden=false;qs<HTMLElement>('[data-mobile-nav]')!.hidden=false;const jl=qs<HTMLAnchorElement>('[data-job-link]'),ph=qs<HTMLAnchorElement>('[data-photos]'),pl=qs<HTMLAnchorElement>('[data-plan-link-2]');if(jl)jl.href=`/internal/jobs/view?id=${encodeURIComponent(job.id)}`;if(ph)ph.href=`/internal/tools/photos?jobId=${encodeURIComponent(job.id)}`;if(pl&&job.quote_id)pl.href=`/internal/quotes/build-plan?quoteId=${encodeURIComponent(job.quote_id)}`;render();document.querySelectorAll<HTMLInputElement>('[data-gate]').forEach(i=>i.addEventListener('change',()=>patchGate(i)));window.addEventListener('pageshow',()=>refreshPhotos());}catch(e){showError(e instanceof Error?e.message:'Could not load field mode.');}}
  qs('[data-prev]')?.addEventListener('click',()=>{if(index>0){index--;render();}});qs('[data-next]')?.addEventListener('click',()=>{if(canMove(index+1)){index++;render();}});qs('[data-mobile-prev]')?.addEventListener('click',()=>{if(index>0){index--;render();}});qs('[data-mobile-next]')?.addEventListener('click',()=>{if(canMove(index+1)){index++;render();}});qs('[data-save-evidence]')?.addEventListener('click',()=>saveEvidence());qs('[data-add-material]')?.addEventListener('click',()=>{const box=qs<HTMLElement>('[data-materials]');if(box)addMaterialRow(box,'',0,true);});
  init();
</script>
<style>
