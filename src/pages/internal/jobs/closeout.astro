---
import InternalLayout from '../../../layouts/InternalLayout.astro';
---
<InternalLayout title="Job Closeout">
  <div class="head"><div><p class="kicker">Operations · final handoff</p><h1 data-title>Job closeout</h1><p class="lede" data-subtitle>Reconcile the field record before the project leaves production.</p></div><div class="actions"><a class="btn btn-ghost" data-job href="/internal/jobs">Job workspace</a><a class="btn btn-ghost" data-field href="#">Field mode</a></div></div>
  <p class="error" data-error hidden role="alert"></p>
  <main class="closeout" data-main hidden>
    <section class="readiness panel"><div><p class="kicker">Release gate</p><h2 data-readiness-title>Not ready</h2><p data-readiness-copy>Checking openings, exceptions, and project closeout gates…</p></div><div class="readiness-score"><strong data-score>0%</strong><span>field record complete</span></div></section>
    <section class="summary-grid"><article class="metric panel"><span>Openings</span><strong data-openings>0 / 0</strong><small>closed in Field Mode</small></article><article class="metric panel"><span>Exceptions</span><strong data-exceptions>0</strong><small>open exceptions</small></article><article class="metric panel"><span>Photos</span><strong data-photos>0</strong><small>before / during / after records</small></article><article class="metric panel"><span>Closeout gates</span><strong data-gates>0 / 0</strong><small>project checklist</small></article></section>
    <section class="columns"><section class="panel record"><div class="panel-head"><div><p class="kicker">Opening reconciliation</p><h2>Every opening</h2></div></div><div class="opening-list" data-opening-list></div></section><aside class="side"><section class="panel exceptions"><div class="panel-head"><div><p class="kicker">Punch list</p><h2>Exceptions</h2></div></div><div data-exception-list class="exception-list"></div></section><section class="panel signoff"><div class="panel-head"><div><p class="kicker">Final handoff</p><h2>Signoff</h2></div><span class="saved" data-saved>Not finalized</span></div><label class="check"><input type="checkbox" data-walkthrough> <span>Customer walkthrough completed</span></label><label class="check"><input type="checkbox" data-warranty> <span>Warranty / care handoff completed</span></label><label class="check"><input type="checkbox" data-balance> <span>Final balance status confirmed</span></label><label class="field">Signoff name<input data-name maxlength="160" placeholder="Name of person closing the job"></label><label class="field">Closeout notes<textarea data-notes maxlength="5000" rows="4" placeholder="Final customer notes, punch-list disposition, follow-up commitments…"></textarea></label><button class="btn btn-primary finalize" data-finalize type="button">Finalize closeout</button><p class="helper">Finalization is blocked until all openings, project closeout gates, and exceptions are reconciled.</p></section></aside></section>
  </main>
</InternalLayout>
<script>
  let job:any=null,data:any=null;
  const qs=<T extends Element>(s:string)=>document.querySelector(s) as T|null;
  function err(message:string){const el=qs<HTMLElement>('[data-error]');if(el){el.hidden=false;el.textContent=message;window.scrollTo({top:0,behavior:'smooth'});}}
  function photoTotal(e:any[]){return e.reduce((n,x)=>{try{const p=typeof x.photo_summary_json==='string'?JSON.parse(x.photo_summary_json):x.photo_summary_json;return n+Number(p?.before||0)+Number(p?.during||0)+Number(p?.after||0)+Number(p?.issue||0);}catch{return n;}},0);}
  function render(){const d=data;const openings=d.openings||[];const completed=openings.filter((x:any)=>x.complete).length;const exceptions=d.exceptions||[];const closeout=d.closeoutItems||[];const gatesDone=closeout.filter((x:any)=>Number(x.checked)===1).length;const photoCount=photoTotal(d.evidence||[]);const score=Math.round(((openings.length?completed/openings.length:1)*.55+(closeout.length?gatesDone/closeout.length:1)*.3+(exceptions.length?0:.15))*100);qs('[data-openings]')!.textContent=`${completed} / ${openings.length}`;qs('[data-exceptions]')!.textContent=String(exceptions.length);qs('[data-photos]')!.textContent=String(photoCount);qs('[data-gates]')!.textContent=`${gatesDone} / ${closeout.length}`;qs('[data-score]')!.textContent=`${score}%`;const ready=Boolean(d.readyForFinalize);qs('[data-readiness-title]')!.textContent=ready?'Ready to close':'Not ready';qs('[data-readiness-copy]')!.textContent=ready?'All field openings and project closeout gates are reconciled. Complete the handoff confirmations below to finalize.':'Resolve every highlighted blocker before finalizing the job.';const list=qs('[data-opening-list]')!;list.innerHTML=openings.map((o:any,i:number)=>`<div class="opening-row ${o.complete?'done':'blocked'}"><span>${String(i+1).padStart(2,'0')}</span><div><strong>Opening ${i+1}</strong><small>${o.complete?'Complete':'Incomplete'}</small></div><a href="/internal/jobs/field?id=${encodeURIComponent(job.id)}&opening=${i+1}">Open →</a></div>`).join('')||'<p class="empty-copy">No openings are attached to the approved Build Plan.</p>';const ex=qs('[data-exception-list]')!;ex.innerHTML=exceptions.length?exceptions.map((x:any)=>`<div class="exception"><strong>Opening ${Number(x.openingIndex)+1}</strong><p>${String(x.notes||'Open exception').replace(/</g,'&lt;')}</p><a href="/internal/jobs/field?id=${encodeURIComponent(job.id)}&opening=${Number(x.openingIndex)+1}">Resolve →</a></div>`).join(''):'<div class="clear-state"><strong>No open exceptions</strong><span>The field record is clear.</span></div>';const c=d.closeout||{};(qs<HTMLInputElement>('[data-walkthrough]')!).checked=Number(c.walkthrough_confirmed)===1;(qs<HTMLInputElement>('[data-warranty]')!).checked=Number(c.warranty_handoff_confirmed)===1;(qs<HTMLInputElement>('[data-balance]')!).checked=Number(c.balance_confirmed)===1;(qs<HTMLInputElement>('[data-name]')!).value=c.signoff_name||'';(qs<HTMLTextAreaElement>('[data-notes]')!).value=c.signoff_notes||'';const saved=qs<HTMLElement>('[data-saved]')!;saved.textContent=c.finalized_at?`Finalized ${new Date(c.finalized_at).toLocaleDateString()}`:'Not finalized';}
  async function save(finalize=false){const body={walkthroughConfirmed:qs<HTMLInputElement>('[data-walkthrough]')!.checked,warrantyHandoffConfirmed:qs<HTMLInputElement>('[data-warranty]')!.checked,balanceConfirmed:qs<HTMLInputElement>('[data-balance]')!.checked,signoffName:qs<HTMLInputElement>('[data-name]')!.value,signoffNotes:qs<HTMLTextAreaElement>('[data-notes]')!.value,finalize};const b=qs<HTMLButtonElement>('[data-finalize]')!;b.disabled=true;try{const r=await fetch(`/internal/api/job-closeout?jobId=${encodeURIComponent(job.id)}`,{method:'PATCH',headers:{'content-type':'application/json'},body:JSON.stringify(body)});const d=await r.json().catch(()=>({}));if(!r.ok)throw new Error(d.error||'Could not save closeout.');data.closeout=d.closeout;render();if(finalize)qs<HTMLElement>('[data-readiness-copy]')!.textContent=`Finalized ${new Date(d.closeout.finalized_at).toLocaleString()}`;}catch(e){err(e instanceof Error?e.message:'Could not save closeout.');}finally{b.disabled=false;}}
  async function init(){const id=new URLSearchParams(location.search).get('id');if(!id){err('No job id in the URL.');return;}try{const[jr,cr]=await Promise.all([fetch(`/internal/api/jobs?id=${encodeURIComponent(id)}`,{headers:{'cache-control':'no-cache'}}),fetch(`/internal/api/job-closeout?jobId=${encodeURIComponent(id)}`,{headers:{'cache-control':'no-cache'}})]);const jd=await jr.json().catch(()=>({}));data=await cr.json().catch(()=>({}));if(!jr.ok||!cr.ok)throw new Error(jd.error||data.error||'Could not load closeout.');job=jd.job;qs<HTMLElement>('[data-main]')!.hidden=false;qs('[data-title]')!.textContent=`${job.customer_name||job.id} · Closeout`;qs('[data-subtitle]')!.textContent=job.id;qs<HTMLAnchorElement>('[data-job]')!.href=`/internal/jobs/view?id=${encodeURIComponent(job.id)}`;qs<HTMLAnchorElement>('[data-field]')!.href=`/internal/jobs/field?id=${encodeURIComponent(job.id)}`;render();}catch(e){err(e instanceof Error?e.message:'Could not load closeout.');}}
  qs('[data-finalize]')?.addEventListener('click',()=>save(true));init();
</script>
<style>
.head{display:flex;justify-content:space-between;align-items:end;gap:1rem;margin-bottom:1rem}.actions{display:flex;gap:.5rem;flex-wrap:wrap}.panel{border:1px solid var(--line);border-radius:var(--radius-lg);background:var(--paper-raised);overflow:hidden;box-shadow:var(--shadow-sm)}.readiness{display:flex;justify-content:space-between;align-items:center;gap:1rem;padding:1rem 1.1rem;margin-bottom:1rem}.readiness h2{margin:.1rem 0 .2rem}.readiness p{margin:0;color:var(--ink-soft);font-size:.78rem}.readiness-score{text-align:right}.readiness-score strong{font-size:2rem;display:block}.readiness-score span{font-size:.68rem;color:var(--ink-faint)}.summary-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:.75rem;margin-bottom:1rem}.metric{padding:.85rem}.metric span{font-size:.68rem;text-transform:uppercase;letter-spacing:.06em;color:var(--ink-faint);font-weight:800}.metric strong{display:block;font-size:1.35rem;margin:.25rem 0}.metric small{color:var(--ink-soft);font-size:.68rem}.columns{display:grid;grid-template-columns:minmax(0,1fr) 360px;gap:1rem}.side{display:grid;gap:1rem;align-content:start}.panel-head{padding:1rem 1.1rem;border-bottom:1px solid var(--line);display:flex;justify-content:space-between;align-items:center;gap:.75rem}.panel-head h2{margin:.1rem 0 0;font-size:var(--step-1)}.opening-list{padding:.4rem .8rem}.opening-row{display:grid;grid-template-columns:38px 1fr auto;align-items:center;gap:.7rem;padding:.75rem .3rem;border-bottom:1px solid var(--line)}.opening-row:last-child{border-bottom:0}.opening-row>span{width:32px;height:32px;border-radius:50%;display:grid;place-items:center;background:var(--line);font-size:.7rem;font-weight:850}.opening-row.done>span{background:var(--ink);color:var(--paper)}.opening-row.blocked>span{background:color-mix(in srgb,var(--danger) 12%,transparent);color:var(--danger)}.opening-row div{display:grid;gap:.15rem}.opening-row small{color:var(--ink-soft);font-size:.68rem}.opening-row a,.exception a{font-size:.72rem;font-weight:800}.exception-list{padding:.8rem}.exception{border:1px solid var(--line);border-left:3px solid var(--danger);border-radius:var(--radius);padding:.7rem;margin-bottom:.6rem}.exception strong{font-size:.76rem}.exception p{font-size:.72rem;color:var(--ink-soft);margin:.25rem 0 .5rem}.clear-state{display:grid;gap:.2rem;padding:1rem;text-align:center}.clear-state span{font-size:.72rem;color:var(--ink-soft)}.signoff{padding-bottom:1rem}.check{display:flex;gap:.5rem;align-items:flex-start;padding:.65rem 1rem;font-size:.78rem;font-weight:700}.check input{width:20px;height:20px;accent-color:var(--ink);margin-top:-1px}.field{display:grid;gap:.3rem;padding:.5rem 1rem;font-size:.72rem;font-weight:750}.field input,.field textarea{border:1px solid var(--line-strong);border-radius:var(--radius);padding:.6rem;font:inherit;background:var(--paper);color:var(--ink);width:100%}.field textarea{resize:vertical}.finalize{margin:.6rem 1rem 0;width:calc(100% - 2rem)}.helper{font-size:.68rem;color:var(--ink-faint);padding:0 1rem}.saved{font-size:.68rem;padding:.3rem .5rem;border-radius:999px;background:var(--accent-wash);font-weight:800}.error{border:1px solid var(--danger);border-radius:var(--radius);padding:.8rem 1rem;color:var(--danger);background:color-mix(in srgb,var(--danger) 8%,transparent);font-weight:700}.empty-copy{padding:1rem;color:var(--ink-soft)}
@media(max-width:800px){.summary-grid{grid-template-columns:1fr 1fr}.columns{grid-template-columns:1fr}.side{grid-template-columns:1fr 1fr}.signoff{grid-column:span 2}}@media(max-width:560px){.head{align-items:flex-start;flex-direction:column}.actions,.actions .btn{width:100%}.actions .btn{text-align:center}.readiness{align-items:flex-start;flex-direction:column}.readiness-score{text-align:left}.summary-grid{grid-template-columns:1fr 1fr}.side{grid-template-columns:1fr}.signoff{grid-column:auto}.opening-row{grid-template-columns:34px 1fr}.opening-row a{grid-column:2;justify-self:start}.panel-head{padding:.8rem .85rem}}
</style>
