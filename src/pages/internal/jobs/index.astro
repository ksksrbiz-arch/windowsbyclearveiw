---
import InternalLayout from '../../../layouts/InternalLayout.astro';
---
<InternalLayout title="Jobs">
  <div class="jobs-head">
    <div>
      <p class="kicker">Operations</p>
      <h1>Jobs</h1>
      <p class="lede">Turn finalized quotes into active projects, schedule the work, and keep installation notes with the job.</p>
    </div>
    <div class="jobs-head-actions"><a class="btn btn-ghost" href="/internal/invoices">Invoices</a><a class="btn btn-ghost" href="/internal/tools">All tools</a></div>
  </div>

  <section class="create-job panel">
    <div class="create-copy">
      <p class="kicker">Start project</p>
      <h2>Create a job from a finalized quote</h2>
      <p class="muted">Customer details and quoted scope are copied into the new job. Nothing on the original quote is changed.</p>
    </div>
    <div class="create-controls">
      <label>Finalized quote
        <select data-quote-select><option value="">Loading finalized quotes…</option></select>
      </label>
      <button class="btn btn-primary" type="button" data-create disabled>Create job</button>
    </div>
    <p class="create-status" data-create-status role="status"></p>
  </section>

  <section class="jobs-toolbar panel">
    <div class="queue-summary"><strong data-count>—</strong><span>active jobs</span></div>
    <div class="job-filters" role="group" aria-label="Filter jobs">
      <button type="button" class="filter active" data-filter="all">All</button><button type="button" class="filter" data-filter="ready">Ready</button><button type="button" class="filter" data-filter="scheduled">Scheduled</button><button type="button" class="filter" data-filter="in-progress">In progress</button><button type="button" class="filter" data-filter="completed">Completed</button>
    </div>
  </section>

  <section class="jobs-list panel">
    <div class="panel-head"><div><p class="kicker">Project queue</p><h2>Jobs</h2></div><span class="muted" data-updated>Loading…</span></div>
    <div class="list-body" data-list></div>
  </section>

  <p class="page-note">A job can only be created from a finalized quote. Scheduling and closeout details remain editable until the job is complete.</p>
</InternalLayout>

<script>
  type Job = { id:string; quote_id?:string|null; status:string; scheduled_date?:string|null; scheduled_window?:string|null; customer_name:string; customer_address?:string|null; customer_city?:string|null; total_cents?:number|null; };
  type Quote = { id:string; status:string; customer_name:string; customer_city?:string|null; total_cents?:number|null; };
  function initJobsIndex(){
    const list=document.querySelector('[data-list]'); if(!(list instanceof HTMLElement)||list.dataset.bound==='true')return; list.dataset.bound='true';
    const filters=Array.from(document.querySelectorAll('[data-filter]')); const count=document.querySelector('[data-count]'); const updated=document.querySelector('[data-updated]'); const select=document.querySelector('[data-quote-select]'); const create=document.querySelector('[data-create]'); const createStatus=document.querySelector('[data-create-status]');
    let jobs:Job[]=[]; let activeFilter='all'; let finalizedQuotes:Quote[]=[];
    const money=(c:number)=>`$${(Number(c||0)/100).toLocaleString('en-US',{maximumFractionDigits:0})}`;
    const date=(value?:string|null)=>{if(!value)return'Not scheduled';const d=new Date(`${value}T12:00:00`);return Number.isNaN(d.getTime())?value:d.toLocaleDateString('en-US',{weekday:'short',month:'short',day:'numeric'});};
    const esc=(v:unknown)=>{const d=document.createElement('div');d.textContent=String(v??'');return d.innerHTML;};
    function render(){
      const visible=activeFilter==='all'?jobs:jobs.filter(j=>j.status===activeFilter);
      if(count)count.textContent=String(jobs.filter(j=>j.status!=='completed'&&j.status!=='cancelled').length);
      filters.forEach(f=>f.classList.toggle('active',f.getAttribute('data-filter')===activeFilter));
      if(!visible.length){list.innerHTML=`<div class="empty"><strong>No ${activeFilter==='all'?'':activeFilter.replace('-',' ')} jobs yet.</strong><span>Create one from a finalized quote above.</span></div>`;return;}
      list.innerHTML=visible.map(job=>{
        const label=job.status==='in-progress'?'In progress':job.status.charAt(0).toUpperCase()+job.status.slice(1);
        const address=[job.customer_address,job.customer_city].filter(Boolean).join(', ')||'Address not provided';
        return `<a class="job-row" href="/internal/jobs/view?id=${encodeURIComponent(job.id)}"><span class="status status-${esc(job.status)}">${esc(label)}</span><span class="job-main"><strong>${esc(job.customer_name)}</strong><small>${esc(address)}</small></span><span class="job-date"><strong>${esc(date(job.scheduled_date))}</strong><small>${esc(job.scheduled_window||'Schedule window not set')}</small></span><span class="job-total"><strong>${money(Number(job.total_cents||0))}</strong><small>${esc(job.quote_id||job.id)}</small></span><span class="row-arrow" aria-hidden="true">→</span></a>`;
      }).join('');
    }
    async function loadJobs(){try{const r=await fetch('/internal/api/jobs',{headers:{'cache-control':'no-cache'}});if(!r.ok)throw new Error('Could not load jobs.');const d=await r.json();jobs=Array.isArray(d.jobs)?d.jobs:[];if(updated)updated.textContent=`Updated ${new Date().toLocaleTimeString('en-US',{hour:'numeric',minute:'2-digit'})}`;render();}catch(e){list.innerHTML=`<div class="empty"><strong>Jobs could not be loaded.</strong><span>${esc(e instanceof Error?e.message:'Try again.')}</span></div>`;}}
    async function loadQuotes(){if(!(select instanceof HTMLSelectElement))return;try{const r=await fetch('/internal/api/quotes');if(!r.ok)throw new Error('Could not load quotes.');const d=await r.json();finalizedQuotes=(d.quotes||[]).filter((q:Quote)=>q.status==='finalized');select.innerHTML=finalizedQuotes.length?'<option value="">Select a finalized quote…</option>'+finalizedQuotes.map(q=>`<option value="${esc(q.id)}">${esc(q.customer_name)} · ${esc(q.id)} · ${money(Number(q.total_cents||0))}</option>`).join(''):'<option value="">No finalized quotes available</option>';}catch(e){select.innerHTML='<option value="">Quotes unavailable</option>';}}
    create?.addEventListener('click',async()=>{if(!(select instanceof HTMLSelectElement)||!select.value||!(create instanceof HTMLButtonElement))return;create.disabled=true;createStatus!.textContent='Creating job…';try{const r=await fetch('/internal/api/jobs',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({quoteId:select.value})});const d=await r.json().catch(()=>({}));if(!r.ok)throw new Error(d.error||'Could not create job.');createStatus!.textContent=d.existing?'That quote already has a job. Opening it…':'Job created. Opening workspace…';location.href=`/internal/jobs/view?id=${encodeURIComponent(d.id)}`;}catch(e){createStatus!.textContent=e instanceof Error?e.message:'Could not create job.';create.disabled=false;}});
    select?.addEventListener('change',()=>{if(create instanceof HTMLButtonElement)create.disabled=!(select instanceof HTMLSelectElement&&select.value);});
    filters.forEach(f=>f.addEventListener('click',()=>{activeFilter=f.getAttribute('data-filter')||'all';render();}));
    loadJobs();loadQuotes();
  }
  initJobsIndex();document.addEventListener('astro:page-load',initJobsIndex);
</script>

<style>
  .jobs-head{display:flex;justify-content:space-between;align-items:end;gap:var(--space-m);margin-bottom:var(--space-l)}.jobs-head-actions{display:flex;gap:var(--space-xs);flex-wrap:wrap}
  .panel{border:1px solid var(--line);border-radius:var(--radius);background:var(--paper-raised);overflow:hidden;box-shadow:0 1px 2px rgb(0 0 0 / .03)}
  .create-job{padding:clamp(1rem,2vw,1.35rem);margin-bottom:var(--space-m);display:grid;grid-template-columns:1.3fr .9fr;gap:var(--space-l);align-items:end}.create-copy{max-width:42rem}.create-job h2{margin:.12rem 0 .35rem;font-size:var(--step-1)}.create-controls{display:grid;grid-template-columns:1fr auto;gap:.55rem;align-items:end}.create-controls label{display:grid;gap:.38rem;font-size:var(--step--1);font-weight:700}.create-controls select{width:100%;min-height:2.85rem;border:1px solid var(--line-strong);border-radius:var(--radius);padding:.65rem .7rem;background:var(--paper);font:inherit;color:var(--ink)}.create-controls .btn{min-height:2.85rem}.create-status{grid-column:1/-1;margin:0;color:var(--ink-soft);font-size:var(--step--2);min-height:1.2em}
  .jobs-toolbar{display:flex;justify-content:space-between;align-items:center;gap:var(--space-m);padding:.8rem 1rem;margin-bottom:var(--space-m)}.queue-summary{display:flex;align-items:baseline;gap:.4rem}.queue-summary strong{font-size:var(--step-1);letter-spacing:-.02em}.queue-summary span{color:var(--ink-soft);font-size:var(--step--1)}.job-filters{display:flex;flex-wrap:wrap;gap:.35rem}.filter{border:1px solid var(--line);background:var(--paper);color:var(--ink-soft);border-radius:999px;padding:.48rem .75rem;font:inherit;font-size:var(--step--2);font-weight:650;cursor:pointer;min-height:2.4rem}.filter.active,.filter:hover{background:var(--ink);color:var(--on-dark);border-color:var(--ink)}
  .panel-head{padding:var(--space-m);border-bottom:1px solid var(--line);display:flex;align-items:end;justify-content:space-between;gap:var(--space-s)}.panel-head h2{margin:.12rem 0 0;font-size:var(--step-1)}.list-body{min-height:10rem}
  :global(.job-row){display:grid;grid-template-columns:auto minmax(12rem,1fr) minmax(10rem,.8fr) auto auto;gap:var(--space-s);align-items:center;padding:1rem var(--space-m);border-bottom:1px solid var(--line);color:inherit;text-decoration:none;transition:background 120ms ease,transform 120ms ease}.job-row:last-child{border-bottom:0}:global(.job-row:hover){background:var(--accent-wash)}:global(.job-main),:global(.job-date),:global(.job-total){display:grid;gap:.18rem}:global(.job-main small),:global(.job-date small),:global(.job-total small){color:var(--ink-soft);font-size:var(--step--2)}:global(.job-date),:global(.job-total){text-align:right}:global(.status){display:inline-flex;align-items:center;justify-content:center;border-radius:999px;padding:.36rem .58rem;font-size:.7rem;font-weight:800;white-space:nowrap;border:1px solid var(--line);min-height:2rem}:global(.status-ready){background:color-mix(in srgb,var(--ink) 5%,transparent)}:global(.status-scheduled){background:color-mix(in srgb,var(--accent) 12%,transparent);border-color:color-mix(in srgb,var(--accent) 30%,var(--line))}:global(.status-in-progress){background:color-mix(in srgb,var(--accent) 8%,transparent);border-color:color-mix(in srgb,var(--accent) 22%,var(--line))}:global(.status-completed){opacity:.68}:global(.row-arrow){color:var(--ink-faint);font-size:1.15rem}.empty{min-height:12rem;display:grid;place-items:center;align-content:center;gap:.45rem;padding:var(--space-l);text-align:center;color:var(--ink-soft)}.empty strong{color:var(--ink)}.page-note{margin-top:var(--space-s);color:var(--ink-faint);font-size:var(--step--2)}
  @media(max-width:900px){.create-job{grid-template-columns:1fr;gap:var(--space-m)}.create-controls{grid-template-columns:1fr}.jobs-toolbar,.jobs-head{align-items:flex-start;flex-direction:column}.jobs-head-actions{width:100%}.jobs-head-actions .btn{flex:1}.job-row{grid-template-columns:auto 1fr auto}.job-date{text-align:left;grid-column:2}.job-total{display:none}.row-arrow{grid-column:3;grid-row:1/span 2}.job-main small{max-width:42vw;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}}
  @media(max-width:620px){.jobs-head{gap:.65rem;margin-bottom:var(--space-m)}.jobs-head .lede{max-width:36rem}.create-job{padding:1rem}.create-controls select,.create-controls .btn{min-height:3rem}.jobs-toolbar{padding:.75rem;gap:.7rem}.job-filters{width:100%;overflow-x:auto;flex-wrap:nowrap;padding-bottom:.1rem;scrollbar-width:none}.job-filters::-webkit-scrollbar{display:none}.filter{flex:0 0 auto;min-height:2.75rem;padding-inline:.8rem}.panel-head{padding:1rem}.panel-head .muted{font-size:.72rem}.job-row{grid-template-columns:auto minmax(0,1fr) auto;gap:.65rem;padding:.9rem .8rem}.job-main small{max-width:100%;white-space:normal;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical}.job-date{grid-column:2;margin-top:.05rem}.job-date strong{font-size:.82rem}.row-arrow{grid-column:3}.status{align-self:start;min-height:2.2rem}.page-note{padding-inline:.2rem}}
  @media(max-width:420px){.jobs-head-actions{display:grid;grid-template-columns:1fr 1fr}.job-row{padding:.82rem .7rem}.status{font-size:.64rem;padding-inline:.48rem}.queue-summary strong{font-size:1.25rem}}
</style>
