---
import InternalLayout from '../../../layouts/InternalLayout.astro';
---
<InternalLayout title="Jobs">
  <div class="jobs-head"><div><p class="kicker">Operations</p><h1>Jobs</h1><p class="lede">Turn approved production plans into scheduled field work and keep installation notes with the job.</p></div><div class="jobs-head-actions"><a class="btn btn-ghost" href="/internal/schedule">Schedule</a><a class="btn btn-ghost" href="/internal/invoices">Invoices</a><a class="btn btn-primary" href="/internal/tools">Tools</a></div></div>
  <section class="create-job panel"><div class="create-copy"><p class="kicker">Start project</p><h2>Create a job from a finalized quote</h2><p class="muted">Only a finalized quote with a current, explicitly approved Build Plan can enter production.</p></div><div class="create-controls"><label>Finalized quote<select data-quote-select><option value="">Loading finalized quotes…</option></select></label><button class="btn btn-primary" type="button" data-create disabled>Create job</button></div><p class="create-status" data-create-status role="status"></p></section>
  <section class="jobs-toolbar" aria-label="Job queue controls"><div class="queue-summary"><strong data-count>—</strong><span>active jobs</span></div><div class="job-filters" role="group" aria-label="Filter jobs"><button type="button" class="filter active" data-filter="all">All</button><button type="button" class="filter" data-filter="ready">Ready</button><button type="button" class="filter" data-filter="scheduled">Scheduled</button><button type="button" class="filter" data-filter="in-progress">In progress</button><button type="button" class="filter" data-filter="completed">Completed</button></div></section>
  <section class="jobs-list panel"><div class="panel-head"><div><p class="kicker">Project queue</p><h2>Work in motion</h2></div><span class="muted" data-updated>Loading…</span></div><div class="list-body" data-list></div></section><p class="page-note">Open a job to manage the verified Build Plan snapshot, schedule, field notes, photos, prep, closeout, and customer communication.</p>
</InternalLayout>
<script>
  type Job={id:string;quote_id?:string|null;status:string;scheduled_date?:string|null;scheduled_window?:string|null;customer_name:string;customer_address?:string|null;customer_city?:string|null;total_cents?:number|null};type Quote={id:string;status:string;customer_name:string;customer_city?:string|null;total_cents?:number|null};
  function initJobsIndex(){const root=document.querySelector('main');if(!(root instanceof HTMLElement)||root.dataset.jobsBound==='true')return;root.dataset.jobsBound='true';const list=root.querySelector('[data-list]') as HTMLElement,filters=Array.from(root.querySelectorAll('[data-filter]')),count=root.querySelector('[data-count]'),updated=root.querySelector('[data-updated]'),select=root.querySelector('[data-quote-select]') as HTMLSelectElement|null,create=root.querySelector('[data-create]') as HTMLButtonElement|null,createStatus=root.querySelector('[data-create-status]');let jobs:Job[]=[];let activeFilter='all';const money=(c:number)=>`$${(Number(c||0)/100).toLocaleString('en-US',{maximumFractionDigits:0})}`;const date=(v?:string|null)=>{if(!v)return'Not scheduled';const d=new Date(`${v}T12:00:00`);return Number.isNaN(d.getTime())?v:d.toLocaleDateString('en-US',{weekday:'short',month:'short',day:'numeric'})};const esc=(v:unknown)=>{const d=document.createElement('div');d.textContent=String(v??'');return d.innerHTML};const label=(s:string)=>s==='in-progress'?'In progress':s.charAt(0).toUpperCase()+s.slice(1);
    function render(){const visible=activeFilter==='all'?jobs:jobs.filter(j=>j.status===activeFilter);if(count)count.textContent=String(jobs.filter(j=>!['completed','cancelled'].includes(j.status)).length);filters.forEach(f=>f.classList.toggle('active',f.getAttribute('data-filter')===activeFilter));if(!visible.length){list.innerHTML=`<div class="empty"><strong>No ${activeFilter==='all'?'':activeFilter.replace('-',' ')} jobs yet.</strong><span>Create one from a finalized quote above.</span></div>`;return;}list.innerHTML=visible.map(job=>{const address=[job.customer_address,job.customer_city].filter(Boolean).join(', ')||'Address not provided';return `<a class="job-card" href="/internal/jobs/view?id=${encodeURIComponent(job.id)}"><span class="job-card-status status-${esc(job.status)}">${esc(label(job.status))}</span><span class="job-card-main"><strong>${esc(job.customer_name)}</strong><small>${esc(address)}</small></span><span class="job-card-schedule"><small>${esc(job.scheduled_window||'Schedule window not set')}</small><strong>${esc(date(job.scheduled_date))}</strong></span><span class="job-card-total"><strong>${money(Number(job.total_cents||0))}</strong><small>${esc(job.quote_id||job.id)}</small></span><span class="job-card-arrow" aria-hidden="true">→</span></a>`}).join('')}
    async function loadJobs(){try{const r=await fetch('/internal/api/jobs',{headers:{'cache-control':'no-cache'}});if(!r.ok)throw new Error('Could not load jobs.');const d=await r.json();jobs=Array.isArray(d.jobs)?d.jobs:[];if(updated)updated.textContent=`Updated ${new Date().toLocaleTimeString('en-US',{hour:'numeric',minute:'2-digit'})}`;render()}catch(e){list.innerHTML=`<div class="empty"><strong>Jobs could not be loaded.</strong><span>${esc(e instanceof Error?e.message:'Try again.')}</span></div>`}}
    async function loadQuotes(){if(!select)return;try{const r=await fetch('/internal/api/quotes');if(!r.ok)throw new Error();const d=await r.json();const qs=(d.quotes||[]).filter((q:Quote)=>q.status==='finalized');select.innerHTML=qs.length?'<option value="">Select a finalized quote…</option>'+qs.map(q=>`<option value="${esc(q.id)}">${esc(q.customer_name)} · ${esc(q.id)} · ${money(Number(q.total_cents||0))}</option>`).join(''):'<option value="">No finalized quotes available</option>'}catch{select.innerHTML='<option value="">Quotes unavailable</option>'}}
    create?.addEventListener('click',async()=>{if(!select?.value||!create)return;create.disabled=true;if(createStatus)createStatus.textContent='Verifying approved Build Plan…';try{const r=await fetch('/internal/api/jobs',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({quoteId:select.value})});const d=await r.json().catch(()=>({}));if(!r.ok)throw new Error(d.error||'Could not create job.');if(createStatus)createStatus.textContent=d.existing?'That quote already has a job. Opening it…':'Job created. Opening workspace…';location.href=`/internal/jobs/view?id=${encodeURIComponent(d.id)}`}catch(e){if(createStatus)createStatus.textContent=e instanceof Error?e.message:'Could not create job.';create.disabled=false}});select?.addEventListener('change',()=>{if(create)create.disabled=!select.value});filters.forEach(f=>f.addEventListener('click',()=>{activeFilter=f.getAttribute('data-filter')||'all';render()}));loadJobs();loadQuotes()}
  initJobsIndex();document.addEventListener('astro:page-load',initJobsIndex);
</script>
<style>
.jobs-head{display:flex;justify-content:space-between;align-items:end;gap:var(--space-m);margin-bottom:var(--space-l)}.jobs-head-actions{display:flex;gap:var(--space-xs);flex-wrap:wrap}.panel{border:1px solid var(--line);border-radius:var(--radius-lg);background:var(--paper-raised);overflow:hidden;box-shadow:var(--shadow-sm)}.create-job{padding:clamp(1.15rem,2vw,1.5rem);margin-bottom:var(--space-m);display:grid;grid-template-columns:1.15fr .85fr;gap:var(--space-l);align-items:end;border-color:color-mix(in srgb,var(--accent) 22%,var(--line))}.create-copy{max-width:42rem}.create-job h2{margin:.12rem 0 .35rem;font-size:var(--step-1)}.create-controls{display:grid;grid-template-columns:1fr auto;gap:.6rem;align-items:end}.create-controls label{display:grid;gap:.38rem;font-size:var(--step--1);font-weight:700}.create-controls select{width:100%;min-height:3rem;border:1px solid var(--line-strong);border-radius:var(--radius);padding:.68rem .75rem;background:var(--paper);font:inherit;color:var(--ink)}.create-controls .btn{min-height:3rem}.create-status{grid-column:1/-1;margin:0;color:var(--ink-soft);font-size:var(--step--2);min-height:1.2em}.jobs-toolbar{display:flex;justify-content:space-between;align-items:center;gap:var(--space-m);padding:.7rem .8rem;margin-bottom:var(--space-m)}.queue-summary{display:flex;align-items:baseline;gap:.4rem}.queue-summary strong{font-size:var(--step-2);letter-spacing:-.03em}.queue-summary span{color:var(--ink-soft);font-size:var(--step--1)}.job-filters{display:flex;gap:.4rem;overflow-x:auto;scrollbar-width:none}.job-filters::-webkit-scrollbar{display:none}.filter{border:1px solid var(--line);background:var(--paper-raised);color:var(--ink-soft);border-radius:999px;padding:.48rem .75rem;font:inherit;font-size:var(--step--2);font-weight:700;cursor:pointer;min-height:2.5rem;white-space:nowrap}.filter.active{background:var(--ink);color:var(--on-dark);border-color:var(--ink)}.panel-head{padding:var(--space-m);border-bottom:1px solid var(--line);display:flex;align-items:end;justify-content:space-between;gap:var(--space-s)}.panel-head h2{margin:.12rem 0 0;font-size:var(--step-1)}.list-body{min-height:10rem}:global(.job-card){display:grid;grid-template-columns:auto minmax(12rem,1fr) minmax(9rem,.8fr) auto auto;gap:var(--space-s);align-items:center;padding:1rem var(--space-m);border-bottom:1px solid var(--line);color:inherit;text-decoration:none;transition:background var(--dur-fast) var(--ease)}:global(.job-card:hover){background:var(--accent-wash)}:global(.job-card:last-child){border-bottom:0}:global(.job-card-main),:global(.job-card-schedule),:global(.job-card-total){display:grid;gap:.18rem}:global(.job-card-main small),:global(.job-card-schedule small),:global(.job-card-total small){color:var(--ink-soft);font-size:var(--step--2)}:global(.job-card-schedule),:global(.job-card-total){text-align:right}:global(.job-card-status){display:inline-flex;align-items:center;justify-content:center;border-radius:999px;padding:.38rem .62rem;font-size:.7rem;font-weight:800;white-space:nowrap;border:1px solid var(--line);min-height:2.15rem;background:var(--paper)}:global(.status-scheduled),:global(.status-in-progress){background:var(--accent-wash);border-color:color-mix(in srgb,var(--accent) 28%,var(--line))}:global(.status-completed){opacity:.65}:global(.job-card-arrow){color:var(--ink-faint);font-size:1.2rem}.empty{min-height:12rem;display:grid;place-items:center;align-content:center;gap:.45rem;padding:var(--space-l);text-align:center;color:var(--ink-soft)}.empty strong{color:var(--ink)}.page-note{margin-top:var(--space-s);color:var(--ink-faint);font-size:var(--step--2)}@media(max-width:900px){.create-job{grid-template-columns:1fr;gap:var(--space-m)}.jobs-head{align-items:flex-start;flex-direction:column}.jobs-head-actions{width:100%}.jobs-head-actions .btn{flex:1}.job-card{grid-template-columns:auto minmax(0,1fr) auto}.job-card-schedule{text-align:left;grid-column:2}.job-card-total{display:none}.job-card-arrow{grid-column:3;grid-row:1/span 2}}@media(max-width:620px){.jobs-head{gap:.65rem;margin-bottom:var(--space-m)}.jobs-head-actions{display:grid;grid-template-columns:1fr 1fr}.create-job{padding:1rem}.create-controls select,.create-controls .btn{min-height:3.15rem}.jobs-toolbar{padding:.6rem 0;margin-bottom:.7rem}.job-filters{width:100%;padding-bottom:.1rem}.filter{min-height:2.8rem}.panel-head{padding:1rem}.job-card{grid-template-columns:auto minmax(0,1fr) auto;gap:.65rem;padding:.9rem .8rem}.job-card-main small{max-width:100%;white-space:normal;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical}.job-card-schedule{grid-column:2;margin-top:.05rem}.job-card-schedule strong{font-size:.82rem}.job-card-arrow{grid-column:3}.job-card-status{align-self:start;min-height:2.25rem}.page-note{padding-inline:.2rem}}@media(max-width:420px){.jobs-head-actions{grid-template-columns:1fr}.job-card{padding:.82rem .7rem}.job-card-status{font-size:.63rem;padding-inline:.48rem}.queue-summary strong{font-size:1.25rem}}
</style>