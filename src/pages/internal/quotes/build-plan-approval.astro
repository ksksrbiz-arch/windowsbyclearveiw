---
import InternalLayout from '../../../layouts/InternalLayout.astro';
---
<InternalLayout title="Build Plan approval">
  <main class="approval-shell">
    <header class="approval-head">
      <div><p class="kicker">Production control · human gate</p><h1>Build Plan approval</h1><p data-subtitle>Loading…</p></div>
      <div class="head-actions"><a class="btn btn-ghost" data-plan-link href="#">Back to Build Plan</a><button class="btn btn-ghost" type="button" data-refresh>Refresh checks</button></div>
    </header>
    <section class="state-card" data-state-card>
      <span class="state-badge" data-state>—</span>
      <div><strong data-state-title>Checking plan state…</strong><p data-state-copy>Approval is a human decision. Automated generation never approves a plan.</p></div>
    </section>
    <section class="review-card">
      <div class="review-head"><div><p class="kicker">Approval gate</p><h2>Can this plan move into production?</h2></div><span class="review-version" data-version>v—</span></div>
      <div class="gate-summary" data-gate-summary>Checking quote freshness and quality…</div>
      <ul data-checks><li>Loading quality checks…</li></ul>
      <p class="warning" data-warning hidden></p>
      <div class="actions">
        <button class="btn btn-primary" data-action="approve" disabled>Approve for Job</button>
        <button class="btn btn-ghost" data-action="submit-review" disabled>Move to review</button>
        <button class="btn btn-ghost" data-action="reopen" hidden>Reopen for correction</button>
        <button class="btn btn-ghost" data-action="return-to-draft" hidden>Return to draft</button>
      </div>
      <p class="approval-note">Approval records the current plan version against the current quote. A later quote change or plan edit invalidates that operational state.</p>
    </section>
    <section class="history-card"><h2>State history</h2><ol data-history><li>No history yet.</li></ol></section>
  </main>
</InternalLayout>
<script>
  function initApproval(){
    const root=document.querySelector('.approval-shell');if(!(root instanceof HTMLElement)||root.dataset.bound==='true')return;root.dataset.bound='true';
    const params=new URLSearchParams(location.search),quoteId=params.get('quoteId');const q=(s)=>document.querySelector(s);if(!quoteId){q('[data-subtitle]').textContent='No quote id supplied.';return;}
    q('[data-plan-link]').href=`/internal/quotes/build-plan?quoteId=${encodeURIComponent(quoteId)}`;
    const state=q('[data-state]'),title=q('[data-state-title]'),copy=q('[data-state-copy]'),checks=q('[data-checks]'),history=q('[data-history]'),warning=q('[data-warning]'),gate=q('[data-gate-summary]'),version=q('[data-version]');
    const buttons=[...document.querySelectorAll('[data-action]')];
    const esc=(value)=>{const d=document.createElement('div');d.textContent=String(value??'');return d.innerHTML;};
    let busy=false;
    const load=async()=>{if(busy)return;busy=true;warning.hidden=true;try{const [s,p]=await Promise.all([fetch(`/internal/api/build-plan-state?quoteId=${encodeURIComponent(quoteId)}`,{headers:{'cache-control':'no-cache'}}),fetch(`/internal/api/build-plan?quoteId=${encodeURIComponent(quoteId)}`,{headers:{'cache-control':'no-cache'}})]);const sd=await s.json().catch(()=>({})),pd=await p.json().catch(()=>({}));if(!s.ok)throw new Error(sd.error||'Build Plan state unavailable.');if(!p.ok)throw new Error(pd.error||'Build Plan unavailable.');
      q('[data-subtitle]').textContent=`Quote ${quoteId} · ${pd.quote?.customer_name||'Customer'}`;state.textContent=String(sd.status||'draft').replace('-', ' ');state.dataset.status=sd.status||'draft';version.textContent=`v${sd.version||pd.plan?.version||'—'}`;
      title.textContent=sd.status==='approved'?'Approved for Job':sd.status==='review'?'Awaiting human approval':sd.status==='reopened'?'Reopened for correction':'Draft';copy.textContent=sd.status==='approved'?'This is the approved operational version.':'Review quote freshness, blockers, warnings and VERIFY items before approval.';
      const quality=sd.quality||{};const blockers=quality.blockers||[],warnings=quality.warnings||[],stale=Boolean(sd.stale);gate.textContent=stale?'STOP · Quote has changed since the saved plan.':blockers.length?`STOP · ${blockers.length} blocking issue${blockers.length===1?'':'s'}.`:warnings.length?`REVIEW · ${warnings.length} warning${warnings.length===1?'':'s'} remain.`:'READY · No automated blockers or quote drift detected.';gate.dataset.tone=stale||blockers.length?'stop':warnings.length?'review':'ready';
      const items=[...blockers.map(x=>`BLOCKER: ${x}`),...warnings.map(x=>`VERIFY: ${x}`)];checks.innerHTML=items.length?items.map(x=>`<li>${esc(x)}</li>`).join(''):'<li>No automated quality warnings returned.</li>';
      if(stale){warning.hidden=false;warning.textContent='The quote changed after this plan was saved. Return to the Build Plan, regenerate/reconcile it, save, and run review again.';}
      buttons.forEach(b=>b.disabled=false);const approve=q('[data-action="approve"]');approve.disabled=sd.status!=='review'||Boolean(blockers.length)||stale;q('[data-action="submit-review"]').hidden=sd.status!=='draft';q('[data-action="submit-review"]').disabled=sd.status!=='draft';q('[data-action="return-to-draft"]').hidden=!['review','reopened'].includes(sd.status);q('[data-action="reopen"]').hidden=sd.status!=='approved';history.innerHTML=(sd.stateHistory?.length?sd.stateHistory:[{from:'',to:sd.status,actor:'system',at:''}]).map(x=>`<li><strong>${esc(x.to)}</strong> · ${esc(x.actor||'unknown')} ${x.at?`· ${new Date(x.at).toLocaleString()}`:''}</li>`).join('');
    }catch(e){gate.textContent='Unable to verify the approval gate.';gate.dataset.tone='stop';warning.hidden=false;warning.textContent=e instanceof Error?e.message:'Could not load approval state.';buttons.forEach(b=>b.disabled=true);}finally{busy=false;}};
    buttons.forEach(b=>b.addEventListener('click',async()=>{if(busy)return;b.disabled=true;warning.hidden=true;try{const r=await fetch('/internal/api/build-plan-state',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({quoteId,action:b.dataset.action,actor:'mark'})});const d=await r.json().catch(()=>({}));if(!r.ok)throw new Error(d.error||'Action failed.');await load();}catch(e){warning.hidden=false;warning.textContent=e instanceof Error?e.message:'Action failed.';await load();}}));
    q('[data-refresh]')?.addEventListener('click',load);load();
  }
  initApproval();document.addEventListener('astro:page-load',initApproval);
</script>
<style>
.approval-shell{max-width:900px;margin:0 auto}.approval-head{display:flex;justify-content:space-between;align-items:end;gap:1rem;margin-bottom:1.5rem}.approval-head p{margin:.25rem 0 0;color:var(--muted)}.head-actions{display:flex;gap:.5rem;flex-wrap:wrap}.state-card,.review-card,.history-card{border:1px solid var(--line);border-radius:var(--radius);background:var(--paper-raised);padding:1.1rem;margin-bottom:1rem}.state-card{display:flex;gap:.9rem;align-items:flex-start}.state-badge{font-weight:800;text-transform:uppercase;letter-spacing:.08em;font-size:.72rem;padding:.35rem .55rem;border:1px solid var(--line);border-radius:999px}.state-card[data-status="approved"] .state-badge{color:var(--accent-ink)}.review-head{display:flex;justify-content:space-between;gap:1rem;align-items:start}.review-card h2,.history-card h2{margin:.15rem 0 0}.review-version{font-size:.72rem;font-weight:800;color:var(--ink-faint);border:1px solid var(--line);border-radius:999px;padding:.35rem .55rem}.gate-summary{margin:1rem 0 .75rem;padding:.75rem .85rem;border:1px solid var(--line);border-radius:.55rem;font-weight:800}.gate-summary[data-tone="stop"]{color:var(--danger);border-color:var(--danger)}.gate-summary[data-tone="review"]{color:var(--ink-soft)}.gate-summary[data-tone="ready"]{color:var(--accent-ink)}.review-card li,.history-card li{margin:.45rem 0}.actions{display:flex;gap:.6rem;flex-wrap:wrap;margin-top:1rem}.approval-note{margin:1rem 0 0;color:var(--ink-faint);font-size:var(--step--2)}.warning{padding:.8rem;border:1px solid var(--danger);border-radius:var(--radius);color:var(--danger);margin:.75rem 0 0}@media(max-width:640px){.approval-head{align-items:flex-start;flex-direction:column}.head-actions,.actions{display:grid;width:100%}.head-actions .btn,.actions .btn{width:100%}.review-head{align-items:flex-start}}
</style>
