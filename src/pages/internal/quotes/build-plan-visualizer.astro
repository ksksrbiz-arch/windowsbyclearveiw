---
import InternalLayout from '../../../layouts/InternalLayout.astro';
---
<InternalLayout title="Build Plan Visualizer">
  <div class="viz-head"><div><p class="kicker">Production planning · visual mode</p><h1>Build Plan Visualizer</h1><p class="lede" data-subtitle>Turn the approved scope into a buildable sequence.</p></div><div class="actions"><a class="btn btn-ghost" data-back href="#">Build Plan</a><a class="btn btn-primary" data-quote href="#">Quote</a></div></div>
  <p class="error" data-error hidden role="alert"></p>
  <section class="hero-card" data-hero hidden><div><span class="eyebrow">FIELD BUILD MAP</span><h2 data-title>—</h2><p data-copy>—</p></div><div class="hero-metrics"><div><strong data-openings>0</strong><span>openings</span></div><div><strong data-buy>0</strong><span>buy groups</span></div><div><strong data-verify>0</strong><span>VERIFY</span></div></div></section>
  <section class="flow" data-flow hidden aria-label="Build sequence"><article class="flow-step active" data-step="scope"><b>01</b><strong>Scope</strong><span>Know what is being built</span></article><i>→</i><article class="flow-step" data-step="openings"><b>02</b><strong>Openings</strong><span>Build each opening</span></article><i>→</i><article class="flow-step" data-step="materials"><b>03</b><strong>Materials</strong><span>Buy + load</span></article><i>→</i><article class="flow-step" data-step="install"><b>04</b><strong>Install</strong><span>Execute the sequence</span></article><i>→</i><article class="flow-step" data-step="qc"><b>05</b><strong>QC</strong><span>Verify the finished work</span></article></section>
  <main class="viz-grid" data-workspace hidden>
    <section class="panel opening-panel"><div class="panel-head"><div><p class="kicker">Opening navigator</p><h2 data-opening-heading>Opening 1</h2><p class="muted">Build one opening completely before moving to the next.</p></div><div class="opening-nav"><button class="btn btn-ghost btn-small" data-prev type="button">← Previous</button><span data-opening-position>1 / 1</span><button class="btn btn-primary btn-small" data-next type="button">Next →</button></div></div><div class="opening-card" data-opening-card></div><div class="build-gates"><div><span>1</span><strong>Confirm</strong><small>Product + dimensions</small></div><div><span>2</span><strong>Prepare</strong><small>Opening + water path</small></div><div><span>3</span><strong>Install</strong><small>Follow product instructions</small></div><div><span>4</span><strong>Prove</strong><small>Operation + photos</small></div></div></section>
    <aside class="side-stack"><section class="panel"><div class="panel-head"><div><p class="kicker">Decision board</p><h2>What Mark needs to know</h2></div></div><div class="decision-list" data-decisions></div></section><section class="panel"><div class="panel-head"><div><p class="kicker">Loadout</p><h2>Truck-ready groups</h2></div></div><div class="loadout" data-loadout></div></section></aside>
  </main>
</InternalLayout>
<script>
  let plan:any=null;let index=0;
  const qs=<T extends Element>(s:string)=>document.querySelector(s) as T|null;
  const esc=(v:any)=>{const d=document.createElement('div');d.textContent=String(v??'');return d.innerHTML;};
  function render(){if(!plan)return;const openings=Array.isArray(plan.openings)?plan.openings:[];const o=openings[index]||null;const title=qs('[data-title]');if(title)title.textContent=plan.project?.customerName||plan.project?.customer_name||'Build plan';qs('[data-copy]')!.textContent=`${openings.length} opening${openings.length===1?'':'s'} · ${plan.buy?.length||0} purchase groups · ${plan.verify?.length||0} verification items`;qs('[data-openings]')!.textContent=String(openings.length);qs('[data-buy]')!.textContent=String(plan.buy?.length||0);qs('[data-verify]')!.textContent=String(plan.verify?.length||0);qs('[data-opening-heading]')!.textContent=o?`Opening ${index+1}`:'No openings';qs('[data-opening-position]')!.textContent=`${openings.length?index+1:0} / ${openings.length}`;const card=qs('[data-opening-card]');if(card)card.innerHTML=o?`<div class="opening-top"><div><span class="number">${index+1}</span><div><strong>${esc(o.product||o.sourceItemLabel||'Quoted opening')}</strong><small>${esc(o.openingType||'Type VERIFY')} · ${esc(o.installationMethod||'Method VERIFY')}</small></div></div><span class="status-pill">FIELD VERIFY</span></div><div class="spec-grid"><div><span>Quantity</span><strong>${Number(o.quantity)||1}</strong></div><div><span>Dimensions</span><strong>${esc(o.dimensions||'VERIFY on site')}</strong></div><div><span>Existing condition</span><strong>${esc(o.existingCondition||'VERIFY on site')}</strong></div><div><span>Water management</span><strong>${esc(o.flashing||'VERIFY against product instructions')}</strong></div></div><div class="sequence"><div><b>PREP</b><p>Protect the work area. Inspect the opening and stop for concealed damage.</p></div><div><b>SET</b><p>Confirm the selected unit and install using the manufacturer's current instructions.</p></div><div><b>SEAL</b><p>Complete the required flashing, WRB transitions, air sealing and insulation for the actual assembly.</p></div><div><b>VERIFY</b><p>Check alignment, operation, water-management path and finish. Photograph the completed work.</p></div></div>${o.notes?`<div class="note"><strong>Plan note</strong><p>${esc(o.notes)}</p></div>`:''}`:'<div class="empty-state">No opening schedule is attached to this plan. Add openings in the Build Plan editor first.</div>';const prev=qs<HTMLButtonElement>('[data-prev]'),next=qs<HTMLButtonElement>('[data-next]');if(prev)prev.disabled=index<=0;if(next)next.disabled=index>=openings.length-1;const decisions=qs('[data-decisions]');if(decisions)decisions.innerHTML=[...(plan.verify||[]).slice(0,8)].map((x:string)=>`<div class="decision"><span>VERIFY</span><p>${esc(x)}</p></div>`).join('')||'<p class="muted empty-pad">No outstanding verification items.</p>';const load=qs('[data-loadout]');if(load)load.innerHTML=[...(plan.load||[]),...(plan.buy||[])].slice(0,12).map((x:string)=>`<div class="load-row"><span>□</span><strong>${esc(x)}</strong></div>`).join('')||'<p class="muted empty-pad">No loadout groups.</p>';document.querySelectorAll('.flow-step').forEach((el,i)=>el.classList.toggle('active',i<=1));}
  async function init(){const id=new URLSearchParams(location.search).get('quoteId');const error=qs<HTMLElement>('[data-error]');if(!id){error!.hidden=false;error!.textContent='No quote id in the URL.';return;}try{const r=await fetch(`/internal/api/build-plan?quoteId=${encodeURIComponent(id)}`,{headers:{'cache-control':'no-cache'}});const d=await r.json();if(!r.ok)throw new Error(d.error||'Could not load the Build Plan.');plan=d.plan;qs<HTMLElement>('[data-hero]')!.hidden=false;qs<HTMLElement>('[data-flow]')!.hidden=false;qs<HTMLElement>('[data-workspace]')!.hidden=false;qs<HTMLAnchorElement>('[data-back]')!.href=`/internal/quotes/build-plan?quoteId=${encodeURIComponent(id)}`;qs<HTMLAnchorElement>('[data-quote]')!.href=`/internal/quotes/view?id=${encodeURIComponent(id)}`;render();}catch(e){error!.hidden=false;error!.textContent=e instanceof Error?e.message:'Could not load the Build Plan.';}}
  qs('[data-prev]')?.addEventListener('click',()=>{index=Math.max(0,index-1);render();});qs('[data-next]')?.addEventListener('click',()=>{index=Math.min((plan?.openings?.length||1)-1,index+1);render();});init();document.addEventListener('astro:page-load',init);
</script>
<style>
.viz-head{display:flex;justify-content:space-between;align-items:end;gap:var(--space-m);margin-bottom:var(--space-m)}.actions{display:flex;gap:.45rem;flex-wrap:wrap}.btn-small{padding:.45rem .7rem}.hero-card{display:flex;justify-content:space-between;gap:var(--space-m);align-items:center;padding:clamp(1.1rem,3vw,1.6rem);border:1px solid var(--accent-ink);border-radius:var(--radius);background:var(--paper-raised);margin-bottom:var(--space-m)}.eyebrow,.kicker{font-size:var(--step--2);font-weight:750;letter-spacing:.08em;text-transform:uppercase;color:var(--ink-faint)}.hero-card h2{margin:.2rem 0;font-size:var(--step-2)}.hero-card p{margin:0;color:var(--ink-soft)}.hero-metrics{display:grid;grid-template-columns:repeat(3,minmax(5rem,1fr));border-left:1px solid var(--line)}.hero-metrics div{padding:0 var(--space-m);display:grid;gap:.1rem}.hero-metrics strong{font-size:1.5rem}.hero-metrics span{font-size:var(--step--2);color:var(--ink-faint)}.flow{display:flex;align-items:stretch;gap:.35rem;margin-bottom:var(--space-m);overflow:auto;padding-bottom:.15rem}.flow-step{min-width:10rem;flex:1;padding:.8rem;border:1px solid var(--line);border-radius:var(--radius);background:var(--paper-raised);display:grid;gap:.12rem}.flow-step b{font-size:var(--step--2);color:var(--ink-faint)}.flow-step span{font-size:var(--step--2);color:var(--ink-soft)}.flow-step.active{border-color:var(--accent);box-shadow:inset 0 0 0 1px var(--accent)}.flow>i{align-self:center;color:var(--ink-faint);font-style:normal}.viz-grid{display:grid;grid-template-columns:minmax(0,1.7fr) minmax(18rem,.7fr);gap:var(--space-m)}.panel{border:1px solid var(--line);border-radius:var(--radius);background:var(--paper-raised);overflow:hidden}.panel-head{padding:var(--space-m);border-bottom:1px solid var(--line);display:flex;justify-content:space-between;align-items:end;gap:var(--space-s)}.panel-head h2{margin:.12rem 0 0;font-size:var(--step-1)}.opening-nav{display:flex;align-items:center;gap:.5rem;white-space:nowrap}.opening-nav span{font-size:var(--step--2);color:var(--ink-faint)}.opening-card{padding:var(--space-m)}.opening-top{display:flex;justify-content:space-between;gap:var(--space-m);align-items:center}.opening-top>div{display:flex;align-items:center;gap:.8rem}.number{display:grid;place-items:center;width:2.4rem;height:2.4rem;border-radius:50%;background:var(--black);color:var(--on-dark);font-weight:800}.opening-top strong{display:block;font-size:1.05rem}.opening-top small{display:block;color:var(--ink-soft);margin-top:.15rem}.status-pill{padding:.35rem .55rem;border-radius:999px;background:var(--accent-wash);color:var(--accent-ink);font-size:.7rem;font-weight:800;letter-spacing:.06em}.spec-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1px;background:var(--line);margin-top:var(--space-m);border:1px solid var(--line)}.spec-grid div{background:var(--paper);padding:.8rem}.spec-grid span{display:block;color:var(--ink-faint);font-size:.72rem;text-transform:uppercase;letter-spacing:.06em}.spec-grid strong{display:block;margin-top:.2rem;font-size:.92rem}.sequence{display:grid;grid-template-columns:repeat(4,1fr);gap:.6rem;margin-top:var(--space-m)}.sequence div{padding:.8rem;border:1px solid var(--line);border-radius:var(--radius);background:var(--paper)}.sequence b{font-size:.72rem;letter-spacing:.06em}.sequence p{margin:.25rem 0 0;font-size:.82rem;color:var(--ink-soft);line-height:1.45}.note{margin-top:var(--space-m);padding:.8rem;border-left:3px solid var(--accent);background:var(--accent-wash)}.note p{margin:.2rem 0 0;color:var(--ink-soft)}.build-gates{display:grid;grid-template-columns:repeat(4,1fr);border-top:1px solid var(--line)}.build-gates div{padding:.75rem;display:grid;grid-template-columns:auto 1fr;column-gap:.45rem}.build-gates span{grid-row:span 2;display:grid;place-items:center;width:1.7rem;height:1.7rem;border:1px solid var(--line-strong);border-radius:50%;font-size:.75rem}.build-gates strong{font-size:.8rem}.build-gates small{color:var(--ink-faint);font-size:.68rem}.side-stack{display:grid;gap:var(--space-m);align-content:start}.decision-list,.loadout{padding:0 var(--space-m) var(--space-m)}.decision{padding:.75rem 0;border-bottom:1px solid var(--line)}.decision span{font-size:.65rem;font-weight:800;color:var(--warning,#9a6700)}.decision p{margin:.2rem 0 0;font-size:.82rem}.load-row{display:grid;grid-template-columns:auto 1fr;gap:.55rem;padding:.7rem 0;border-bottom:1px solid var(--line);font-size:.82rem}.empty-pad{padding:.5rem 0}.error{padding:.8rem;border-left:2px solid var(--danger);background:color-mix(in srgb,var(--danger) 8%,transparent);margin-bottom:var(--space-m)}.muted{color:var(--ink-soft)}@media(max-width:900px){.viz-grid{grid-template-columns:1fr}.sequence{grid-template-columns:repeat(2,1fr)}}@media(max-width:650px){.viz-head{align-items:flex-start;flex-direction:column}.hero-card{align-items:flex-start;flex-direction:column}.hero-metrics{width:100%;border-left:0;border-top:1px solid var(--line);padding-top:.8rem}.hero-metrics div{padding:0 .7rem}.flow{margin-inline:-.2rem}.flow-step{min-width:8.5rem}.flow>i{display:none}.opening-top{align-items:flex-start;flex-direction:column}.opening-nav{width:100%;justify-content:space-between}.spec-grid{grid-template-columns:1fr}.sequence{grid-template-columns:1fr}.build-gates{grid-template-columns:repeat(2,1fr)}}
</style>