---
import InternalLayout from '../../../layouts/InternalLayout.astro';
---
<InternalLayout title="Quotes">
  <div class="ql-head">
    <div><p class="kicker">Sales workspace</p><h1>Quotes</h1><p class="lede">Build, finalize, and hand the customer cleanly into invoicing and production.</p></div>
    <div class="ql-head-actions"><a class="btn btn-ghost" href="/internal/invoices">Invoices</a><a class="btn btn-ghost" href="/internal/leads">Leads</a><a class="btn btn-primary" href="/internal/quotes/new">New quote</a></div>
  </div>
  <section class="quote-command"><div><span>QUOTE WORKSPACE</span><strong>Finish drafts before starting more work.</strong><p>Every draft needs a current, approved Build Plan before it can be finalized.</p></div><a href="/internal/jobs">Open jobs →</a></section>
  <div class="quote-toolbar"><label class="ql-search"><span>Search quotes</span><input type="search" data-search placeholder="Customer or city" /></label><span class="ql-result-note" data-result-note></span></div>
  <p data-loading>Loading…</p><p class="ql-error" data-error hidden role="alert"></p><p data-empty hidden>No quotes yet. Start with New quote above.</p><p class="ql-empty-filtered" data-empty-filtered hidden>No quotes match that search.</p>
  <div class="quote-list" data-list></div>
</InternalLayout>
<script>
  function initQuoteList(){
    const list=document.querySelector('[data-list]');if(!(list instanceof HTMLElement)||list.dataset.bound==='true')return;list.dataset.bound='true';
    const loading=document.querySelector('[data-loading]');const errorEl=document.querySelector('[data-error]');const emptyEl=document.querySelector('[data-empty]');const emptyFiltered=document.querySelector('[data-empty-filtered]');const search=document.querySelector('[data-search]');const note=document.querySelector('[data-result-note]');
    const money=(c:number)=>`$${(Number(c||0)/100).toLocaleString('en-US',{maximumFractionDigits:0})}`;const esc=(s:unknown)=>{const d=document.createElement('div');d.textContent=String(s??'');return d.innerHTML};
    const quoteLabel=(s:string)=>s==='finalized'?'Finalized':'Draft';const invoiceLabel=(s?:string)=>({draft:'Draft invoice',open:'Invoice open',sent:'Invoice sent',paid:'Paid',void:'Void'}[s||'']||'No invoice');
    const planLabel=(p:any)=>{if(p?.status==='approved')return 'Plan approved';if(p?.stale)return 'Plan stale';if((p?.quality?.blockers||[]).length)return 'Plan blocked';if(p?.status==='review')return 'Plan in review';if(p?.status==='reopened')return 'Plan reopened';if(p?.generated)return 'Plan not saved';return 'Plan draft';};
    const planClass=(p:any)=>p?.status==='approved'?'plan-approved':p?.stale?'plan-stale':(p?.quality?.blockers||[]).length?'plan-blocked':p?.status==='review'?'plan-review':'plan-draft';
    let quotes:any[]=[];let plans:Record<string,any>={};
    async function loadPlans(items:any[]){await Promise.all(items.filter(x=>x.status!=='finalized').map(async x=>{try{const r=await fetch(`/internal/api/build-plan?quoteId=${encodeURIComponent(x.id)}`,{headers:{'cache-control':'no-cache'}});plans[x.id]=r.ok?await r.json():{status:'draft'};}catch{plans[x.id]={status:'draft'};}}));}
    function render(){
      const q=search instanceof HTMLInputElement?search.value.trim().toLowerCase():'';const visible=quotes.filter(x=>!q||`${x.customer_name||''} ${x.customer_city||''}`.toLowerCase().includes(q));
      if(note)note.textContent=quotes.length?`${visible.length} of ${quotes.length} quotes`:'';if(emptyFiltered instanceof HTMLElement)emptyFiltered.hidden=!(q&&!visible.length);if(!visible.length){if(!quotes.length){if(emptyEl instanceof HTMLElement)emptyEl.hidden=false;}list.innerHTML='';return;}
      if(emptyEl instanceof HTMLElement)emptyEl.hidden=true;
      list.innerHTML=visible.map(x=>{const finalized=x.status==='finalized';const p=plans[x.id];const buildHref=`/internal/quotes/build-plan?quoteId=${encodeURIComponent(x.id)}`;const planText=finalized?'Build Plan attached to job/invoice flow':planLabel(p);const pClass=finalized?'plan-approved':planClass(p);return `<article class="quote-card"><div class="quote-card-main"><div class="quote-card-top"><span class="quote-status ${finalized?'is-final':'is-draft'}">${quoteLabel(x.status)}</span>${!finalized?`<span class="plan-status ${pClass}">${planText}</span>`:''}<span class="quote-id">${esc(x.id)}</span><time>${new Date(x.created_at).toLocaleDateString('en-US',{month:'short',day:'numeric',year:'numeric'})}</time></div><h2>${esc(x.customer_name)}</h2><p class="quote-meta">${esc([x.customer_city,x.customer_role].filter(Boolean).join(' · ')||'Customer')}</p></div><div class="quote-card-value"><strong>${money(x.total_cents)}</strong><span>${invoiceLabel(x.invoice_status)}</span></div><div class="quote-card-actions"><a class="btn btn-ghost btn-small" href="/internal/quotes/view?id=${encodeURIComponent(x.id)}">Open quote</a>${!finalized?`<a class="btn btn-primary btn-small" href="${buildHref}">${p?.status==='approved'?'Open plan':'Build plan'}</a>`:''}${x.invoice_id?`<a class="btn btn-ghost btn-small" href="/internal/invoices/view?id=${encodeURIComponent(x.invoice_id)}">Invoice</a>`:''}${finalized?`<a class="btn btn-primary btn-small" href="/internal/jobs">Jobs →</a>`:''}</div></article>`;}).join('');
    }
    async function load(){try{const response=await fetch('/internal/api/quotes',{headers:{'cache-control':'no-cache'}});const data=await response.json().catch(()=>({}));if(!response.ok)throw new Error(data.error||'Could not load quotes.');quotes=Array.isArray(data.quotes)?data.quotes:[];await loadPlans(quotes);if(loading instanceof HTMLElement)loading.hidden=true;render();}catch(e){if(loading instanceof HTMLElement)loading.hidden=true;if(errorEl instanceof HTMLElement){errorEl.hidden=false;errorEl.textContent=e instanceof Error?e.message:'Could not load quotes.';}}}
    search?.addEventListener('input',render);load();
  }
  initQuoteList();document.addEventListener('astro:page-load',initQuoteList);
</script>
<style>
  .ql-head{display:flex;justify-content:space-between;align-items:end;gap:var(--space-m);margin-bottom:var(--space-m)}.ql-head-actions{display:flex;gap:.5rem;flex-wrap:wrap}
  .quote-command{display:flex;justify-content:space-between;align-items:center;gap:var(--space-m);padding:1.05rem 1.15rem;margin-bottom:var(--space-s);border-radius:var(--radius-lg);background:var(--ink);color:var(--on-dark);box-shadow:var(--shadow-md)}.quote-command>div{display:grid;gap:.18rem}.quote-command span{font-size:.65rem;letter-spacing:.16em;font-weight:800;color:var(--accent-bright)}.quote-command strong{font-size:var(--step-1)}.quote-command p{margin:0;color:var(--on-dark-soft);font-size:var(--step--2)}.quote-command>a{color:var(--on-dark);font-size:var(--step--2);font-weight:750;white-space:nowrap}
  .quote-toolbar{display:flex;align-items:end;justify-content:space-between;gap:var(--space-m);margin-bottom:var(--space-s)}.ql-search{display:grid;gap:.25rem;max-width:24rem;width:100%;font-size:var(--step--2);font-weight:700}.ql-search input{width:100%;border:1px solid var(--line-strong);border-radius:var(--radius);padding:.7rem .8rem;font:inherit;background:var(--paper-raised);color:var(--ink)}.ql-result-note{font-size:var(--step--2);color:var(--ink-faint)}.ql-error{color:var(--danger)}
  .quote-list{display:grid;gap:.65rem}.quote-card{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:1rem;padding:1rem 1.05rem;border:1px solid var(--line);border-radius:var(--radius-lg);background:var(--paper-raised);box-shadow:var(--shadow-sm)}.quote-card-main{min-width:0}.quote-card-top{display:flex;align-items:center;gap:.5rem;flex-wrap:wrap}.quote-status,.plan-status{font-size:.66rem;font-weight:850;text-transform:uppercase;letter-spacing:.07em}.quote-status.is-final{color:var(--accent-ink)}.quote-status.is-draft{color:var(--danger)}.plan-status{border:1px solid var(--line);border-radius:999px;padding:.25rem .45rem;color:var(--ink-soft)}.plan-status.plan-approved{color:var(--accent-ink);border-color:var(--accent-ink)}.plan-status.plan-blocked{color:var(--danger);border-color:var(--danger)}.plan-status.plan-stale,.plan-status.plan-review{color:var(--warning,#9a6700);border-color:var(--warning,#9a6700)}.quote-id,.quote-card-top time{font-size:.7rem;color:var(--ink-faint)}.quote-card h2{margin:.32rem 0 .12rem;font-size:var(--step-1);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.quote-meta{margin:0;color:var(--ink-soft);font-size:var(--step--1)}.quote-card-value{display:grid;justify-items:end;align-content:start;gap:.12rem}.quote-card-value strong{font-size:1.6rem;line-height:1}.quote-card-value span{font-size:.7rem;color:var(--ink-soft)}.quote-card-actions{grid-column:1/-1;display:flex;gap:.45rem;flex-wrap:wrap;padding-top:.65rem;border-top:1px solid var(--line)}.btn-small{padding:.45rem .68rem;font-size:var(--step--2)}.ql-empty-filtered{color:var(--ink-soft)}
  @media(max-width:700px){.ql-head,.quote-toolbar,.quote-command{align-items:flex-start;flex-direction:column}.quote-command>a{align-self:flex-start}.quote-card{grid-template-columns:1fr}.quote-card-value{justify-items:start}.quote-card-actions{grid-column:auto}}
  @media(max-width:460px){.ql-head-actions{width:100%}.ql-head-actions .btn{flex:1}.quote-card-actions .btn{flex:1;justify-content:center}}
</style>
