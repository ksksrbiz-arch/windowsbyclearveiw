---
import InternalLayout from '../../../layouts/InternalLayout.astro';
---
<InternalLayout title="Build plan">
  <div class="bp-head"><div><p class="kicker">Production planning · controlled by rules</p><h1>Build plan</h1><p class="lede" data-subtitle>Loading quote…</p></div><div class="bp-actions"><span class="bp-state" data-state>Draft</span><a class="btn btn-ghost" data-quote-link href="#">Quote</a><a class="btn btn-ghost" data-approval-link href="#" hidden>Review &amp; approve</a><button class="btn btn-primary" type="button" data-save>Save verified plan</button></div></div>
  <p class="bp-status" data-status hidden role="status"></p><p class="bp-error" data-error hidden role="alert"></p>
  <section class="quality" data-quality hidden><div class="quality-main"><span class="quality-icon">✓</span><div><strong data-quality-title>Plan checked</strong><p data-quality-summary>Rules and source data have been checked.</p></div></div><div class="quality-meta"><span data-knowledge>Rules —</span><span data-quality-count>0 warnings</span></div><ul data-quality-list></ul></section>
  <section class="drift" data-drift hidden><strong>Quote changed since this plan was saved.</strong><span data-drift-text>Review the affected openings before ordering.</span><button type="button" class="link-button" data-refresh>Regenerate fresh baseline</button></section>
  <div class="bp-summary" data-summary hidden><div><span>Customer</span><strong data-customer>—</strong><small data-location>—</small></div><div><span>Quoted</span><strong data-total>—</strong><small>Plan remains tied to this quote</small></div><div><span>Openings</span><strong data-opening-count>0</strong><small data-opening-detail>Review before ordering</small></div></div>
  <main class="bp-grid" data-workspace hidden>
    <section class="bp-card bp-card-wide"><div class="card-head"><div><p class="kicker">01 · BUY</p><h2>Purchase plan</h2><p class="card-note">Items are deliberately classified. Product-specific details stay VERIFY until source documentation is known.</p></div><span class="badge" data-buy-count>0 items</span></div><div class="legend"><span>QUOTE / BASELINE</span><span class="verify">VERIFY</span><span class="conditional">CONDITIONAL</span></div><div class="editable-list" data-buy></div><button class="add-line" type="button" data-add="buy">+ Add purchase item</button></section>
    <section class="bp-card"><div class="card-head"><div><p class="kicker">02 · LOAD</p><h2>Truck load</h2></div></div><div class="editable-list" data-load></div><button class="add-line" type="button" data-add="load">+ Add load item</button></section>
    <section class="bp-card"><div class="card-head"><div><p class="kicker">03 · VERIFY</p><h2>Do not guess</h2><p class="card-note">Anything product-, site-, measurement-, or code-dependent belongs here until confirmed.</p></div></div><div class="editable-list" data-verify></div><button class="add-line" type="button" data-add="verify">+ Add verification</button></section>
    <section class="bp-card bp-card-wide"><div class="card-head"><div><p class="kicker">04 · INSTALL</p><h2>Controlled sequence</h2></div></div><ol class="install-list" data-install></ol><button class="add-line" type="button" data-add="install">+ Add installation step</button></section>
    <section class="bp-card bp-card-wide"><div class="card-head"><div><p class="kicker">05 · OPENINGS</p><h2>Opening-by-opening plan</h2><p class="card-note">AI classification is a starting point. Mark confirms the actual product, dimensions, method and site conditions before work begins.</p></div></div><div class="openings" data-openings></div><button class="add-line" type="button" data-add-opening>+ Add opening</button></section>
    <section class="bp-card bp-card-wide"><div class="card-head"><div><p class="kicker">06 · QC</p><h2>Before customer walkthrough</h2></div></div><div class="editable-list" data-qc></div><button class="add-line" type="button" data-add="qc">+ Add QC check</button></section>
    <section class="bp-card bp-card-wide"><label class="notes-label">Plan notes<textarea data-notes rows="5" maxlength="5000" placeholder="Special conditions, customer promises, access notes, rot repair, trim, ordering notes…"></textarea></label></section>
  </main>
</InternalLayout>
<script>
  type Opening={id:string;opening:number;product:string;sourceItemLabel?:string;quantity:number;openingType:string;installationMethod:string;existingCondition:string;dimensions:string;flashing:string;notes:string;qc:string[]};
  type Plan={schemaVersion:number;knowledgeVersion?:string;project:any;sourceItems?:any[];materialRules?:any[];buy:string[];load:string[];install:string[];verify:string[];qc:string[];openings:Opening[];notes:string;status?:string;approvedAt?:string|null;approvedBy?:string|null};
  let plan:Plan|null=null;let quote:any=null;let quoteId='';let dirty=false;let readOnly=false;
  function init(){
    const root=document.querySelector('[data-workspace]');if(!(root instanceof HTMLElement)||root.dataset.bound==='true')return;root.dataset.bound='true';quoteId=new URLSearchParams(location.search).get('quoteId')||'';
    const qs=<T extends Element>(s:string)=>document.querySelector(s) as T|null;const esc=(v:any)=>{const d=document.createElement('div');d.textContent=String(v??'');return d.innerHTML;};const money=(c:number)=>`$${(Number(c||0)/100).toLocaleString('en-US',{maximumFractionDigits:0})}`;
    const error=qs<HTMLElement>('[data-error]'),status=qs<HTMLElement>('[data-status]');const fail=(m:string)=>{if(error){error.hidden=false;error.textContent=m;}};const say=(m:string)=>{if(status){status.hidden=false;status.textContent=m;setTimeout(()=>status.hidden=true,2600)}};if(!quoteId){fail('No quote id in the URL.');return;}
    function markDirty(){if(readOnly)return;dirty=true;const b=qs<HTMLButtonElement>('[data-save]');if(b)b.textContent='Save verified plan *';}
    function renderList(key:keyof Plan){const host=qs<HTMLElement>(`[data-${String(key)}]`);if(!host||!plan)return;const values=(plan[key] as string[])||[];host.innerHTML=values.map((v,i)=>`<div class="edit-row"><span class="drag-dot">${i+1}</span><input value="${esc(v)}" maxlength="700" data-list-key="${String(key)}" data-index="${i}" ${readOnly?'disabled':''}><button type="button" class="remove" data-remove="${String(key)}" data-index="${i}" ${readOnly?'disabled':''} aria-label="Remove item">×</button></div>`).join('');host.querySelectorAll('input[data-list-key]').forEach(el=>el.addEventListener('input',()=>{const i=Number((el as HTMLInputElement).dataset.index);(plan![key] as string[])[i]=(el as HTMLInputElement).value;markDirty();}));host.querySelectorAll('[data-remove]').forEach(el=>el.addEventListener('click',()=>{const i=Number((el as HTMLElement).dataset.index);(plan![key] as string[]).splice(i,1);renderList(key);markDirty();}));const count=qs<HTMLElement>(`[data-${String(key)}-count]`);if(count)count.textContent=`${values.length} items`;}
    function renderOpenings(){const host=qs<HTMLElement>('[data-openings]');if(!host||!plan)return;host.innerHTML=plan.openings.map((o,i)=>`<article class="opening-card"><header><div><strong>Opening ${i+1}</strong><small>${esc(o.sourceItemLabel||o.product||'Quoted opening')}</small></div><button type="button" class="remove" data-remove-opening="${i}" ${readOnly?'disabled':''} aria-label="Remove opening">×</button></header><div class="opening-grid"><label>Product<input data-o="product" data-i="${i}" value="${esc(o.product)}" ${readOnly?'disabled':''}></label><label>Type<select data-o="openingType" data-i="${i}" ${readOnly?'disabled':''}>${['double-hung','slider','casement','picture/fixed','awning','sliding door','unknown'].map(x=>`<option ${x===o.openingType?'selected':''}>${x}</option>`).join('')}</select></label><label>Method<select data-o="installationMethod" data-i="${i}" ${readOnly?'disabled':''}><option value="verify" ${o.installationMethod==='verify'?'selected':''}>Verify</option><option value="insert" ${o.installationMethod==='insert'?'selected':''}>Insert</option><option value="full-frame" ${o.installationMethod==='full-frame'?'selected':''}>Full-frame</option><option value="new-construction" ${o.installationMethod==='new-construction'?'selected':''}>New construction</option></select></label><label>Qty<input type="number" min="1" data-o="quantity" data-i="${i}" value="${Number(o.quantity)||1}" ${readOnly?'disabled':''}></label><label>Dimensions<input data-o="dimensions" data-i="${i}" value="${esc(o.dimensions)}" ${readOnly?'disabled':''}></label><label>Existing condition<input data-o="existingCondition" data-i="${i}" value="${esc(o.existingCondition)}" ${readOnly?'disabled':''}></label><label class="wide">Flashing / water management<input data-o="flashing" data-i="${i}" value="${esc(o.flashing)}" ${readOnly?'disabled':''}></label><label class="wide">Notes<textarea data-o="notes" data-i="${i}" rows="2" ${readOnly?'disabled':''}>${esc(o.notes)}</textarea></label></div><details><summary>QC for this opening</summary><ul>${(o.qc||[]).map(x=>`<li>${esc(x)}</li>`).join('')}</ul></details></article>`).join('')||'<p class="empty">No openings yet.</p>';host.querySelectorAll('[data-o]').forEach(el=>el.addEventListener('input',()=>{const i=Number((el as HTMLElement).dataset.i);const k=(el as HTMLElement).dataset.o as keyof Opening;const raw=(el as HTMLInputElement).value;(plan!.openings[i] as any)[k]=k==='quantity'?Math.max(1,Number(raw)||1):raw;markDirty();}));host.querySelectorAll('[data-remove-opening]').forEach(el=>el.addEventListener('click',()=>{plan!.openings.splice(Number((el as HTMLElement).dataset.removeOpening),1);plan!.openings.forEach((o,n)=>o.opening=n+1);renderOpenings();markDirty();}));const c=qs<HTMLElement>('[data-opening-count]');if(c)c.textContent=String(plan.openings.length);const d=qs<HTMLElement>('[data-opening-detail]');if(d)d.textContent=plan.openings.length?'Review product, method and VERIFY items':'Add openings before ordering';}
    function add(key:keyof Plan){if(!plan||readOnly)return;(plan[key] as string[]).push('New item — describe exactly what Mark needs');renderList(key);markDirty();}
    document.querySelectorAll('[data-add]').forEach(el=>el.addEventListener('click',()=>add((el as HTMLElement).dataset.add as keyof Plan)));
    qs('[data-add-opening]')?.addEventListener('click',()=>{if(!plan||readOnly)return;plan.openings.push({id:`opening-${Date.now()}`,opening:plan.openings.length+1,product:'Quoted opening — VERIFY order confirmation',sourceItemLabel:'Manual opening',quantity:1,openingType:'unknown',installationMethod:'verify',existingCondition:'VERIFY at site',dimensions:'VERIFY at site',flashing:'VERIFY against selected product instructions and opening conditions',notes:'',qc:[]});renderOpenings();markDirty();});
    qs('[data-save]')?.addEventListener('click',async()=>{if(!plan||readOnly)return;const b=qs<HTMLButtonElement>('[data-save]');if(b)b.disabled=true;try{const r=await fetch('/internal/api/build-plan',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({quoteId,plan})});const d=await r.json().catch(()=>({}));if(!r.ok)throw new Error(`${d.error||'Could not save the build plan.'}${[...(d.blockers||[]),...(d.warnings||[])].length?' '+[...(d.blockers||[]),...(d.warnings||[])].join(' '):''}`);dirty=false;plan.status=d.status||plan.status||'draft';if(b)b.textContent='Saved · verified';renderQuality(d.quality);renderState();say(`Build plan saved · v${d.version}`);}catch(e){fail(e instanceof Error?e.message:'Could not save the build plan.');}finally{if(b)b.disabled=false;}});
    window.addEventListener('beforeunload',e=>{if(dirty){e.preventDefault();e.returnValue='';}});
    qs('[data-refresh]')?.addEventListener('click',async()=>{if(dirty&&!confirm('Discard unsaved edits and load a fresh baseline from the current quote?'))return;await load(true);});
    function renderQuality(q:any){const box=qs<HTMLElement>('[data-quality]');if(!box||!q)return;box.hidden=false;const bad=(q.blockers||[]).length,warnings=(q.warnings||[]).length;qs('[data-quality-title]')!.textContent=bad?'Plan blocked':'Plan checked';qs('[data-quality-summary]')!.textContent=bad?'Correct the blocking issues before saving.':warnings?`${warnings} review item${warnings===1?'':'s'} remain. No hard blocker detected.`:'No automated rule violations detected.';qs('[data-quality-count]')!.textContent=`${warnings} warning${warnings===1?'':'s'}${bad?` · ${bad} blocker${bad===1?'':'s'}`:''}`;qs('[data-knowledge]')!.textContent=`Rules ${q.knowledgeVersion||'current'}`;qs('[data-quality-list]')!.innerHTML=[...(q.blockers||[]).map((x:string)=>`<li class="blocker">BLOCKER · ${esc(x)}</li>`),...(q.warnings||[]).map((x:string)=>`<li>VERIFY · ${esc(x)}</li>`)].join('');}
    function renderState(){const state=plan?.status||'draft';const label=state==='approved'?'Approved':state==='review'?'In review':state==='reopened'?'Reopened':'Draft';const stateEl=qs<HTMLElement>('[data-state]');if(stateEl){stateEl.textContent=label;stateEl.dataset.status=state;}const approval=qs<HTMLAnchorElement>('[data-approval-link]');if(approval){approval.hidden=!['draft','review','reopened'].includes(state);approval.href=`/internal/quotes/build-plan-approval?quoteId=${encodeURIComponent(quoteId)}`;approval.textContent=state==='draft'?'Review & approve':state==='reopened'?'Review & re-approve':'Open approval';}const save=qs<HTMLButtonElement>('[data-save]');if(save){save.disabled=readOnly;save.textContent=readOnly?'Approved · locked':dirty?'Save verified plan *':'Save verified plan';}document.querySelectorAll('[data-add],[data-add-opening]').forEach(el=>{if(el instanceof HTMLButtonElement)el.disabled=readOnly;});}
    function renderAll(d:any){quote=d.quote;plan=d.plan;readOnly=quote.status!=='draft'||plan.status==='approved';qs('[data-subtitle]')!.textContent=`${quote.id} · ${quote.customer_name||'Customer'}${plan.status==='approved'?' · Approved operational version':quote.status!=='draft'?' · Read only after finalization':''}`;qs('[data-customer]')!.textContent=quote.customer_name||'—';qs('[data-location]')!.textContent=[quote.customer_address,quote.customer_city].filter(Boolean).join(', ')||'Address on quote';qs('[data-total]')!.textContent=money(quote.total_cents);qs('[data-quote-link]')!.setAttribute('href',`/internal/quotes/view?id=${encodeURIComponent(quote.id)}`);qs('[data-notes]')!.value=plan.notes||'';root.hidden=false;qs('[data-summary]')!.hidden=false;renderList('buy');renderList('load');renderList('verify');renderList('install');renderList('qc');renderOpenings();renderQuality(d.quality);const drift=qs<HTMLElement>('[data-drift]');if(drift)drift.hidden=!d.stale;renderState();}
    async function load(force=false){try{const r=await fetch(`/internal/api/build-plan?quoteId=${encodeURIComponent(quoteId)}${force?'&fresh=1':''}`,{headers:{'cache-control':'no-cache'}});const d=await r.json();if(!r.ok)throw new Error(d.error||'Could not load the build plan.');if(force){dirty=false;}renderAll(d);if(force)say('Fresh baseline loaded — review it before saving.');}catch(e){fail(e instanceof Error?e.message:'Could not load the build plan.');}}
    qs('[data-notes]')?.addEventListener('input',()=>{if(plan){plan.notes=(qs<HTMLTextAreaElement>('[data-notes]')!).value;markDirty();}});load();
  }
  init();document.addEventListener('astro:page-load',init);
</script>
<style>
.bp-head{display:flex;justify-content:space-between;align-items:end;gap:var(--space-m);margin-bottom:var(--space-m)}.bp-actions{display:flex;gap:var(--space-xs);flex-wrap:wrap;align-items:center}.bp-state{font-size:.7rem;font-weight:850;text-transform:uppercase;letter-spacing:.07em;border:1px solid var(--line);border-radius:999px;padding:.4rem .6rem;color:var(--ink-soft)}.bp-state[data-status="approved"]{color:var(--accent-ink);border-color:var(--accent-ink)}.bp-status,.bp-error{margin:0 0 var(--space-m);padding:.75rem 1rem;border:1px solid var(--line);border-radius:var(--radius);background:var(--paper-raised)}.bp-error{border-color:var(--danger);color:var(--danger)}.quality,.drift{border:1px solid var(--line);border-radius:var(--radius);padding:var(--space-m);margin-bottom:var(--space-m);background:var(--paper-raised)}.quality{display:grid;grid-template-columns:1fr auto;gap:.7rem}.quality-main{display:flex;gap:.75rem}.quality-icon{display:grid;place-items:center;width:2rem;height:2rem;border-radius:50%;border:1px solid var(--line);font-weight:800}.quality p{margin:.2rem 0 0;color:var(--ink-soft)}.quality-meta{display:flex;gap:var(--space-s);color:var(--ink-faint);font-size:var(--step--2);align-items:center}.quality ul{grid-column:1/-1;margin:.1rem 0 0;padding-left:1.2rem}.quality li{margin:.25rem 0}.quality li.blocker{color:var(--danger);font-weight:700}.drift{display:flex;gap:.7rem;align-items:center;flex-wrap:wrap}.drift span{color:var(--ink-soft)}.link-button{border:0;background:none;color:inherit;text-decoration:underline;font:inherit;font-weight:700;cursor:pointer;margin-left:auto}.bp-summary{display:grid;grid-template-columns:2fr 1fr 1fr;gap:var(--space-s);margin-bottom:var(--space-m)}.bp-summary>div{border:1px solid var(--line);background:var(--paper-raised);border-radius:var(--radius);padding:var(--space-m);display:grid;gap:.2rem}.bp-summary span,.bp-summary small{font-size:var(--step--2);color:var(--ink-faint)}.bp-summary strong{font-size:var(--step-1)}.bp-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:var(--space-m)}.bp-card{border:1px solid var(--line);background:var(--paper-raised);border-radius:var(--radius);overflow:hidden}.bp-card-wide{grid-column:1/-1}.card-head{padding:var(--space-m);border-bottom:1px solid var(--line);display:flex;justify-content:space-between;gap:var(--space-m);align-items:start}.card-head h2{margin:.15rem 0 0;font-size:var(--step-1)}.card-note{margin:.35rem 0 0;color:var(--ink-soft);max-width:75ch}.badge{white-space:nowrap;color:var(--ink-faint);font-size:var(--step--2)}.legend{display:flex;gap:.5rem;flex-wrap:wrap;padding:.65rem var(--space-m) 0}.legend span{font-size:.68rem;font-weight:800;letter-spacing:.05em;border:1px solid var(--line);border-radius:999px;padding:.25rem .45rem}.legend .verify{border-color:var(--warning,#9a6700)}.editable-list{padding:var(--space-s) var(--space-m)}.edit-row{display:grid;grid-template-columns:1.6rem 1fr auto;align-items:center;gap:.6rem;border-bottom:1px solid var(--line);padding:.45rem 0}.edit-row:last-child{border-bottom:0}.drag-dot{color:var(--ink-faint);font-size:var(--step--2);text-align:center}.edit-row input,.opening-card input,.opening-card select,.opening-card textarea,.notes-label textarea{width:100%;min-width:0;border:1px solid var(--line-strong);border-radius:.5rem;background:var(--paper);color:var(--ink);padding:.65rem;font:inherit}.remove{border:0;background:transparent;color:var(--ink-faint);font-size:1.35rem;min-width:2.5rem;min-height:2.5rem;cursor:pointer}.remove:hover{color:var(--danger)}.add-line{margin:0 var(--space-m) var(--space-m);border:1px dashed var(--line-strong);background:transparent;color:var(--ink-soft);border-radius:.5rem;padding:.7rem .8rem;font:inherit;font-weight:650;cursor:pointer;width:calc(100% - 2 * var(--space-m))}.install-list{margin:0;padding:var(--space-s) var(--space-m) var(--space-s) calc(var(--space-m) + 1.8rem);list-style:none}.openings{padding:var(--space-s) var(--space-m)}.opening-card{border:1px solid var(--line);border-radius:.65rem;padding:var(--space-s);margin-bottom:var(--space-s);background:var(--paper)}.opening-card header{display:flex;justify-content:space-between;align-items:center;margin-bottom:.5rem}.opening-card header div{display:grid;gap:.15rem}.opening-card header small{color:var(--ink-faint)}.opening-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.6rem}.opening-grid label{font-size:var(--step--2);font-weight:650;display:grid;gap:.25rem}.opening-grid .wide{grid-column:1/-1}.opening-card details{margin-top:.65rem;border-top:1px solid var(--line);padding-top:.55rem;color:var(--ink-soft)}.opening-card details ul{margin:.5rem 0 0;padding-left:1.2rem}.notes-label{display:block;padding:var(--space-m);font-weight:650}.notes-label textarea{display:block;margin-top:.4rem;resize:vertical}.empty{padding:var(--space-m);color:var(--ink-faint)}
@media(max-width:720px){.bp-head{align-items:flex-start;flex-direction:column}.bp-actions{width:100%}.bp-actions .btn{flex:1;text-align:center}.bp-summary{grid-template-columns:1fr}.bp-grid{grid-template-columns:1fr}.bp-card-wide{grid-column:auto}.opening-grid{grid-template-columns:1fr}.opening-grid .wide{grid-column:auto}.quality{grid-template-columns:1fr}.quality-meta{flex-wrap:wrap}.link-button{margin-left:0}.edit-row{grid-template-columns:1.3rem 1fr auto}.bp-state{order:-1}}
</style>
