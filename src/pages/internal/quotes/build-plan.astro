---
import InternalLayout from '../../../layouts/InternalLayout.astro';
---
<InternalLayout title="Build plan">
  <div class="bp-head">
    <div>
      <p class="kicker">Production planning</p>
      <h1>Build plan</h1>
      <p class="lede" data-subtitle>Loading quote…</p>
    </div>
    <div class="bp-actions">
      <a class="btn btn-ghost" data-quote-link href="#">Quote</a>
      <button class="btn btn-primary" type="button" data-save>Save plan</button>
    </div>
  </div>

  <p class="bp-status" data-status hidden role="status"></p>
  <p class="bp-error" data-error hidden role="alert"></p>

  <div class="bp-summary" data-summary hidden>
    <div><span>Customer</span><strong data-customer>—</strong><small data-location>—</small></div>
    <div><span>Quoted</span><strong data-total>—</strong><small>Plan stays tied to this quote</small></div>
    <div><span>Openings</span><strong data-opening-count>0</strong><small data-opening-detail>Review before ordering</small></div>
  </div>

  <main class="bp-grid" data-workspace hidden>
    <section class="bp-card bp-card-wide">
      <div class="card-head"><div><p class="kicker">01 · BUY</p><h2>What needs to be purchased</h2></div><span class="badge" data-buy-count>0 items</span></div>
      <div class="editable-list" data-buy></div>
      <button class="add-line" type="button" data-add="buy">+ Add purchase item</button>
    </section>

    <section class="bp-card">
      <div class="card-head"><div><p class="kicker">02 · LOAD</p><h2>What goes in the truck</h2></div></div>
      <div class="editable-list" data-load></div>
      <button class="add-line" type="button" data-add="load">+ Add load item</button>
    </section>

    <section class="bp-card">
      <div class="card-head"><div><p class="kicker">03 · VERIFY</p><h2>Do not guess</h2></div></div>
      <div class="editable-list" data-verify></div>
      <button class="add-line" type="button" data-add="verify">+ Add verification</button>
    </section>

    <section class="bp-card bp-card-wide">
      <div class="card-head"><div><p class="kicker">04 · INSTALL</p><h2>Run the job in this order</h2></div></div>
      <ol class="install-list" data-install></ol>
      <button class="add-line" type="button" data-add="install">+ Add installation step</button>
    </section>

    <section class="bp-card bp-card-wide">
      <div class="card-head"><div><p class="kicker">05 · OPENINGS</p><h2>Opening-by-opening plan</h2><p class="card-note">Dimensions, conditions, and manufacturer requirements remain VERIFY items until Mark confirms them at the job.</p></div></div>
      <div class="openings" data-openings></div>
      <button class="add-line" type="button" data-add-opening>+ Add opening</button>
    </section>

    <section class="bp-card bp-card-wide">
      <div class="card-head"><div><p class="kicker">06 · QC</p><h2>Before the customer walkthrough</h2></div></div>
      <div class="editable-list" data-qc></div>
      <button class="add-line" type="button" data-add="qc">+ Add QC check</button>
    </section>

    <section class="bp-card bp-card-wide">
      <label class="notes-label">Plan notes<textarea data-notes rows="5" maxlength="5000" placeholder="Special conditions, customer promises, access notes, rot repair, trim, ordering notes…"></textarea></label>
    </section>
  </main>
</InternalLayout>

<script>
  type Opening = { id:string; opening:number; product:string; quantity:number; openingType:string; installationMethod:string; existingCondition:string; dimensions:string; flashing:string; notes:string; qc:string[] };
  type Plan = { schemaVersion:number; project:any; buy:string[]; load:string[]; install:string[]; verify:string[]; qc:string[]; openings:Opening[]; notes:string };
  let plan:Plan|null=null; let quote:any=null; let items:any[]=[]; let quoteId=''; let dirty=false;

  function init(){
    const root=document.querySelector('[data-workspace]'); if(!(root instanceof HTMLElement)||root.dataset.bound==='true')return; root.dataset.bound='true';
    quoteId=new URLSearchParams(location.search).get('quoteId')||'';
    const qs=<T extends Element>(s:string)=>document.querySelector(s) as T|null;
    const esc=(v:any)=>{const d=document.createElement('div');d.textContent=String(v??'');return d.innerHTML;};
    const money=(c:number)=>`$${(Number(c||0)/100).toLocaleString('en-US',{maximumFractionDigits:0})}`;
    const error=qs<HTMLElement>('[data-error]'); const status=qs<HTMLElement>('[data-status]');
    const fail=(m:string)=>{if(error){error.hidden=false;error.textContent=m;}};
    const say=(m:string)=>{if(status){status.hidden=false;status.textContent=m;setTimeout(()=>{status.hidden=true},2200)}};
    if(!quoteId){fail('No quote id in the URL.');return;}

    function markDirty(){dirty=true;const b=qs<HTMLButtonElement>('[data-save]');if(b)b.textContent='Save plan *';}
    function renderList(key:keyof Plan){
      const host=qs<HTMLElement>(`[data-${String(key)}]`); if(!host||!plan)return; const values=(plan[key] as string[])||[];
      host.innerHTML=values.map((v,i)=>`<div class="edit-row"><span class="drag-dot">${i+1}</span><input value="${esc(v)}" maxlength="500" data-list-key="${String(key)}" data-index="${i}"><button type="button" class="remove" data-remove="${String(key)}" data-index="${i}" aria-label="Remove item">×</button></div>`).join('');
      host.querySelectorAll('input[data-list-key]').forEach(el=>el.addEventListener('input',()=>{const i=Number((el as HTMLInputElement).dataset.index);(plan![key] as string[])[i]=(el as HTMLInputElement).value;markDirty();}));
      host.querySelectorAll('[data-remove]').forEach(el=>el.addEventListener('click',()=>{const i=Number((el as HTMLElement).dataset.index);(plan![key] as string[]).splice(i,1);renderList(key);markDirty();}));
      const count=qs<HTMLElement>(`[data-${String(key)}-count]`);if(count)count.textContent=`${values.length} items`;
    }
    function renderOpenings(){
      const host=qs<HTMLElement>('[data-openings]');if(!host||!plan)return;
      host.innerHTML=plan.openings.map((o,i)=>`<article class="opening-card"><header><strong>Opening ${i+1}</strong><button type="button" class="remove" data-remove-opening="${i}" aria-label="Remove opening">×</button></header><div class="opening-grid"><label>Product<input data-o="product" data-i="${i}" value="${esc(o.product)}"></label><label>Type<select data-o="openingType" data-i="${i}">${['double-hung','slider','casement','picture/fixed','awning','sliding door','unknown'].map(x=>`<option ${x===o.openingType?'selected':''}>${x}</option>`).join('')}</select></label><label>Method<select data-o="installationMethod" data-i="${i}"><option value="insert" ${o.installationMethod==='insert'?'selected':''}>Insert</option><option value="full-frame" ${o.installationMethod==='full-frame'?'selected':''}>Full-frame</option></select></label><label>Qty<input type="number" min="1" data-o="quantity" data-i="${i}" value="${Number(o.quantity)||1}"></label><label>Dimensions<input data-o="dimensions" data-i="${i}" value="${esc(o.dimensions)}"></label><label>Existing condition<input data-o="existingCondition" data-i="${i}" value="${esc(o.existingCondition)}"></label><label class="wide">Flashing<input data-o="flashing" data-i="${i}" value="${esc(o.flashing)}"></label><label class="wide">Notes<textarea data-o="notes" data-i="${i}" rows="2">${esc(o.notes)}</textarea></label></div></article>`).join('')||'<p class="empty">No openings yet. Add one or save the quote lines into this plan.</p>';
      host.querySelectorAll('[data-o]').forEach(el=>{el.addEventListener('input',()=>{const i=Number((el as HTMLElement).dataset.i);const k=(el as HTMLElement).dataset.o as keyof Opening;const raw=(el as HTMLInputElement).value; (plan!.openings[i] as any)[k]=k==='quantity'?Math.max(1,Number(raw)||1):raw;markDirty();});});
      host.querySelectorAll('[data-remove-opening]').forEach(el=>el.addEventListener('click',()=>{plan!.openings.splice(Number((el as HTMLElement).dataset.removeOpening),1);plan!.openings.forEach((o,n)=>o.opening=n+1);renderOpenings();markDirty();}));
      const c=qs<HTMLElement>('[data-opening-count]');if(c)c.textContent=String(plan.openings.length);const d=qs<HTMLElement>('[data-opening-detail]');if(d)d.textContent=plan.openings.length?'Review products, methods and VERIFY items':'Add openings before ordering';
    }
    function add(key:keyof Plan){if(!plan)return;(plan[key] as string[]).push('New item — describe exactly what Mark needs');renderList(key);markDirty();}
    document.querySelectorAll('[data-add]').forEach(el=>el.addEventListener('click',()=>add((el as HTMLElement).dataset.add as keyof Plan)));
    qs('[data-add-opening]')?.addEventListener('click',()=>{if(!plan)return;plan.openings.push({id:`opening-${Date.now()}`,opening:plan.openings.length+1,product:'Quoted opening',quantity:1,openingType:'unknown',installationMethod:'insert',existingCondition:'VERIFY at site',dimensions:'VERIFY at site',flashing:'VERIFY sill and perimeter flashing sequence',notes:'',qc:['Plumb','Level','Square','Fasteners verified','Flashing complete','Insulation complete','Seal complete','Operation tested','Photos captured']});renderOpenings();markDirty();});
    qs('[data-save]')?.addEventListener('click',async()=>{if(!plan)return;const b=qs<HTMLButtonElement>('[data-save]');if(b)b.disabled=true;try{const r=await fetch('/internal/api/build-plan',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({quoteId,plan})});const d=await r.json().catch(()=>({}));if(!r.ok)throw new Error(d.error||'Could not save the build plan.');dirty=false;if(b)b.textContent='Saved';say(`Build plan saved · v${d.version}`);}catch(e){fail(e instanceof Error?e.message:'Could not save the build plan.');}finally{if(b)b.disabled=false;}});
    window.addEventListener('beforeunload',(e)=>{if(dirty){e.preventDefault();e.returnValue='';}});

    async function load(){try{const r=await fetch(`/internal/api/build-plan?quoteId=${encodeURIComponent(quoteId)}`,{headers:{'cache-control':'no-cache'}});const d=await r.json();if(!r.ok)throw new Error(d.error||'Could not load the build plan.');quote=d.quote;items=d.items||[];plan=d.plan;qs('[data-subtitle]')!.textContent=`${quote.id} · ${quote.customer_name||'Customer'}${quote.status==='finalized'?' · Read only after finalization':''}`;qs('[data-customer]')!.textContent=quote.customer_name||'—';qs('[data-location]')!.textContent=[quote.customer_address,quote.customer_city].filter(Boolean).join(', ')||'Address on quote';qs('[data-total]')!.textContent=money(quote.total_cents);qs('[data-quote-link]')!.setAttribute('href',`/internal/quotes/view?id=${encodeURIComponent(quote.id)}`);qs('[data-notes]')!.value=plan.notes||'';qs('[data-notes]')!.addEventListener('input',()=>{plan!.notes=(qs<HTMLTextAreaElement>('[data-notes]')!).value;markDirty();});root.hidden=false;qs('[data-summary]')!.hidden=false;renderList('buy');renderList('load');renderList('verify');renderList('install');renderList('qc');renderOpenings();if(quote.status!=='draft'){const b=qs<HTMLButtonElement>('[data-save]');if(b){b.disabled=true;b.textContent='Read only';}root.querySelectorAll('input,select,textarea,button').forEach(el=>{if(el!==b) (el as HTMLInputElement).disabled=true;});}}
    catch(e){fail(e instanceof Error?e.message:'Could not load the build plan.');}}
    load();
  }
  init();document.addEventListener('astro:page-load',init);
</script>

<style>
  .bp-head{display:flex;justify-content:space-between;align-items:end;gap:var(--space-m);margin-bottom:var(--space-m)}.bp-actions{display:flex;gap:var(--space-xs);flex-wrap:wrap}.bp-summary{display:grid;grid-template-columns:2fr 1fr 1fr;gap:var(--space-s);margin-bottom:var(--space-m)}.bp-summary>div{border:1px solid var(--line);background:var(--paper-raised);border-radius:var(--radius);padding:var(--space-m);display:grid;gap:.2rem}.bp-summary span,.bp-summary small{font-size:var(--step--2);color:var(--ink-faint)}.bp-summary strong{font-size:var(--step-1)}
  .bp-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:var(--space-m)}.bp-card{border:1px solid var(--line);background:var(--paper-raised);border-radius:var(--radius);overflow:hidden}.bp-card-wide{grid-column:1/-1}.card-head{padding:var(--space-m);border-bottom:1px solid var(--line);display:flex;justify-content:space-between;gap:var(--space-m);align-items:start}.card-head h2{margin:.15rem 0 0;font-size:var(--step-1)}.card-note{margin:.35rem 0 0;color:var(--ink-soft);max-width:70ch}.badge{white-space:nowrap;color:var(--ink-faint);font-size:var(--step--2)}.editable-list{padding:var(--space-s) var(--space-m)}.edit-row{display:grid;grid-template-columns:1.6rem 1fr auto;align-items:center;gap:.6rem;border-bottom:1px solid var(--line);padding:.45rem 0}.edit-row:last-child{border-bottom:0}.drag-dot{color:var(--ink-faint);font-size:var(--step--2);text-align:center}.edit-row input,.opening-card input,.opening-card select,.opening-card textarea{width:100%;min-width:0;border:1px solid var(--line-strong);border-radius:.5rem;background:var(--paper);color:var(--ink);padding:.65rem;font:inherit}.remove{border:0;background:transparent;color:var(--ink-faint);font-size:1.35rem;min-width:2.5rem;min-height:2.5rem;cursor:pointer}.remove:hover{color:var(--danger)}.add-line{margin:0 var(--space-m) var(--space-m);border:1px dashed var(--line-strong);background:transparent;color:var(--ink-soft);border-radius:.5rem;padding:.7rem .8rem;font:inherit;font-weight:650;cursor:pointer;width:calc(100% - 2 * var(--space-m))}.install-list{margin:0;padding:var(--space-s) var(--space-m) var(--space-s) calc(var(--space-m) + 1.8rem)}.install-list .edit-row{padding-left:.2rem}.install-list{list-style:none}.install-list:before{content:''}.openings{padding:var(--space-s) var(--space-m)}.opening-card{border:1px solid var(--line);border-radius:.65rem;padding:var(--space-s);margin-bottom:var(--space-s);background:var(--paper)}.opening-card header{display:flex;justify-content:space-between;align-items:center;margin-bottom:.5rem}.opening-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.6rem}.opening-grid label{font-size:var(--step--2);font-weight:650;display:grid;gap:.25rem}.opening-grid .wide{grid-column:1/-1}.notes-label{display:block;padding:var(--space-m);font-weight:650}.notes-label textarea{display:block;width:100%;margin-top:.4rem;border:1px solid var(--line-strong);border-radius:.5rem;background:var(--paper);color:var(--ink);padding:.7rem;font:inherit}.bp-status{padding:.7rem var(--space-m);border-left:2px solid var(--accent);background:var(--paper-raised)}.bp-error{padding:.7rem var(--space-m);border-left:2px solid var(--danger);background:color-mix(in srgb,var(--danger) 8%,transparent)}.empty{padding:var(--space-m);color:var(--ink-faint)}
  @media(max-width:760px){.bp-head{align-items:flex-start;flex-direction:column}.bp-actions{width:100%}.bp-actions .btn{flex:1;text-align:center}.bp-summary{grid-template-columns:1fr 1fr}.bp-summary>div:first-child{grid-column:1/-1}.bp-grid{grid-template-columns:1fr}.bp-card-wide{grid-column:auto}.opening-grid{grid-template-columns:1fr}.opening-grid .wide{grid-column:auto}.edit-row{grid-template-columns:1.4rem 1fr auto}.bp-card{border-radius:.7rem}}
</style>