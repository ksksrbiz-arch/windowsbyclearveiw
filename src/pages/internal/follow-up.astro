---
import InternalLayout from '../../layouts/InternalLayout.astro';
---
<InternalLayout title="Follow-up">
  <div class="fu-head">
    <div><p class="kicker">CRM</p><h1>Follow-up</h1><p class="lede">Keep open customer actions visible without losing them in the lead list.</p></div>
    <div class="fu-actions"><a class="btn btn-ghost" href="/internal/leads">Leads</a><button class="btn btn-primary" type="button" data-add-open>Add task</button></div>
  </div>

  <section class="stats" aria-label="Follow-up summary">
    <article class="stat panel"><span>Open</span><strong data-open>—</strong></article>
    <article class="stat panel"><span>Due today</span><strong data-today>—</strong></article>
    <article class="stat panel"><span>Overdue</span><strong data-overdue>—</strong></article>
  </section>

  <section class="panel add-card" data-add-card hidden>
    <div class="panel-head"><div><p class="kicker">New follow-up</p><h2>Add a task</h2></div></div>
    <form data-form>
      <label>Task<input name="title" required maxlength="240" placeholder="Call customer about installation date" /></label>
      <label>Lead ID<input name="leadId" inputmode="numeric" placeholder="Optional lead ID" /></label>
      <label>Due<input name="dueAt" type="datetime-local" /></label>
      <label>Notes<textarea name="notes" rows="3" maxlength="4000" placeholder="What needs to happen next?"></textarea></label>
      <div class="form-actions"><button class="btn btn-primary" type="submit">Save task</button><button class="text-button" type="button" data-cancel>Add later</button></div>
      <p class="form-error" data-form-error hidden role="alert"></p>
    </form>
  </section>

  <section class="panel task-panel">
    <div class="panel-head"><div><p class="kicker">Work queue</p><h2>Open tasks</h2></div><span class="muted" data-updated>Loading…</span></div>
    <div class="tasks" data-list></div>
  </section>
</InternalLayout>

<script>
  type Task={id:number;title:string;lead_id:number|null;lead_name?:string|null;lead_phone?:string|null;lead_email?:string|null;lead_city?:string|null;due_at:string|null;status:string;notes:string|null;created_at:string};
  function initFollowUp(){
    const list=document.querySelector('[data-list]'); if(!(list instanceof HTMLElement)||list.dataset.bound==='true') return; list.dataset.bound='true';
    const addCard=document.querySelector('[data-add-card]'); const form=document.querySelector('[data-form]'); const updated=document.querySelector('[data-updated]');
    const openOut=document.querySelector('[data-open]'); const todayOut=document.querySelector('[data-today]'); const overdueOut=document.querySelector('[data-overdue]'); let tasks:Task[]=[];
    const esc=(v:unknown)=>{const d=document.createElement('div');d.textContent=String(v??'');return d.innerHTML};
    const dateLabel=(value:string|null)=>{if(!value)return 'No due date';const d=new Date(value);return Number.isNaN(d.getTime())?value:d.toLocaleString('en-US',{weekday:'short',month:'short',day:'numeric',hour:'numeric',minute:'2-digit'});};
    const isOverdue=(t:Task)=>!!t.due_at&&new Date(t.due_at).getTime()<Date.now()&&t.status==='open';
    const isToday=(t:Task)=>{if(!t.due_at||t.status!=='open')return false;const d=new Date(t.due_at),n=new Date();return d.getFullYear()===n.getFullYear()&&d.getMonth()===n.getMonth()&&d.getDate()===n.getDate();};
    function render(){
      const visible=tasks.filter(t=>t.status==='open'); if(openOut)openOut.textContent=String(visible.length); if(todayOut)todayOut.textContent=String(visible.filter(isToday).length); if(overdueOut)overdueOut.textContent=String(visible.filter(isOverdue).length);
      if(!visible.length){list.innerHTML='<div class="empty"><strong>No open follow-ups.</strong><span>Use Add task whenever there is a concrete next action.</span></div>';return;}
      list.innerHTML=visible.map(t=>{const lead=t.lead_name?`<span>${esc(t.lead_name)}${t.lead_city?` · ${esc(t.lead_city)}`:''}</span>`:'<span>Unlinked task</span>';const contact=t.lead_phone?`<a href="tel:${esc(t.lead_phone.replace(/\D/g,''))}">Call</a>`:'';return `<article class="task ${isOverdue(t)?'is-overdue':''}"><div class="task-main"><div class="task-top"><strong>${esc(t.title)}</strong><time>${esc(dateLabel(t.due_at))}</time></div><div class="task-lead">${lead}${t.lead_email?` · <a href="mailto:${esc(t.lead_email)}">${esc(t.lead_email)}</a>`:''}</div>${t.notes?`<p>${esc(t.notes)}</p>`:''}</div><div class="task-actions">${contact}<button type="button" data-done="${t.id}">Done</button></div></article>`;}).join('');
      list.querySelectorAll('[data-done]').forEach(btn=>btn.addEventListener('click',async()=>{const id=(btn as HTMLElement).dataset.done;await fetch(`/internal/api/tasks?id=${encodeURIComponent(id||'')}`,{method:'PATCH',headers:{'content-type':'application/json'},body:JSON.stringify({status:'done'})});await load();}));
    }
    async function load(){try{const r=await fetch('/internal/api/tasks',{headers:{'cache-control':'no-cache'}});if(!r.ok)throw new Error();const d=await r.json();tasks=Array.isArray(d.tasks)?d.tasks:[];render();if(updated)updated.textContent=`Updated ${new Date().toLocaleTimeString('en-US',{hour:'numeric',minute:'2-digit'})}`;}catch{list.innerHTML='<div class="empty"><strong>Could not load follow-ups.</strong><span>Try refreshing the page.</span></div>';}}
    document.querySelector('[data-add-open]')?.addEventListener('click',()=>{if(addCard instanceof HTMLElement){addCard.hidden=false;addCard.scrollIntoView({behavior:'smooth',block:'start'});} });
    document.querySelector('[data-cancel]')?.addEventListener('click',()=>{if(addCard instanceof HTMLElement)addCard.hidden=true;});
    form?.addEventListener('submit',async(e)=>{e.preventDefault();if(!(form instanceof HTMLFormElement))return;const err=document.querySelector('[data-form-error]');if(err instanceof HTMLElement)err.hidden=true;const fd=new FormData(form);const leadId=String(fd.get('leadId')||'').trim();const due=String(fd.get('dueAt')||'').trim();const payload={title:String(fd.get('title')||''),leadId:leadId||null,dueAt:due?new Date(due).toISOString():null,notes:String(fd.get('notes')||'')};try{const r=await fetch('/internal/api/tasks',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify(payload)});const d=await r.json().catch(()=>({}));if(!r.ok)throw new Error(d.error||'Could not save task.');form.reset();if(addCard instanceof HTMLElement)addCard.hidden=true;await load();}catch(x){if(err instanceof HTMLElement){err.hidden=false;err.textContent=x instanceof Error?x.message:'Could not save task.';}}});
    load();
  }
  initFollowUp();document.addEventListener('astro:page-load',initFollowUp);
</script>

<style>
  .fu-head{display:flex;justify-content:space-between;align-items:end;gap:var(--space-m);margin-bottom:var(--space-m)}.fu-actions{display:flex;gap:var(--space-xs)}.panel{border:1px solid var(--line);border-radius:var(--radius);background:var(--paper-raised);overflow:hidden}.stats{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:var(--space-s);margin-bottom:var(--space-m)}.stat{padding:var(--space-m);display:grid;gap:.25rem}.stat span{font-size:var(--step--2);color:var(--ink-soft)}.stat strong{font-size:var(--step-1)}.panel-head{padding:var(--space-m);border-bottom:1px solid var(--line);display:flex;justify-content:space-between;align-items:end;gap:var(--space-s)}.panel-head h2{margin:.12rem 0 0;font-size:var(--step-1)}.add-card{margin-bottom:var(--space-m)}.add-card form{display:grid;grid-template-columns:1.5fr .7fr .8fr;gap:var(--space-s);padding:var(--space-m)}.add-card label{display:grid;gap:.35rem;font-size:var(--step--1);font-weight:650}.add-card label:last-of-type{grid-column:1 / -1}.add-card input,.add-card textarea{border:1px solid var(--line-strong);border-radius:var(--radius);padding:.6rem;font:inherit;background:var(--paper);color:var(--ink)}.form-actions{grid-column:1/-1;display:flex;gap:var(--space-s);align-items:center}.form-error{color:var(--danger);font-size:var(--step--2)}.tasks{padding:0 var(--space-m)}.task{display:grid;grid-template-columns:1fr auto;gap:var(--space-m);padding:var(--space-m) 0;border-bottom:1px solid var(--line)}.task:last-child{border-bottom:0}.task-main{display:grid;gap:.35rem}.task-top{display:flex;justify-content:space-between;gap:var(--space-m)}.task-top time{font-size:var(--step--2);color:var(--ink-faint);white-space:nowrap}.task-lead{font-size:var(--step--1);color:var(--ink-soft)}.task p{margin:0;color:var(--ink-soft);font-size:var(--step--1)}.task-actions{display:flex;gap:.45rem;align-items:center}.task-actions button{border:1px solid var(--line);background:var(--paper);border-radius:999px;padding:.4rem .65rem;font:inherit;font-size:var(--step--2);font-weight:700;cursor:pointer}.task-actions button:hover{border-color:var(--line-strong)}.is-overdue{border-left:3px solid var(--danger);padding-left:var(--space-s)}.empty{min-height:12rem;display:grid;place-items:center;align-content:center;gap:.45rem;text-align:center;color:var(--ink-soft);padding:var(--space-l)}.empty strong{color:var(--ink)}
  @media(max-width:720px){.fu-head{align-items:flex-start;flex-direction:column}.stats{grid-template-columns:1fr}.add-card form{grid-template-columns:1fr}.add-card label:last-of-type{grid-column:auto}.form-actions{grid-column:auto}.task{grid-template-columns:1fr}.task-top{align-items:flex-start;flex-direction:column}.task-actions{justify-content:flex-start}}
</style>
