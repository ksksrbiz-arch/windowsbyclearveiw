---
import InternalLayout from '../../layouts/InternalLayout.astro';
---
<InternalLayout title="Follow-up">
  <div class="fu-head">
    <div><p class="kicker">Customer actions</p><h1>Follow-up</h1><p class="lede">Keep every promised call, email, and next step visible until it is done.</p></div>
    <div class="fu-actions"><a class="btn btn-ghost" href="/internal/leads">Leads</a><button class="btn btn-primary" type="button" data-add-open>Add follow-up</button></div>
  </div>

  <section class="fu-command" aria-label="Follow-up status">
    <div><span class="fu-command-label">WORK QUEUE</span><strong>Clear overdue work first.</strong><p>Then finish today's commitments before adding new tasks.</p></div>
    <div class="fu-command-stats"><span><b data-overdue>—</b><small>overdue</small></span><span><b data-today>—</b><small>today</small></span><span><b data-open>—</b><small>open</small></span></div>
  </section>

  <section class="stats" aria-label="Follow-up summary">
    <article class="stat"><span>Open</span><strong data-open-copy>—</strong><small>all unfinished customer actions</small></article>
    <article class="stat stat-hot"><span>Overdue</span><strong data-overdue-copy>—</strong><small>needs attention first</small></article>
    <article class="stat"><span>Due today</span><strong data-today-copy>—</strong><small>planned for today</small></article>
  </section>

  <section class="add-card" data-add-card hidden>
    <div class="panel-head"><div><p class="kicker">New follow-up</p><h2>Capture the next action</h2></div><button class="text-button" type="button" data-cancel>Cancel</button></div>
    <form data-form>
      <label>Task<input name="title" required maxlength="240" placeholder="Call customer about installation date" /></label>
      <label>Lead ID<input name="leadId" inputmode="numeric" placeholder="Optional" /></label>
      <label>Due<input name="dueAt" type="datetime-local" /></label>
      <label class="notes-field">Notes<textarea name="notes" rows="3" maxlength="4000" placeholder="What needs to happen next?"></textarea></label>
      <div class="form-actions"><button class="btn btn-primary" type="submit">Save follow-up</button></div>
      <p class="form-error" data-form-error hidden role="alert"></p>
    </form>
  </section>

  <section class="task-panel">
    <div class="panel-head"><div><p class="kicker">Action queue</p><h2>Open follow-ups</h2></div><span class="muted" data-updated>Loading…</span></div>
    <div class="tasks" data-list></div>
  </section>
</InternalLayout>

<script>
  type Task={id:number;title:string;lead_id:number|null;lead_name?:string|null;lead_phone?:string|null;lead_email?:string|null;lead_city?:string|null;due_at:string|null;status:string;notes:string|null;created_at:string};
  function initFollowUp(){
    const list=document.querySelector('[data-list]'); if(!(list instanceof HTMLElement)||list.dataset.bound==='true')return;list.dataset.bound='true';
    const addCard=document.querySelector('[data-add-card]');const form=document.querySelector('[data-form]');const updated=document.querySelector('[data-updated]');
    const openOut=document.querySelector('[data-open]');const todayOut=document.querySelector('[data-today]');const overdueOut=document.querySelector('[data-overdue]');
    const openCopy=document.querySelector('[data-open-copy]');const todayCopy=document.querySelector('[data-today-copy]');const overdueCopy=document.querySelector('[data-overdue-copy]');let tasks:Task[]=[];
    const esc=(v:unknown)=>{const d=document.createElement('div');d.textContent=String(v??'');return d.innerHTML};
    const dateLabel=(value:string|null)=>{if(!value)return 'No due date';const d=new Date(value);return Number.isNaN(d.getTime())?value:d.toLocaleString('en-US',{weekday:'short',month:'short',day:'numeric',hour:'numeric',minute:'2-digit'});};
    const isOverdue=(t:Task)=>!!t.due_at&&new Date(t.due_at).getTime()<Date.now()&&t.status==='open';
    const isToday=(t:Task)=>{if(!t.due_at||t.status!=='open')return false;const d=new Date(t.due_at),n=new Date();return d.getFullYear()===n.getFullYear()&&d.getMonth()===n.getMonth()&&d.getDate()===n.getDate();};
    function setSummary(){const open=tasks.filter(t=>t.status==='open');const today=open.filter(isToday).length;const overdue=open.filter(isOverdue).length;[openOut,openCopy].forEach(el=>{if(el)el.textContent=String(open.length)});[todayOut,todayCopy].forEach(el=>{if(el)el.textContent=String(today)});[overdueOut,overdueCopy].forEach(el=>{if(el)el.textContent=String(overdue)});}
    function render(){
      const visible=tasks.filter(t=>t.status==='open');setSummary();
      if(!visible.length){list.innerHTML='<div class="empty"><strong>No open follow-ups.</strong><span>The action queue is clear.</span></div>';return;}
      const ordered=[...visible].sort((a,b)=>Number(isOverdue(b))-Number(isOverdue(a))||Number(new Date(a.due_at||'2999-12-31'))-Number(new Date(b.due_at||'2999-12-31')));
      list.innerHTML=ordered.map(t=>{const overdue=isOverdue(t);const lead=t.lead_name?`${esc(t.lead_name)}${t.lead_city?` · ${esc(t.lead_city)}`:''}`:'Unlinked task';const contact=t.lead_phone?`<a href="tel:${esc(t.lead_phone.replace(/\D/g,''))}">Call</a>`:'';return `<article class="task ${overdue?'is-overdue':''}"><div class="task-main"><div class="task-title"><span class="task-priority">${overdue?'OVERDUE':isToday(t)?'TODAY':'UPCOMING'}</span><strong>${esc(t.title)}</strong></div><div class="task-lead">${lead}${t.lead_email?` · <a href="mailto:${esc(t.lead_email)}">${esc(t.lead_email)}</a>`:''}</div>${t.notes?`<p>${esc(t.notes)}</p>`:''}</div><div class="task-actions"><time>${esc(dateLabel(t.due_at))}</time>${contact}<button type="button" data-done="${t.id}">Done</button></div></article>`;}).join('');
      list.querySelectorAll('[data-done]').forEach(btn=>btn.addEventListener('click',async()=>{const id=(btn as HTMLElement).dataset.done;if(btn instanceof HTMLButtonElement){btn.disabled=true;btn.textContent='Saving…';}await fetch(`/internal/api/tasks?id=${encodeURIComponent(id||'')}`,{method:'PATCH',headers:{'content-type':'application/json'},body:JSON.stringify({status:'done'})});await load();}));
    }
    async function load(){try{const r=await fetch('/internal/api/tasks',{headers:{'cache-control':'no-cache'}});if(!r.ok)throw new Error();const d=await r.json();tasks=Array.isArray(d.tasks)?d.tasks:[];render();if(updated)updated.textContent=`Updated ${new Date().toLocaleTimeString('en-US',{hour:'numeric',minute:'2-digit'})}`;}catch{list.innerHTML='<div class="empty"><strong>Could not load follow-ups.</strong><span>Try refreshing the page.</span></div>';}}
    document.querySelector('[data-add-open]')?.addEventListener('click',()=>{if(addCard instanceof HTMLElement){addCard.hidden=false;addCard.scrollIntoView({behavior:'smooth',block:'start'});}});
    document.querySelector('[data-cancel]')?.addEventListener('click',()=>{if(addCard instanceof HTMLElement)addCard.hidden=true;});
    form?.addEventListener('submit',async(e)=>{e.preventDefault();if(!(form instanceof HTMLFormElement))return;const err=document.querySelector('[data-form-error]');if(err instanceof HTMLElement)err.hidden=true;const fd=new FormData(form);const leadId=String(fd.get('leadId')||'').trim();const due=String(fd.get('dueAt')||'').trim();const payload={title:String(fd.get('title')||''),leadId:leadId||null,dueAt:due?new Date(due).toISOString():null,notes:String(fd.get('notes')||'')};try{const r=await fetch('/internal/api/tasks',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify(payload)});const d=await r.json().catch(()=>({}));if(!r.ok)throw new Error(d.error||'Could not save follow-up.');form.reset();if(addCard instanceof HTMLElement)addCard.hidden=true;await load();}catch(x){if(err instanceof HTMLElement){err.hidden=false;err.textContent=x instanceof Error?x.message:'Could not save follow-up.';}}});
    load();
  }
  initFollowUp();document.addEventListener('astro:page-load',initFollowUp);
</script>

<style>
  .fu-head{display:flex;justify-content:space-between;align-items:end;gap:var(--space-m);margin-bottom:var(--space-m)}.fu-actions{display:flex;gap:.5rem;flex-wrap:wrap}
  .fu-command{display:flex;justify-content:space-between;align-items:center;gap:var(--space-m);padding:1.15rem 1.2rem;margin-bottom:.65rem;border-radius:var(--radius-lg);background:var(--ink);color:var(--on-dark);box-shadow:var(--shadow-md)}.fu-command>div:first-child{display:grid;gap:.18rem}.fu-command-label{font-size:.65rem;letter-spacing:.16em;font-weight:800;color:var(--accent-bright)}.fu-command strong{font-size:var(--step-1)}.fu-command p{margin:0;color:var(--on-dark-soft);font-size:var(--step--2)}.fu-command-stats{display:flex;gap:1.35rem}.fu-command-stats span{display:grid;gap:.1rem}.fu-command-stats b{font-size:1.5rem;line-height:1}.fu-command-stats small{font-size:.65rem;color:var(--on-dark-soft);text-transform:uppercase;letter-spacing:.08em}
  .stats{display:grid;grid-template-columns:repeat(3,1fr);gap:.65rem;margin-bottom:var(--space-l)}.stat{min-height:7.5rem;padding:1rem 1.05rem;border:1px solid var(--line);border-radius:var(--radius-lg);background:var(--paper-raised);display:grid;align-content:start;gap:.2rem;box-shadow:var(--shadow-sm)}.stat span{font-size:var(--step--2);color:var(--ink-soft);font-weight:650}.stat strong{font-size:2.1rem;line-height:1;letter-spacing:-.04em;margin:.2rem 0}.stat small{color:var(--ink-faint);font-size:var(--step--2)}.stat-hot strong{color:var(--danger)}
  .add-card,.task-panel{border:1px solid var(--line);border-radius:var(--radius-lg);background:var(--paper-raised);overflow:hidden;box-shadow:var(--shadow-sm)}.add-card{margin-bottom:var(--space-s)}.panel-head{padding:1rem 1.05rem;border-bottom:1px solid var(--line);display:flex;justify-content:space-between;align-items:end;gap:.75rem}.panel-head h2{margin:.08rem 0 0;font-size:var(--step-1)}.add-card form{display:grid;grid-template-columns:1.4fr .6fr .8fr;gap:.7rem;padding:1.05rem}.add-card label{display:grid;gap:.3rem;font-size:var(--step--1);font-weight:650}.add-card .notes-field{grid-column:1/-1}.add-card input,.add-card textarea{border:1px solid var(--line-strong);border-radius:var(--radius);padding:.65rem;font:inherit;background:var(--paper);color:var(--ink)}.form-actions{grid-column:1/-1;display:flex;gap:.5rem}.form-error{color:var(--danger);font-size:var(--step--2)}.tasks{padding:0 1.05rem}
  :global(.task){display:grid;grid-template-columns:minmax(0,1fr) auto;gap:1rem;padding:1rem 0;border-bottom:1px solid var(--line)}:global(.task:last-child){border-bottom:0}:global(.task-main){min-width:0;display:grid;gap:.3rem}:global(.task-title){display:flex;align-items:center;gap:.5rem;min-width:0}:global(.task-title strong){overflow:hidden;text-overflow:ellipsis;white-space:nowrap}:global(.task-priority){font-size:.62rem;font-weight:850;letter-spacing:.08em;white-space:nowrap;color:var(--ink-faint)}:global(.task.is-overdue .task-priority){color:var(--danger)}:global(.task-lead){font-size:var(--step--1);color:var(--ink-soft)}:global(.task-lead a){color:inherit}:global(.task p){margin:0;color:var(--ink-soft);font-size:var(--step--1)}:global(.task-actions){display:flex;align-items:center;justify-content:flex-end;gap:.45rem;flex-wrap:wrap}:global(.task-actions time){font-size:var(--step--2);color:var(--ink-faint);white-space:nowrap}:global(.task-actions a),:global(.task-actions button){min-height:2.1rem;display:inline-flex;align-items:center;padding:.35rem .62rem;border:1px solid var(--line);border-radius:999px;background:var(--paper);color:inherit;text-decoration:none;font:inherit;font-size:var(--step--2);font-weight:750;cursor:pointer}:global(.task-actions a:hover),:global(.task-actions button:hover){background:var(--accent-wash);border-color:var(--line-strong)}:global(.task.is-overdue){border-left:3px solid var(--danger);padding-left:.8rem}:global(.empty){min-height:10rem;display:grid;place-items:center;align-content:center;gap:.25rem;text-align:center;color:var(--ink-soft);padding:var(--space-m)}:global(.empty strong){color:var(--ink)}.status{margin:.75rem 0 0;color:var(--ink-faint);font-size:var(--step--2)}
  @media(max-width:760px){.fu-head{align-items:flex-start;flex-direction:column}.fu-command{align-items:flex-start;flex-direction:column}.fu-command-stats{width:100%;justify-content:space-between}.stats{grid-template-columns:1fr 1fr}.add-card form{grid-template-columns:1fr}.add-card .notes-field,.form-actions{grid-column:auto}:global(.task){grid-template-columns:1fr}:global(.task-actions){justify-content:flex-start}.panel-head{align-items:flex-start;flex-direction:column}}
  @media(max-width:480px){.stats{grid-template-columns:1fr}.fu-command-stats{gap:.8rem}.fu-command-stats b{font-size:1.3rem}}
</style>
