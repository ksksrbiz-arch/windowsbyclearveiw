---
import InternalLayout from '../../layouts/InternalLayout.astro';
---
<InternalLayout title="Payments">
  <div class="head">
    <div><p class="kicker">Closeout</p><h1>Payments & balances</h1><p class="lede">See what has been paid, what is still due, and where a collection action is needed.</p></div>
    <div class="actions"><a class="btn btn-ghost" href="/internal/jobs">Jobs</a><a class="btn btn-ghost" href="/internal/invoices">Invoices</a><button class="btn btn-ghost" type="button" data-refresh>Refresh</button></div>
  </div>

  <section class="metric-grid" aria-label="Payment snapshot">
    <article class="metric-card"><span>Quoted value</span><strong data-total>—</strong><small>Active + completed jobs</small></article>
    <article class="metric-card"><span>Recorded paid</span><strong data-paid>—</strong><small>Payment records entered</small></article>
    <article class="metric-card metric-money"><span>Outstanding</span><strong data-balance>—</strong><small>Quoted less recorded paid</small></article>
    <article class="metric-card"><span>Needs attention</span><strong data-outstanding-count>—</strong><small>Jobs with an open balance</small></article>
  </section>

  <section class="panel receivables-panel">
    <div class="panel-head">
      <div><p class="kicker">Receivables</p><h2>Job balances</h2><p class="panel-sub">Update the payment record from the same screen. Open a job when you need the full project history.</p></div>
      <div class="filters" role="group" aria-label="Payment filter"><button class="filter active" data-filter="all" type="button">All</button><button class="filter" data-filter="outstanding" type="button">Outstanding</button><button class="filter" data-filter="paid" type="button">Paid</button></div>
    </div>
    <div class="list" data-list><p class="muted">Loading payment records…</p></div>
  </section>
  <p class="note">This tracker records what your team says was paid. It does not charge cards, verify bank transfers, or replace your accounting records.</p>
</InternalLayout>

<script>
  type JobPayment={id:string;job_status:string;scheduled_date?:string|null;customer_name:string;customer_city?:string|null;total_cents?:number|null;amount_paid_cents:number;balance_cents:number;payment_status:string;payment_method?:string|null;notes?:string|null};
  function initPayments(){
    const root=document.querySelector('main'); if(!(root instanceof HTMLElement)||root.dataset.paymentBound==='true')return; root.dataset.paymentBound='true';
    const list=root.querySelector('[data-list]') as HTMLElement; const filters=Array.from(root.querySelectorAll('[data-filter]')); const refresh=root.querySelector('[data-refresh]') as HTMLButtonElement|null; let jobs:JobPayment[]=[]; let filter='all';
    const money=(c:number)=>`$${(Number(c||0)/100).toLocaleString('en-US',{maximumFractionDigits:0})}`; const esc=(v:unknown)=>{const d=document.createElement('div');d.textContent=String(v??'');return d.innerHTML;};
    const date=(v?:string|null)=>{if(!v)return'Not scheduled';const d=new Date(`${v}T12:00:00`);return Number.isNaN(d.getTime())?'Not scheduled':d.toLocaleDateString('en-US',{month:'short',day:'numeric',year:'numeric'});};
    function render(){
      const visible=filter==='all'?jobs:jobs.filter(j=>filter==='paid'?j.payment_status==='paid':j.balance_cents>0);
      filters.forEach(b=>b.classList.toggle('active',b.getAttribute('data-filter')===filter));
      if(!visible.length){list.innerHTML='<div class="empty"><strong>No jobs in this view.</strong><span>Payment records appear here as jobs are created.</span></div>';return;}
      list.innerHTML=visible.map((j,i)=>{
        const state=j.payment_status==='paid'?'Paid':j.payment_status==='partial'?'Partial':'Unpaid';
        return `<article class="payment-card" data-row="${i}">
          <div class="payment-card-head"><div><span class="pill pill-${esc(j.payment_status)}">${state}</span><a class="customer-link" href="/internal/jobs/view?id=${encodeURIComponent(j.id)}"><strong>${esc(j.customer_name)}</strong></a><small>${esc([j.customer_city,date(j.scheduled_date)].filter(Boolean).join(' · '))}</small></div><div class="balance-block"><span>Balance</span><strong>${money(j.balance_cents)}</strong></div></div>
          <div class="money-grid"><div><span>Quoted</span><strong>${money(Number(j.total_cents)||0)}</strong></div><div><span>Paid</span><strong>${money(j.amount_paid_cents)}</strong></div><div><span>Status</span><strong>${state}</strong></div></div>
          <details class="payment-editor"><summary>Update payment record</summary><div class="editor-body"><div class="field-grid"><label>Paid to date<input inputmode="decimal" data-paid-input value="${(Number(j.amount_paid_cents||0)/100).toFixed(2)}"></label><label>Method<select data-method><option value="">Not recorded</option><option>Cash</option><option>Check</option><option>Card</option><option>ACH</option><option>Other</option></select></label></div><label>Notes<textarea data-notes maxlength="4000" placeholder="Payment / reconciliation note">${esc(j.notes||'')}</textarea><div class="editor-foot"><span class="status-text" data-status-text>Ready</span><button class="btn btn-primary" type="button" data-save>Save payment record</button></div></div></details>
        </article>`;
      }).join('');
      visible.forEach((j,i)=>{const row=list.querySelector(`[data-row="${i}"]`);if(!row)return;const method=row.querySelector('[data-method]') as HTMLSelectElement|null;if(method)method.value=j.payment_method||'';const save=row.querySelector('[data-save]') as HTMLButtonElement|null;save?.addEventListener('click',()=>saveRow(j,row));});
    }
    async function saveRow(job:JobPayment,row:Element){
      const input=row.querySelector('[data-paid-input]') as HTMLInputElement|null;const method=row.querySelector('[data-method]') as HTMLSelectElement|null;const notes=row.querySelector('[data-notes]') as HTMLTextAreaElement|null;const status=row.querySelector('[data-status-text]') as HTMLElement|null;const btn=row.querySelector('[data-save]') as HTMLButtonElement|null;if(!input||!method||!notes||!btn)return;
      const dollars=Number(input.value.replace(/[$,\s]/g,''));if(!Number.isFinite(dollars)||dollars<0){if(status)status.textContent='Enter a valid amount.';return;}
      const cents=Math.round(dollars*100);btn.disabled=true;btn.textContent='Saving…';
      try{const r=await fetch(`/internal/api/payments?jobId=${encodeURIComponent(job.id)}`,{method:'PATCH',headers:{'content-type':'application/json'},body:JSON.stringify({amountPaidCents:cents,paymentMethod:method.value,notes:notes.value})});const d=await r.json().catch(()=>({}));if(!r.ok)throw new Error(d.error||'Could not save payment.');job.amount_paid_cents=d.payment.amount_paid_cents;job.balance_cents=d.payment.balance_cents;job.payment_status=d.payment.status;job.payment_method=d.payment.payment_method;job.notes=d.payment.notes;updateSummary();render();}catch(e){if(status)status.textContent=e instanceof Error?e.message:'Could not save payment.';}finally{btn.disabled=false;btn.textContent='Save payment record';}
    }
    function updateSummary(){const total=jobs.reduce((s,j)=>s+(Number(j.total_cents)||0),0);const paid=jobs.reduce((s,j)=>s+(Number(j.amount_paid_cents)||0),0);const balance=jobs.reduce((s,j)=>s+(Number(j.balance_cents)||0),0);const set=(s:string,v:string)=>{const e=root.querySelector(s);if(e)e.textContent=v;};set('[data-total]',money(total));set('[data-paid]',money(paid));set('[data-balance]',money(balance));set('[data-outstanding-count]',String(jobs.filter(j=>j.balance_cents>0).length));}
    async function load(){if(refresh){refresh.disabled=true;refresh.textContent='Refreshing…';}try{const r=await fetch('/internal/api/payments',{headers:{'cache-control':'no-cache'}});if(!r.ok)throw new Error('Could not load payment records.');const d=await r.json();jobs=Array.isArray(d.jobs)?d.jobs:[];updateSummary();render();}catch(e){list.innerHTML=`<div class="empty"><strong>Payments could not be loaded.</strong><span>${esc(e instanceof Error?e.message:'Try again.')}</span></div>`;}finally{if(refresh){refresh.disabled=false;refresh.textContent='Refresh';}}}
    filters.forEach(b=>b.addEventListener('click',()=>{filter=b.getAttribute('data-filter')||'all';render();}));refresh?.addEventListener('click',load);load();
  }
  initPayments();document.addEventListener('astro:page-load',initPayments);
</script>

<style>
  .head{display:flex;justify-content:space-between;align-items:end;gap:var(--space-m);margin-bottom:var(--space-l)}.actions{display:flex;gap:var(--space-xs);flex-wrap:wrap}
  .metric-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:var(--space-s);margin-bottom:var(--space-l)}.metric-card{border:1px solid var(--line);border-radius:var(--radius-lg);padding:var(--space-m);display:grid;gap:.35rem;background:var(--paper-raised);min-height:8.8rem;align-content:space-between;box-shadow:var(--shadow-sm)}.metric-card strong{font-size:clamp(1.65rem,3vw,2.35rem);line-height:1;letter-spacing:-.03em}.metric-card span,.metric-card small{color:var(--ink-soft);font-size:var(--step--2)}.metric-money{background:var(--ink);color:var(--on-dark);border-color:var(--ink)}.metric-money span,.metric-money small{color:var(--on-dark-soft)}
  .panel{border:1px solid var(--line);border-radius:var(--radius-lg);background:var(--paper-raised);overflow:hidden;box-shadow:var(--shadow-sm)}.panel-head{padding:var(--space-m);border-bottom:1px solid var(--line);display:flex;justify-content:space-between;align-items:end;gap:var(--space-m)}.panel-head h2{margin:.12rem 0 .25rem;font-size:var(--step-1)}.panel-sub{margin:0;color:var(--ink-soft);font-size:var(--step--2);max-width:55ch}.filters{display:flex;gap:.35rem;flex:0 0 auto}.filter{border:1px solid var(--line);border-radius:999px;background:var(--paper);padding:.48rem .75rem;font:inherit;font-size:var(--step--2);font-weight:700;cursor:pointer;min-height:2.55rem;white-space:nowrap}.filter.active{background:var(--ink);color:var(--on-dark);border-color:var(--ink)}
  .list{display:grid}:global(.payment-card){padding:var(--space-m);border-bottom:1px solid var(--line)}:global(.payment-card:last-child){border-bottom:0}:global(.payment-card-head){display:flex;justify-content:space-between;gap:var(--space-m);align-items:start}:global(.payment-card-head>div:first-child){display:grid;gap:.18rem}:global(.customer-link){color:inherit;text-decoration:none;margin-top:.12rem}:global(.customer-link:hover){text-decoration:underline}:global(.payment-card-head small){font-size:var(--step--2);color:var(--ink-soft)}:global(.pill){justify-self:start;border-radius:999px;border:1px solid var(--line);padding:.34rem .55rem;font-size:.7rem;font-weight:800;text-transform:capitalize;min-height:2.1rem;display:inline-flex;align-items:center;background:var(--paper)}:global(.pill-paid){background:var(--accent-wash);border-color:color-mix(in srgb,var(--accent) 30%,var(--line))}:global(.pill-partial){background:color-mix(in srgb,var(--ink) 7%,transparent)}:global(.balance-block){display:grid;gap:.15rem;text-align:right}:global(.balance-block span),:global(.money-grid span){font-size:.67rem;color:var(--ink-faint);text-transform:uppercase;letter-spacing:.06em}:global(.balance-block strong){font-size:var(--step-2);letter-spacing:-.02em}
  .money-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:var(--space-s);margin-top:var(--space-s);padding-top:var(--space-s);border-top:1px solid var(--line)}.money-grid>div{display:grid;gap:.18rem}.money-grid strong{font-size:var(--step-0)}
  :global(.payment-editor){margin-top:var(--space-s);border-top:1px dashed var(--line);padding-top:.7rem}:global(.payment-editor summary){cursor:pointer;font-size:var(--step--1);font-weight:700;color:var(--ink-soft);padding:.35rem 0}:global(.editor-body){display:grid;gap:var(--space-s);padding-top:var(--space-xs)}.field-grid{display:grid;grid-template-columns:1fr 1fr;gap:var(--space-s)}.field-grid label,.editor-body>label{display:grid;gap:.35rem;font-size:var(--step--2);font-weight:700}.field-grid input,.field-grid select,.editor-body textarea{border:1px solid var(--line-strong);border-radius:var(--radius);background:var(--paper);color:var(--ink);padding:.68rem;font:inherit;width:100%;min-height:2.9rem}.editor-body textarea{min-height:4.5rem;resize:vertical}.editor-foot{display:flex;justify-content:space-between;align-items:center;gap:var(--space-s)}.status-text{font-size:var(--step--2);color:var(--ink-faint)}.btn-small{padding:.55rem .8rem}.empty{min-height:12rem;display:grid;place-items:center;align-content:center;gap:.4rem;color:var(--ink-soft);padding:var(--space-l);text-align:center}.empty strong{color:var(--ink)}.note{margin-top:var(--space-s);color:var(--ink-faint);font-size:var(--step--2)}
  @media(max-width:850px){.metric-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.panel-head{align-items:flex-start;flex-direction:column}.filters{width:100%}.filter{flex:1}}
  @media(max-width:620px){.head{align-items:flex-start;flex-direction:column}.actions{width:100%}.actions .btn{flex:1}.metric-grid{grid-template-columns:1fr 1fr}.payment-card{padding:.95rem .8rem}.payment-card-head{gap:.7rem}.balance-block strong{font-size:var(--step-1)}.money-grid{grid-template-columns:1fr 1fr}.money-grid>div:last-child{grid-column:1/-1}.field-grid{grid-template-columns:1fr}.editor-foot{align-items:flex-start;flex-direction:column}.editor-foot .btn{width:100%}}
  @media(max-width:420px){.actions{display:grid;grid-template-columns:1fr 1fr}.actions .btn:last-child{grid-column:1/-1}.metric-grid{grid-template-columns:1fr}.panel-head{padding:.9rem}.payment-card{padding:.8rem .7rem}.money-grid{grid-template-columns:1fr}.money-grid>div:last-child{grid-column:auto}}
</style>
