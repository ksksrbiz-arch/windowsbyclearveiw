---
import InternalLayout from '../../layouts/InternalLayout.astro';
---
<InternalLayout title="Payments">
  <div class="head">
    <div><p class="kicker">Closeout</p><h1>Payments & balances</h1><p class="lede">Track what has been paid against each job without pretending this is a payment processor.</p></div>
    <div class="actions"><a class="btn btn-ghost" href="/internal/jobs">Jobs</a><button class="btn btn-ghost" type="button" data-refresh>Refresh</button></div>
  </div>

  <section class="metric-grid" aria-label="Payment snapshot">
    <article class="metric-card"><span>Quoted value</span><strong data-total>—</strong><small>All active and completed jobs</small></article>
    <article class="metric-card"><span>Recorded paid</span><strong data-paid>—</strong><small>Internal payment records</small></article>
    <article class="metric-card metric-money"><span>Outstanding</span><strong data-balance>—</strong><small>Quoted less recorded paid</small></article>
    <article class="metric-card"><span>Jobs with balance</span><strong data-outstanding-count>—</strong><small>Needs collection / reconciliation</small></article>
  </section>

  <section class="panel">
    <div class="panel-head"><div><p class="kicker">Receivables</p><h2>Job balances</h2></div><div class="filters" role="group" aria-label="Payment filter"><button class="filter active" data-filter="all" type="button">All</button><button class="filter" data-filter="outstanding" type="button">Outstanding</button><button class="filter" data-filter="paid" type="button">Paid</button></div></div>
    <div class="list" data-list><p class="muted">Loading payment records…</p></div>
  </section>
  <p class="note">This tracker records what your team says was paid. It does not charge cards, verify bank transfers, or replace your accounting records.</p>
</InternalLayout>

<script>
  type JobPayment={id:string;job_status:string;scheduled_date?:string|null;customer_name:string;customer_city?:string|null;total_cents?:number|null;amount_paid_cents:number;balance_cents:number;payment_status:string;payment_method?:string|null;notes?:string|null};
  function initPayments(){
    const root=document.querySelector('main'); if(!(root instanceof HTMLElement)||root.dataset.paymentBound==='true')return; root.dataset.paymentBound='true';
    const list=root.querySelector('[data-list]') as HTMLElement; const filters=Array.from(root.querySelectorAll('[data-filter]')); const refresh=root.querySelector('[data-refresh]') as HTMLButtonElement|null; let jobs:JobPayment[]=[]; let filter='all';
    const money=(c:number)=>`$${(Number(c||0)/100).toLocaleString('en-US',{maximumFractionDigits:0})}`; const esc=(v:unknown)=>{const d=document.createElement('div');d.textContent=String(v??'');return d.innerHTML;};
    const date=(v?:string|null)=>v?new Date(`${v}T12:00:00`).toLocaleDateString('en-US',{month:'short',day:'numeric',year:'numeric'}):'Not scheduled';
    function render(){
      const visible=filter==='all'?jobs:jobs.filter(j=>filter==='paid'?j.payment_status==='paid':j.balance_cents>0);
      filters.forEach(b=>b.classList.toggle('active',b.getAttribute('data-filter')===filter));
      if(!visible.length){list.innerHTML='<div class="empty"><strong>No jobs in this view.</strong><span>Payment records appear here as jobs are created.</span></div>';return;}
      list.innerHTML=visible.map((j,i)=>`<article class="payment-row" data-row="${i}"><div class="job"><span class="pill pill-${esc(j.payment_status)}">${j.payment_status==='paid'?'Paid':j.payment_status==='partial'?'Partial':'Unpaid'}</span><strong>${esc(j.customer_name)}</strong><small>${esc([j.customer_city,date(j.scheduled_date),j.id].filter(Boolean).join(' · '))}</small></div><div class="money"><span>Quoted</span><strong>${money(Number(j.total_cents)||0)}</strong></div><div class="money"><span>Paid</span><strong>${money(j.amount_paid_cents)}</strong></div><div class="money balance"><span>Balance</span><strong>${money(j.balance_cents)}</strong></div><div class="editor"><div class="field-grid"><label>Paid to date<input inputmode="decimal" data-paid-input value="${(Number(j.amount_paid_cents||0)/100).toFixed(2)}"></label><label>Method<select data-method><option value="">Not recorded</option><option>Cash</option><option>Check</option><option>Card</option><option>ACH</option><option>Other</option></select></label></div><textarea data-notes maxlength="4000" placeholder="Payment / reconciliation note">${esc(j.notes||'')}</textarea><div class="editor-foot"><span class="status-text" data-status-text>Ready</span><button class="btn btn-primary btn-small" type="button" data-save>Save payment record</button></div></div></article>`).join('');
      visible.forEach((j,i)=>{const row=list.querySelector(`[data-row="${i}"]`);if(!row)return; const method=row.querySelector('[data-method]') as HTMLSelectElement|null;if(method)method.value=j.payment_method||'';const save=row.querySelector('[data-save]') as HTMLButtonElement|null;save?.addEventListener('click',()=>saveRow(j,row));});
    }
    async function saveRow(job:JobPayment,row:Element){
      const input=row.querySelector('[data-paid-input]') as HTMLInputElement|null; const method=row.querySelector('[data-method]') as HTMLSelectElement|null; const notes=row.querySelector('[data-notes]') as HTMLTextAreaElement|null; const status=row.querySelector('[data-status-text]') as HTMLElement|null; const btn=row.querySelector('[data-save]') as HTMLButtonElement|null; if(!input||!method||!notes||!btn)return;
      const dollars=Number(input.value.replace(/[$,\s]/g,'')); if(!Number.isFinite(dollars)||dollars<0){if(status)status.textContent='Enter a valid amount.';return;}
      const cents=Math.round(dollars*100); btn.disabled=true; btn.textContent='Saving…';
      try{const r=await fetch(`/internal/api/payments?jobId=${encodeURIComponent(job.id)}`,{method:'PATCH',headers:{'content-type':'application/json'},body:JSON.stringify({amountPaidCents:cents,paymentMethod:method.value,notes:notes.value})});const d=await r.json().catch(()=>({}));if(!r.ok)throw new Error(d.error||'Could not save payment.');job.amount_paid_cents=d.payment.amount_paid_cents;job.balance_cents=d.payment.balance_cents;job.payment_status=d.payment.status;job.payment_method=d.payment.payment_method;job.notes=d.payment.notes;updateSummary();render();}catch(e){if(status)status.textContent=e instanceof Error?e.message:'Could not save payment.';}finally{btn.disabled=false;btn.textContent='Save payment record';}
    }
    function updateSummary(){const total=jobs.reduce((s,j)=>s+(Number(j.total_cents)||0),0);const paid=jobs.reduce((s,j)=>s+(Number(j.amount_paid_cents)||0),0);const balance=jobs.reduce((s,j)=>s+(Number(j.balance_cents)||0),0);const set=(s:string,v:string)=>{const e=root.querySelector(s);if(e)e.textContent=v;};set('[data-total]',money(total));set('[data-paid]',money(paid));set('[data-balance]',money(balance));set('[data-outstanding-count]',String(jobs.filter(j=>j.balance_cents>0).length));}
    async function load(){if(refresh){refresh.disabled=true;refresh.textContent='Refreshing…';}try{const r=await fetch('/internal/api/payments',{headers:{'cache-control':'no-cache'}});if(!r.ok)throw new Error('Could not load payment records.');const d=await r.json();jobs=Array.isArray(d.jobs)?d.jobs:[];updateSummary();render();}catch(e){list.innerHTML=`<div class="empty"><strong>Payments could not be loaded.</strong><span>${esc(e instanceof Error?e.message:'Try again.')}</span></div>`;}finally{if(refresh){refresh.disabled=false;refresh.textContent='Refresh';}}}
    filters.forEach(b=>b.addEventListener('click',()=>{filter=b.getAttribute('data-filter')||'all';render();})); refresh?.addEventListener('click',load); load();
  }
  initPayments(); document.addEventListener('astro:page-load',initPayments);
</script>

<style>
  .head{display:flex;justify-content:space-between;align-items:end;gap:var(--space-m);margin-bottom:var(--space-m)}.actions{display:flex;gap:var(--space-xs);flex-wrap:wrap}.metric-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:var(--space-s);margin-bottom:var(--space-l)}.metric-card{border:1px solid var(--line);border-radius:var(--radius);padding:var(--space-m);display:grid;gap:.35rem;background:var(--paper-raised)}.metric-card strong{font-size:clamp(1.6rem,3vw,2.25rem);line-height:1}.metric-card span,.metric-card small{color:var(--ink-soft);font-size:var(--step--2)}.metric-money{background:var(--ink);color:var(--on-dark);border-color:var(--ink)}.metric-money span,.metric-money small{color:var(--on-dark-soft)}.panel{border:1px solid var(--line);border-radius:var(--radius);background:var(--paper-raised);overflow:hidden}.panel-head{padding:var(--space-m);border-bottom:1px solid var(--line);display:flex;justify-content:space-between;align-items:end;gap:var(--space-s)}.panel-head h2{margin:.12rem 0 0;font-size:var(--step-1)}.filters{display:flex;gap:.35rem}.filter{border:1px solid var(--line);border-radius:999px;background:var(--paper);padding:.4rem .65rem;font:inherit;font-size:var(--step--2);cursor:pointer}.filter.active{background:var(--ink);color:var(--on-dark);border-color:var(--ink)}.list{display:grid}.payment-row{display:grid;grid-template-columns:minmax(15rem,1.5fr) repeat(3,minmax(6rem,.7fr));gap:var(--space-s);padding:var(--space-m);border-bottom:1px solid var(--line);align-items:start}.payment-row:last-child{border-bottom:0}.job{display:grid;gap:.22rem}.job small{color:var(--ink-soft);font-size:var(--step--2)}.pill{justify-self:start;border-radius:999px;border:1px solid var(--line);padding:.28rem .5rem;font-size:.7rem;font-weight:750;text-transform:capitalize}.pill-paid{background:color-mix(in srgb,var(--accent) 12%,transparent);border-color:color-mix(in srgb,var(--accent) 30%,var(--line))}.pill-partial{background:color-mix(in srgb,var(--ink) 8%,transparent)}.money{display:grid;gap:.15rem;text-align:right}.money span{font-size:.68rem;color:var(--ink-faint);text-transform:uppercase;letter-spacing:.06em}.money strong{font-size:var(--step-0)}.balance strong{font-size:var(--step-1)}.editor{grid-column:1/-1;border-top:1px dashed var(--line);padding-top:var(--space-s);display:grid;gap:var(--space-s)}.field-grid{display:grid;grid-template-columns:1fr 1fr;gap:var(--space-s)}.field-grid label{display:grid;gap:.35rem;font-size:var(--step--2);font-weight:650}.field-grid input,.field-grid select,.editor textarea{border:1px solid var(--line-strong);border-radius:var(--radius);background:var(--paper);color:var(--ink);padding:.6rem;font:inherit;width:100%}.editor textarea{min-height:4.5rem;resize:vertical}.editor-foot{display:flex;justify-content:space-between;align-items:center;gap:var(--space-s)}.status-text{font-size:var(--step--2);color:var(--ink-faint)}.btn-small{padding:.5rem .75rem}.empty{min-height:12rem;display:grid;place-items:center;align-content:center;gap:.4rem;color:var(--ink-soft);padding:var(--space-l);text-align:center}.empty strong{color:var(--ink)}.note{margin-top:var(--space-s);color:var(--ink-faint);font-size:var(--step--2)}
  @media(max-width:900px){.metric-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.payment-row{grid-template-columns:1fr 1fr}.job{grid-column:1/-1}.money{text-align:left}.editor{grid-column:1/-1}}@media(max-width:560px){.head{align-items:flex-start;flex-direction:column}.metric-grid{grid-template-columns:1fr}.panel-head{align-items:flex-start;flex-direction:column}.filters{width:100%}.filter{flex:1}.payment-row{grid-template-columns:1fr}.job{grid-column:auto}.editor{grid-column:auto}.field-grid{grid-template-columns:1fr}.editor-foot{align-items:flex-start;flex-direction:column}}
</style>
