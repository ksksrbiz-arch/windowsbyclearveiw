---
import InternalLayout from '../../layouts/InternalLayout.astro';
---
<InternalLayout title="Schedule">
  <div class="head">
    <div><p class="kicker">Operations</p><h1>Schedule</h1><p class="lede">See this week’s installation commitments at a glance. Open a job for the full workspace.</p></div>
    <div class="actions"><a class="btn btn-ghost" href="/internal/jobs">Jobs</a><button class="btn btn-ghost" type="button" data-refresh>Refresh</button></div>
  </div>
  <section class="week-nav panel"><button type="button" class="nav-btn" data-prev aria-label="Previous week">←</button><div><strong data-range>Loading…</strong><small data-range-note>Monday–Sunday</small></div><button type="button" class="nav-btn" data-next aria-label="Next week">→</button><button type="button" class="today-btn" data-today>Today</button></section>
  <section class="calendar panel"><div class="calendar-grid" data-grid></div><div class="empty" data-empty hidden><strong>No installations scheduled this week.</strong><span>Schedule a job from its workspace.</span><a class="btn btn-primary" href="/internal/jobs">Open jobs</a></div></section>
  <p class="status" data-status role="status">Loading schedule…</p>
</InternalLayout>

<script>
  import { businessCalendarDate, scheduleWeek } from '../../lib/schedule-week';
  type Job={id:string;status:string;scheduled_date:string|null;scheduled_window:string|null;customer_name:string;customer_city:string|null;customer_phone:string|null;total_cents:number|null};
  function initSchedule(){
    const grid=document.querySelector('[data-grid]');if(!(grid instanceof HTMLElement)||grid.dataset.bound==='true')return;grid.dataset.bound='true';
    const range=document.querySelector('[data-range]');const status=document.querySelector('[data-status]');const empty=document.querySelector('[data-empty]');let jobs:Job[]=[];let anchor=businessCalendarDate();let pending:AbortController|null=null;
    const dayKey=(d:Date)=>d.toISOString().slice(0,10);const esc=(v:unknown)=>{const x=document.createElement('div');x.textContent=String(v??'');return x.innerHTML.replace(/"/g,'&quot;').replace(/'/g,'&#39;');};const label=(d:Date)=>d.toLocaleDateString('en-US',{timeZone:'UTC',weekday:'short',month:'short',day:'numeric'});
    function render(){
      const days=scheduleWeek(anchor);
      if(range)range.textContent=`${days[0].toLocaleDateString('en-US',{timeZone:'UTC',month:'short',day:'numeric'})} – ${days[6].toLocaleDateString('en-US',{timeZone:'UTC',month:'short',day:'numeric',year:'numeric'})}`;
      grid.innerHTML='';let any=false;
      for(const d of days){
        const key=dayKey(d);const scheduled=jobs.filter(j=>j.scheduled_date===key&&j.status!=='cancelled');if(scheduled.length)any=true;
        const col=document.createElement('section');col.className='day';col.innerHTML=`<header><strong>${esc(label(d))}</strong><span>${scheduled.length?`${scheduled.length} job${scheduled.length===1?'':'s'}`:'Open'}</span></header>`;
        if(!scheduled.length)col.innerHTML+='<p class="none">No installation scheduled</p>';
        else scheduled.forEach(job=>{const card=document.createElement('a');card.className='job';card.href=`/internal/jobs/view?id=${encodeURIComponent(job.id)}`;card.innerHTML=`<span class="job-time">${esc(job.scheduled_window||'Time not set')}</span><strong>${esc(job.customer_name)}</strong><small>${esc(job.customer_city||'')}</small><span class="job-status">${esc(job.status==='in-progress'?'In progress':job.status)}</span>`;col.append(card);});
        grid.append(col);
      }
      if(empty instanceof HTMLElement)empty.hidden=any;if(status)status.textContent=`Updated ${new Date().toLocaleTimeString('en-US',{hour:'numeric',minute:'2-digit'})}`;
    }
    async function load(){
      pending?.abort();const request=new AbortController();pending=request;
      const refresh=document.querySelector('[data-refresh]') as HTMLButtonElement|null;
      if(refresh){refresh.disabled=true;refresh.textContent='Refreshing…';}
      if(empty instanceof HTMLElement)empty.hidden=true;
      grid.innerHTML='<p class="none">Loading selected week…</p>';
      const days=scheduleWeek(anchor),end=new Date(days[6]);end.setUTCDate(end.getUTCDate()+1);
      if(range)range.textContent=`${label(days[0])} – ${label(days[6])}`;
      if(status)status.textContent='Loading schedule…';
      try{
        const records:Job[]=[];let page=1,totalPages=1;
        do{
          const params=new URLSearchParams({from:dayKey(days[0]),to:dayKey(end),page:String(page)});
          const r=await fetch(`/internal/api/jobs?${params}`,{signal:request.signal,headers:{'cache-control':'no-cache'}});
          const d=await r.json();if(!r.ok)throw new Error(d.error||'Could not load the installation schedule.');if(pending!==request)return;
          records.push(...(Array.isArray(d.jobs)?d.jobs:[]));totalPages=d.totalPages||1;page++;
        }while(page<=totalPages);
        jobs=records;render();
      }catch(error){if(pending!==request||request.signal.aborted)return;grid.innerHTML='';if(status)status.textContent=error instanceof Error?error.message:'Could not load the installation schedule. Use Refresh to try again.';}
      finally{if(pending===request&&refresh){refresh.disabled=false;refresh.textContent='Refresh';}}
    }
    document.querySelector('[data-prev]')?.addEventListener('click',()=>{anchor.setUTCDate(anchor.getUTCDate()-7);load();});
    document.querySelector('[data-next]')?.addEventListener('click',()=>{anchor.setUTCDate(anchor.getUTCDate()+7);load();});
    document.querySelector('[data-today]')?.addEventListener('click',()=>{anchor=businessCalendarDate();load();});
    document.querySelector('[data-refresh]')?.addEventListener('click',load);load();
  }
  initSchedule();document.addEventListener('astro:page-load',initSchedule);
</script>
<style>
  .head{display:flex;justify-content:space-between;align-items:end;gap:var(--space-m);margin-bottom:var(--space-m)}.actions{display:flex;gap:var(--space-xs)}.panel{border:1px solid var(--line);border-radius:var(--radius-lg);background:var(--paper-raised);overflow:hidden;box-shadow:var(--shadow-sm)}.week-nav{display:grid;grid-template-columns:auto 1fr auto auto;gap:.6rem;align-items:center;padding:var(--space-s);margin-bottom:var(--space-s)}.week-nav>div{display:grid;gap:.15rem}.week-nav small{color:var(--ink-faint);font-size:var(--step--2)}.nav-btn,.today-btn{border:1px solid var(--line);background:var(--paper);border-radius:var(--radius);padding:.6rem .75rem;min-height:2.65rem;font:inherit;cursor:pointer}.nav-btn:hover,.today-btn:hover{border-color:var(--line-strong)}.calendar{overflow:hidden}.calendar-grid{display:grid;grid-template-columns:repeat(7,minmax(0,1fr))}:global(.day){min-height:19rem;border-right:1px solid var(--line);padding:.75rem;background:var(--paper-raised)}:global(.day:last-child){border-right:0}:global(.day header){display:flex;justify-content:space-between;align-items:baseline;gap:.4rem;padding-bottom:.7rem;border-bottom:1px solid var(--line);font-size:var(--step--1)}:global(.day header span){color:var(--ink-faint);font-size:.7rem}:global(.none){color:var(--ink-faint);font-size:var(--step--2);text-align:center;margin-top:1.6rem}:global(.job){display:grid;gap:.25rem;margin-top:.65rem;padding:.78rem;border:1px solid var(--line);border-radius:var(--radius-lg);text-decoration:none;color:inherit;background:var(--paper);box-shadow:var(--shadow-sm)}:global(.job:hover){border-color:color-mix(in srgb,var(--accent) 40%,var(--line));background:var(--accent-wash)}:global(.job-time){font-size:.7rem;color:var(--accent-ink);font-weight:800}:global(.job small){color:var(--ink-soft);font-size:var(--step--2)}:global(.job-status){justify-self:start;margin-top:.1rem;padding:.22rem .45rem;border-radius:999px;background:var(--paper-raised);border:1px solid var(--line);font-size:.65rem;text-transform:capitalize;font-weight:750}.empty{padding:var(--space-l);text-align:center;display:grid;place-items:center;gap:.45rem;color:var(--ink-soft)}.empty strong{color:var(--ink)}.status{margin-top:var(--space-s);color:var(--ink-faint);font-size:var(--step--2)}
  @media(max-width:820px){.head{align-items:flex-start;flex-direction:column}.actions{width:100%}.actions .btn{flex:1}.week-nav{grid-template-columns:auto 1fr auto}.today-btn{grid-column:2;justify-self:start}.calendar-grid{grid-template-columns:1fr}:global(.day){min-height:auto;border-right:0;border-bottom:1px solid var(--line);padding:1rem}:global(.day:last-child){border-bottom:0}:global(.day header){padding-bottom:.55rem}:global(.job){margin-top:.55rem;padding:.85rem}:global(.none){margin:.8rem 0;color:var(--ink-faint);text-align:left}:global(.job-status){font-size:.62rem}}
  @media(max-width:520px){.week-nav{grid-template-columns:2.75rem 1fr 2.75rem;gap:.45rem}.nav-btn,.today-btn{width:100%}.today-btn{grid-column:1/-1}.actions{display:grid;grid-template-columns:1fr 1fr}.actions .btn:last-child{grid-column:1/-1}}
</style>
