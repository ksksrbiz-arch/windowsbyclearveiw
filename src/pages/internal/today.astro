---
import InternalLayout from '../../layouts/InternalLayout.astro';
---
<InternalLayout title="Today">
  <div class="today-head">
    <div><p class="kicker">Daily operations</p><h1>Today</h1><p class="lede">Your next customer actions and scheduled work, in the order that matters.</p></div>
    <div class="head-actions"><a class="btn btn-ghost" href="/internal/">Dashboard</a><a class="btn btn-primary" href="/internal/follow-up">Add follow-up</a></div>
  </div>

  <section class="today-command" aria-label="Today's command summary">
    <div class="command-copy"><span class="command-label">FIELD MODE</span><strong>Work the red items first.</strong><p>Overdue follow-ups, today's commitments, then the next scheduled job.</p></div>
    <div class="command-stats">
      <span><b data-overdue>—</b><small>overdue</small></span>
      <span><b data-today>—</b><small>due today</small></span>
      <span><b data-jobs>—</b><small>active jobs</small></span>
    </div>
  </section>

  <section class="summary-grid" aria-label="Today's workload">
    <article class="summary-card"><span>Open follow-ups</span><strong data-open>—</strong><a href="/internal/follow-up">Work queue →</a></article>
    <article class="summary-card summary-hot"><span>Overdue</span><strong data-overdue-copy>—</strong><a href="/internal/follow-up">Clear overdue →</a></article>
    <article class="summary-card"><span>Due today</span><strong data-today-copy>—</strong><a href="/internal/follow-up">View today's work →</a></article>
    <article class="summary-card summary-dark"><span>Active jobs</span><strong data-jobs-copy>—</strong><a href="/internal/jobs">Open job board →</a></article>
  </section>

  <div class="work-grid">
    <section class="work-panel priority-work">
      <div class="panel-head"><div><p class="kicker">Customer work</p><h2>Next follow-ups</h2></div><a href="/internal/follow-up">See all →</a></div>
      <div class="list" data-tasks><p class="muted">Loading…</p></div>
    </section>
    <section class="work-panel">
      <div class="panel-head"><div><p class="kicker">Field work</p><h2>Upcoming jobs</h2></div><a href="/internal/jobs">See all →</a></div>
      <div class="list" data-jobs-list><p class="muted">Loading…</p></div>
    </section>
  </div>

  <section class="flow-panel">
    <div class="flow-intro"><p class="kicker">Workflow</p><h2>Keep the day moving</h2><p>Use the shortest path from inquiry to installed job.</p></div>
    <div class="flow">
      <a href="/internal/leads"><span>01</span><strong>Review leads</strong><small>Respond before the lead goes cold.</small></a>
      <a href="/internal/follow-up"><span>02</span><strong>Clear actions</strong><small>Finish calls, emails, and customer commitments.</small></a>
      <a href="/internal/quotes"><span>03</span><strong>Move quotes</strong><small>Finish drafts, finalize agreements, generate invoices.</small></a>
      <a href="/internal/jobs"><span>04</span><strong>Prep jobs</strong><small>Confirm dates, notes, photos, and materials.</small></a>
    </div>
  </section>

  <p class="status" data-status role="status">Loading daily operations…</p>
</InternalLayout>

<script>
  type Task={id:number;title:string;lead_id:number|null;lead_name?:string|null;lead_phone?:string|null;lead_city?:string|null;due_at:string|null;status:string;notes:string|null};
  type Job={id:string;status:string;scheduled_date:string|null;scheduled_window:string|null;customer_name:string;customer_city:string|null;total_cents:number|null};
  function initToday(){
    const root=document.querySelector('main'); if(!(root instanceof HTMLElement)||root.dataset.bound==='true')return; root.dataset.bound='true';
    function q<T extends Element>(s:string){return root.querySelector(s) as T|null};
    const esc=(v:unknown)=>{const d=document.createElement('div');d.textContent=String(v??'');return d.innerHTML};
    const date=(v:string|null)=>{if(!v)return 'No due date';const d=new Date(v);return Number.isNaN(d.getTime())?v:d.toLocaleString('en-US',{weekday:'short',month:'short',day:'numeric',hour:'numeric',minute:'2-digit'})};
    const jobDate=(v:string|null)=>{if(!v)return 'Not scheduled';const d=new Date(`${v}T12:00:00`);return Number.isNaN(d.getTime())?v:d.toLocaleDateString('en-US',{weekday:'short',month:'short',day:'numeric'})};
    const money=(c:number|null)=>`$${(Number(c||0)/100).toLocaleString('en-US',{maximumFractionDigits:0})}`;
    function dueClass(v:string|null){if(!v)return '';const d=new Date(v).getTime();return Number.isFinite(d)&&d<Date.now()?' overdue':''}
    function set(s:string,v:string){const el=q(s);if(el)el.textContent=v;}
    async function load(){
      try{
        const r=await fetch('/internal/api/dashboard',{headers:{'cache-control':'no-cache'}}); const d=await r.json(); if(!r.ok)throw new Error();
        const c=d.counts||{}, tasks=(d.tasks||[]) as Task[], jobs=(d.recentJobs||[]) as Job[];
        const open=Number(c.open_tasks)||0,today=Number(c.tasks_today)||0,overdue=Number(c.tasks_overdue)||0;
        set('[data-open]',String(open));set('[data-today]',String(today));set('[data-overdue]',String(overdue));set('[data-jobs]',String(jobs.length));set('[data-overdue-copy]',String(overdue));set('[data-today-copy]',String(today));set('[data-jobs-copy]',String(jobs.length));
        const taskHost=q('[data-tasks');
        if(taskHost)taskHost.innerHTML=tasks.length?tasks.map(t=>`<article class="today-task${dueClass(t.due_at)}"><div class="today-task-main"><strong>${esc(t.title)}</strong><small>${esc(t.lead_name||'Unlinked task')}${t.lead_city?` · ${esc(t.lead_city)}`:''}</small></div><div class="today-task-meta"><time>${esc(date(t.due_at))}</time>${t.lead_phone?`<a href="tel:${esc(t.lead_phone.replace(/\D/g,''))}">Call</a>`:''}<button type="button" data-done="${t.id}">Done</button></div></article>`).join(''):'<div class="empty"><strong>No open follow-ups.</strong><span>The queue is clear.</span></div>';
        taskHost?.querySelectorAll('[data-done]').forEach(b=>b.addEventListener('click',async()=>{const id=(b as HTMLElement).dataset.done||'';await fetch(`/internal/api/tasks?id=${encodeURIComponent(id)}`,{method:'PATCH',headers:{'content-type':'application/json'},body:JSON.stringify({status:'done'})});load();}));
        const jobHost=q('[data-jobs-list]');if(jobHost)jobHost.innerHTML=jobs.length?jobs.map(j=>`<a class="today-job" href="/internal/jobs/view?id=${encodeURIComponent(j.id)}"><span class="job-status job-${esc(j.status)}">${esc(j.status.replace('-',' '))}</span><span class="today-job-main"><strong>${esc(j.customer_name)}</strong><small>${esc([j.customer_city,j.scheduled_window].filter(Boolean).join(' · ')||'Schedule details not set')}</small></span><span class="today-job-meta"><strong>${esc(jobDate(j.scheduled_date))}</strong><small>${money(j.total_cents)}</small></span><span class="today-arrow">→</span></a>`).join(''):'<div class="empty"><strong>No active jobs.</strong><span>Nothing is scheduled yet.</span></div>';
        const s=q('[data-status]');if(s)s.textContent=`Updated ${new Date().toLocaleTimeString('en-US',{hour:'numeric',minute:'2-digit'})}`;
      }catch{const s=q('[data-status]');if(s)s.textContent='Could not load today’s operations.';}
    }
    load();
  }
  initToday();document.addEventListener('astro:page-load',initToday);
</script>

<style>
  .today-head{display:flex;justify-content:space-between;align-items:end;gap:var(--space-m);margin-bottom:var(--space-m)}.head-actions{display:flex;gap:.5rem;flex-wrap:wrap}
  .today-command{display:flex;justify-content:space-between;align-items:center;gap:var(--space-m);margin-bottom:var(--space-s);padding:1.1rem 1.2rem;background:var(--ink);color:var(--on-dark);border-radius:var(--radius-lg);box-shadow:var(--shadow-md)}.command-copy{display:grid;gap:.2rem}.command-label{font-size:.66rem;letter-spacing:.16em;font-weight:800;color:var(--accent-bright)}.command-copy strong{font-size:var(--step-1)}.command-copy p{margin:0;color:var(--on-dark-soft);font-size:var(--step--2)}.command-stats{display:flex;gap:1.25rem}.command-stats span{display:grid;gap:.08rem;text-align:right}.command-stats b{font-size:1.55rem;line-height:1}.command-stats small{font-size:.68rem;color:var(--on-dark-soft);text-transform:uppercase;letter-spacing:.08em}
  .summary-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:.65rem;margin-bottom:var(--space-l)}.summary-card{min-height:8.5rem;padding:1rem 1.05rem;border:1px solid var(--line);border-radius:var(--radius-lg);display:grid;align-content:start;gap:.25rem;background:var(--paper-raised);box-shadow:var(--shadow-sm)}.summary-card span{font-size:var(--step--2);color:var(--ink-soft);font-weight:650}.summary-card strong{font-size:clamp(1.9rem,3vw,2.4rem);line-height:1;letter-spacing:-.035em;margin:.25rem 0}.summary-card a{margin-top:auto;font-size:var(--step--2);font-weight:750;color:inherit}.summary-hot{border-color:color-mix(in srgb,var(--danger) 36%,var(--line))}.summary-hot strong{color:var(--danger)}.summary-dark{background:var(--ink);color:var(--on-dark);border-color:var(--ink)}.summary-dark span,.summary-dark a{color:var(--on-dark-soft)}
  .work-grid{display:grid;grid-template-columns:1.15fr .85fr;gap:var(--space-s);margin-bottom:var(--space-s)}.work-panel{background:var(--paper-raised);border:1px solid var(--line);border-radius:var(--radius-lg);overflow:hidden;box-shadow:var(--shadow-sm)}.priority-work{border-color:color-mix(in srgb,var(--accent) 25%,var(--line))}.panel-head{padding:1rem 1.05rem;border-bottom:1px solid var(--line);display:flex;justify-content:space-between;align-items:end;gap:.75rem}.panel-head h2{margin:.08rem 0 0;font-size:var(--step-1)}.panel-head>a{font-size:var(--step--2);font-weight:750;color:inherit;white-space:nowrap}.list{padding:0 1.05rem}
  :global(.today-task){display:grid;grid-template-columns:minmax(0,1fr) auto;gap:1rem;align-items:center;padding:.85rem 0;border-bottom:1px solid var(--line)}:global(.today-task:last-child){border-bottom:0}:global(.today-task-main){display:grid;gap:.12rem;min-width:0}:global(.today-task-main strong){overflow:hidden;text-overflow:ellipsis;white-space:nowrap}:global(.today-task-main small){color:var(--ink-soft);font-size:var(--step--2)}:global(.today-task-meta){display:flex;align-items:center;justify-content:flex-end;gap:.5rem;flex-wrap:wrap}:global(.today-task-meta time){font-size:var(--step--2);color:var(--ink-faint);white-space:nowrap}:global(.today-task-meta a),:global(.today-task-meta button){font:inherit;font-size:var(--step--2);font-weight:750;border:1px solid var(--line);background:var(--paper);border-radius:999px;padding:.35rem .55rem;color:inherit;text-decoration:none;cursor:pointer}:global(.today-task-meta a:hover),:global(.today-task-meta button:hover){background:var(--accent-wash);border-color:var(--line-strong)}:global(.today-task.overdue){border-left:3px solid var(--danger);padding-left:.7rem}:global(.today-job){display:grid;grid-template-columns:auto minmax(0,1fr) auto auto;gap:.75rem;align-items:center;padding:.85rem 0;border-bottom:1px solid var(--line);color:inherit;text-decoration:none}:global(.today-job:last-child){border-bottom:0}:global(.today-job-main){display:grid;gap:.12rem;min-width:0}:global(.today-job-main strong){overflow:hidden;text-overflow:ellipsis;white-space:nowrap}:global(.today-job-main small),:global(.today-job-meta small){color:var(--ink-soft);font-size:var(--step--2)}:global(.today-job-meta){display:grid;justify-items:end;gap:.12rem;white-space:nowrap;font-size:var(--step--2)}:global(.job-status){font-size:.66rem;font-weight:800;text-transform:uppercase;letter-spacing:.06em;color:var(--ink-soft);white-space:nowrap}:global(.job-scheduled){color:var(--accent-ink)}:global(.today-arrow){color:var(--ink-faint)}:global(.empty){min-height:10rem;display:grid;place-items:center;align-content:center;gap:.25rem;padding:var(--space-m) 0;text-align:center;color:var(--ink-soft)}:global(.empty strong){color:var(--ink)}
  .flow-panel{display:grid;grid-template-columns:.8fr 1.6fr;background:var(--paper-raised);border:1px solid var(--line);border-radius:var(--radius-lg);overflow:hidden;box-shadow:var(--shadow-sm)}.flow-intro{padding:1.1rem;background:var(--paper-sunk);border-right:1px solid var(--line)}.flow-intro h2{margin:.08rem 0 .3rem}.flow-intro p:last-child{margin:0;color:var(--ink-soft);font-size:var(--step--1)}.flow{display:grid;grid-template-columns:repeat(4,1fr)}.flow a{display:grid;gap:.22rem;padding:1rem;border-right:1px solid var(--line);color:inherit;text-decoration:none}.flow a:last-child{border-right:0}.flow a:hover{background:var(--accent-wash)}.flow span{font-size:.68rem;font-weight:800;color:var(--ink-faint)}.flow small{color:var(--ink-soft);font-size:var(--step--2);line-height:1.45}.status{margin:.75rem 0 0;color:var(--ink-faint);font-size:var(--step--2)}
  @media(max-width:900px){.summary-grid{grid-template-columns:repeat(2,1fr)}.work-grid{grid-template-columns:1fr}.flow-panel{grid-template-columns:1fr}.flow-intro{border-right:0;border-bottom:1px solid var(--line)}.flow{grid-template-columns:repeat(2,1fr)}.flow a:nth-child(2){border-right:0}.flow a:nth-child(-n+2){border-bottom:1px solid var(--line)}}
  @media(max-width:620px){.today-head{align-items:flex-start;flex-direction:column}.today-command{align-items:flex-start;flex-direction:column}.command-stats{width:100%;justify-content:space-between}.command-stats span{text-align:left}.summary-grid{grid-template-columns:1fr 1fr}.flow{grid-template-columns:1fr}.flow a{border-right:0;border-bottom:1px solid var(--line)}.flow a:last-child{border-bottom:0}:global(.today-task){grid-template-columns:1fr;gap:.55rem}:global(.today-task-meta){justify-content:flex-start}:global(.today-job){grid-template-columns:auto minmax(0,1fr) auto}:global(.today-job-meta){grid-column:2;justify-items:start}:global(.today-arrow){grid-column:3;grid-row:1/span 2}}
  @media(max-width:460px){.summary-grid{grid-template-columns:1fr}.command-stats{gap:.7rem}.command-stats b{font-size:1.35rem}.panel-head{align-items:flex-start;flex-direction:column}}
</style>
