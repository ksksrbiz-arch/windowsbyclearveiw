---
import InternalLayout from '../../layouts/InternalLayout.astro';
---
<InternalLayout title="Command Center">
  <div class="cc-hero">
    <div>
      <p class="kicker">Daily operations</p>
      <h1>Command Center</h1>
      <p class="lede">See what needs attention, what is moving, and what can wait.</p>
    </div>
    <div class="cc-hero-actions">
      <button class="btn btn-ghost" type="button" data-refresh>Refresh</button>
      <a class="btn btn-primary" href="/internal/quotes/new">New quote</a>
    </div>
  </div>

  <section class="priority-grid" aria-label="Priority work">
    <a class="priority priority-hot" href="/internal/leads">
      <span class="priority-icon">↗</span>
      <span class="priority-copy"><small>New leads</small><strong data-attention-leads>—</strong><em>Review & respond</em></span>
    </a>
    <a class="priority" href="/internal/follow-up">
      <span class="priority-icon">!</span>
      <span class="priority-copy"><small>Overdue follow-ups</small><strong data-attention-overdue>—</strong><em>Clear the queue</em></span>
    </a>
    <a class="priority" href="/internal/quotes">
      <span class="priority-icon">$</span>
      <span class="priority-copy"><small>Draft quotes</small><strong data-attention-drafts>—</strong><em>Finish & send</em></span>
    </a>
  </section>

  <section class="snapshot-grid" aria-label="Business snapshot">
    <article class="snapshot-card snapshot-accent">
      <div class="snapshot-top"><span>New leads</span><span>7 days</span></div>
      <strong data-metric="newLeads">—</strong>
      <a href="/internal/leads">Open leads →</a>
    </article>
    <article class="snapshot-card">
      <div class="snapshot-top"><span>Follow-ups</span><span>today</span></div>
      <strong data-metric="openTasks">—</strong>
      <p><span data-metric="tasksToday">—</span> due today</p>
      <a href="/internal/follow-up">Open follow-up →</a>
    </article>
    <article class="snapshot-card">
      <div class="snapshot-top"><span>Draft quotes</span><span>awaiting action</span></div>
      <strong data-metric="draftQuotes">—</strong>
      <a href="/internal/quotes">Open quotes →</a>
    </article>
    <article class="snapshot-card snapshot-dark">
      <div class="snapshot-top"><span>Active job value</span><span>scheduled / active</span></div>
      <strong data-metric="activeValue">—</strong>
      <a href="/internal/jobs">Open jobs →</a>
    </article>
  </section>

  <section class="focus-grid">
    <article class="focus-panel focus-primary">
      <div class="panel-head">
        <div><p class="kicker">Today</p><h2>What needs you now</h2></div>
        <a class="panel-link" href="/internal/today">Open Today →</a>
      </div>
      <div class="focus-body" data-tasks-body><p class="muted">Loading…</p></div>
    </article>
    <article class="focus-panel">
      <div class="panel-head">
        <div><p class="kicker">Operations</p><h2>Upcoming jobs</h2></div>
        <a class="panel-link" href="/internal/jobs">Open jobs →</a>
      </div>
      <div class="focus-body" data-jobs-body><p class="muted">Loading…</p></div>
    </article>
  </section>

  <section class="work-grid">
    <article class="work-panel">
      <div class="panel-head"><div><p class="kicker">Inbound</p><h2>Recent leads</h2></div><a class="panel-link" href="/internal/leads">See all →</a></div>
      <div class="focus-body" data-leads-body><p class="muted">Loading…</p></div>
    </article>
    <article class="work-panel">
      <div class="panel-head"><div><p class="kicker">Sales</p><h2>Recent quotes</h2></div><a class="panel-link" href="/internal/quotes">See all →</a></div>
      <div class="focus-body" data-quotes-body><p class="muted">Loading…</p></div>
    </article>
  </section>

  <section class="pipeline-panel">
    <div class="panel-head">
      <div><p class="kicker">Pipeline</p><h2>Quote value by stage</h2></div>
      <span class="pipeline-total" data-pipeline-total>—</span>
    </div>
    <div class="pipeline-grid">
      <div class="pipeline-stage">
        <div class="stage-top"><span>Drafts</span><strong data-stage-drafts>—</strong></div>
        <div class="progress"><span data-progress-drafts></span></div>
        <small data-stage-drafts-value>—</small>
      </div>
      <div class="pipeline-stage">
        <div class="stage-top"><span>Finalized</span><strong data-stage-finalized>—</strong></div>
        <div class="progress"><span data-progress-finalized></span></div>
        <small data-stage-finalized-value>—</small>
      </div>
      <div class="pipeline-summary">
        <span>Average finalized</span>
        <strong data-average-finalized>—</strong>
        <small>finalized quotes only</small>
      </div>
    </div>
  </section>

  <section class="insight-strip">
    <article class="insight-panel">
      <div class="panel-head"><div><p class="kicker">Lead intelligence</p><h2>Top sources</h2></div></div>
      <div class="insight-list" data-source-body><p class="muted">Loading…</p></div>
    </article>
    <article class="insight-panel">
      <div class="panel-head"><div><p class="kicker">Service area</p><h2>Recent lead locations</h2></div></div>
      <div class="insight-list" data-city-body><p class="muted">Loading…</p></div>
    </article>
  </section>

  <section class="workflow-panel">
    <div class="workflow-intro"><p class="kicker">Workflow</p><h2>Move a project forward</h2><p>Keep the core sequence visible without making it compete with live work.</p></div>
    <div class="workflow-steps">
      <a href="/internal/leads"><span>01</span><strong>Qualify</strong><small>Review the lead and create the next action.</small></a>
      <a href="/internal/tools/measurements"><span>02</span><strong>Measure</strong><small>Capture openings and carry them into a quote.</small></a>
      <a href="/internal/quotes/new"><span>03</span><strong>Quote</strong><small>Build scope, finalize, and generate the invoice.</small></a>
      <a href="/internal/jobs"><span>04</span><strong>Install</strong><small>Schedule the job and keep field notes together.</small></a>
    </div>
  </section>

  <p class="dash-status" data-status role="status">Refreshing business snapshot…</p>
</InternalLayout>

<script>
  type Lead={id:number|string;created_at:string;name:string;phone?:string;city?:string;role?:string};
  type Quote={id:string;created_at:string;status:string;customer_name:string;customer_city?:string;total_cents:number};
  type CountRow={source?:string;city?:string;count:number};
  type Task={id:number;title:string;due_at?:string|null;lead_id?:number|null;lead_name?:string|null;lead_phone?:string|null;lead_city?:string|null};
  type Job={id:string;status:string;scheduled_date?:string|null;scheduled_window?:string|null;customer_name:string;customer_city?:string|null;total_cents?:number|null};
  type Snapshot={counts:{new_leads?:number;draft_quotes?:number;finalized_quotes?:number;draft_value_cents?:number;finalized_value_cents?:number;total_quotes?:number;open_tasks?:number;tasks_today?:number;tasks_overdue?:number;active_job_value_cents?:number};recentLeads:Lead[];recentQuotes:Quote[];sources:CountRow[];cities:CountRow[];tasks:Task[];recentJobs:Job[]};

  function initDashboard(){
    if(document.body.dataset.dashboardBound==='true')return;
    document.body.dataset.dashboardBound='true';
    const $=<T extends Element>(s:string)=>document.querySelector(s) as T|null;
    const text=(s:string,v:string)=>{const e=$(s);if(e)e.textContent=v;};
    const money=(c:number)=>new Intl.NumberFormat('en-US',{style:'currency',currency:'USD',maximumFractionDigits:0}).format((Number(c)||0)/100);
    const day=(iso:string)=>{const d=new Date(iso);return Number.isNaN(d.getTime())?'':d.toLocaleDateString('en-US',{month:'short',day:'numeric'});};
    const datetime=(iso:string)=>{if(!iso)return 'No due date';const d=new Date(iso);return Number.isNaN(d.getTime())?'':d.toLocaleString('en-US',{month:'short',day:'numeric',hour:'numeric',minute:'2-digit'});};
    const esc=(v:unknown)=>{const d=document.createElement('div');d.textContent=String(v??'');return d.innerHTML;};
    const phone=(v:string)=>String(v||'').replace(/\D/g,'');
    async function completeTask(id:number){try{const r=await fetch(`/internal/api/tasks?id=${encodeURIComponent(String(id))}`,{method:'PATCH',headers:{'content-type':'application/json'},body:JSON.stringify({status:'done'})});if(!r.ok)throw new Error();await load();}catch{const status=$('[data-status]');if(status)status.textContent='Could not complete that follow-up.';}}
    async function load(){
      const refresh=$('[data-refresh]') as HTMLButtonElement|null;
      if(refresh){refresh.disabled=true;refresh.textContent='Refreshing…';}
      try{
        const response=await fetch('/internal/api/dashboard',{headers:{'cache-control':'no-cache'}});if(!response.ok)throw new Error('Request failed');
        const data=await response.json() as Snapshot;
        const counts=data.counts||{};
        const draftValue=Number(counts.draft_value_cents)||0;
        const finalValue=Number(counts.finalized_value_cents)||0;
        const finalized=Number(counts.finalized_quotes)||0;
        text('[data-metric="newLeads"]',String(Number(counts.new_leads)||0));
        text('[data-metric="openTasks"]',String(Number(counts.open_tasks)||0));
        text('[data-metric="tasksToday"]',String(Number(counts.tasks_today)||0));
        text('[data-metric="draftQuotes"]',String(Number(counts.draft_quotes)||0));
        text('[data-metric="activeValue"]',money(Number(counts.active_job_value_cents)||0));
        text('[data-attention-leads]',String(Number(counts.new_leads)||0));
        text('[data-attention-overdue]',String(Number(counts.tasks_overdue)||0));
        text('[data-attention-drafts]',String(Number(counts.draft_quotes)||0));
        text('[data-pipeline-total]',`${Number(counts.total_quotes)||0} quotes`);
        text('[data-stage-drafts]',String(Number(counts.draft_quotes)||0));
        text('[data-stage-finalized]',String(finalized));
        text('[data-stage-drafts-value]',money(draftValue));
        text('[data-stage-finalized-value]',money(finalValue));
        text('[data-average-finalized]',finalized?money(finalValue/finalized):'—');
        const totalValue=draftValue+finalValue;
        const dp=$('[data-progress-drafts]') as HTMLElement|null;
        const fp=$('[data-progress-finalized]') as HTMLElement|null;
        if(dp)dp.style.width=`${totalValue?draftValue/totalValue*100:0}%`;
        if(fp)fp.style.width=`${totalValue?finalValue/totalValue*100:0}%`;

        const tb=$('[data-tasks-body');
        if(tb)tb.innerHTML=(data.tasks||[]).map(t=>`<div class="cc-task-row"><span class="cc-task-indicator ${t.due_at&&new Date(t.due_at)<new Date()?'is-overdue':''}"></span><span class="cc-row-main"><strong>${esc(t.title)}</strong><small>${esc([t.lead_name,t.lead_city].filter(Boolean).join(' · ')||'Internal follow-up')} · ${esc(datetime(t.due_at||''))}</small></span><span class="cc-row-actions">${t.lead_phone?`<a href="tel:${phone(t.lead_phone)}">Call</a>`:''}<button type="button" data-complete-task="${t.id}">Done</button></span></div>`).join('')||'<p class="cc-empty">No open follow-ups.</p>';
        tb?.querySelectorAll('[data-complete-task]').forEach(btn=>btn.addEventListener('click',()=>completeTask(Number((btn as HTMLElement).dataset.completeTask))));

        const jb=$('[data-jobs-body]');
        if(jb)jb.innerHTML=(data.recentJobs||[]).map(j=>`<a class="cc-job-row" href="/internal/jobs/view?id=${encodeURIComponent(j.id)}"><span class="cc-status">${esc(j.status.replace('-', ' '))}</span><span class="cc-row-main"><strong>${esc(j.customer_name)}</strong><small>${esc([j.customer_city,j.scheduled_window].filter(Boolean).join(' · ')||'No crew window')}</small></span><span class="cc-row-meta"><strong>${j.scheduled_date?day(j.scheduled_date):'Unscheduled'}</strong><small>${money(Number(j.total_cents)||0)}</small></span></a>`).join('')||'<p class="cc-empty">No active jobs yet.</p>';

        const lb=$('[data-leads-body]');
        if(lb)lb.innerHTML=(data.recentLeads||[]).map(l=>`<div class="cc-lead-row"><span class="cc-avatar">${esc((l.name||'?')[0].toUpperCase())}</span><span class="cc-row-main"><strong>${esc(l.name)}</strong><small>${esc([l.city,l.role].filter(Boolean).join(' · ')||'Estimate request')}</small></span><span class="cc-row-actions"><a href="/internal/follow-up?leadId=${encodeURIComponent(String(l.id))}">Follow-up</a>${l.phone?`<a href="tel:${phone(l.phone)}">Call</a>`:''}</span><time class="cc-row-meta">${day(l.created_at)}</time></div>`).join('')||'<p class="cc-empty">No recent estimate requests.</p>';

        const qb=$('[data-quotes-body]');
        if(qb)qb.innerHTML=(data.recentQuotes||[]).map(q=>`<a class="cc-quote-row" href="/internal/quotes/view?id=${encodeURIComponent(q.id)}"><span class="cc-quote-status ${q.status==='finalized'?'is-final':''}">${q.status==='finalized'?'Finalized':'Draft'}</span><span class="cc-row-main"><strong>${esc(q.customer_name)}</strong><small>${esc([q.customer_city,q.id].filter(Boolean).join(' · '))}</small></span><span class="cc-row-meta"><strong>${money(Number(q.total_cents)||0)}</strong><time>${day(q.created_at)}</time></span></a>`).join('')||'<p class="cc-empty">No quotes yet.</p>';

        const renderCounts=(rows:CountRow[],field:'source'|'city')=>rows.length?rows.map(r=>`<div class="cc-insight-row"><span>${esc(r[field]||'')}</span><strong>${Number(r.count)||0}</strong></div>`).join(''):'<p class="cc-empty">Not enough data yet.</p>';
        const sb=$('[data-source-body]');if(sb)sb.innerHTML=renderCounts(data.sources||[],'source');
        const cb=$('[data-city-body]');if(cb)cb.innerHTML=renderCounts(data.cities||[],'city');
        const status=$('[data-status]');if(status)status.textContent=`Updated ${new Date().toLocaleTimeString('en-US',{hour:'numeric',minute:'2-digit'})}`;
      }catch{const status=$('[data-status]');if(status)status.textContent='Could not refresh the dashboard. Your work screens are still available.';}
      finally{if(refresh){refresh.disabled=false;refresh.textContent='Refresh';}}
    }
    const refresh=$('[data-refresh]');if(refresh)refresh.addEventListener('click',load);
    load();
  }
  initDashboard();
  document.addEventListener('astro:page-load',initDashboard);
</script>

<style>
  .cc-hero{display:flex;justify-content:space-between;align-items:end;gap:var(--space-m);margin-bottom:var(--space-m)}
  .cc-hero h1{margin:.08rem 0 .35rem}.cc-hero-actions{display:flex;gap:.5rem;flex-wrap:wrap}
  .priority-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:.65rem;margin-bottom:var(--space-m)}
  .priority{display:grid;grid-template-columns:auto 1fr;gap:.85rem;align-items:center;padding:1rem 1.05rem;border:1px solid var(--line);border-radius:var(--radius-lg);background:var(--paper-raised);color:inherit;text-decoration:none;box-shadow:var(--shadow-sm);transition:transform var(--dur-fast) var(--ease),box-shadow var(--dur-fast) var(--ease),border-color var(--dur-fast) var(--ease)}
  .priority:hover{transform:translateY(-1px);box-shadow:var(--shadow-md);border-color:var(--line-strong)}.priority-hot{border-color:color-mix(in srgb,var(--accent) 35%,var(--line));background:color-mix(in srgb,var(--accent) 6%,var(--paper-raised))}
  .priority-icon{width:2.35rem;height:2.35rem;border-radius:50%;display:grid;place-items:center;background:var(--ink);color:var(--on-dark);font-weight:800}.priority-hot .priority-icon{background:var(--accent)}
  .priority-copy{display:grid;gap:.08rem}.priority-copy small{font-size:var(--step--2);font-weight:650;text-transform:uppercase;letter-spacing:.08em;color:var(--ink-faint)}.priority-copy strong{font-size:1.65rem;line-height:1}.priority-copy em{font-style:normal;font-size:var(--step--2);color:var(--ink-soft)}
  .snapshot-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:.65rem;margin-bottom:var(--space-l)}
  .snapshot-card{min-height:9.5rem;padding:1.05rem;border:1px solid var(--line);border-radius:var(--radius-lg);background:var(--paper-raised);display:grid;align-content:start;gap:.3rem;box-shadow:var(--shadow-sm)}.snapshot-accent{border-color:color-mix(in srgb,var(--accent) 30%,var(--line))}.snapshot-dark{background:var(--ink);color:var(--on-dark);border-color:var(--ink)}
  .snapshot-top{display:flex;justify-content:space-between;gap:.5rem;font-size:var(--step--2);color:var(--ink-soft)}.snapshot-dark .snapshot-top{color:var(--on-dark-soft)}.snapshot-card>strong{font-size:clamp(2rem,3vw,2.7rem);line-height:1;letter-spacing:-.04em;margin:.25rem 0}.snapshot-card p{margin:0;color:var(--ink-soft);font-size:var(--step--2)}.snapshot-dark p{color:var(--on-dark-soft)}.snapshot-card a{margin-top:auto;font-size:var(--step--2);font-weight:750;color:inherit}
  .focus-grid,.work-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:var(--space-s);margin-bottom:var(--space-s)}
  .focus-panel,.work-panel,.insight-panel{background:var(--paper-raised);border:1px solid var(--line);border-radius:var(--radius-lg);overflow:hidden;box-shadow:var(--shadow-sm)}.focus-primary{border-color:color-mix(in srgb,var(--accent) 24%,var(--line))}
  .panel-head{padding:1rem 1.05rem;border-bottom:1px solid var(--line);display:flex;justify-content:space-between;align-items:end;gap:.8rem}.panel-head h2{margin:.08rem 0 0;font-size:var(--step-1)}.panel-link{font-size:var(--step--2);font-weight:750;color:inherit;white-space:nowrap}.focus-body{padding:0 1.05rem}
  :global(.cc-task-row),:global(.cc-job-row),:global(.cc-lead-row),:global(.cc-quote-row){display:grid;align-items:center;gap:.72rem;padding:.82rem 0;border-bottom:1px solid var(--line);color:inherit;text-decoration:none}.cc-task-row:last-child,.cc-job-row:last-child,.cc-lead-row:last-child,.cc-quote-row:last-child{border-bottom:0}
  :global(.cc-task-row){grid-template-columns:auto minmax(0,1fr) auto}:global(.cc-job-row){grid-template-columns:auto minmax(0,1fr) auto}:global(.cc-lead-row){grid-template-columns:auto minmax(0,1fr) auto auto}:global(.cc-quote-row){grid-template-columns:auto minmax(0,1fr) auto}
  :global(.cc-row-main){min-width:0;display:grid;gap:.12rem}:global(.cc-row-main strong){overflow:hidden;text-overflow:ellipsis;white-space:nowrap}:global(.cc-row-main small),:global(.cc-row-meta small){color:var(--ink-soft);overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:var(--step--2)}:global(.cc-row-meta){display:grid;justify-items:end;gap:.1rem;white-space:nowrap;font-size:var(--step--2)}:global(.cc-row-actions){display:flex;gap:.45rem;align-items:center;flex-wrap:wrap}:global(.cc-row-actions a),:global(.cc-row-actions button){font:inherit;font-size:var(--step--2);font-weight:750;color:inherit;text-decoration:none;border:0;background:none;padding:0;cursor:pointer}:global(.cc-row-actions a:hover),:global(.cc-row-actions button:hover){text-decoration:underline}
  :global(.cc-task-indicator){width:.62rem;height:.62rem;border-radius:50%;background:var(--line-strong)}:global(.cc-task-indicator.is-overdue){background:var(--danger)}:global(.cc-status),:global(.cc-quote-status){font-size:.68rem;font-weight:800;text-transform:uppercase;letter-spacing:.06em;color:var(--ink-soft);white-space:nowrap}:global(.cc-quote-status.is-final){color:var(--accent-ink)}:global(.cc-avatar){width:2rem;height:2rem;border-radius:50%;display:grid;place-items:center;background:var(--ink);color:var(--on-dark);font-size:.72rem;font-weight:800}:global(.cc-empty){padding:1rem 0;margin:0;color:var(--ink-faint)}
  .pipeline-panel{margin-bottom:var(--space-s);background:var(--paper-raised);border:1px solid var(--line);border-radius:var(--radius-lg);overflow:hidden;box-shadow:var(--shadow-sm)}.pipeline-total{font-size:var(--step--2);font-weight:750;color:var(--ink-soft)}.pipeline-grid{display:grid;grid-template-columns:1fr 1fr .85fr;gap:var(--space-m);padding:1.05rem}.pipeline-stage,.pipeline-summary{display:grid;gap:.4rem;align-content:start}.stage-top{display:flex;justify-content:space-between;gap:.5rem}.progress{height:.48rem;background:var(--line);border-radius:999px;overflow:hidden}.progress span{display:block;height:100%;width:0;background:var(--accent);border-radius:inherit}.pipeline-stage small,.pipeline-summary small{color:var(--ink-faint);font-size:var(--step--2)}.pipeline-summary{align-content:center;padding-left:1rem;border-left:1px solid var(--line)}.pipeline-summary strong{font-size:var(--step-2)}
  .insight-strip{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:var(--space-s);margin-bottom:var(--space-s)}.insight-list{padding:0 1.05rem}.cc-insight-row{display:flex;justify-content:space-between;gap:.75rem;padding:.68rem 0;border-bottom:1px solid var(--line)}.cc-insight-row:last-child{border-bottom:0}
  .workflow-panel{display:grid;grid-template-columns:.85fr 1.6fr;border:1px solid var(--line);border-radius:var(--radius-lg);overflow:hidden;background:var(--paper-raised);box-shadow:var(--shadow-sm)}.workflow-intro{padding:1.15rem;background:var(--paper-sunk);border-right:1px solid var(--line)}.workflow-intro h2{margin:.1rem 0 .35rem}.workflow-intro p:last-child{margin:0;color:var(--ink-soft);font-size:var(--step--1)}.workflow-steps{display:grid;grid-template-columns:repeat(4,1fr)}.workflow-steps a{display:grid;gap:.2rem;padding:1rem;border-right:1px solid var(--line);color:inherit;text-decoration:none}.workflow-steps a:last-child{border-right:0}.workflow-steps a:hover{background:var(--accent-wash)}.workflow-steps span{font-size:.68rem;font-weight:800;color:var(--ink-faint)}.workflow-steps strong{font-size:var(--step-0)}.workflow-steps small{color:var(--ink-soft);font-size:var(--step--2);line-height:1.45}.dash-status{margin:.8rem 0 0;color:var(--ink-faint);font-size:var(--step--2)}
  @media(max-width:980px){.snapshot-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.pipeline-grid{grid-template-columns:1fr 1fr}.pipeline-summary{grid-column:1/-1;border-left:0;border-top:1px solid var(--line);padding:var(--space-s) 0 0}.workflow-panel{grid-template-columns:1fr}.workflow-intro{border-right:0;border-bottom:1px solid var(--line)}.workflow-steps{grid-template-columns:repeat(2,1fr)}.workflow-steps a:nth-child(2){border-right:0}.workflow-steps a:nth-child(-n+2){border-bottom:1px solid var(--line)}}
