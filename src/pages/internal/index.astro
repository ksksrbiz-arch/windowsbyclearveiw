---
import InternalLayout from '../../layouts/InternalLayout.astro';
---
<InternalLayout title="Command Center">
  <div class="dash-head">
    <div><p class="kicker">Clearview internal</p><h1>Command Center</h1><p class="lede">The daily operating view for leads, follow-ups, quotes, and active jobs.</p></div>
    <div class="dash-actions"><button class="btn btn-ghost" type="button" data-refresh>Refresh</button><a class="btn btn-primary" href="/internal/quotes/new">New quote</a></div>
  </div>

  <section class="attention-strip" aria-label="Priority work">
    <a class="attention-item attention-hot" href="/internal/leads"><span class="attention-icon">!</span><span><strong data-attention-leads>—</strong> new lead<span data-lead-plural>s</span> to review</span><span>→</span></a>
    <a class="attention-item" href="/internal/follow-up"><span class="attention-icon">↗</span><span><strong data-attention-overdue>—</strong> overdue follow-up<span data-overdue-plural>s</span></span><span>→</span></a>
    <a class="attention-item" href="/internal/quotes"><span class="attention-icon">$</span><span><strong data-attention-drafts>—</strong> quote<span data-quote-plural>s</span> still in draft</span><span>→</span></a>
  </section>

  <section class="metric-grid" aria-label="Business snapshot">
    <article class="metric-card metric-hot"><span class="metric-label">New leads</span><strong data-metric="newLeads">—</strong><span class="metric-note">Last 7 days</span><a href="/internal/leads">Work leads →</a></article>
    <article class="metric-card"><span class="metric-label">Open follow-ups</span><strong data-metric="openTasks">—</strong><span class="metric-note"><span data-metric="tasksToday">—</span> due today</span><a href="/internal/follow-up">Open follow-up desk →</a></article>
    <article class="metric-card"><span class="metric-label">Draft quotes</span><strong data-metric="draftQuotes">—</strong><span class="metric-note">Awaiting action</span><a href="/internal/quotes">Open quote list →</a></article>
    <article class="metric-card metric-money"><span class="metric-label">Active job value</span><strong data-metric="activeValue">—</strong><span class="metric-note">Scheduled / in progress</span><a href="/internal/jobs">Open jobs →</a></article>
  </section>

  <div class="dash-grid">
    <section class="panel">
      <div class="panel-head"><div><p class="kicker">Today</p><h2>Follow-ups that need attention</h2></div><a class="panel-link" href="/internal/follow-up">See all</a></div>
      <div class="panel-body" data-tasks-body><p class="muted">Loading…</p></div>
    </section>
    <section class="panel">
      <div class="panel-head"><div><p class="kicker">Operations</p><h2>Upcoming jobs</h2></div><a class="panel-link" href="/internal/jobs">See all</a></div>
      <div class="panel-body" data-jobs-body><p class="muted">Loading…</p></div>
    </section>
  </div>

  <div class="dash-grid">
    <section class="panel">
      <div class="panel-head"><div><p class="kicker">Inbound</p><h2>Recent leads</h2></div><a class="panel-link" href="/internal/leads">See all</a></div>
      <div class="panel-body" data-leads-body><p class="muted">Loading…</p></div>
    </section>
    <section class="panel">
      <div class="panel-head"><div><p class="kicker">Sales</p><h2>Recent quotes</h2></div><a class="panel-link" href="/internal/quotes">See all</a></div>
      <div class="panel-body" data-quotes-body><p class="muted">Loading…</p></div>
    </section>
  </div>

  <div class="insight-grid">
    <section class="panel"><div class="panel-head"><div><p class="kicker">Lead intelligence</p><h2>Lead sources</h2></div></div><div class="insight-list" data-source-body><p class="muted">Loading…</p></div></section>
    <section class="panel"><div class="panel-head"><div><p class="kicker">Service area</p><h2>Recent lead locations</h2></div></div><div class="insight-list" data-city-body><p class="muted">Loading…</p></div></section>
  </div>

  <section class="pipeline-panel panel">
    <div class="panel-head"><div><p class="kicker">Quote pipeline</p><h2>Value by stage</h2></div><span class="pipeline-total" data-pipeline-total>—</span></div>
    <div class="pipeline-body">
      <div class="pipeline-stage"><div class="stage-top"><span>Drafts</span><strong data-stage-drafts>—</strong></div><div class="progress"><span data-progress-drafts></span></div><small data-stage-drafts-value>—</small></div>
      <div class="pipeline-stage"><div class="stage-top"><span>Finalized</span><strong data-stage-finalized>—</strong></div><div class="progress"><span data-progress-finalized></span></div><small data-stage-finalized-value>—</small></div>
      <div class="pipeline-stage pipeline-summary"><span>Average finalized quote</span><strong data-average-finalized>—</strong><small>Based only on finalized quotes</small></div>
    </div>
  </section>

  <section class="quick-actions">
    <div><p class="kicker">Workflow</p><h2>Move a project forward</h2></div>
    <div class="quick-links">
      <a href="/internal/leads"><span>01</span><strong>Capture & qualify</strong><small>Review a new lead and create the next follow-up.</small></a>
      <a href="/internal/tools/measurements"><span>02</span><strong>Measure</strong><small>Record field openings and carry them into a quote.</small></a>
      <a href="/internal/quotes/new"><span>03</span><strong>Quote & sign</strong><small>Build pricing and finalize the agreed scope.</small></a>
      <a href="/internal/jobs"><span>04</span><strong>Schedule & install</strong><small>Turn a finalized quote into an operating job.</small></a>
    </div>
  </section>

  <p class="dash-status" data-status role="status">Refreshing business snapshot…</p>
</InternalLayout>

<script>
  type Lead={id:number|string;created_at:string;name:string;phone?:string;city?:string;role?:string};
  type Quote={id:string;created_at:string;status:string;customer_name:string;customer_city?:string;total_cents:number};
  type CountRow={source?:string;city?:string;count:number};
  type Task={id:number;title:string;due_at?:string|null;lead_id?:number|null;lead_name?:string|null;lead_phone?:string|null;lead_city?:string|null};
  type Job={id:string;status:string;scheduled_date?:string|null;scheduled_window?:string|null;customer_name:string;customer_city?:string|null;total_cents?:number|null};
  type Snapshot={counts:{new_leads?:number;draft_quotes?:number;finalized_quotes?:number;draft_value_cents?:number;finalized_value_cents?:number;total_quotes?:number;open_tasks?:number;tasks_today?:number;tasks_overdue?:number;active_job_value_cents?:number};recentLeads:Lead[];recentQuotes:Quote[];sources:CountRow[];cities:CountRow[];tasks:Task[];recentJobs:Job[]};

  function initDashboard(){
    if(document.body.dataset.dashboardBound==='true')return; document.body.dataset.dashboardBound='true';
    const $=<T extends Element>(s:string)=>document.querySelector(s) as T|null;
    const text=(s:string,v:string)=>{const e=$(s);if(e)e.textContent=v;};
    const money=(c:number)=>new Intl.NumberFormat('en-US',{style:'currency',currency:'USD',maximumFractionDigits:0}).format((Number(c)||0)/100);
    const day=(iso:string)=>{const d=new Date(iso);return Number.isNaN(d.getTime())?'':d.toLocaleDateString('en-US',{month:'short',day:'numeric'});};
    const datetime=(iso:string)=>{if(!iso)return 'No due date';const d=new Date(iso);return Number.isNaN(d.getTime())?'':d.toLocaleString('en-US',{month:'short',day:'numeric',hour:'numeric',minute:'2-digit'});};
    const esc=(v:unknown)=>{const d=document.createElement('div');d.textContent=String(v??'');return d.innerHTML;};
    const phone=(v:string)=>String(v||'').replace(/\D/g,'');
    async function completeTask(id:number){try{const r=await fetch(`/internal/api/tasks?id=${encodeURIComponent(String(id))}`,{method:'PATCH',headers:{'content-type':'application/json'},body:JSON.stringify({status:'done'})});if(!r.ok)throw new Error();await load();}catch{const status=$('[data-status]');if(status)status.textContent='Could not complete that follow-up.';}}
    async function load(){
      const refresh=$('[data-refresh]') as HTMLButtonElement|null;if(refresh){refresh.disabled=true;refresh.textContent='Refreshing…';}
      try{
        const response=await fetch('/internal/api/dashboard',{headers:{'cache-control':'no-cache'}});if(!response.ok)throw new Error('Request failed');
        const data=await response.json() as Snapshot;const counts=data.counts||{};const draftValue=Number(counts.draft_value_cents)||0;const finalValue=Number(counts.finalized_value_cents)||0;const finalized=Number(counts.finalized_quotes)||0;
        text('[data-metric="newLeads"]',String(Number(counts.new_leads)||0));text('[data-metric="openTasks"]',String(Number(counts.open_tasks)||0));text('[data-metric="tasksToday"]',String(Number(counts.tasks_today)||0));text('[data-metric="draftQuotes"]',String(Number(counts.draft_quotes)||0));text('[data-metric="activeValue"]',money(Number(counts.active_job_value_cents)||0));
        text('[data-attention-leads]',String(Number(counts.new_leads)||0));text('[data-attention-overdue]',String(Number(counts.tasks_overdue)||0));text('[data-attention-drafts]',String(Number(counts.draft_quotes)||0));
        if((Number(counts.new_leads)||0)===1)text('[data-lead-plural]','');if((Number(counts.tasks_overdue)||0)===1)text('[data-overdue-plural]','');if((Number(counts.draft_quotes)||0)===1)text('[data-quote-plural]','');
        text('[data-pipeline-total]',`${Number(counts.total_quotes)||0} quotes`);text('[data-stage-drafts]',String(Number(counts.draft_quotes)||0));text('[data-stage-finalized]',String(finalized));text('[data-stage-drafts-value]',money(draftValue));text('[data-stage-finalized-value]',money(finalValue));text('[data-average-finalized]',finalized?money(finalValue/finalized):'—');
        const totalValue=draftValue+finalValue;const dp=$('[data-progress-drafts]') as HTMLElement|null;const fp=$('[data-progress-finalized]') as HTMLElement|null;if(dp)dp.style.width=`${totalValue?draftValue/totalValue*100:0}%`;if(fp)fp.style.width=`${totalValue?finalValue/totalValue*100:0}%`;
        const tb=$('[data-tasks-body]');if(tb)tb.innerHTML=(data.tasks||[]).map(t=>`<div class="task-row"><span class="task-dot ${t.due_at&&new Date(t.due_at)<new Date()?'is-overdue':''}"></span><span class="row-main"><strong>${esc(t.title)}</strong><small>${esc([t.lead_name,t.lead_city].filter(Boolean).join(' · ')||'Internal follow-up')} · ${esc(datetime(t.due_at||''))}</small></span><span class="row-actions">${t.lead_phone?`<a href="tel:${phone(t.lead_phone)}">Call</a>`:''}<button type="button" data-complete-task="${t.id}">Done</button></span></div>`).join('')||'<p class="empty">No open follow-ups.</p>';
        tb?.querySelectorAll('[data-complete-task]').forEach(btn=>btn.addEventListener('click',()=>completeTask(Number((btn as HTMLElement).dataset.completeTask))));
        const jb=$('[data-jobs-body]');if(jb)jb.innerHTML=(data.recentJobs||[]).map(j=>`<a class="job-row" href="/internal/jobs/view?id=${encodeURIComponent(j.id)}"><span class="job-status">${esc(j.status.replace('-', ' '))}</span><span class="row-main"><strong>${esc(j.customer_name)}</strong><small>${esc([j.customer_city,j.scheduled_window].filter(Boolean).join(' · ')||'No crew window')}</small></span><span class="row-meta"><strong>${j.scheduled_date?day(j.scheduled_date):'Unscheduled'}</strong><small>${money(Number(j.total_cents)||0)}</small></span></a>`).join('')||'<p class="empty">No active jobs yet.</p>';
        const lb=$('[data-leads-body]');if(lb)lb.innerHTML=(data.recentLeads||[]).map(l=>`<div class="lead-row"><span class="avatar">${esc((l.name||'?')[0].toUpperCase())}</span><span class="row-main"><strong>${esc(l.name)}</strong><small>${esc([l.city,l.role].filter(Boolean).join(' · ')||'Estimate request')}</small></span><span class="row-actions"><a href="/internal/follow-up?leadId=${encodeURIComponent(String(l.id))}">Follow-up</a>${l.phone?`<a href="tel:${phone(l.phone)}">Call</a>`:''}</span><span class="row-meta"><time>${day(l.created_at)}</time></span></div>`).join('')||'<p class="empty">No recent estimate requests.</p>';
        const qb=$('[data-quotes-body]');if(qb)qb.innerHTML=(data.recentQuotes||[]).map(q=>`<a class="quote-row" href="/internal/quotes/view?id=${encodeURIComponent(q.id)}"><span class="quote-status ${q.status==='finalized'?'is-final':'is-draft'}">${q.status==='finalized'?'Finalized':'Draft'}</span><span class="row-main"><strong>${esc(q.customer_name)}</strong><small>${esc([q.customer_city,q.id].filter(Boolean).join(' · '))}</small></span><span class="row-meta"><strong>${money(Number(q.total_cents)||0)}</strong><time>${day(q.created_at)}</time></span></a>`).join('')||'<p class="empty">No quotes yet.</p>';
        const renderCounts=(rows:CountRow[],field:'source'|'city')=>rows.length?rows.map(r=>`<div class="insight-row"><span>${esc(r[field]||'')}</span><strong>${Number(r.count)||0}</strong></div>`).join(''):'<p class="empty">Not enough data yet.</p>';
        const sb=$('[data-source-body]');if(sb)sb.innerHTML=renderCounts(data.sources||[],'source');const cb=$('[data-city-body]');if(cb)cb.innerHTML=renderCounts(data.cities||[],'city');
        const status=$('[data-status]');if(status)status.textContent=`Updated ${new Date().toLocaleTimeString('en-US',{hour:'numeric',minute:'2-digit'})}`;
      }catch{const status=$('[data-status]');if(status)status.textContent='Could not refresh the snapshot. The underlying work screens are still available.';}
      finally{if(refresh){refresh.disabled=false;refresh.textContent='Refresh';}}
    }
    const refresh=$('[data-refresh]');if(refresh)refresh.addEventListener('click',load);load();
  }
  initDashboard();document.addEventListener('astro:page-load',initDashboard);
</script>

<style>
  .dash-head{display:flex;justify-content:space-between;align-items:end;gap:var(--space-m);margin-bottom:var(--space-m)}.dash-actions{display:flex;gap:var(--space-xs);flex-wrap:wrap}
  .attention-strip{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:var(--space-xs);margin-bottom:var(--space-m)}.attention-item{display:grid;grid-template-columns:auto 1fr auto;align-items:center;gap:.55rem;padding:.75rem .85rem;border:1px solid var(--line);border-radius:var(--radius);color:inherit;text-decoration:none;font-size:var(--step--2)}.attention-item:hover{border-color:var(--line-strong);background:var(--accent-wash)}.attention-hot{border-color:color-mix(in srgb,var(--accent) 35%,var(--line))}.attention-icon{width:1.6rem;height:1.6rem;border-radius:50%;display:grid;place-items:center;background:var(--ink);color:var(--on-dark);font-weight:800;font-size:.75rem}.attention-hot .attention-icon{background:var(--accent)}.attention-item strong{font-size:var(--step-0)}
  .metric-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:var(--space-s);margin-bottom:var(--space-l)}.metric-card{border:1px solid var(--line);border-radius:var(--radius);padding:var(--space-m);display:grid;gap:.35rem;min-height:9rem;background:var(--paper-raised)}.metric-hot{border-color:color-mix(in srgb,var(--accent) 35%,var(--line))}.metric-money{background:var(--ink);color:var(--on-dark);border-color:var(--ink)}.metric-label{font-size:var(--step--1);color:var(--ink-soft);font-weight:600}.metric-money .metric-label,.metric-money .metric-note{color:var(--on-dark-soft)}.metric-card strong{font-size:clamp(1.7rem,3vw,2.35rem);line-height:1;letter-spacing:-.03em}.metric-card a{font-size:var(--step--2);color:inherit;font-weight:600;margin-top:auto}.metric-note{font-size:var(--step--2);color:var(--ink-faint)}
  .dash-grid,.insight-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:var(--space-m);margin-bottom:var(--space-m)}.panel{border:1px solid var(--line);border-radius:var(--radius);overflow:hidden;background:var(--paper-raised)}.panel-head{padding:var(--space-m);display:flex;justify-content:space-between;align-items:end;gap:var(--space-s);border-bottom:1px solid var(--line)}.panel-head h2{margin:.12rem 0 0;font-size:var(--step-1)}.panel-link{font-size:var(--step--2);font-weight:700;color:inherit}.panel-body{padding:0 var(--space-m)}
  .task-row,.lead-row,.quote-row,.job-row{display:grid;grid-template-columns:auto 1fr auto auto;gap:.75rem;align-items:center;padding:.85rem 0;border-bottom:1px solid var(--line);color:inherit;text-decoration:none}.task-row:last-child,.lead-row:last-child,.quote-row:last-child,.job-row:last-child{border-bottom:0}.row-main{min-width:0;display:grid;gap:.16rem}.row-main strong{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.row-main small,.row-meta small{color:var(--ink-soft);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.row-actions{display:flex;gap:.5rem;align-items:center}.row-actions a,.row-actions button{font:inherit;font-size:var(--step--2);font-weight:700;border:0;background:none;padding:0;color:inherit;text-decoration:underline;cursor:pointer}.row-meta{display:grid;justify-items:end;gap:.2rem;font-size:var(--step--2);white-space:nowrap}.avatar{width:2rem;height:2rem;border-radius:50%;display:grid;place-items:center;background:var(--ink);color:var(--on-dark);font-weight:800;font-size:.8rem}.task-dot{width:.65rem;height:.65rem;border-radius:50%;background:var(--line-strong)}.task-dot.is-overdue{background:var(--danger)}.job-status{font-size:.72rem;font-weight:800;text-transform:uppercase;letter-spacing:.06em}.quote-status{font-size:.72rem;font-weight:800;text-transform:uppercase;letter-spacing:.05em}.quote-status.is-final{color:var(--accent-ink)}.quote-status.is-draft{color:var(--ink-soft)}.empty,.muted{padding:var(--space-m) 0;color:var(--ink-faint)}
  .insight-list{padding:0 var(--space-m)}.insight-row{display:flex;justify-content:space-between;gap:var(--space-m);padding:.75rem 0;border-bottom:1px solid var(--line)}.insight-row:last-child{border-bottom:0}
  .pipeline-panel{margin-bottom:var(--space-m)}.pipeline-total{font-size:var(--step--1);font-weight:700;color:var(--ink-soft)}.pipeline-body{display:grid;grid-template-columns:repeat(3,1fr);gap:var(--space-m);padding:var(--space-m)}.pipeline-stage{display:grid;gap:.4rem}.stage-top{display:flex;justify-content:space-between;gap:var(--space-s)}.progress{height:.5rem;background:var(--line);border-radius:999px;overflow:hidden}.progress span{display:block;height:100%;width:0;background:var(--accent)}.pipeline-stage small{color:var(--ink-faint)}.pipeline-summary{align-content:center}
  .quick-actions{border:1px solid var(--line);border-radius:var(--radius);padding:var(--space-m);margin-bottom:var(--space-m);background:var(--paper-raised)}.quick-actions h2{margin:.15rem 0 0}.quick-links{display:grid;grid-template-columns:repeat(4,1fr);gap:var(--space-xs);margin-top:var(--space-m)}.quick-links a{display:grid;gap:.25rem;padding:1rem;border:1px solid var(--line);border-radius:var(--radius);color:inherit;text-decoration:none}.quick-links a:hover{border-color:var(--line-strong);background:var(--accent-wash)}.quick-links span{font-size:var(--step--2);color:var(--ink-faint);font-weight:800}.quick-links small{color:var(--ink-soft)}.dash-status{font-size:var(--step--2);color:var(--ink-faint);margin:var(--space-s) 0}
  @media(max-width:900px){.metric-grid{grid-template-columns:repeat(2,1fr)}.pipeline-body{grid-template-columns:1fr 1fr}.quick-links{grid-template-columns:repeat(2,1fr)}}
  @media(max-width:700px){.attention-strip,.dash-grid,.insight-grid{grid-template-columns:1fr}.dash-head{align-items:flex-start;flex-direction:column}.pipeline-body{grid-template-columns:1fr}.quick-links{grid-template-columns:1fr}.task-row,.lead-row,.quote-row,.job-row{grid-template-columns:auto 1fr auto}.row-meta{grid-column:2/-1;justify-items:start}.row-actions{grid-column:3}}
</style>
