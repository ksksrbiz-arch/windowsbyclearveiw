---
import InternalLayout from '../../layouts/InternalLayout.astro';
---
<InternalLayout title="Command Center">
  <div class="dash-head">
    <div>
      <p class="kicker">Clearview internal</p>
      <h1>Command Center</h1>
      <p class="lede">A field-friendly snapshot of leads, quotes, and the work that needs attention.</p>
    </div>
    <div class="dash-actions">
      <a class="btn btn-primary" href="/internal/quotes/new">New quote</a>
      <a class="btn btn-ghost" href="/internal/leads">All leads</a>
    </div>
  </div>

  <section class="metric-grid" aria-label="Business snapshot">
    <article class="metric-card metric-hot">
      <span class="metric-label">New leads</span>
      <strong data-metric="newLeads">—</strong>
      <span class="metric-note">Last 7 days</span>
      <a href="/internal/leads">View leads →</a>
    </article>
    <article class="metric-card">
      <span class="metric-label">Open quotes</span>
      <strong data-metric="draftQuotes">—</strong>
      <span class="metric-note">Drafts waiting on action</span>
      <a href="/internal/quotes">View quotes →</a>
    </article>
    <article class="metric-card">
      <span class="metric-label">Signed quotes</span>
      <strong data-metric="finalizedQuotes">—</strong>
      <span class="metric-note">Finalized contracts</span>
      <a href="/internal/quotes">Open quote list →</a>
    </article>
    <article class="metric-card metric-money">
      <span class="metric-label">Quoted value</span>
      <strong data-metric="openValue">—</strong>
      <span class="metric-note">Current draft pipeline</span>
      <span class="metric-foot">Based on quote totals</span>
    </article>
  </section>

  <div class="dash-grid">
    <section class="panel">
      <div class="panel-head">
        <div>
          <p class="kicker">Needs attention</p>
          <h2>Recent leads</h2>
        </div>
        <a class="panel-link" href="/internal/leads">See all</a>
      </div>
      <div class="panel-body" data-leads-body>
        <p class="muted">Loading leads…</p>
      </div>
    </section>

    <section class="panel">
      <div class="panel-head">
        <div>
          <p class="kicker">Sales pipeline</p>
          <h2>Recent quotes</h2>
        </div>
        <a class="panel-link" href="/internal/quotes">See all</a>
      </div>
      <div class="panel-body" data-quotes-body>
        <p class="muted">Loading quotes…</p>
      </div>
    </section>
  </div>

  <section class="quick-actions">
    <div>
      <p class="kicker">Quick actions</p>
      <h2>Keep the workflow moving</h2>
    </div>
    <div class="quick-links">
      <a href="/internal/quotes/new"><span>＋</span><strong>Build a quote</strong><small>Start a firm-price estimate</small></a>
      <a href="/internal/leads"><span>↗</span><strong>Work your leads</strong><small>Call, email, and review visitor journeys</small></a>
      <a href="/internal/ask-logs"><span>✦</span><strong>Review Ask activity</strong><small>See questions visitors asked the AI assistant</small></a>
    </div>
  </section>

  <p class="dash-status" data-status role="status">Refreshing business snapshot…</p>
</InternalLayout>

<script>
  type Lead = {
    id: string;
    created_at: string;
    name: string;
    phone?: string;
    email?: string;
    city?: string;
    role?: string;
    notes?: string;
  };

  type Quote = {
    id: string;
    created_at: string;
    status: string;
    customer_name: string;
    customer_city?: string;
    total_cents: number;
    signature_method?: string;
  };

  function initDashboard() {
    if (document.body.dataset.dashboardBound === 'true') return;
    document.body.dataset.dashboardBound = 'true';

    const $ = <T extends Element>(selector: string) => document.querySelector(selector) as T | null;
    const money = (cents: number) => new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD', maximumFractionDigits: 0 }).format((Number(cents) || 0) / 100);
    const date = (iso: string) => {
      const value = new Date(iso);
      return Number.isNaN(value.getTime()) ? '' : value.toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
    };
    const escape = (value: string | undefined) => {
      const node = document.createElement('div');
      node.textContent = value || '';
      return node.innerHTML;
    };
    const tel = (phone: string | undefined) => {
      const digits = String(phone || '').replace(/\D/g, '');
      if (!digits) return '';
      if (digits.length === 10) return `tel:+1${digits}`;
      if (digits.length === 11 && digits.startsWith('1')) return `tel:+${digits}`;
      return `tel:${digits}`;
    };

    async function load() {
      try {
        const [leadsResponse, quotesResponse] = await Promise.all([
          fetch('/internal/api/leads', { headers: { 'cache-control': 'no-cache' } }),
          fetch('/internal/api/quotes', { headers: { 'cache-control': 'no-cache' } }),
        ]);
        if (!leadsResponse.ok || !quotesResponse.ok) throw new Error('Request failed');

        const [{ leads }, { quotes }] = await Promise.all([leadsResponse.json(), quotesResponse.json()]) as [{ leads: Lead[] }, { quotes: Quote[] }];
        const weekAgo = Date.now() - 7 * 24 * 60 * 60 * 1000;
        const recentLeads = leads.filter((lead) => new Date(lead.created_at).getTime() >= weekAgo);
        const drafts = quotes.filter((quote) => quote.status === 'draft');
        const finalized = quotes.filter((quote) => quote.status === 'finalized');
        const openValue = drafts.reduce((sum, quote) => sum + (Number(quote.total_cents) || 0), 0);

        const setMetric = (name: string, value: string) => {
          const el = document.querySelector(`[data-metric="${name}"]`);
          if (el) el.textContent = value;
        };
        setMetric('newLeads', String(recentLeads.length));
        setMetric('draftQuotes', String(drafts.length));
        setMetric('finalizedQuotes', String(finalized.length));
        setMetric('openValue', money(openValue));

        const leadsBody = $('[data-leads-body]');
        if (leadsBody) {
          const rows = recentLeads.slice(0, 6).map((lead) => {
            const phone = tel(lead.phone);
            return `<a class="lead-row" href="/internal/leads">
              <span class="avatar">${escape((lead.name || '?').slice(0, 1).toUpperCase())}</span>
              <span class="row-main"><strong>${escape(lead.name)}</strong><small>${escape([lead.city, lead.role].filter(Boolean).join(' · ') || 'Estimate request')}</small></span>
              <span class="row-meta"><time>${date(lead.created_at)}</time>${phone ? `<span>${escape(lead.phone)}</span>` : ''}</span>
            </a>`;
          }).join('');
          leadsBody.innerHTML = rows || '<p class="empty">No estimate requests in the last 7 days.</p>';
        }

        const quotesBody = $('[data-quotes-body]');
        if (quotesBody) {
          const rows = quotes.slice(0, 6).map((quote) => {
            const finalizedLabel = quote.status === 'finalized' ? 'Finalized' : 'Draft';
            const statusClass = quote.status === 'finalized' ? 'is-final' : 'is-draft';
            return `<a class="quote-row" href="/internal/quotes">
              <span class="quote-status ${statusClass}">${finalizedLabel}</span>
              <span class="row-main"><strong>${escape(quote.customer_name)}</strong><small>${escape([quote.customer_city, quote.id].filter(Boolean).join(' · '))}</small></span>
              <span class="row-meta"><strong>${money(Number(quote.total_cents) || 0)}</strong><time>${date(quote.created_at)}</time></span>
            </a>`;
          }).join('');
          quotesBody.innerHTML = rows || '<p class="empty">No quotes yet. Start the first one.</p>';
        }

        const status = $('[data-status]');
        if (status) status.textContent = `Updated ${new Date().toLocaleTimeString('en-US', { hour: 'numeric', minute: '2-digit' })}`;
      } catch (error) {
        const status = $('[data-status]');
        if (status) status.textContent = 'Could not refresh the snapshot. The underlying lead and quote pages are still available.';
        const leadsBody = $('[data-leads-body]');
        const quotesBody = $('[data-quotes-body]');
        if (leadsBody) leadsBody.innerHTML = '<p class="empty">Could not load leads.</p>';
        if (quotesBody) quotesBody.innerHTML = '<p class="empty">Could not load quotes.</p>';
      }
    }

    load();
  }

  initDashboard();
  document.addEventListener('astro:page-load', initDashboard);
</script>

<style>
  .dash-head { display: flex; justify-content: space-between; align-items: end; gap: var(--space-m); margin-bottom: var(--space-l); }
  .dash-actions { display: flex; gap: var(--space-xs); flex-wrap: wrap; }
  .metric-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--space-s); margin-bottom: var(--space-l); }
  .metric-card { border: 1px solid var(--line); border-radius: var(--radius); padding: var(--space-m); display: grid; gap: 0.35rem; min-height: 9rem; background: var(--paper-raised, var(--paper)); }
  .metric-hot { border-color: color-mix(in srgb, var(--accent) 35%, var(--line)); }
  .metric-money { background: var(--ink); color: var(--on-dark); border-color: var(--ink); }
  .metric-label { font-size: var(--step--1); color: var(--ink-soft); font-weight: 600; }
  .metric-money .metric-label, .metric-money .metric-note, .metric-money .metric-foot { color: var(--on-dark-soft); }
  .metric-card strong { font-size: clamp(1.7rem, 3vw, 2.35rem); line-height: 1; letter-spacing: -0.03em; }
  .metric-card a { font-size: var(--step--2); color: inherit; font-weight: 600; margin-top: auto; }
  .metric-note, .metric-foot { font-size: var(--step--2); color: var(--ink-faint); }

  .dash-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: var(--space-m); }
  .panel { border: 1px solid var(--line); border-radius: var(--radius); overflow: hidden; background: var(--paper-raised, var(--paper)); }
  .panel-head { padding: var(--space-m); display: flex; justify-content: space-between; align-items: end; gap: var(--space-s); border-bottom: 1px solid var(--line); }
  .panel-head h2 { margin: 0.12rem 0 0; font-size: var(--step-1); }
  .panel-link { font-size: var(--step--1); font-weight: 600; white-space: nowrap; }
  .panel-body { padding: 0; }
  .lead-row, .quote-row { display: grid; grid-template-columns: auto minmax(0, 1fr) auto; gap: var(--space-xs); align-items: center; padding: 0.85rem var(--space-m); color: inherit; text-decoration: none; border-bottom: 1px solid var(--line); }
  .lead-row:last-child, .quote-row:last-child { border-bottom: 0; }
  .lead-row:hover, .quote-row:hover { background: color-mix(in srgb, var(--accent) 6%, transparent); }
  .avatar { width: 2.1rem; height: 2.1rem; border-radius: 50%; display: grid; place-items: center; background: var(--ink); color: var(--on-dark); font-size: var(--step--2); font-weight: 700; }
  .row-main { min-width: 0; display: grid; gap: 0.15rem; }
  .row-main strong, .row-main small { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .row-main small, .row-meta { font-size: var(--step--2); color: var(--ink-soft); }
  .row-meta { display: grid; gap: 0.12rem; text-align: right; white-space: nowrap; }
  .row-meta strong { color: var(--ink); }
  .quote-status { padding: 0.25rem 0.45rem; border-radius: 999px; font-size: var(--step--2); font-weight: 700; }
  .is-draft { background: color-mix(in srgb, var(--accent) 14%, var(--paper)); color: var(--ink); }
  .is-final { background: color-mix(in srgb, var(--ink) 10%, var(--paper)); color: var(--ink); }
  .empty, .muted { margin: 0; padding: var(--space-m); color: var(--ink-soft); font-size: var(--step--1); }

  .quick-actions { margin-top: var(--space-m); border: 1px solid var(--line); border-radius: var(--radius); padding: var(--space-m); }
  .quick-actions h2 { margin: 0.12rem 0 0; font-size: var(--step-1); }
  .quick-links { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-xs); margin-top: var(--space-s); }
  .quick-links a { display: grid; grid-template-columns: auto 1fr; gap: 0.2rem var(--space-xs); padding: 0.85rem; border: 1px solid var(--line); border-radius: var(--radius); color: inherit; text-decoration: none; }
  .quick-links a:hover { border-color: var(--line-strong); transform: translateY(-1px); }
  .quick-links span { grid-row: span 2; font-size: 1.25rem; }
  .quick-links strong { font-size: var(--step--1); }
  .quick-links small { color: var(--ink-soft); font-size: var(--step--2); }
  .dash-status { margin: var(--space-s) 0 0; font-size: var(--step--2); color: var(--ink-faint); text-align: right; }

  @media (max-width: 800px) {
    .metric-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .dash-grid { grid-template-columns: 1fr; }
    .quick-links { grid-template-columns: 1fr; }
  }
  @media (max-width: 560px) {
    .dash-head { align-items: start; flex-direction: column; }
    .metric-grid { grid-template-columns: 1fr 1fr; gap: var(--space-xs); }
    .metric-card { min-height: 8rem; padding: var(--space-s); }
    .lead-row, .quote-row { padding-inline: var(--space-s); }
    .row-meta span { display: none; }
  }
</style>
