---
import InternalLayout from '../../layouts/InternalLayout.astro';
---
<InternalLayout title="Command Center">
  <div class="dash-head">
    <div>
      <p class="kicker">Clearview internal</p>
      <h1>Command Center</h1>
      <p class="lede">The daily operating view for leads, quotes, and sales activity.</p>
    </div>
    <div class="dash-actions">
      <button class="btn btn-ghost" type="button" data-refresh>Refresh</button>
      <a class="btn btn-primary" href="/internal/quotes/new">New quote</a>
    </div>
  </div>

  <section class="attention-strip" aria-label="Priority work">
    <a class="attention-item attention-hot" href="/internal/leads"><span class="attention-icon">!</span><span><strong data-attention-leads>—</strong> new lead<span data-lead-plural>s</span> to review</span><span>→</span></a>
    <a class="attention-item" href="/internal/quotes"><span class="attention-icon">$</span><span><strong data-attention-drafts>—</strong> quote<span data-quote-plural>s</span> still in draft</span><span>→</span></a>
    <a class="attention-item" href="/internal/quotes"><span class="attention-icon">✓</span><span><strong data-attention-finalized>—</strong> signed contract<span data-final-plural>s</span></span><span>→</span></a>
  </section>

  <section class="metric-grid" aria-label="Business snapshot">
    <article class="metric-card metric-hot"><span class="metric-label">New leads</span><strong data-metric="newLeads">—</strong><span class="metric-note">Last 7 days</span><a href="/internal/leads">Work leads →</a></article>
    <article class="metric-card"><span class="metric-label">Open quotes</span><strong data-metric="draftQuotes">—</strong><span class="metric-note">Drafts awaiting action</span><a href="/internal/quotes">Open quote list →</a></article>
    <article class="metric-card"><span class="metric-label">Signed quotes</span><strong data-metric="finalizedQuotes">—</strong><span class="metric-note">Finalized contracts</span><a href="/internal/quotes">Review signed work →</a></article>
    <article class="metric-card metric-money"><span class="metric-label">Open quoted value</span><strong data-metric="openValue">—</strong><span class="metric-note">Draft pipeline</span><span class="metric-foot">Not booked sales</span></article>
  </section>

  <div class="dash-grid">
    <section class="panel">
      <div class="panel-head"><div><p class="kicker">Inbound</p><h2>Recent leads</h2></div><a class="panel-link" href="/internal/leads">See all</a></div>
      <div class="panel-body" data-leads-body><p class="muted">Loading leads…</p></div>
    </section>
    <section class="panel">
      <div class="panel-head"><div><p class="kicker">Sales</p><h2>Recent quotes</h2></div><a class="panel-link" href="/internal/quotes">See all</a></div>
      <div class="panel-body" data-quotes-body><p class="muted">Loading quotes…</p></div>
    </section>
  </div>

  <div class="insight-grid">
    <section class="panel"><div class="panel-head"><div><p class="kicker">Lead intelligence</p><h2>Where leads came from</h2></div></div><div class="insight-list" data-source-body><p class="muted">Loading…</p></div></section>
    <section class="panel"><div class="panel-head"><div><p class="kicker">Service area</p><h2>Recent lead locations</h2></div></div><div class="insight-list" data-city-body><p class="muted">Loading…</p></div></section>
  </div>

  <section class="pipeline-panel panel">
    <div class="panel-head"><div><p class="kicker">Quote pipeline</p><h2>Value by stage</h2></div><span class="pipeline-total" data-pipeline-total>—</span></div>
    <div class="pipeline-body">
      <div class="pipeline-stage"><div class="stage-top"><span>Drafts</span><strong data-stage-drafts>—</strong></div><div class="progress"><span data-progress-drafts></span></div><small data-stage-drafts-value>—</small></div>
      <div class="pipeline-stage"><div class="stage-top"><span>Finalized</span><strong data-stage-finalized>—</strong></div><div class="progress"><span data-progress-finalized></span></div><small data-stage-finalized-value>—</small></div>
      <div class="pipeline-stage pipeline-summary"><span>Average finalized quote</span><strong data-average-finalized>—</strong><small>Based only on finalized quotes</small></div>
    </div>
  </section>

  <section class="quick-actions">
    <div><p class="kicker">Quick actions</p><h2>Keep the workflow moving</h2></div>
    <div class="quick-links">
      <a href="/internal/quotes/new"><span>＋</span><strong>Build a quote</strong><small>Start a firm-price estimate</small></a>
      <a href="/internal/leads"><span>↗</span><strong>Work leads</strong><small>Review customer details and visitor journeys</small></a>
      <a href="/internal/ask-logs"><span>✦</span><strong>Review Ask</strong><small>See what prospects asked the assistant</small></a>
    </div>
  </section>

  <p class="dash-status" data-status role="status">Refreshing business snapshot…</p>
</InternalLayout>

<script>
  type Lead = { id: number|string; created_at: string; name: string; phone?: string; city?: string; role?: string };
  type Quote = { id: string; created_at: string; status: string; customer_name: string; customer_city?: string; total_cents: number };
  type CountRow = { source?: string; city?: string; count: number };
  type Snapshot = {
    counts: { new_leads?: number; draft_quotes?: number; finalized_quotes?: number; draft_value_cents?: number; finalized_value_cents?: number; total_quotes?: number };
    recentLeads: Lead[];
    recentQuotes: Quote[];
    sources: CountRow[];
    cities: CountRow[];
  };

  function initDashboard() {
    if (document.body.dataset.dashboardBound === 'true') return;
    document.body.dataset.dashboardBound = 'true';

    const $ = <T extends Element>(s: string) => document.querySelector(s) as T | null;
    const text = (s: string, v: string) => { const e = $(s); if (e) e.textContent = v; };
    const money = (cents: number) => new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD', maximumFractionDigits: 0 }).format((Number(cents) || 0) / 100);
    const day = (iso: string) => { const d = new Date(iso); return Number.isNaN(d.getTime()) ? '' : d.toLocaleDateString('en-US', { month: 'short', day: 'numeric' }); };
    const esc = (v: unknown) => { const d = document.createElement('div'); d.textContent = String(v ?? ''); return d.innerHTML; };

    async function load() {
      const refresh = $('[data-refresh]') as HTMLButtonElement | null;
      if (refresh) { refresh.disabled = true; refresh.textContent = 'Refreshing…'; }
      try {
        const response = await fetch('/internal/api/dashboard', { headers: { 'cache-control': 'no-cache' } });
        if (!response.ok) throw new Error('Request failed');
        const data = await response.json() as Snapshot;
        const counts = data.counts || {};
        const recentLeads = data.recentLeads || [];
        const recentQuotes = data.recentQuotes || [];
        const draftValue = Number(counts.draft_value_cents) || 0;
        const finalValue = Number(counts.finalized_value_cents) || 0;
        const totalValue = draftValue + finalValue;
        const finalizedCount = Number(counts.finalized_quotes) || 0;

        text('[data-metric="newLeads"]', String(Number(counts.new_leads) || 0));
        text('[data-metric="draftQuotes"]', String(Number(counts.draft_quotes) || 0));
        text('[data-metric="finalizedQuotes"]', String(finalizedCount));
        text('[data-metric="openValue"]', money(draftValue));
        text('[data-attention-leads]', String(Number(counts.new_leads) || 0));
        text('[data-attention-drafts]', String(Number(counts.draft_quotes) || 0));
        text('[data-attention-finalized]', String(finalizedCount));
        if ((Number(counts.new_leads) || 0) === 1) text('[data-lead-plural]', '');
        if ((Number(counts.draft_quotes) || 0) === 1) text('[data-quote-plural]', '');
        if (finalizedCount === 1) text('[data-final-plural]', '');

        text('[data-pipeline-total]', `${Number(counts.total_quotes) || 0} quotes`);
        text('[data-stage-drafts]', String(Number(counts.draft_quotes) || 0));
        text('[data-stage-finalized]', String(finalizedCount));
        text('[data-stage-drafts-value]', money(draftValue));
        text('[data-stage-finalized-value]', money(finalValue));
        text('[data-average-finalized]', finalizedCount ? money(finalValue / finalizedCount) : '—');
        const dp = $('[data-progress-drafts]') as HTMLElement | null;
        const fp = $('[data-progress-finalized]') as HTMLElement | null;
        if (dp) dp.style.width = `${totalValue ? draftValue / totalValue * 100 : 0}%`;
        if (fp) fp.style.width = `${totalValue ? finalValue / totalValue * 100 : 0}%`;

        const leadsBody = $('[data-leads-body]');
        if (leadsBody) leadsBody.innerHTML = recentLeads.map((l) => `<div class="lead-row"><span class="avatar">${esc((l.name || '?')[0].toUpperCase())}</span><span class="row-main"><strong>${esc(l.name)}</strong><small>${esc([l.city, l.role].filter(Boolean).join(' · ') || 'Estimate request')}</small></span><span class="row-actions"><a href="/internal/leads">Open</a>${l.phone ? `<a href="tel:${esc(l.phone.replace(/\D/g, ''))}">Call</a>` : ''}</span><span class="row-meta"><time>${day(l.created_at)}</time></span></div>`).join('') || '<p class="empty">No recent estimate requests.</p>';

        const quotesBody = $('[data-quotes-body]');
        if (quotesBody) quotesBody.innerHTML = recentQuotes.map((q) => `<a class="quote-row" href="/internal/quotes/view?id=${encodeURIComponent(q.id)}"><span class="quote-status ${q.status === 'finalized' ? 'is-final' : 'is-draft'}">${q.status === 'finalized' ? 'Finalized' : 'Draft'}</span><span class="row-main"><strong>${esc(q.customer_name)}</strong><small>${esc([q.customer_city, q.id].filter(Boolean).join(' · '))}</small></span><span class="row-meta"><strong>${money(Number(q.total_cents) || 0)}</strong><time>${day(q.created_at)}</time></span></a>`).join('') || '<p class="empty">No quotes yet. Start the first one.</p>';

        const renderCounts = (rows: CountRow[], field: 'source'|'city') => rows.length ? rows.map((r) => `<div class="insight-row"><span>${esc(r[field] || '')}</span><strong>${Number(r.count) || 0}</strong></div>`).join('') : '<p class="empty">Not enough data yet.</p>';
        const sb = $('[data-source-body]'); if (sb) sb.innerHTML = renderCounts(data.sources || [], 'source');
        const cb = $('[data-city-body]'); if (cb) cb.innerHTML = renderCounts(data.cities || [], 'city');

        const status = $('[data-status]'); if (status) status.textContent = `Updated ${new Date().toLocaleTimeString('en-US', { hour: 'numeric', minute: '2-digit' })}`;
      } catch {
        const status = $('[data-status]'); if (status) status.textContent = 'Could not refresh the snapshot. The lead and quote pages are still available.';
      } finally {
        if (refresh) { refresh.disabled = false; refresh.textContent = 'Refresh'; }
      }
    }
    const refresh = $('[data-refresh]'); if (refresh) refresh.addEventListener('click', load);
    load();
  }

  initDashboard();
  document.addEventListener('astro:page-load', initDashboard);
</script>

<style>
  .dash-head { display: flex; justify-content: space-between; align-items: end; gap: var(--space-m); margin-bottom: var(--space-m); }
  .dash-actions { display: flex; gap: var(--space-xs); flex-wrap: wrap; }
  .attention-strip { display: grid; grid-template-columns: repeat(3, minmax(0,1fr)); gap: var(--space-xs); margin-bottom: var(--space-m); }
  .attention-item { display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: 0.55rem; padding: 0.75rem 0.85rem; border: 1px solid var(--line); border-radius: var(--radius); color: inherit; text-decoration: none; font-size: var(--step--2); }
  .attention-item:hover { border-color: var(--line-strong); background: var(--accent-wash); }
  .attention-hot { border-color: color-mix(in srgb, var(--accent) 35%, var(--line)); }
  .attention-icon { width: 1.6rem; height: 1.6rem; border-radius: 50%; display: grid; place-items: center; background: var(--ink); color: var(--on-dark); font-weight: 800; font-size: 0.75rem; }
  .attention-hot .attention-icon { background: var(--accent); }
  .attention-item strong { font-size: var(--step-0); }
  .metric-grid { display: grid; grid-template-columns: repeat(4, minmax(0,1fr)); gap: var(--space-s); margin-bottom: var(--space-l); }
  .metric-card { border: 1px solid var(--line); border-radius: var(--radius); padding: var(--space-m); display: grid; gap: 0.35rem; min-height: 9rem; background: var(--paper-raised); }
  .metric-hot { border-color: color-mix(in srgb, var(--accent) 35%, var(--line)); }
  .metric-money { background: var(--ink); color: var(--on-dark); border-color: var(--ink); }
  .metric-label { font-size: var(--step--1); color: var(--ink-soft); font-weight: 600; }
  .metric-money .metric-label, .metric-money .metric-note, .metric-money .metric-foot { color: var(--on-dark-soft); }
  .metric-card strong { font-size: clamp(1.7rem, 3vw, 2.35rem); line-height: 1; letter-spacing: -0.03em; }
  .metric-card a { font-size: var(--step--2); color: inherit; font-weight: 600; margin-top: auto; }
  .metric-note, .metric-foot { font-size: var(--step--2); color: var(--ink-faint); }
  .dash-grid, .insight-grid { display: grid; grid-template-columns: repeat(2, minmax(0,1fr)); gap: var(--space-m); }
  .panel { border: 1px solid var(--line); border-radius: var(--radius); overflow: hidden; background: var(--paper-raised); }
  .panel-head { padding: var(--space-m); display: flex; justify-content: space-between; align-items: end; gap: var(--space-s); border-bottom: 1px solid var(--line); }
  .panel-head h2 { margin: 0.12rem 0 0; font-size: var(--step-1); }
  .panel-link { font-size: var(--step--1); font-weight: 600; white-space: nowrap; }
  .panel-body { padding: 0; }
  .lead-row, .quote-row { display: grid; grid-template-columns: auto minmax(0,1fr) auto auto; gap: var(--space-xs); align-items: center; padding: 0.8rem var(--space-m); border-bottom: 1px solid var(--line); color: inherit; text-decoration: none; }
  .lead-row:last-child, .quote-row:last-child { border-bottom: 0; }
  .lead-row:hover, .quote-row:hover { background: color-mix(in srgb, var(--accent) 6%, transparent); }
  .avatar { width: 2.1rem; height: 2.1rem; border-radius: 50%; display: grid; place-items: center; background: var(--ink); color: var(--on-dark); font-size: var(--step--2); font-weight: 700; }
  .row-main { min-width: 0; display: grid; gap: 0.15rem; }
  .row-main strong, .row-main small { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .row-main small, .row-meta { font-size: var(--step--2); color: var(--ink-soft); }
  .row-meta { display: grid; gap: 0.12rem; text-align: right; white-space: nowrap; }
  .row-meta strong { color: var(--ink); }
  .row-actions { display: flex; gap: 0.4rem; font-size: var(--step--2); font-weight: 700; }
  .quote-status { padding: 0.25rem 0.45rem; border-radius: 999px; font-size: var(--step--2); font-weight: 700; }
  .is-draft { background: color-mix(in srgb, var(--accent) 14%, var(--paper)); color: var(--ink); }
  .is-final { background: color-mix(in srgb, var(--ink) 10%, var(--paper)); color: var(--ink); }
  .empty, .muted { margin: 0; padding: var(--space-m); color: var(--ink-soft); font-size: var(--step--1); }
  .insight-grid { margin-top: var(--space-m); }
  .insight-list { padding: 0.25rem 0; }
  .insight-row { display: flex; justify-content: space-between; gap: var(--space-s); padding: 0.7rem var(--space-m); border-bottom: 1px solid var(--line); font-size: var(--step--1); }
  .insight-row:last-child { border-bottom: 0; }
  .pipeline-panel { margin-top: var(--space-m); }
  .pipeline-total { font-size: var(--step--2); color: var(--ink-soft); }
  .pipeline-body { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: var(--space-m); padding: var(--space-m); }
  .pipeline-stage { min-width: 0; }
  .stage-top { display: flex; justify-content: space-between; font-size: var(--step--1); }
  .stage-top strong { font-size: var(--step-1); }
  .progress { height: 0.4rem; margin: 0.6rem 0 0.4rem; border-radius: 999px; background: var(--paper-sunk); overflow: hidden; }
  .progress span { display: block; height: 100%; width: 0; border-radius: inherit; background: var(--accent); transition: width 240ms ease; }
  .pipeline-stage small { font-size: var(--step--2); color: var(--ink-soft); }
  .pipeline-summary { display: grid; align-content: center; padding-left: var(--space-m); border-left: 1px solid var(--line); }
  .pipeline-summary span, .pipeline-summary small { color: var(--ink-soft); font-size: var(--step--2); }
  .pipeline-summary strong { display: block; margin: 0.25rem 0; font-size: var(--step-2); letter-spacing: -0.03em; }
  .quick-actions { margin-top: var(--space-m); border: 1px solid var(--line); border-radius: var(--radius); padding: var(--space-m); }
  .quick-actions h2 { margin: 0.12rem 0 0; font-size: var(--step-1); }
  .quick-links { display: grid; grid-template-columns: repeat(3, minmax(0,1fr)); gap: var(--space-xs); margin-top: var(--space-s); }
  .quick-links a { display: grid; grid-template-columns: auto 1fr; gap: 0.2rem var(--space-xs); padding: 0.85rem; border: 1px solid var(--line); border-radius: var(--radius); color: inherit; text-decoration: none; }
  .quick-links a:hover { border-color: var(--line-strong); transform: translateY(-1px); }
  .quick-links span { grid-row: span 2; font-size: 1.25rem; }
  .quick-links strong { font-size: var(--step--1); }
  .quick-links small { color: var(--ink-soft); font-size: var(--step--2); }
  .dash-status { margin: var(--space-s) 0 0; font-size: var(--step--2); color: var(--ink-faint); text-align: right; }
  @media (max-width: 900px) { .metric-grid, .attention-strip { grid-template-columns: repeat(2, minmax(0,1fr)); } .attention-strip .attention-item:last-child { grid-column: 1 / -1; } .dash-grid, .insight-grid { grid-template-columns: 1fr; } .pipeline-body { grid-template-columns: 1fr 1fr; } .pipeline-summary { grid-column: 1 / -1; border-left: 0; border-top: 1px solid var(--line); padding: var(--space-m) 0 0; } .quick-links { grid-template-columns: 1fr; } }
  @media (max-width: 560px) { .dash-head { align-items: start; flex-direction: column; } .metric-grid, .attention-strip { grid-template-columns: 1fr; } .attention-strip .attention-item:last-child { grid-column: auto; } .metric-card { min-height: 8rem; padding: var(--space-s); } .lead-row, .quote-row { grid-template-columns: auto minmax(0,1fr); padding-inline: var(--space-s); } .row-actions, .row-meta { grid-column: 2; justify-self: start; text-align: left; } .pipeline-body { grid-template-columns: 1fr; } .pipeline-summary { grid-column: auto; } }
</style>
