---
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaBar from '../components/CtaBar.astro';
---
<BaseLayout
  title="Window replacement"
  description="Replacement windows for Vancouver and Clark County homes: full-frame and insert installs, from measure to finish."
  path="/replacement"
  crumbs={[{ name: 'Window replacement', href: '/replacement' }]}
>
  <section class="page-hero">
    <div class="wrap">
      <p class="kicker">Services</p>
      <h1>Window replacement</h1>
      <p class="lede">
        Tired, leaky, or single-pane units out. The right replacement in the same opening —
        without wrecking the siding or the interior finish.
      </p>
    </div>
  </section>
  <section class="section">
    <div class="wrap split">
      <article>
        <h2>Full-frame replacement</h2>
        <p>
          The old window and frame come out to the rough opening. This is the right call when the
          frame is rotten, out of square, or you want to change the look of the exterior trim.
        </p>
        <h2>Insert / pocket replacement</h2>
        <p>
          A new sash and frame set into a sound existing frame. Faster, less disruption, and often
          less cost when the opening is still structurally good.
        </p>
      </article>
      <article>
        <p class="kicker">Typical install</p>
        <ul class="plain-list">
          <li>Vinyl replacement windows</li>
          <li>Fiberglass when the opening and budget want it</li>
          <li>Double- and triple-pane insulated glass</li>
          <li>Low-E coatings matched to your climate</li>
          <li>Picture, slider, single-hung, and casement</li>
        </ul>
        <p class="fine-print">Brand list goes here once Mark confirms manufacturers.</p>
      </article>
    </div>
  </section>
  <CtaBar />
</BaseLayout>
