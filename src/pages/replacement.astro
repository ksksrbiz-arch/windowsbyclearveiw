---
import { getImage, Image } from 'astro:assets';
import vinylFiberglassGraphic from '../assets/guides/vinyl-fiberglass-guide.png';
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaBar from '../components/CtaBar.astro';
import WorkCard from '../components/WorkCard.astro';
import { replacementWork, findWork, workKindLabel } from '../data/work';
import { site } from '../data/site';

const ogPhoto = findWork('vaulted-grids')!;

// The replacement page should lead with a finished replacement, not a
// generated house. The gallery already has a strong real Clearview elevation
// that makes the service immediately legible without implying a specific
// product line.
// Customer-facing material diagrams live on /window-features and the guides,
// so this page avoids duplicating the older frame-material schematic.
const heroPhoto = findWork('stone-craftsman')!;
const heroBg = await getImage({ src: heroPhoto.image, width: 2400, format: 'webp', quality: 76 });

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  serviceType: 'Window replacement',
  name: 'Window replacement',
  description:
    'Window replacement for existing Vancouver, WA and Clark County homes, measured on site and quoted in writing.',
  provider: { '@id': `${site.url}/#business` },
  areaServed: site.nearby.map((place) => ({
    '@type': 'City',
    name: place.name,
    containedInPlace: { '@type': 'State', name: place.state },
  })),
};

const offers = [
  {
    title: 'Measured at the opening',
    text: 'Nobody can size a window from a photo. We measure every opening in person and check the condition of what is already there.',
  },
  {
    title: 'The right approach, in writing',
    text: 'We measure every opening and tell you the right approach in the written estimate, opening by opening, before anything is ordered.',
  },
  {
    title: 'Interior trim and exterior look',
    text: 'Keeping your existing trim and siding, or changing the exterior trim, sightline, or window style: tell us which you want and we quote it.',
  },
  {
    title: 'Damage found is damage explained',
    text: 'If an opening turns out to have rot or has moved out of square, we tell you what it changes in the scope and the price.',
  },
];

const spec = [
  ['Materials', 'Vinyl and fiberglass, in the sizes Clark County houses actually have'],
  ['Glass', 'Double- and triple-pane insulated units'],
  ['Coatings', 'Low-E matched to a Pacific Northwest heating season'],
  ['Styles', 'Picture, slider, single- and double-hung, casement, awning'],
  ['Openings', 'Standard, arched, and gable shapes measured individually'],
];
---
<BaseLayout
  title="Window replacement"
  description="Replacement windows for Vancouver and Clark County homes, from measure to finish, with a written estimate before anything is ordered."
  path="/replacement"
  crumbs={[{ name: 'Window replacement', href: '/replacement' }]}
  ogImageSrc={ogPhoto.image}
  ogImageAlt={ogPhoto.alt}
  schema={schema}
>
  <section class="page-hero page-hero-photo" style={`background-image: linear-gradient(180deg, color-mix(in srgb, var(--black) 58%, transparent), color-mix(in srgb, var(--black) 88%, transparent)), url(${heroBg.src})`}>
    <div class="wrap">
      <p class="kicker">Services</p>
      <h1>Window replacement in Vancouver, WA</h1>
      <p class="lede">
        Old, leaky, or single-pane units out. The right replacement in the same opening —
        without wrecking the siding or the interior finish.
      </p>
      <p class="hero-note">
        Framing a new build or an addition instead? See <a href="/new-construction">new construction window installs</a>.
        Replacing a patio door? See <a href="/sliding-glass-doors">sliding glass doors</a>.
      </p>
    </div>
    <p class="hero-photo-credit">Clearview job photo — completed replacement elevation</p>
  </section>

  <section class="section">
    <div class="wrap" data-reveal>
      <p class="rule-label">What we can do for you</p>
      <h2>Tell us what you need. We spec every opening.</h2>
      <p class="lede">
        You do not need to work out how it gets done. We measure, look at each opening, and write
        down exactly what we recommend for it before we put a number on it.
      </p>

      <div class="offer">
        {offers.map((item) => (
          <article class="offer-item">
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </article>
        ))}
      </div>

      <p class="section-link">
        <a href="/guides/what-your-openings-need">How we decide what each opening needs</a>
      </p>
    </div>
  </section>

  <section class="section section-sunk">
    <div class="wrap is-narrow" data-reveal>
      <p class="rule-label">Frame materials</p>
      <h2>Vinyl vs. fiberglass.</h2>
      <p class="lede">
        Two common frame materials, shown at the same scale so you can see the construction
        difference before we get into the cost and sizing tradeoffs.
      </p>
      <figure class="replacement-material-graphic">
        <Image
          src={vinylFiberglassGraphic}
          alt="Vinyl versus fiberglass window frame comparison showing hollow multi-chamber vinyl construction and a denser fiberglass profile."
          widths={[760, 1140, 1580]}
          sizes="(max-width: 800px) 100vw, 1100px"
          quality={82}
          loading="lazy"
        />
      </figure>
      <p class="section-link">
        <a href="/guides/vinyl-vs-fiberglass-pacific-northwest">See the full vinyl vs. fiberglass guide →</a>
      </p>
    </div>
  </section>

  <section class="section">
    <div class="wrap split" data-reveal>
      <div>
        <p class="rule-label">What we install</p>
        <h2>Ordinary materials, measured properly.</h2>
        <p>
          There is no secret window. The difference between a good replacement and a bad one
          is almost entirely in how the opening is measured, prepared, and flashed.
        </p>
        <p class="fine-print">
          Ask which manufacturer a quote is written around, and why. We will tell you what
          we are ordering and what it costs before anything goes on paper.
        </p>
        <p class="section-link">
          <a href="/window-features">Vinyl vs fiberglass, Cascade vs Milgard, and every style — in detail</a>
        </p>
        <p class="section-link">
          <a href="/process">How the install itself runs, step by step</a>
        </p>
      </div>
      <dl class="spec-table">
        {spec.map(([term, description]) => (
          <div class="spec-pair">
            <dt>{term}</dt>
            <dd>{description}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <section class="section section-sunk">
    <div class="wrap is-wide" data-reveal>
      <p class="rule-label">Replacement work</p>
      <h2>Clark County openings, finished.</h2>
      <div class="work-grid">
        {replacementWork.slice(0, 6).map((photo) => (
          <WorkCard
            image={photo.image}
            alt={photo.alt}
            caption={photo.caption}
            kind={workKindLabel(photo.kind)}
          />
        ))}
      </div>
      <p class="section-link"><a href="/gallery">See the full gallery</a></p>
    </div>
  </section>

  <CtaBar
    heading="Get every opening spec'd, then the price."
    body="We measure every opening, tell you the right approach for each one, and write it down in the estimate."
  />
</BaseLayout>

<style>
  .replacement-material-graphic {
    margin: var(--space-l) 0 0;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--paper-raised);
    overflow: hidden;
    box-shadow: var(--shadow-soft);
  }

  .replacement-material-graphic img {
    display: block;
    width: 100%;
    height: auto;
  }

  .page-hero-photo {
    position: relative;
    background-size: cover;
    background-position: center 40%;
  }

  .hero-photo-credit {
    position: absolute;
    right: var(--space-s);
    bottom: var(--space-2xs);
    margin: 0;
    font-size: var(--step--2);
    color: var(--on-dark-faint);
    opacity: 0.85;
  }

  .hero-note {
    margin: var(--space-s) 0 0;
    max-width: 44rem;
    font-size: var(--step--1);
    color: var(--on-dark-faint);
  }

  .hero-note a {
    color: var(--on-dark);
    text-decoration: underline;
    text-decoration-color: var(--accent-bright);
    text-underline-offset: 0.2em;
  }

  .hero-note a:hover,
  .hero-note a:focus-visible {
    color: var(--accent-bright);
  }

  .offer {
    display: grid;
    grid-template-columns: 1fr 1fr;
    margin-top: var(--space-l);
    border-top: 1px solid var(--line);
  }

  .offer-item {
    padding: var(--space-m) var(--space-m) var(--space-m) 0;
    border-bottom: 1px solid var(--line);
  }

  .offer-item:nth-child(even) {
    padding-left: var(--space-m);
    border-left: 1px solid var(--line);
  }

  .offer-item h3 {
    margin: 0 0 var(--space-2xs);
    font-size: var(--step-1);
  }

  .offer-item p {
    margin: 0;
    font-size: var(--step--1);
    color: var(--ink-soft);
  }

  .spec-table {
    margin: 0;
  }

  .spec-pair {
    display: grid;
    grid-template-columns: 7.5rem minmax(0, 1fr);
    gap: var(--space-s);
    padding: var(--space-s) 0;
    border-top: 1px solid var(--line);
  }

  .spec-pair:last-child {
    border-bottom: 1px solid var(--line);
  }

  .spec-pair dt {
    text-transform: uppercase;
    letter-spacing: var(--tracking-label);
    font-size: var(--step--2);
    font-weight: 500;
    color: var(--ink-faint);
  }

  .spec-pair dd {
    margin: 0;
    font-size: var(--step--1);
  }

  @media (max-width: 900px) {
    .offer {
      grid-template-columns: 1fr;
    }

    .offer-item,
    .offer-item:nth-child(even) {
      padding-left: 0;
      padding-right: 0;
      border-left: 0;
    }

    .spec-pair {
      grid-template-columns: 1fr;
      gap: var(--space-3xs);
    }
  }
</style>
