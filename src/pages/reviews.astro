---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ReviewCard from '../components/ReviewCard.astro';
import CtaBar from '../components/CtaBar.astro';
import GoogleReviews from '../components/GoogleReviews.astro';
import FacebookIcon from '../components/icons/FacebookIcon.astro';
import { site } from '../data/site';

const reviews = await getCollection('reviews', ({ data }) => data.published);

// The rating Google shows on the Business Profile. We can honestly say how
// many reviews there are and what they average, but we only quote a review's
// words when we have them (curated collection or the live feed).
const google = site.googleReviews;
const hasGoogle = google.count > 0;
const earnedStars = hasGoogle ? Math.round(google.rating) : 0;
const googleHeading = `${google.count === 1 ? 'One' : google.count} ${
  google.rating === 5 ? 'five-star ' : ''
}${google.count === 1 ? 'review' : 'reviews'} on Google so far.`;
---
<BaseLayout
  title="Clearview Windows reviews and references"
  description="What Vancouver, WA and Clark County homeowners say about Clearview Windows — real names only, no invented testimonials. Ask us for references."
  path="/reviews"
  crumbs={[{ name: 'Reviews', href: '/reviews' }]}
>
  <section class="page-hero">
    <div class="wrap">
      <p class="kicker">Reviews</p>
      <h1>Customer reviews</h1>
      <p
        class="lede"
        data-lede-google="Real reviews from real customers, pulled live from our Google Business Profile."
      >
        {reviews.length > 0
          ? 'Real customers, in their own words.'
          : hasGoogle
            ? 'Real customers, in their own words.'
            : 'Reviews will appear here as customers leave them.'}
      </p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      {reviews.length > 0 ? (
        <>
          {hasGoogle && <p class="lede" data-hide-when-google-reviews>{google.rating.toFixed(1)} out of 5 · {google.count} Google reviews</p>}
          <div class="review-list">
            {reviews.map((review) => (
              <ReviewCard
                quote={review.data.quote}
                name={review.data.name}
                city={review.data.city}
                source={review.data.source}
                sourceUrl={review.data.sourceUrl}
                rating={review.data.rating}
              />
            ))}
          </div>
          {site.social.google && (
            <p class="post-reviews-cta">
              Leave a review of your own on our{' '}
              <a class="inline-social" href={site.social.googleReview || site.social.google} target="_blank" rel="noopener noreferrer">
                Google Business Profile
              </a>
              .
            </p>
          )}
        </>
      ) : (
        <div class="empty" data-reveal data-hide-when-google-reviews>
          <div class="empty-mark" aria-hidden="true">
            {[0, 1, 2, 3, 4].map((i) => (
              <span class={i < earnedStars ? 'earned' : ''}></span>
            ))}
          </div>
          <div class="empty-copy">
            {hasGoogle ? (
              <>
                <h2>{googleHeading}</h2>
                <p class="lede">
                  Google shows {google.count === 1 ? 'one review' : `${google.count} reviews`} on
                  our Business Profile, averaging {google.rating.toFixed(1)} stars. You can read
                  {google.count === 1 ? ' it' : ' them'} there and leave one of your own.
                </p>
                {site.social.google && (
                  <p>
                    <a class="inline-social" href={site.social.google} target="_blank" rel="noopener noreferrer">
                      See it on our Google Business Profile
                    </a>
                  </p>
                )}
                <p>
                  We show the rating and link to the source instead of retyping anyone’s words,
                  so this page only carries what real customers actually wrote.
                </p>
              </>
            ) : (
              <>
                <h2>No reviews yet.</h2>
                <p class="lede">
                  We only publish reviews from real customers, with their permission, so this
                  page stays empty until they arrive.
                </p>
              </>
            )}
            <p>
              Ask for references when we come out to measure. We can put you in touch with past
              customers who have said they are happy to talk about their project.
            </p>
          </div>
        </div>
      )}
    </div>
  </section>

  <GoogleReviews />

  {reviews.length === 0 && (
    <section class="section section-sunk">
      <div class="wrap split" data-reveal>
        <div>
          <p class="rule-label">Already worked with us?</p>
          <h2>Leave us a review.</h2>
          <ul class="plain-list">
            <li>Tell us you are happy to be quoted here</li>
            {site.social.facebook && (
              <li>
                Or leave it on our{' '}
                <a class="inline-social" href={site.social.facebook} target="_blank" rel="noopener noreferrer">
                  <FacebookIcon class="inline-social-icon" />
                  Facebook page
                </a>
              </li>
            )}
            <li>
              {site.social.google ? (
                <>
                  Or leave it on our{' '}
                  <a
                    class="inline-social"
                    href={site.social.googleReview || site.social.google}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    Google Business Profile
                  </a>
                </>
              ) : (
                'Or leave it on the Google Business Profile once it is live'
              )}
            </li>
          </ul>
        </div>
        <div>
          <p class="rule-label">In the meantime</p>
          <p>
            <a href="/gallery">The gallery</a> shows our own jobs, in our own photos.
          </p>
        </div>
      </div>
    </section>
  )}

  <CtaBar />
</BaseLayout>

<style>
  /* Once there are real quotes, they sit in a two-column measure rather than
     a flexible card row — a testimonial reads as text, not as a product. */
  .review-list {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-l) var(--space-xl);
  }

  .review-list:has(> :only-child) {
    grid-template-columns: 1fr;
    max-width: 960px;
  }

  @media (max-width: 800px) {
    .review-list {
      grid-template-columns: 1fr;
    }
  }

  .post-reviews-cta {
    margin-top: var(--space-l);
  }

  /* An empty page is the whole argument here, so it gets composed rather than
     apologised for. The mark is five stars, and only the ones Google actually
     shows on the Business Profile are filled — drawing more would be the exact
     thing this page refuses to do. */
  .empty {
    display: grid;
    grid-template-columns: minmax(0, 0.5fr) minmax(0, 1fr);
    gap: var(--space-xl);
    align-items: start;
  }

  .empty-mark {
    display: flex;
    gap: var(--space-3xs);
  }

  .empty-mark span {
    width: 1.5rem;
    height: 1.5rem;
    background: var(--line);
    clip-path: polygon(
      50% 0%, 61% 35%, 98% 35%, 68% 57%,
      79% 91%, 50% 70%, 21% 91%, 32% 57%,
      2% 35%, 39% 35%
    );
  }

  .empty-mark span.earned {
    background: var(--accent);
  }

  .empty-copy h2 {
    margin-top: 0;
    font-size: var(--step-3);
  }

  .empty-copy .lede {
    max-width: none;
  }

  .empty-copy p:last-child {
    margin-bottom: 0;
  }

  @media (max-width: 800px) {
    .empty {
      grid-template-columns: 1fr;
      gap: var(--space-m);
    }
  }
</style>
