---
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaBar from '../components/CtaBar.astro';
import { site } from '../data/site';
---
<BaseLayout
  title="About"
  description={`Meet ${site.owner} and ${site.legalName}, a Vancouver, WA window installation company.`}
  path="/about"
  crumbs={[{ name: 'About', href: '/about' }]}
>
  <section class="page-hero">
    <div class="wrap">
      <p class="kicker">About</p>
      <h1>A Vancouver crew, not a national sales office.</h1>
      <p class="lede">
        The site, the truck, and the estimate all point back to the same person responsible for the
        opening in your wall.
      </p>
    </div>
  </section>
  <section class="section">
    <div class="wrap split">
      <div>
        <p>
          {site.legalName} is Mark’s window company. We install in Vancouver and the towns around it —
          Camas, Washougal, Battle Ground, Brush Prairie, Ridgefield, La Center, and Woodland — and
          we cross the river into Portland.
        </p>
        <p>
          Show up, install it right, leave the house better than we found it.
        </p>
      </div>
      <aside>
        <p class="kicker">Where we work</p>
        <ul class="plain-list">
          {site.nearby.map((place) => (
            <li>{place.name}, {place.region}</li>
          ))}
        </ul>
        <p class="fine-print">Still waiting on L&amp;I number, insurance, and brand list.</p>
      </aside>
    </div>
  </section>
  <CtaBar />
</BaseLayout>
