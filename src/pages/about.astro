---
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaBar from '../components/CtaBar.astro';
import { site } from '../data/site';
import { pricingIsRegionalAverage } from '../data/pricing';
import { getImage } from 'astro:assets';
import { findWork } from '../data/work';

const pricesAreAverages = pricingIsRegionalAverage();

const description = `Clearview Windows replaces windows and installs sliding glass doors in Vancouver, WA and Clark County. Free in-home measure, written estimate first.`;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  '@id': `${site.url}/about#page`,
  url: `${site.url}/about`,
  name: `About ${site.shortName}`,
  description,
  mainEntity: { '@id': `${site.url}/#business` },
};

// Use an actual Clearview installation photo here. The About page is making
// claims about the people doing the work, so showing the crew actually
// setting a window is more useful than an illustrative rendering.
const heroPhoto = findWork('cabin-gable-install-crew')!;
const heroBg = await getImage({ src: heroPhoto.image, width: 2400, format: 'webp', quality: 76 });
---
<BaseLayout
  title="About Clearview Windows | Vancouver, WA Window Installers"
  description={description}
  path="/about"
  crumbs={[{ name: 'About', href: '/about' }]}
  schema={schema}
>
  <section class="page-hero page-hero-photo" style={`background-image: linear-gradient(180deg, color-mix(in srgb, var(--black) 58%, transparent), color-mix(in srgb, var(--black) 88%, transparent)), url(${heroBg.src})`}>
    <div class="wrap">
      <p class="kicker about-kicker">
        <img class="about-kicker-mark" src="/logo/icon-mark@256.png" width="256" height="256" alt="" loading="eager" decoding="async" />
        About
      </p>
      <h1>A local window company.</h1>
      <p class="lede">
        Every job follows the same steps: an in-person measure, a written estimate, and a
        final walkthrough.
      </p>
    </div>
    <p class="hero-photo-credit">Clearview job photo — crew setting gable windows</p>
  </section>
  <section class="section">
    <div class="wrap split" data-reveal>
      <div class="prose">
        <p>
          {site.legalName} is a locally owned window
          company. We install in Vancouver and the towns
          around it — Camas, Washougal, Battle Ground, Brush Prairie, Ridgefield, La Center,
          and Woodland.
        </p>
        <p>
          Every job starts with an in-person measure and a written estimate. Materials are
          ordered to the measured openings, the install follows the same steps on every job, and
          the finished work is walked through with you before we leave.
        </p>
      </div>
      <aside>
        <p class="rule-label">Where we work</p>
        <ul class="plain-list">
          {site.nearby.map((place) => (
            <li>{place.name}, {place.region}</li>
          ))}
        </ul>
      </aside>
    </div>
  </section>

  <section class="section section-sunk">
    <div class="wrap is-narrow" data-reveal>
      <p class="rule-label">Straight answers</p>
      <h2>How our prices work.</h2>
      <dl class="honest">
        <div>
          <dt>{pricesAreAverages ? 'Prices are regional averages' : 'Prices are still ranges'}</dt>
          <dd>
            {pricesAreAverages ? (
              <>
                The <a href="/tools/window-replacement-cost-calculator">cost calculator</a> runs
                on published Washington averages, clearly labeled as such, not on Clearview’s
                own pricing. It is there to sanity-check any quote you get — including ours.
              </>
            ) : (
              <>
                The <a href="/tools/window-replacement-cost-calculator">cost calculator</a> runs
                on our own installed pricing, but it still gives you a range rather than a
                number. Anyone quoting a single figure before seeing your openings is guessing,
                and so would we be.
              </>
            )}
          </dd>
        </div>
      </dl>
    </div>
  </section>

  {site.lniNumber && (
    <section class="section">
      <div class="wrap is-narrow" data-reveal>
        <p class="rule-label">Contractor registration</p>
        <p>
          {site.legalName} · WA UBI {site.ubiNumber} · L&amp;I {site.lniNumber}.{' '}
          <a href="https://secure.lni.wa.gov/verify/" target="_blank" rel="noopener noreferrer">
            Verify registration
          </a>.
        </p>
      </div>
    </section>
  )}

  <CtaBar
    heading="Ready for a written estimate?"
    body="Call or send a request. A window count and a city are enough to start."
  />
</BaseLayout>

<style>
  .page-hero-photo {
    position: relative;
    background-size: cover;
    background-position: center 35%;
  }

  .hero-photo-credit {
    position: absolute;
    right: var(--space-s);
    bottom: var(--space-2xs);
    margin: 0;
    font-size: var(--step--2);
    color: var(--on-dark-faint);
    opacity: 0.85;
  }

  .about-kicker {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .about-kicker-mark {
    width: 1.05rem;
    height: 1.05rem;
    flex: none;
    object-fit: contain;
  }

  .honest {
    margin: var(--space-l) 0 0;
    border-top: 1px solid var(--line);
  }

  .honest > div {
    padding: var(--space-m) 0;
    border-bottom: 1px solid var(--line);
  }

  .honest dt {
    font-size: var(--step-1);
    font-weight: 600;
    letter-spacing: -0.015em;
    margin-bottom: var(--space-3xs);
  }

  .honest dd {
    margin: 0;
    color: var(--ink-soft);
    font-size: var(--step--1);
    max-width: var(--measure);
  }

  .honest a {
    color: var(--accent-ink);
    text-underline-offset: 0.2em;
  }
</style>
