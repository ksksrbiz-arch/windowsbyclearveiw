---
import BaseLayout from '../layouts/BaseLayout.astro';
import WorkCard from '../components/WorkCard.astro';
import CtaBar from '../components/CtaBar.astro';
import { allWork } from '../data/work';

// Grouped rather than poured into one long grid: 26 tiles in a single field
// is a contact sheet, not a portfolio. The groups also let a builder skip
// straight to framing shots.
const groups = [
  {
    id: 'elevations',
    label: 'Finished elevations',
    blurb: 'What the street sees once the job is done.',
    photos: allWork.filter((photo) => photo.kind === 'after'),
  },
  {
    id: 'interiors',
    label: 'From inside the room',
    blurb: 'The side you actually live with.',
    photos: allWork.filter((photo) => photo.kind === 'interior'),
  },
  {
    id: 'install-day',
    label: 'Install day',
    blurb: 'Ladders, openings, and the part most sites leave out.',
    photos: allWork.filter((photo) => photo.kind === 'process'),
  },
  {
    id: 'new-construction',
    label: 'New construction',
    blurb: 'Set and flashed, handed back to the builder.',
    photos: allWork.filter((photo) => photo.kind === 'new construction'),
  },
].filter((group) => group.photos.length > 0);

const total = allWork.length;
---
<BaseLayout
  title="Project gallery"
  description="Real replacement jobs from Clearveiw Windows, LLC in Clark County homes."
  path="/gallery"
  crumbs={[{ name: 'Gallery', href: '/gallery' }]}
>
  <section class="page-hero">
    <div class="wrap">
      <p class="kicker">Gallery</p>
      <h1>Mark’s work</h1>
      <p class="lede">
        Vinyl replacement in lived-in Washington houses — sliders, double-hungs, and the
        ladder shots from install day. Every photo here is a job Mark did. None of it is stock.
      </p>
      <p class="gallery-index">
        <span class="gallery-count">{total}</span>
        <span>
          {groups.map((group, index) => (
            <>
              <a href={`#${group.id}`}>{group.label.toLowerCase()}</a>
              {index < groups.length - 1 ? ' · ' : ''}
            </>
          ))}
        </span>
      </p>
    </div>
  </section>

  {groups.map((group, groupIndex) => (
    <section class:list={['section', groupIndex % 2 === 1 && 'section-sunk']} id={group.id}>
      <div class="wrap is-wide" data-reveal>
        <div class="group-head">
          <div>
            <p class="rule-label">{group.label}</p>
            <h2>{group.blurb}</h2>
          </div>
          <p class="group-count">{group.photos.length} {group.photos.length === 1 ? 'photo' : 'photos'}</p>
        </div>
        <div class="work-grid">
          {group.photos.map((photo, index) => (
            <WorkCard
              image={photo.image}
              alt={photo.alt}
              caption={photo.caption}
              kind={photo.kind}
              eager={groupIndex === 0 && index < 3}
            />
          ))}
        </div>
      </div>
    </section>
  ))}

  <CtaBar
    heading="Want yours in here?"
    body="Mark measures every opening before quoting, and you can ask to see a job like yours nearby."
  />
</BaseLayout>

<style>
  /* A jump index in the hero: 26 tiles down one page is a long scroll for a
     builder who only wants the framing shots. */
  .gallery-index {
    display: flex;
    align-items: baseline;
    gap: var(--space-s);
    margin: var(--space-m) 0 0;
    padding-top: var(--space-s);
    border-top: 1px solid var(--dark-line);
    font-size: var(--step--1);
    color: var(--on-dark-faint);
  }

  .gallery-count {
    font-size: var(--step-2);
    font-weight: 600;
    line-height: 1;
    color: var(--accent-bright);
    font-variant-numeric: tabular-nums;
  }

  .gallery-index a {
    color: var(--on-dark-soft);
    text-underline-offset: 0.2em;
    text-decoration-color: var(--dark-line-strong);
  }

  .gallery-index a:hover {
    color: var(--on-dark);
    text-decoration-color: currentColor;
  }

  .group-head {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: var(--space-m);
    margin-bottom: var(--space-l);
  }

  .group-head h2 {
    margin: 0;
    font-size: var(--step-3);
  }

  .group-count {
    flex: none;
    margin: 0;
    text-transform: uppercase;
    letter-spacing: var(--tracking-label);
    font-size: var(--step--2);
    font-weight: 500;
    color: var(--ink-faint);
    font-variant-numeric: tabular-nums;
  }

  @media (max-width: 700px) {
    .group-head {
      display: grid;
      gap: var(--space-2xs);
    }
  }
</style>
