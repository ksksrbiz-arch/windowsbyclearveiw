---
import { getImage } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import WorkCard from '../components/WorkCard.astro';
import CtaBar from '../components/CtaBar.astro';
import { allWork, findWork } from '../data/work';
import { site } from '../data/site';

const ogPhoto = findWork('green-craftsman-upper')!;

// A real job photo for the hero, not stock or AI -- the page's own copy
// promises exactly that ("None of it is stock"), so the hero has to keep it.
const heroBg = await getImage({ src: ogPhoto.image, width: 2400, format: 'webp', quality: 76 });

// Grouped rather than poured into one long grid: 26 tiles in a single field
// is a contact sheet, not a portfolio. The groups also let a builder skip
// straight to framing shots.
// Every source photo is 450x600, so tiles cannot be made wider without
// upscaling — a two-column span would ask a 450px file to fill ~800px. Scale
// therefore varies between groups rather than within them: the elevations run
// large and tall, the interiors square and mid-sized, install day dense like a
// contact sheet. Nothing renders above its source width.
const groups = [
  {
    id: 'elevations',
    label: 'Finished elevations',
    blurb: 'What the street sees once the job is done.',
    density: 'is-large',
    photos: allWork.filter((photo) => photo.kind === 'after'),
  },
  {
    id: 'interiors',
    label: 'From inside the room',
    blurb: 'The side you actually live with.',
    density: 'is-square',
    photos: allWork.filter((photo) => photo.kind === 'interior'),
  },
  {
    id: 'install-day',
    label: 'Install day',
    blurb: 'Ladders, openings, and the part most sites leave out.',
    density: 'is-dense',
    photos: allWork.filter((photo) => photo.kind === 'process'),
  },
  {
    id: 'new-construction',
    label: 'New construction',
    blurb: 'Set and flashed, handed back to the builder.',
    density: 'is-large',
    photos: allWork.filter((photo) => photo.kind === 'new construction'),
  },
].filter((group) => group.photos.length > 0);

const total = allWork.length;
---
<BaseLayout
  title="Project gallery"
  description="Real window replacement and new-construction jobs in Vancouver, WA and Clark County — finished elevations, interiors, and install-day photos."
  path="/gallery"
  crumbs={[{ name: 'Gallery', href: '/gallery' }]}
  ogImageSrc={ogPhoto.image}
  ogImageAlt={ogPhoto.alt}
>
  <section class="page-hero page-hero-photo" style={`background-image: linear-gradient(180deg, color-mix(in srgb, var(--black) 58%, transparent), color-mix(in srgb, var(--black) 88%, transparent)), url(${heroBg.src})`}>
    <div class="wrap">
      <p class="kicker">Gallery</p>
      <h1>Mark’s work</h1>
      <p class="lede">
        Vinyl replacement in lived-in Washington houses — sliders, double-hungs, and the
        ladder shots from install day. Every photo here is a job Mark did. None of it is stock.
      </p>
      <p class="gallery-index">
        <span class="gallery-count">{total}</span>
        <span>
          {groups.map((group, index) => (
            <>
              <a href={`#${group.id}`}>{group.label.toLowerCase()}</a>
              {index < groups.length - 1 ? ' · ' : ''}
            </>
          ))}
        </span>
      </p>
      {site.social.facebook && (
        <p class="gallery-social">
          More jobs go up on <a href={site.social.facebook} target="_blank" rel="noopener noreferrer">Facebook</a> as they finish.
        </p>
      )}
    </div>
  </section>

  {groups.map((group, groupIndex) => (
    <section class:list={['section', groupIndex % 2 === 1 && 'section-sunk']} id={group.id}>
      <div class="wrap is-wide" data-reveal>
        <div class="group-head">
          <div>
            <p class="rule-label">{group.label}</p>
            <h2>{group.blurb}</h2>
          </div>
          <p class="group-count">{group.photos.length} {group.photos.length === 1 ? 'photo' : 'photos'}</p>
        </div>
        {/* A lone photo in a three-column grid is not a large tile, it is a
            hole with a picture in the corner. Constrain it instead. */}
        <div class:list={['work-grid', group.photos.length === 1 ? 'is-single' : group.density]}>
          {group.photos.map((photo, index) => (
            <WorkCard
              image={photo.image}
              alt={photo.alt}
              caption={photo.caption}
              kind={photo.kind}
              eager={groupIndex === 0 && index < 3}
              sizes={
                group.density === 'is-dense'
                  ? '(max-width: 560px) 45vw, (max-width: 900px) 31vw, 340px'
                  : '(max-width: 560px) 45vw, (max-width: 900px) 46vw, 450px'
              }
            />
          ))}
        </div>
      </div>
    </section>
  ))}

  <CtaBar
    heading="Want yours in here?"
    body="Mark measures every opening before quoting, and you can ask to see a job like yours nearby."
  />
</BaseLayout>

<style>
  .page-hero-photo {
    position: relative;
    background-size: cover;
    background-position: center;
  }

  /* A jump index in the hero: 26 tiles down one page is a long scroll for a
     builder who only wants the framing shots. */
  /* The link list re-wraps when Outfit replaces the fallback — metric matching
     keeps block heights honest but cannot hold line breaks in place, since the
     glyph widths differ. Measured at 0.016 CLS, which is well inside the 0.1
     "good" threshold. Reserving the container height and restructuring to a
     grid were both tried and changed nothing, because the links still reflow
     within whatever box they are given. Left alone deliberately. */
  .gallery-index {
    display: flex;
    align-items: baseline;
    gap: var(--space-s);
    margin: var(--space-m) 0 0;
    padding-top: var(--space-s);
    border-top: 1px solid var(--dark-line);
    font-size: var(--step--1);
    color: var(--on-dark-faint);
  }

  .gallery-count {
    font-size: var(--step-2);
    font-weight: 600;
    line-height: 1;
    color: var(--accent-bright);
    font-variant-numeric: tabular-nums;
  }

  .gallery-index a {
    color: var(--on-dark-soft);
    text-underline-offset: 0.2em;
    text-decoration-color: var(--dark-line-strong);
  }

  .gallery-index a:hover {
    color: var(--on-dark);
    text-decoration-color: currentColor;
  }

  .gallery-social {
    margin: var(--space-2xs) 0 0;
    font-size: var(--step--1);
    color: var(--on-dark-faint);
  }

  .gallery-social a {
    color: var(--on-dark-soft);
    text-underline-offset: 0.2em;
    text-decoration-color: var(--dark-line-strong);
  }

  .gallery-social a:hover {
    color: var(--on-dark);
    text-decoration-color: currentColor;
  }

  /* Per-group scale. The column counts keep every tile at or below the 450px
     source width at the widths this page is read at. */
  .work-grid.is-large {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .work-grid.is-square {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .work-grid.is-dense {
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-2xs);
  }

  .work-grid.is-single {
    grid-template-columns: minmax(0, 22rem);
  }

  /* Interiors are room shots, which survive a square crop better than an
     elevation does — an elevation cropped short loses the roofline that makes
     it legible. */
  .work-grid.is-square :global(.work-card img) {
    aspect-ratio: 1 / 1;
  }

  @media (max-width: 900px) {
    .work-grid.is-large,
    .work-grid.is-square {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .work-grid.is-dense {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (max-width: 560px) {
    .work-grid.is-large,
    .work-grid.is-square,
    .work-grid.is-dense {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .work-grid.is-single {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .group-head {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: var(--space-m);
    margin-bottom: var(--space-l);
  }

  .group-head h2 {
    margin: 0;
    font-size: var(--step-3);
  }

  .group-count {
    flex: none;
    margin: 0;
    text-transform: uppercase;
    letter-spacing: var(--tracking-label);
    font-size: var(--step--2);
    font-weight: 500;
    color: var(--ink-faint);
    font-variant-numeric: tabular-nums;
  }

  /* Below 700px the label/count pair in .group-head wraps to two lines
     rather than fighting for a single row next to the group heading. */
  @media (max-width: 700px) {
    .group-head {
      display: grid;
      gap: var(--space-2xs);
    }
  }
</style>
