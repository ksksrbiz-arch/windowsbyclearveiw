---
import BaseLayout from '../layouts/BaseLayout.astro';
import WorkCard from '../components/WorkCard.astro';
import CtaBar from '../components/CtaBar.astro';
import { allWork } from '../data/work';
---
<BaseLayout
  title="Project gallery"
  description="Real replacement jobs from Clearveiw Windows, LLC in Clark County homes."
  path="/gallery"
>
  <section class="page-hero">
    <div class="wrap">
      <p class="kicker">Gallery</p>
      <h1>Mark’s work</h1>
      <p class="lede">
        Vinyl replacement in lived-in Washington houses — sliders, double-hungs, and the ladder shots from install day.
      </p>
    </div>
  </section>
  <section class="section">
    <div class="wrap">
      <div class="work-grid">
        {allWork.map((photo) => (
          <WorkCard
            src={photo.src}
            alt={photo.alt}
            caption={photo.caption}
            kind={photo.kind}
            featured={photo.featured && photo.order <= 2}
          />
        ))}
      </div>
    </div>
  </section>
  <CtaBar />
</BaseLayout>
