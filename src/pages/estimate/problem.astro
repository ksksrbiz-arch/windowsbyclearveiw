---
import BaseLayout from '../../layouts/BaseLayout.astro';
import EstimateForm from '../../components/EstimateForm.astro';
import { mailHref, site, telHref } from '../../data/site';
---
<BaseLayout
  title="That request did not go through"
  description="The estimate form could not be sent. Call Clearview Windows in Vancouver, WA instead."
  path="/estimate/problem"
  crumbs={[{ name: 'Request an estimate', href: '/estimate' }]}
  noindex
>
  <section class="page-hero">
    <div class="wrap">
      <p class="kicker">Did not send</p>
      <h1>That one did not go through.</h1>
      <p class="lede">
        Either a field was missing or our mail hiccuped. Nothing reached Mark, so it is worth
        another try — or just call.
      </p>
    </div>
  </section>
  <section class="section">
    <div class="wrap split" data-reveal>
      <div>
        <p class="kicker">Fastest route</p>
        <p class="phone-display"><a href={telHref()}>{site.phoneDisplay}</a></p>
        <p>
          Leave a name, your city, and a rough window count. You can also email{' '}
          <a href={mailHref()}>{site.email}</a>.
        </p>
      </div>
      <div>
        <p class="kicker">Try again</p>
        <EstimateForm />
      </div>
    </div>
  </section>
</BaseLayout>
