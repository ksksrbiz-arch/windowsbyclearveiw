---
import BaseLayout from '../../layouts/BaseLayout.astro';
import EstimateForm from '../../components/EstimateForm.astro';
import { mailHref, site, telHref } from '../../data/site';
---
<BaseLayout
  title="That request did not go through"
  description="The estimate form could not be sent. Call Clearveiw Windows, LLC in Vancouver, WA instead."
  path="/estimate/problem"
  crumbs={[{ name: 'Request an estimate', href: '/estimate' }]}
>
  <section class="page-hero">
    <div class="wrap">
      <p class="kicker">Did not send</p>
      <h1>That one did not go through.</h1>
      <p class="lede">
        Either a field was missing or our mail hiccuped. Nothing reached Mark, so it is worth
        another try — or just call.
      </p>
    </div>
  </section>
  <section class="section">
    <div class="wrap split" data-reveal>
      <div>
        <p class="kicker">Fastest route</p>
        <p class="problem-phone"><a href={telHref()}>{site.phoneDisplay}</a></p>
        <p>
          Leave a name, your city, and a rough window count. You can also email
          <a href={mailHref()}>{site.email}</a>.
        </p>
      </div>
      <EstimateForm />
    </div>
  </section>
</BaseLayout>

<style>
  /* Same treatment as the phone number on /estimate and /estimate/sent — a
     tel: link this prominent should not carry a stray underline through the
     parentheses. */
  .problem-phone {
    margin: 0 0 var(--space-2xs);
    font-size: var(--step-3);
    font-weight: 600;
    letter-spacing: var(--tracking-display);
    font-variant-numeric: tabular-nums;
  }

  .problem-phone a {
    text-decoration: none;
  }

  .problem-phone a:hover {
    color: var(--accent-ink);
  }
</style>
