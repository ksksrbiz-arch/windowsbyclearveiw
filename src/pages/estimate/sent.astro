---
import BaseLayout from '../../layouts/BaseLayout.astro';
import LogoReveal from '../../components/LogoReveal.astro';
import { site, telHref } from '../../data/site';
---
<BaseLayout
  title="Request received"
  description="Your window estimate request reached Clearveiw Windows, LLC in Vancouver, WA."
  path="/estimate/sent"
  crumbs={[{ name: 'Request an estimate', href: '/estimate' }]}
>
  <section class="page-hero">
    <div class="wrap">
      <p class="kicker">Received</p>
      <h1>We have your request.</h1>
      <p class="lede">
        Mark will follow up, usually the same day, to set a time to measure the openings.
      </p>
    </div>
  </section>
  <section class="section">
    <div class="wrap sent-layout" data-reveal>
      <LogoReveal caption="Clearveiw Windows, LLC — Vancouver, WA" />
      <div class="sent-note">
        <p class="rule-label">What happens now</p>
        <ol class="steps">
          <li><strong>Mark reads it.</strong> Usually within the hour.</li>
          <li><strong>He calls you back.</strong> Same day, most days.</li>
          <li><strong>You book a measure.</strong> Free, and it ends in writing.</li>
        </ol>
      </div>
    </div>
  </section>

  <section class="section section-sunk">
    <div class="wrap split" data-reveal>
      <div>
        <p class="rule-label">Sooner is fine</p>
        <p class="sent-phone"><a href={telHref()}>{site.phoneDisplay}</a></p>
        <p>If something changed or you want to talk it through now, call. Mark answers from the truck.</p>
      </div>
      <div>
        <p class="rule-label">While you wait</p>
        <ul class="plain-list">
          <li><a href="/guides/signs-you-need-new-windows">Six signs it is time to replace</a></li>
          <li><a href="/guides/full-frame-vs-insert">Full-frame vs insert</a></li>
          <li><a href="/guides/window-replacement-cost-washington">What a project costs in Washington</a></li>
          <li><a href="/gallery">See recent work</a></li>
        </ul>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* The confirmation is a moment of completion: nothing is being delayed and
     there is nothing else to look at, which is the one place a six-second
     brand animation costs a visitor nothing. */
  .sent-layout {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
    gap: var(--space-xl);
    align-items: center;
  }

  .sent-note .rule-label {
    margin-bottom: var(--space-s);
  }

  /* The default link underline ran through the parentheses and read as a
     typo. Same treatment as the estimate page's number. */
  .sent-phone {
    margin: 0 0 var(--space-2xs);
    font-size: var(--step-3);
    font-weight: 600;
    letter-spacing: var(--tracking-display);
    font-variant-numeric: tabular-nums;
  }

  .sent-phone a {
    text-decoration: none;
  }

  .sent-phone a:hover {
    color: var(--accent-ink);
  }

  @media (max-width: 900px) {
    .sent-layout {
      grid-template-columns: 1fr;
      gap: var(--space-l);
    }
  }
</style>
