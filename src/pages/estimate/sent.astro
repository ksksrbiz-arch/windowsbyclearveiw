---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site, telHref } from '../../data/site';
---
<BaseLayout
  title="Request received"
  description="Your window estimate request reached Clearveiw Windows, LLC in Vancouver, WA."
  path="/estimate/sent"
  crumbs={[{ name: 'Request an estimate', href: '/estimate' }]}
>
  <section class="page-hero">
    <div class="wrap">
      <p class="kicker">Received</p>
      <h1>We have your request.</h1>
      <p class="lede">
        Mark will follow up, usually the same day, to set a time to measure the openings.
      </p>
    </div>
  </section>
  <section class="section">
    <div class="wrap split">
      <div>
        <p class="kicker">Sooner is fine</p>
        <h2><a href={telHref()}>{site.phoneDisplay}</a></h2>
        <p>If something changed or you want to talk it through now, call. Mark answers from the truck.</p>
      </div>
      <div>
        <p class="kicker">While you wait</p>
        <ul class="plain-list">
          <li><a href="/guides/signs-you-need-new-windows">Six signs it is time to replace</a></li>
          <li><a href="/guides/full-frame-vs-insert">Full-frame vs insert</a></li>
          <li><a href="/guides/window-replacement-cost-washington">What a project costs in Washington</a></li>
          <li><a href="/gallery">See recent work</a></li>
        </ul>
      </div>
    </div>
  </section>
</BaseLayout>
