---
import { getImage, Image } from 'astro:assets';
import vinylFiberglassGraphic from '../assets/guides/vinyl-fiberglass-guide.png';
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaBar from '../components/CtaBar.astro';
import WorkCard from '../components/WorkCard.astro';
import { pricing } from '../data/pricing';
import { findWork } from '../data/work';
import CanvaGuideEmbed from '../components/CanvaGuideEmbed.astro';
import UFactorGauge from '../components/diagrams/UFactorGauge.astro';

const ogPhoto = findWork('stone-craftsman')!;

// The feature page already contains real photos of styles and finished work.
// Use a real Clearview interior here too, so the page opens with an actual
// window rather than an AI-generated product macro.
const heroPhoto = findWork('new-unit-interior')!;
const heroBg = await getImage({ src: heroPhoto.image, width: 2400, format: 'webp', quality: 76 });

const materials = pricing.materials;
const brands = pricing.brands;
const styles = pricing.openings.filter((opening) => !opening.isDoor);
const doors = pricing.openings.filter((opening) => opening.isDoor);

const stylePhotos = [
  { id: 'blue-slider', label: 'Slider' },
  { id: 'new-unit-interior', label: 'Double-hung' },
  { id: 'blue-hung', label: 'Single-hung' },
  { id: 'green-craftsman-upper', label: 'Picture' },
]
  .map(({ id, label }) => ({ label, photo: findWork(id) }))
  .filter((entry): entry is { label: string; photo: NonNullable<ReturnType<typeof findWork>> } => Boolean(entry.photo));
---
<BaseLayout
  title="Window features"
  description="What's actually in a Clearview window: vinyl or fiberglass, Cascade or Milgard, the glass package, and every style we install in Vancouver, WA and Clark County."
  path="/window-features"
  crumbs={[{ name: 'Window features', href: '/window-features' }]}
  ogImageSrc={ogPhoto.image}
  ogImageAlt={ogPhoto.alt}
>
  <section class="page-hero page-hero-photo" style={`background-image: linear-gradient(180deg, color-mix(in srgb, var(--black) 58%, transparent), color-mix(in srgb, var(--black) 88%, transparent)), url(${heroBg.src})`}>
    <div class="wrap">
      <p class="kicker">Window features</p>
      <h1>What goes into a Clearview window.</h1>
      <p class="lede">
        This page explains what a quote pays for: the frame material, the glass, the brand, and
        the window style.
      </p>
    </div>
    <p class="hero-photo-credit">Clearview job photo — finished window from inside the room</p>
  </section>

  <section class="section">
    <div class="wrap is-narrow" data-reveal>
      <p class="rule-label">Why it matters</p>
      <h2>Why windows matter.</h2>
      <p>
        Windows are a small part of a house's wall area but a large share of the heat it loses in
        a Washington winter. A failed seal, worn weatherstripping, or a single pane of glass can
        all show up the same way: a draft at the lock, a cold spot by the window, and higher
        heating bills.
      </p>
      <p>
        Not every window needs replacing. The options below are worth understanding before you
        buy, whether from us or anyone else.
      </p>
    </div>
  </section>

  <section class="section section-sunk">
    <div class="wrap" data-reveal>
      <p class="rule-label">What it's made of</p>
      <h2>Vinyl or fiberglass.</h2>
      <div class="compare">
        {materials.map((material) => (
          <article class="compare-card">
            <h3>{material.label}</h3>
            <p class="compare-blurb">{material.blurb}</p>
          </article>
        ))}
      </div>
      <div class="diagram-slot">
        <figure class="frame-materials-graphic">
          <Image
            src={vinylFiberglassGraphic}
            alt="Vinyl versus fiberglass window frame comparison showing hollow multi-chamber vinyl construction and a denser fiberglass profile."
            widths={[760, 1140, 1580]}
            sizes="(max-width: 800px) 100vw, 1100px"
            quality={82}
            loading="lazy"
          />
        </figure>
      </div>
      <p class="fine-print">
        We install both. Vinyl suits most standard openings; fiberglass suits wide sliders and
        picture windows that might otherwise flex. We recommend one on site, not from a photo.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="wrap" data-reveal>
      <p class="rule-label">Which window</p>
      <h2>Cascade or Milgard.</h2>
      <div class="compare">
        {brands.map((brand) => (
          <article class="compare-card">
            <h3>{brand.label}</h3>
            <p class="compare-blurb">{brand.blurb}</p>
          </article>
        ))}
      </div>
      <p class="fine-print">
        The installation is done to the same standard either way; the window in the opening is
        different. We tell you which one a quote is based on, and why, before anything is ordered.
      </p>
    </div>
  </section>

  <section class="section section-sunk">
    <div class="wrap is-narrow" data-reveal>
      <p class="rule-label">Glass</p>
      <h2>Double- or triple-pane, Low-E either way.</h2>
      <p>
        Every window we install has an insulated glass package, double- or triple-pane, with a
        Low-E coating chosen for a Pacific Northwest heating season.
      </p>
      <p>
        A cloudy or fogged pane is a different problem: a failed seal, not a coating choice. <a href="/guides/fogged-windows">How to tell the difference</a>.
      </p>
      <div class="diagram-slot">
        <UFactorGauge />
      </div>
    </div>
  </section>

  <section class="section" id="styles">
    <div class="wrap is-wide" data-reveal>
      <p class="rule-label">Shapes and operation</p>
      <h2>Window styles.</h2>
      <p class="lede">
        The style does not change the glass. It changes how the window opens and how much frame
        you see when it is shut.
      </p>

      <div class="style-list">
        {styles.map((style) => (
          <article class="style-row">
            <h3>{style.label}</h3>
            <p>{style.blurb}</p>
          </article>
        ))}
      </div>

      {stylePhotos.length > 0 && (
        <div class="work-grid style-photos">
          {stylePhotos.map(({ label, photo }) => (
            <WorkCard image={photo.image} alt={photo.alt} caption={photo.caption} kind={label} />
          ))}
        </div>
      )}

      <p class="fine-print">
        Arches, transoms, and other non-rectangular openings are measured and priced
        individually.
        {doors.length > 0 && (
          <>
            {' '}Doors — {doors.map((door) => door.label.toLowerCase()).join(' and ')} — are not
            windows, but we can install them as part of the same project if you are doing a whole
            side of the house. More on <a href="/sliding-glass-doors">sliding glass doors</a>.
          </>
        )}
      </p>
    </div>
  </section>

  <section class="section section-sunk">
    <div class="wrap is-narrow" data-reveal>
      <p class="rule-label">Hardware and color</p>
      <h2>Hardware and color options.</h2>
      <p>
        Locking hardware, interior and exterior color, and grid patterns depend on the line we
        order, and Cascade's options are not identical to Milgard's. We bring real samples to the
        measure so you choose from what is actually available.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="wrap is-narrow" data-reveal>
      <p class="rule-label">Warranty</p>
      <h2>What the warranty covers.</h2>
      <p>
        The glass and hardware carry the manufacturer's own warranty, and Cascade and Milgard
        each write theirs differently. The installation is covered separately by us. Ask us to
        spell out both before you sign: what is covered, for how long, and who to call.
      </p>
    </div>
  </section>

  <CtaBar
    heading="See it in your own opening."
    body="The right material, brand, and style depend on the house. We measure, then tell you exactly what we're ordering and why."
  />
</BaseLayout>

<style>
  .frame-materials-graphic {
    margin: var(--space-l) 0 0;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--paper-raised);
    box-shadow: var(--shadow-soft);
  }

  .frame-materials-graphic img {
    display: block;
    width: 100%;
    height: auto;
  }

  .page-hero-photo {
    position: relative;
    background-size: cover;
    background-position: center 45%;
  }

  .hero-photo-credit {
    position: absolute;
    right: var(--space-s);
    bottom: var(--space-2xs);
    margin: 0;
    font-size: var(--step--2);
    color: var(--on-dark-faint);
    opacity: 0.85;
  }

  .compare {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-m);
    margin: var(--space-l) 0 var(--space-m);
  }

  .diagram-slot {
    margin: var(--space-l) 0;
  }

  .compare-card {
    padding: var(--space-m);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--paper-raised);
  }

  .compare-card h3 {
    margin: 0 0 var(--space-2xs);
    font-size: var(--step-1);
  }

  .compare-blurb {
    margin: 0;
    color: var(--ink-soft);
    font-size: var(--step--1);
  }

  .style-list {
    margin: var(--space-l) 0 0;
    border-top: 1px solid var(--line);
  }

  .style-row {
    display: grid;
    grid-template-columns: 10rem minmax(0, 1fr);
    gap: var(--space-m);
    align-items: baseline;
    padding: var(--space-s) 0;
    border-bottom: 1px solid var(--line);
  }

  .style-row h3 {
    margin: 0;
    font-size: var(--step-0);
  }

  .style-row p {
    margin: 0;
    color: var(--ink-soft);
    font-size: var(--step--1);
  }

  .style-photos {
    margin-top: var(--space-l);
    grid-template-columns: repeat(4, 1fr);
  }

  @media (max-width: 900px) {
    .compare {
      grid-template-columns: 1fr;
    }

    .style-row {
      grid-template-columns: 1fr;
      gap: var(--space-3xs);
    }

    .style-photos {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
