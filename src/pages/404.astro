---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site, telHref } from '../data/site';
---
<BaseLayout
  title="Page not found"
  description="That page does not exist. Find window replacement and new-construction work from Clearview Windows in Vancouver, WA."
  path="/404"
>
  <section class="page-hero">
    <div class="wrap">
      <p class="kicker">404</p>
      <h1>We could not find that page.</h1>
      <p class="lede">
        The link may be old or mistyped. These pages will get you back on track.
      </p>
    </div>
  </section>
  <section class="section">
    <div class="wrap split">
      <div>
        <p class="rule-label">Start here</p>
        <ul class="plain-list">
          <li><a href="/replacement">Window replacement</a></li>
          <li><a href="/new-construction">New construction installs</a></li>
          <li><a href="/gallery">Recent work</a></li>
          <li><a href="/areas">Where we work</a></li>
          <li><a href="/guides">Guides</a></li>
        </ul>
      </div>
      <div>
        <p class="rule-label">Or just ask</p>
        <p class="lost-phone">
          <a href={telHref()}>{site.phoneDisplay}</a>
        </p>
        <p>A window count and a city are enough to start.</p>
        <p><a class="btn btn-primary" href="/estimate">Request an estimate</a></p>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  if (location.pathname === '/internal' || location.pathname.startsWith('/internal/')) {
    const main = document.querySelector('main');
    if (main) {
      const notice = document.createElement('section');
      notice.className = 'internal-404';
      notice.setAttribute('aria-labelledby', 'internal-404-title');
      notice.innerHTML = '<p class="kicker">Clearview internal</p><h2 id="internal-404-title">Internal page not found</h2><p>That Command Center link is missing or no longer available.</p><p><a href="/internal/">Return to Dashboard</a> <a href="/internal/tools">Open Tools</a></p>';
      main.prepend(notice);
    }
  }
</script>

<style>
  .lost-phone {
    margin: 0 0 var(--space-2xs);
    font-size: var(--step-3);
    font-weight: 600;
    letter-spacing: var(--tracking-display);
    font-variant-numeric: tabular-nums;
  }

  .lost-phone a {
    text-decoration: none;
  }

  .lost-phone a:hover {
    color: var(--accent-ink);
  }

  .internal-404{margin:1rem auto;max-width:42rem;padding:1rem 1.2rem;border:1px solid var(--line);border-radius:var(--radius-lg);background:var(--paper-raised)}
  .internal-404 h2{margin:.2rem 0 .4rem}.internal-404 p:last-child{display:flex;gap:1rem;flex-wrap:wrap}.internal-404 a{font-weight:700}
</style>
