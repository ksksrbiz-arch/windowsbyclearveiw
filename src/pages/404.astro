---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site, telHref } from '../data/site';
---
<BaseLayout
  title="Page not found"
  description="That page does not exist. Find window replacement and new-construction work from Clearveiw Windows, LLC in Vancouver, WA."
  path="/404"
>
  <section class="page-hero">
    <div class="wrap">
      <p class="kicker">404</p>
      <h1>That opening is boarded up.</h1>
      <p class="lede">
        The link may be old, or the page may never have existed. Everything below still works.
      </p>
    </div>
  </section>
  <section class="section">
    <div class="wrap split">
      <div>
        <p class="rule-label">Start here</p>
        <ul class="plain-list">
          <li><a href="/replacement">Window replacement</a></li>
          <li><a href="/new-construction">New construction installs</a></li>
          <li><a href="/gallery">Recent work</a></li>
          <li><a href="/areas">Where we work</a></li>
          <li><a href="/guides">Guides</a></li>
        </ul>
      </div>
      <div>
        <p class="rule-label">Or just ask</p>
        <p class="lost-phone">
          <a href={telHref()}>{site.phoneDisplay}</a>
        </p>
        <p>Mark answers from the truck. A window count and a city is enough to start.</p>
        <p><a class="btn btn-primary" href="/estimate">Request an estimate</a></p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .lost-phone {
    margin: 0 0 var(--space-2xs);
    font-size: var(--step-3);
    font-weight: 600;
    letter-spacing: var(--tracking-display);
    font-variant-numeric: tabular-nums;
  }

  .lost-phone a {
    text-decoration: none;
  }

  .lost-phone a:hover {
    color: var(--accent-ink);
  }
</style>
