---
import { getImage } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CtaBar from '../../components/CtaBar.astro';
import { pricingIsUsable } from '../../data/pricing';
import { site } from '../../data/site';
import toolsHeroSrc from '../../assets/hero/tools.jpg';

const showMoney = pricingIsUsable();

// Real stock photography rather than AI imagery -- a tape measure needs no
auto disclaimer for being generic, only for being staged as a Clearview job.
const heroBg = await getImage({ src: toolsHeroSrc, width: 2400, format: 'webp', quality: 76 });

// Must match the title the calculator page itself gives that URL (see
// window-replacement-cost-calculator.astro) or the listing and the page it
// points to disagree.
const toolName = showMoney
  ? 'Window replacement cost calculator'
  : 'Window replacement project planner';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Free window planning tools',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      url: `${site.url}/tools/window-replacement-cost-calculator`,
      name: toolName,
    },
  ],
};
---
<BaseLayout
  title="Free window replacement tools"
  description="Free tools for Clark County homeowners planning a window replacement, including a cost calculator — no email required."
  path="/tools"
  crumbs={[{ name: 'Tools', href: '/tools' }]}
  schema={schema}
>
  <section class="page-hero page-hero-photo" style={`background-image: linear-gradient(180deg, color-mix(in srgb, var(--black) 58%, transparent), color-mix(in srgb, var(--black) 88%, transparent)), url(${heroBg.src})`}>
    <div class="wrap">
      <p class="kicker">Tools</p>
      <h1>Work it out yourself first.</h1>
      <p class="lede">
        Free, no email, nothing sent anywhere. Start with a planning range, then use the answer
        tools when you have a more specific question. There is no requirement to contact us.
      </p>
    </div>
    <p class="hero-photo-credit">Stock photography — not an actual Clearview job or job site</p>
  </section>

  <section class="section">
    <div class="wrap" data-reveal>
      <a class="tool-feature" href="/tools/window-replacement-cost-calculator">
        <div class="tool-copy">
          <p class="rule-label">1 · Planning</p>
          <h2>
            {showMoney ? 'Window replacement cost calculator' : 'Window project planner'}
          </h2>
          <p>
            Count your openings, choose insert or full-frame, and see where a Clark County
            project lands before anyone comes out. It runs entirely in your browser — nothing
            is sent anywhere unless you decide to send it.
          </p>
          <p class="tool-go">Open the tool <span aria-hidden="true">&rarr;</span></p>
        </div>

        <ul class="tool-facts">
          <li><strong>Free</strong><span>No account, no email</span></li>
          <li><strong>Private</strong><span>Runs in your browser</span></li>
          <li><strong>Honest</strong><span>Ranges, not one fake number</span></li>
        </ul>
      </a>

      <div class="next-tools" aria-label="Next planning steps">
        <a href="/ask" class="next-tool">
          <span class="next-tool-step">2</span>
          <span>
            <strong>Have a specific question?</strong>
            <span>Ask the window Q&amp;A for help with styles, fog, materials, or what to measure next.</span>
          </span>
          <span class="next-tool-arrow" aria-hidden="true">→</span>
        </a>
        <a href="/estimate" class="next-tool">
          <span class="next-tool-step">3</span>
          <span>
            <strong>Ready for your number?</strong>
            <span>Request a free in-home estimate. Mark confirms the openings before anything is ordered.</span>
          </span>
          <span class="next-tool-arrow" aria-hidden="true">→</span>
        </a>
      </div>

      <p class="fine-print tool-note">
        More tools are on the way. We would rather ship one that works than several that do not.
      </p>
    </div>
  </section>

  <CtaBar
    heading="Worked it out? Get it measured."
    body="The calculator gets the order of magnitude right. Only a measure gets your number right."
  />
</BaseLayout>

<style>
  .page-hero-photo {
    position: relative;
    background-size: cover;
    background-position: center;
  }

  .hero-photo-credit {
    position: absolute;
    right: var(--space-s);
    bottom: var(--space-2xs);
    margin: 0;
    font-size: var(--step--2);
    color: var(--on-dark-faint);
    opacity: 0.75;
  }

  .tool-feature {
    display: grid;
    grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr);
    gap: var(--space-xl);
    padding: var(--space-l);
    background: var(--paper-raised);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    text-decoration: none;
    color: inherit;
    transition:
      border-color var(--dur) var(--ease),
      box-shadow var(--dur) var(--ease),
      transform var(--dur) var(--ease);
  }

  .tool-feature:hover,
  .tool-feature:focus-visible {
    border-color: color-mix(in srgb, var(--accent) 45%, transparent);
    box-shadow: var(--shadow-lg);
    transform: translateY(-2px);
  }

  .tool-copy h2 {
    margin: 0 0 var(--space-xs);
    font-size: var(--step-3);
  }

  .tool-copy p {
    max-width: var(--measure);
    color: var(--ink-soft);
  }

  .tool-go {
    margin: var(--space-m) 0 0;
    font-weight: 600;
    color: var(--accent-ink);
  }

  .tool-feature:hover .tool-go span {
    display: inline-block;
    transform: translateX(0.25rem);
    transition: transform var(--dur) var(--ease-out);
  }

  .tool-facts {
    margin: 0;
    padding: 0;
    list-style: none;
    align-self: center;
    border-top: 1px solid var(--line);
  }

  .tool-facts li {
    display: grid;
    gap: 0.1rem;
    padding: var(--space-2xs) 0;
    border-bottom: 1px solid var(--line);
  }

  .tool-facts strong {
    font-size: var(--step-0);
    font-weight: 600;
  }

  .tool-facts span {
    font-size: var(--step--1);
    color: var(--ink-soft);
  }

  .next-tools {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-xs);
    margin-top: var(--space-xs);
  }

  .next-tool {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    gap: var(--space-xs);
    align-items: start;
    padding: var(--space-m);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    color: inherit;
    text-decoration: none;
    transition:
      background var(--dur-fast) var(--ease),
      border-color var(--dur) var(--ease),
      transform var(--dur-fast) var(--ease);
  }

  .next-tool:hover,
  .next-tool:focus-visible {
    background: var(--accent-wash);
    border-color: color-mix(in srgb, var(--accent) 35%, transparent);
    transform: translateY(-1px);
  }

  .next-tool-step {
    display: inline-grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border: 1px solid var(--line-strong);
    border-radius: 50%;
    font-size: var(--step--2);
    font-weight: 600;
    color: var(--accent-ink);
  }

  .next-tool strong {
    display: block;
    margin-bottom: 0.2rem;
    font-size: var(--step-0);
  }

  .next-tool > span:nth-child(2) > span {
    display: block;
    color: var(--ink-soft);
    font-size: var(--step--1);
  }

  .next-tool-arrow {
    color: var(--accent);
    transition: transform var(--dur-fast) var(--ease-out);
  }

  .next-tool:hover .next-tool-arrow,
  .next-tool:focus-visible .next-tool-arrow {
    transform: translateX(0.25rem);
  }

  .tool-note {
    margin-top: var(--space-m);
  }

  @media (max-width: 900px) {
    .tool-feature,
    .next-tools {
      grid-template-columns: 1fr;
    }

    .tool-feature {
      gap: var(--space-l);
      padding: var(--space-m);
    }
  }
</style>
