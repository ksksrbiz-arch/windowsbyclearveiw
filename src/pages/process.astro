---
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaBar from '../components/CtaBar.astro';
import WorkCard from '../components/WorkCard.astro';
import { processWork } from '../data/work';

// Mirrors the four <li> items below exactly — if the steps change, this must
// change with them, or the markup and the schema will say different things.
const steps = [
  {
    name: 'Walkthrough',
    text: 'We look at the openings, the trim, and what you want to change. You get a written estimate, not a surprise on install day.',
  },
  {
    name: 'Measure and order',
    text: 'Each opening is measured for the chosen method. Windows are ordered to those sizes. Lead times vary by manufacturer.',
  },
  {
    name: 'Install',
    text: 'Old units come out. New units go in plumb and flashed. Finishes close up to match the house.',
  },
  {
    name: 'Walk the job',
    text: 'We operate every sash with you, haul debris, and leave the rooms usable.',
  },
];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name: 'How Clearveiw Windows installs replacement windows',
  description: 'The four steps Clearveiw Windows follows on every installation, from the first walkthrough to the final walk-through.',
  step: steps.map((step) => ({
    '@type': 'HowToStep',
    name: step.name,
    text: step.text,
  })),
};
---
<BaseLayout
  title="How installation works"
  description="From first measure to final sweep: the Clearveiw Windows installation process for Clark County homeowners."
  path="/process"
  crumbs={[{ name: 'Process', href: '/process' }]}
  schema={schema}
>
  <section class="page-hero">
    <div class="wrap">
      <p class="kicker">Process</p>
      <h1>Measure once. Install clean.</h1>
      <p class="lede">
        Four steps, in this order, on every job. Nothing here is a surprise on install day —
        that is the whole point of writing it down.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="wrap is-narrow" data-reveal>
      <p class="rule-label">In this order, every job</p>
      <ol class="steps process-steps">
        {steps.map((step) => (
          <li><strong>{step.name}.</strong> {step.text}</li>
        ))}
      </ol>
      <p class="notice">
        Permits depend on the city and whether the opening changes. We handle that
        conversation before work starts.
      </p>
      <p class="section-link">
        <a href="/window-features">What we order at step two — materials, brands, and glass</a>
      </p>
    </div>
  </section>

  <section class="section section-sunk">
    <div class="wrap is-wide" data-reveal>
      <p class="rule-label">Install day</p>
      <h2>What that actually looks like.</h2>
      <div class="work-grid">
        {processWork.map((photo) => (
          <WorkCard image={photo.image} alt={photo.alt} caption={photo.caption} kind={photo.kind} />
        ))}
      </div>
    </div>
  </section>

  <CtaBar
    heading="Start at step one."
    body="A walkthrough costs nothing and ends with a written estimate you can hold anyone else to."
  />
</BaseLayout>

<style>
  /* The shared .steps device, given room to be the page rather than a list
     tucked beside a paragraph. */
  .process-steps li {
    padding-top: var(--space-m);
    padding-bottom: var(--space-m);
  }

  .process-steps li strong {
    display: block;
    font-size: var(--step-1);
    font-weight: 600;
    letter-spacing: -0.015em;
    margin-bottom: var(--space-3xs);
  }

  .notice {
    border: 0;
    border-left: 2px solid var(--accent);
    background: var(--accent-wash);
    border-radius: 0 var(--radius) var(--radius) 0;
    padding: var(--space-s) var(--space-m);
    margin-top: var(--space-xl);
    font-size: var(--step--1);
    color: var(--ink-soft);
  }
</style>
