---
import BaseLayout from '../layouts/BaseLayout.astro';
import EstimateForm from '../components/EstimateForm.astro';
import { mailHref, site, telHref } from '../data/site';
---
<BaseLayout
  title="Request an estimate"
  description="Request a free in-home window replacement estimate from Clearview Windows in Vancouver, WA and Clark County. Mark measures, then writes the number."
  path="/estimate"
  crumbs={[{ name: 'Request an estimate', href: '/estimate' }]}
>
  <section class="page-hero">
    <div class="wrap">
      <p class="kicker">Estimate</p>
      <h1>Tell us about the house.</h1>
      <p class="lede">
        Start with your name, phone, city, and a rough idea of the job. You do not need exact measurements
        before you contact us — Mark confirms the opening details at the house. <a href="/tools/window-replacement-cost-calculator">Already comparing costs?</a>
      </p>
      <div class="start-points" aria-label="What to have ready">
        <span><strong>1</strong> Rough window count</span>
        <span><strong>2</strong> City</span>
        <span><strong>3</strong> What you&rsquo;ve noticed</span>
      </div>
    </div>
  </section>
  <section class="section">
    <div class="wrap estimate-layout" data-reveal>
      <EstimateForm />

      <aside class="estimate-aside">
        <p class="rule-label">Prefer to talk</p>
        <p class="phone-display"><a href={telHref()}>{site.phoneDisplay}</a></p>
        <p>
          Mark answers from the truck. If it rings out, leave a name, city, and a window
          count, or email <a href={mailHref()}>{site.email}</a>.
        </p>

        <p class="rule-label">What to expect</p>
        <ol class="steps">
          <li><strong>Tell us the basics.</strong> A rough count and what you&rsquo;ve noticed is enough to start.</li>
          <li><strong>Get a call back.</strong> Mark confirms the project and schedules the next step.</li>
          <li><strong>Get measured.</strong> Every opening is checked at the house before anything is ordered.</li>
          <li><strong>Get it in writing.</strong> The estimate reflects the method and openings actually measured.</li>
        </ol>

        <div class="estimate-path">
          <p class="rule-label">Not ready for a call?</p>
          <a href="/tools/window-replacement-cost-calculator">
            Run the free cost estimator first <span aria-hidden="true">→</span>
          </a>
          <p>It gives you a planning range without asking for your contact information.</p>
        </div>

        <p class="fine-print">
          No lists, no resale, no follow-up sequence. One person calls you back.
        </p>
      </aside>
    </div>
  </section>
</BaseLayout>

<style>
  .page-hero {
    overflow: hidden;
  }

  .start-points {
    display: flex;
    flex-wrap: wrap;
    gap: 0;
    margin-top: var(--space-m);
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }

  .start-points span {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: var(--space-xs) var(--space-m) var(--space-xs) 0;
    margin-right: var(--space-m);
    color: var(--ink-soft);
    font-size: var(--step--1);
  }

  .start-points strong {
    display: inline-grid;
    place-items: center;
    width: 1.55rem;
    height: 1.55rem;
    border: 1px solid var(--line-strong);
    border-radius: 50%;
    font-size: var(--step--2);
    color: var(--accent-ink);
  }

  .estimate-layout {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
    gap: var(--space-xl);
    align-items: start;
  }

  .estimate-aside .rule-label {
    margin-top: var(--space-l);
  }

  .estimate-aside .rule-label:first-child {
    margin-top: 0;
  }

  .estimate-path {
    margin-top: var(--space-l);
    padding-top: var(--space-m);
    border-top: 1px solid var(--line);
  }

  .estimate-path .rule-label {
    margin: 0 0 var(--space-2xs);
  }

  .estimate-path a {
    font-size: var(--step-0);
    font-weight: 600;
    color: var(--accent-ink);
  }

  .estimate-path a span {
    display: inline-block;
    transition: transform var(--dur-fast) var(--ease-out);
  }

  .estimate-path a:hover span,
  .estimate-path a:focus-visible span {
    transform: translateX(0.25rem);
  }

  .estimate-path p:last-child {
    margin-top: var(--space-2xs);
    font-size: var(--step--1);
    color: var(--ink-soft);
  }

  @media (max-width: 700px) {
    .start-points {
      display: grid;
      grid-template-columns: 1fr;
    }

    .start-points span {
      margin-right: 0;
      padding-right: 0;
      border-bottom: 1px solid var(--line);
    }

    .start-points span:last-child {
      border-bottom: 0;
    }
  }

  @media (max-width: 900px) {
    .estimate-layout {
      grid-template-columns: 1fr;
      gap: var(--space-l);
    }
  }
</style>
