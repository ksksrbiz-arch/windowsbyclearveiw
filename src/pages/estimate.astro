---
import BaseLayout from '../layouts/BaseLayout.astro';
import EstimateForm from '../components/EstimateForm.astro';
import { mailHref, site, telHref } from '../data/site';
---
<BaseLayout
  title="Request an estimate"
  description="Request a free in-home window replacement estimate from Clearveiw Windows, LLC in Vancouver, WA."
  path="/estimate"
>
  <section class="page-hero">
    <div class="wrap">
      <p class="kicker">Estimate</p>
      <h1>Tell us about the house.</h1>
      <p class="lede">
        A photo of the elevations and a rough window count is enough to start. We will follow up
        to schedule a measure.
      </p>
    </div>
  </section>
  <section class="section">
    <div class="wrap split">
      <div>
        <p class="kicker">Prefer to talk</p>
        <h2><a href={telHref()}>{site.phoneDisplay}</a></h2>
        <p>
          Mark answers from the truck. If it rings out, leave a name, city, and a window count,
          or email <a href={mailHref()}>{site.email}</a>.
        </p>
      </div>
      <EstimateForm />
    </div>
  </section>
</BaseLayout>
