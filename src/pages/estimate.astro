---
import BaseLayout from '../layouts/BaseLayout.astro';
import EstimateForm from '../components/EstimateForm.astro';
import { mailHref, site, telHref } from '../data/site';
---
<BaseLayout
  title="Request an estimate"
  description="Request a free in-home window replacement estimate from Clearview Windows in Vancouver, WA."
  path="/estimate"
  crumbs={[{ name: 'Request an estimate', href: '/estimate' }]}
>
  <section class="page-hero">
    <div class="wrap">
      <p class="kicker">Estimate</p>
      <h1>Tell us about the house.</h1>
      <p class="lede">
        A photo of the elevations and a rough window count is enough to start. We will follow up
        to schedule a measure.
      </p>
    </div>
  </section>
  <section class="section">
    <div class="wrap estimate-layout" data-reveal>
      <EstimateForm />

      <aside class="estimate-aside">
        <p class="rule-label">Prefer to talk</p>
        <p class="estimate-phone"><a href={telHref()}>{site.phoneDisplay}</a></p>
        <p>
          Mark answers from the truck. If it rings out, leave a name, city, and a window
          count, or email <a href={mailHref()}>{site.email}</a>.
        </p>

        <p class="rule-label">What happens next</p>
        <ol class="steps">
          <li><strong>A call back.</strong> Usually the same day.</li>
          <li><strong>A measure.</strong> Every opening, at the house.</li>
          <li><strong>A written estimate.</strong> Method listed per opening.</li>
        </ol>

        <p class="fine-print">
          No lists, no resale, no follow-up sequence. One person calls you back.
        </p>
      </aside>
    </div>
  </section>
</BaseLayout>

<style>
  /* The form gets the wider column: it is the reason the page exists, and the
     previous even split gave equal weight to a paragraph beside it. */
  .estimate-layout {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
    gap: var(--space-xl);
    align-items: start;
  }

  .estimate-phone {
    margin: 0 0 var(--space-2xs);
    font-size: var(--step-2);
    font-weight: 600;
    letter-spacing: var(--tracking-display);
    font-variant-numeric: tabular-nums;
  }

  .estimate-phone a {
    text-decoration: none;
  }

  .estimate-phone a:hover {
    color: var(--accent-ink);
  }

  .estimate-aside .rule-label {
    margin-top: var(--space-l);
  }

  .estimate-aside .rule-label:first-child {
    margin-top: 0;
  }

  @media (max-width: 900px) {
    .estimate-layout {
      grid-template-columns: 1fr;
      gap: var(--space-l);
    }
  }
</style>
