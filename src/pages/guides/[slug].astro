---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CtaBar from '../../components/CtaBar.astro';
import InsertVsFullFrame from '../../components/diagrams/InsertVsFullFrame.astro';
import FlashingOrder from '../../components/diagrams/FlashingOrder.astro';
import { site } from '../../data/site';

export async function getStaticPaths() {
  const guides = await getCollection('guides', ({ data }) => data.published);
  return guides.map((guide) => ({
    params: { slug: guide.id },
    props: { guide },
  }));
}

const { guide } = Astro.props;
const { Content } = await render(guide);
const related = (await getCollection('guides', ({ data, id }) => data.published && id !== guide.id))
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 3);

const article = {
  '@type': 'Article',
  headline: guide.data.title,
  description: guide.data.description,
  dateModified: guide.data.updated.toISOString(),
  author: { '@type': 'Organization', name: site.legalName },
  publisher: { '@type': 'Organization', name: site.legalName },
  mainEntityOfPage: `${site.url}/guides/${guide.id}`,
};

const faqPage = guide.data.faq.length
  ? {
      '@type': 'FAQPage',
      mainEntity: guide.data.faq.map((item) => ({
        '@type': 'Question',
        name: item.question,
        acceptedAnswer: { '@type': 'Answer', text: item.answer },
      })),
    }
  : null;

const schema = {
  '@context': 'https://schema.org',
  '@graph': faqPage ? [article, faqPage] : [article],
};

const updated = guide.data.updated.toLocaleDateString('en-US', {
  month: 'long',
  year: 'numeric',
});

// Rendered markdown is not available here, so estimate from the source body.
// 200 wpm, floored at one minute — it is a reading cue, not a measurement.
const minutes = Math.max(1, Math.round(guide.body.split(/\s+/).length / 200));
---
<BaseLayout
  title={guide.data.title}
  description={guide.data.description}
  path={`/guides/${guide.id}`}
  {...(guide.data.heroImage
    ? { ogImageSrc: guide.data.heroImage, ogImageAlt: guide.data.heroImageAlt ?? guide.data.title }
    : {})}
  crumbs={[
    { name: 'Guides', href: '/guides' },
    { name: guide.data.title, href: `/guides/${guide.id}` },
  ]}
  schema={schema}
>
  <section class="page-hero article-hero">
    <div class="wrap is-narrow">
      <p class="kicker">{guide.data.kicker}</p>
      <h1>{guide.data.title}</h1>
      <p class="lede">{guide.data.description}</p>
      <p class="article-meta">
        <span>{guide.data.topic}</span>
        <span>Updated {updated}</span>
        <span>{minutes} min read</span>
      </p>
    </div>
  </section>

  {guide.data.diagram && (
    <section class="section is-tight section-sunk">
      <div class="wrap" data-reveal>
        {guide.data.diagram === 'insert-vs-full-frame' && (
          <InsertVsFullFrame heading={null} />
        )}
        {guide.data.diagram === 'flashing-order' && <FlashingOrder />}
      </div>
    </section>
  )}

  {!guide.data.diagram && guide.data.heroImage && (
    <section class="section is-tight section-sunk">
      <div class="wrap is-narrow" data-reveal>
        <figure class="guide-photo">
          <Image
            src={guide.data.heroImage}
            alt={guide.data.heroImageAlt ?? ''}
            widths={[480, 760, 1140]}
            sizes="(max-width: 800px) 100vw, 760px"
            format="webp"
            quality={72}
            loading="eager"
            fetchpriority="high"
          />
          <figcaption>Stock photo for illustration — not a Clearveiw job.</figcaption>
        </figure>
      </div>
    </section>
  )}

  <article class="section">
    <div class="wrap is-narrow prose" data-reveal>
      <Content />
    </div>

    {guide.data.faq.length > 0 && (
      <div class="wrap is-narrow" data-reveal>
        <section class="faq">
          <p class="rule-label">Common questions</p>
          {guide.data.faq.map((item) => (
            <details>
              <summary>{item.question}</summary>
              <p>{item.answer}</p>
            </details>
          ))}
        </section>
        <p class="faq-ask"><a href="/ask">Still have a question? Ask our guide assistant &rarr;</a></p>
      </div>
    )}

    <div class="wrap is-narrow" data-reveal>
      <section class="related">
        <p class="rule-label">Keep reading</p>
        <ul class="related-list">
          {related.map((item) => (
            <li>
              <a href={`/guides/${item.id}`}>
                <span class="related-topic">{item.data.topic}</span>
                <strong>{item.data.title}</strong>
                <span class="related-blurb">{item.data.description}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    </div>
  </article>
  <CtaBar />
</BaseLayout>

<style>
  /* ───────────────────────────────────────────────────────────────────────
     Guide pages were the weakest type on the site: an h1 dropped onto paper
     with no hero, no measure, and body copy set at the same weight as the
     rest of the page. These are the pages that earn organic traffic, so they
     get proper article typography — a real masthead, a held measure, and
     enough hierarchy that a long answer is skimmable.
     ─────────────────────────────────────────────────────────────────────── */
  .article-hero h1 {
    max-width: 20ch;
  }

  .article-meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs) var(--space-s);
    margin: var(--space-m) 0 0;
    padding-top: var(--space-s);
    border-top: 1px solid var(--dark-line);
    font-size: var(--step--2);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--on-dark-faint);
  }

  .article-meta span + span::before {
    content: '·';
    margin-right: var(--space-s);
  }

  /* Guide photo ───────────────────────────────────────────────────────── */
  .guide-photo {
    margin: 0;
  }

  .guide-photo img {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: var(--radius);
    box-shadow: var(--shadow-sm);
    background: var(--paper-raised);
  }

  .guide-photo figcaption {
    margin-top: var(--space-2xs);
    font-size: var(--step--2);
    color: var(--ink-faint);
  }

  /* FAQ ───────────────────────────────────────────────────────────────── */
  .faq {
    margin-top: var(--space-2xl);
  }

  .faq details {
    border-top: 1px solid var(--line);
    padding: 0;
  }

  .faq details:last-of-type {
    border-bottom: 1px solid var(--line);
  }

  .faq summary {
    display: flex;
    align-items: baseline;
    gap: var(--space-2xs);
    padding: var(--space-s) 0;
    cursor: pointer;
    font-weight: 500;
    font-size: var(--step-0);
    list-style: none;
  }

  .faq summary::-webkit-details-marker {
    display: none;
  }

  .faq summary::before {
    content: '';
    width: 0.7rem;
    height: 1px;
    flex: none;
    translate: 0 -0.3rem;
    background: var(--accent);
    transition: rotate var(--dur) var(--ease-out);
  }

  .faq details[open] summary::before {
    rotate: 90deg;
  }

  .faq summary:hover {
    color: var(--accent-ink);
  }

  .faq details p {
    margin: 0 0 var(--space-s);
    padding-left: calc(0.7rem + var(--space-2xs));
    color: var(--ink-soft);
    font-size: var(--step--1);
  }

  .faq-ask {
    margin-top: var(--space-m);
    font-size: var(--step--1);
  }

  .faq-ask a {
    font-weight: 500;
  }

  /* Related ───────────────────────────────────────────────────────────── */
  .related {
    margin-top: var(--space-2xl);
  }

  .related-list {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--line);
  }

  .related-list li {
    border-bottom: 1px solid var(--line);
  }

  .related-list a {
    display: grid;
    gap: 0.2rem;
    padding: var(--space-s) 0;
    text-decoration: none;
    color: inherit;
    transition: padding-left var(--dur) var(--ease-out), background var(--dur-fast) var(--ease);
  }

  .related-list a:hover,
  .related-list a:focus-visible {
    padding-left: var(--space-2xs);
    background: var(--accent-wash);
  }

  .related-topic {
    text-transform: uppercase;
    letter-spacing: var(--tracking-label);
    font-size: var(--step--2);
    font-weight: 500;
    color: var(--ink-faint);
  }

  .related-list strong {
    font-size: var(--step-1);
    font-weight: 600;
    letter-spacing: -0.015em;
  }

  .related-blurb {
    color: var(--ink-soft);
    font-size: var(--step--1);
  }
</style>
