---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CtaBar from '../../components/CtaBar.astro';
import InsertVsFullFrame from '../../components/diagrams/InsertVsFullFrame.astro';
import FlashingOrder from '../../components/diagrams/FlashingOrder.astro';
import GlassAnatomy from '../../components/diagrams/GlassAnatomy.astro';
import SignsChecklist from '../../components/diagrams/SignsChecklist.astro';
import EstimateBuildUp from '../../components/diagrams/EstimateBuildUp.astro';
import FaqAccordion from '../../components/FaqAccordion.astro';
import { site } from '../../data/site';

export async function getStaticPaths() {
  const guides = await getCollection('guides', ({ data }) => data.published);
  return guides.map((guide) => ({
    params: { slug: guide.id },
    props: { guide },
  }));
}

const { guide } = Astro.props;
const { Content } = await render(guide);
const related = (await getCollection('guides', ({ data, id }) => data.published && id !== guide.id))
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 3);

const diagramNotes = {
  'insert-vs-full-frame': {
    eyebrow: 'Photo guide',
    title: 'See what actually changes at the opening.',
    body: 'The easiest way to understand the two methods is to look at how far the existing assembly is opened up.',
    answer: 'Insert replacement keeps the existing frame. Full-frame replacement removes that frame and takes the work back to the rough opening.',
  },
  'flashing-order': {
    eyebrow: 'Photo guide',
    title: 'Follow the water path, not the product names.',
    body: 'Start with the installation photo, then use the numbered notes to see how sill, jamb, head, and WRB treatments work together.',
    answer: 'The objective is controlled drainage: water moves down through the exterior layers and leaves the wall assembly instead of turning inward.',
  },
  'glass-anatomy': {
    eyebrow: 'Photo guide',
    title: 'The location of the moisture tells you what failed.',
    body: 'Compare moisture inside the insulated glass unit with condensation sitting on the room-facing surface.',
    answer: 'Fog trapped between panes points to an insulated-glass seal failure. Water on the room-side surface is surface condensation.',
  },
  'signs-checklist': {
    eyebrow: 'Photo guide',
    title: 'Inspect the opening before you decide what the symptom means.',
    body: 'Use the numbered checks to inspect the opening, then compare multiple signs at the same window.',
    answer: 'A symptom is a clue, not a diagnosis. Location, repetition, and the condition of the opening matter more than one isolated nuisance.',
  },
};

const article = {
  '@type': 'Article',
  headline: guide.data.title,
  description: guide.data.description,
  dateModified: guide.data.updated.toISOString(),
  author: {
    '@type': 'Person',
    name: site.owner,
    jobTitle: 'Owner and installer',
    worksFor: { '@type': 'Organization', name: site.legalName },
  },
  publisher: { '@type': 'Organization', name: site.legalName },
  mainEntityOfPage: `${site.url}/guides/${guide.id}`,
};

const faqPage = guide.data.faq.length
  ? {
      '@type': 'FAQPage',
      mainEntity: guide.data.faq.map((item) => ({
        '@type': 'Question',
        name: item.question,
        acceptedAnswer: { '@type': 'Answer', text: item.answer },
      })),
    }
  : null;

const schema = {
  '@context': 'https://schema.org',
  '@graph': faqPage ? [article, faqPage] : [article],
};

const updated = guide.data.updated.toLocaleDateString('en-US', {
  month: 'long',
  year: 'numeric',
});

const minutes = Math.max(1, Math.round(guide.body.split(/\s+/).length / 200));
const currentDiagramNote = guide.data.diagram ? diagramNotes[guide.data.diagram] : null;

const slugifyHeading = (value) => value
  .toLowerCase()
  .trim()
  .replace(/[`*_~]/g, '')
  .replace(/[^a-z0-9\s-]/g, '')
  .replace(/\s+/g, '-')
  .replace(/-+/g, '-');

const pageHeadings = [...guide.body.matchAll(/^##\s+(.+)$/gm)]
  .map((match) => ({ text: match[1].replace(/[`*_~]/g, '').trim(), id: slugifyHeading(match[1]) }))
  .filter((heading) => heading.text)
  .slice(0, 8);
---
<BaseLayout
  title={guide.data.title}
  description={guide.data.description}
  path={`/guides/${guide.id}`}
  {...(guide.data.heroImage
    ? { ogImageSrc: guide.data.heroImage, ogImageAlt: guide.data.heroImageAlt ?? guide.data.title }
    : {})}
  crumbs={[
    { name: 'Guides', href: '/guides' },
    { name: guide.data.title, href: `/guides/${guide.id}` },
  ]}
  schema={schema}
>
  <section class="page-hero article-hero">
    <div class="wrap is-narrow">
      <p class="kicker">{guide.data.kicker}</p>
      <h1>{guide.data.title}</h1>
      <p class="lede">{guide.data.description}</p>
      <div class="article-tools" aria-label="Guide actions">
        <a href="/guides">All guides</a>
        <a href="/ask">Ask a question</a>
      </div>
      <p class="article-meta">
        <span>Written by <a href="/about">{site.owner}</a>, owner and installer</span>
        <span>{guide.data.topic}</span>
        <span>Updated {updated}</span>
        <span>{minutes} min read</span>
      </p>
    </div>
  </section>

  {currentDiagramNote && (
    <section class="section is-tight section-sunk visual-section">
      <div class="wrap" data-reveal>
        <div class="answer-strip">
          <span class="answer-mark">ANSWER</span>
          <strong>{currentDiagramNote.answer}</strong>
        </div>

        <div class="visual-intro">
          <div>
            <p class="rule-label">{currentDiagramNote.eyebrow}</p>
            <h2>{currentDiagramNote.title}</h2>
          </div>
          <p>{currentDiagramNote.body}</p>
        </div>

        <div class="visual-frame">
          {guide.data.diagram === 'insert-vs-full-frame' && (
            <InsertVsFullFrame heading={null} />
          )}
          {guide.data.diagram === 'flashing-order' && <FlashingOrder />}
          {guide.data.diagram === 'glass-anatomy' && <GlassAnatomy heading={null} />}
          {guide.data.diagram === 'signs-checklist' && <SignsChecklist />}
        </div>
      </div>
    </section>
  )}

  {!guide.data.diagram && guide.data.heroImage && (
    <section class="section is-tight section-sunk">
      <div class="wrap is-narrow" data-reveal>
        <figure class="guide-photo">
          <Image
            src={guide.data.heroImage}
            alt={guide.data.heroImageAlt ?? ''}
            widths={[480, 760, 1140]}
            sizes="(max-width: 800px) 100vw, 760px"
            format="webp"
            quality={72}
            loading="eager"
            fetchpriority="high"
            style={`object-position: ${guide.data.heroImageFocus ?? '50% 50%'}`}
          />
          <figcaption>{guide.data.heroImageCredit ?? 'Stock photo for illustration — not a Clearview job.'}</figcaption>
        </figure>
      </div>
    </section>
  )}

  <article class="section">
    <div class="wrap is-narrow">
      {pageHeadings.length >= 3 && (
        <nav class="guide-outline" aria-label="On this page">
          <div class="guide-outline-label">On this page</div>
          <ol>
            {pageHeadings.map((heading, index) => (
              <li>
                <a href={`#${heading.id}`}>
                  <span aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
                  <span>{heading.text}</span>
                </a>
              </li>
            ))}
          </ol>
        </nav>
      )}
    </div>

    <div class="wrap is-narrow prose" data-reveal>
      <Content />
    </div>

    {guide.data.secondaryDiagram && (
      <div class="wrap is-narrow" data-reveal>
        <section class="section-tight secondary-diagram">
          <div class="secondary-label">
            <span>More detail</span>
            <span aria-hidden="true">↓</span>
          </div>
          {guide.data.secondaryDiagram === 'flashing-order' && <FlashingOrder />}
          {guide.data.secondaryDiagram === 'cost-build-up' && <EstimateBuildUp />}
        </section>
      </div>
    )}

    {guide.data.faq.length > 0 && (
      <div class="wrap is-narrow" data-reveal>
        <FaqAccordion items={guide.data.faq} />
        <p class="faq-ask"><a href="/ask">Still have a question? Ask our guide assistant &rarr;</a></p>
      </div>
    )}

    <div class="wrap is-narrow" data-reveal>
      <section class="related">
        <div class="related-head">
          <div>
            <h2 class="rule-label">Keep reading</h2>
            <p>Continue from the question you just answered.</p>
          </div>
          <a href="/guides">View all guides →</a>
        </div>
        <ul class="related-list">
          {related.map((item) => (
            <li>
              <a href={`/guides/${item.id}`}>
                <span class="related-topic">{item.data.topic}</span>
                <strong>{item.data.title}</strong>
                <span class="related-blurb">{item.data.description}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    </div>
  </article>
  <CtaBar />
</BaseLayout>

<style>
  .article-hero h1 { max-width: 20ch; }

  .article-tools {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs) var(--space-s);
    margin: var(--space-m) 0 0;
  }

  .article-tools a {
    display: inline-flex;
    align-items: center;
    min-height: 2.4rem;
    padding: 0.45rem 0.8rem;
    border: 1px solid var(--dark-line-strong);
    color: var(--on-dark);
    text-decoration: none;
    font-size: var(--step--2);
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    transition: background var(--dur-fast) var(--ease), border-color var(--dur-fast) var(--ease);
  }

  .article-tools a:hover,
  .article-tools a:focus-visible {
    background: color-mix(in srgb, var(--on-dark) 9%, transparent);
    border-color: var(--on-dark-soft);
  }

  .article-meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs) var(--space-s);
    margin: var(--space-m) 0 0;
    padding-top: var(--space-s);
    border-top: 1px solid var(--dark-line);
    font-size: var(--step--2);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--on-dark-faint);
  }

  .article-meta span + span::before { content: '·'; margin-right: var(--space-s); }
  .article-meta a { color: var(--on-dark-soft); text-decoration: underline; text-underline-offset: 0.2em; text-decoration-color: var(--dark-line-strong); }
  .article-meta a:hover, .article-meta a:focus-visible { color: var(--on-dark); text-decoration-color: currentColor; }

  .answer-strip {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: var(--space-s);
    align-items: center;
    margin-bottom: var(--space-l);
    padding: var(--space-s) var(--space-m);
    border: 1px solid var(--line-strong);
    border-left: 4px solid var(--accent);
    background: var(--paper-raised);
    box-shadow: var(--shadow-soft);
  }

  .answer-mark { padding: .28rem .45rem; background: var(--ink); color: var(--paper); font-size: 10px; font-weight: 750; letter-spacing: .11em; }
  .answer-strip strong { max-width: 72ch; font-size: var(--step-0); line-height: 1.3; }
  .visual-section .wrap { max-width: 92rem; }

  .visual-intro {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(18rem, 32rem);
    gap: var(--space-xl);
    align-items: end;
    margin-bottom: var(--space-m);
  }

  .visual-intro h2 { max-width: 23ch; margin: 0.35rem 0 0; }
  .visual-intro > p { margin: 0; color: var(--ink-soft); }

  .visual-frame {
    padding: clamp(var(--space-s), 2.5vw, var(--space-m));
    border: 1px solid var(--line);
    border-top: 2px solid var(--ink);
    background: var(--paper-raised);
    box-shadow: var(--shadow-soft);
  }

  .guide-photo { margin: 0; }
  .guide-photo img { display: block; width: 100%; height: auto; aspect-ratio: 16 / 9; object-fit: cover; border-radius: var(--radius); box-shadow: var(--shadow-sm); background: var(--paper-raised); }
  .guide-photo figcaption { margin-top: var(--space-2xs); font-size: var(--step--2); color: var(--ink-faint); }

  .guide-outline {
    position: sticky;
    top: 76px;
    z-index: 4;
    margin: 0 0 var(--space-l);
    padding: var(--space-xs) var(--space-s);
    border: 1px solid var(--line);
    border-left: 3px solid var(--accent);
    background: color-mix(in srgb, var(--paper-raised) 94%, transparent);
    backdrop-filter: blur(8px);
    box-shadow: var(--shadow-sm);
  }

  .guide-outline-label {
    margin-bottom: var(--space-2xs);
    font-size: var(--step--2);
    font-weight: 600;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--ink-faint);
  }

  .guide-outline ol {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: .25rem var(--space-s);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .guide-outline a {
    display: grid;
    grid-template-columns: 1.8rem minmax(0, 1fr);
    gap: .35rem;
    align-items: baseline;
    padding: .28rem 0;
    color: var(--ink-soft);
    text-decoration: none;
    font-size: var(--step--1);
    line-height: 1.35;
  }

  .guide-outline a:hover,
  .guide-outline a:focus-visible { color: var(--accent-ink); }

  .guide-outline a span:first-child {
    color: var(--accent);
    font-size: var(--step--2);
    font-variant-numeric: tabular-nums;
    letter-spacing: .06em;
  }

  .secondary-diagram { margin-top: var(--space-2xl); padding-top: var(--space-xl); border-top: 1px solid var(--line); }
  .secondary-label { display: flex; justify-content: space-between; margin-bottom: var(--space-s); color: var(--ink-faint); font-size: var(--step--2); font-weight: 600; letter-spacing: var(--tracking-label); text-transform: uppercase; }
  .faq-ask { margin-top: var(--space-m); font-size: var(--step--1); }
  .faq-ask a { font-weight: 500; }
  .related { margin-top: var(--space-2xl); }

  .related-head { display: flex; justify-content: space-between; gap: var(--space-l); align-items: end; margin-bottom: var(--space-s); }
  .related-head h2 { margin-bottom: 0; }
  .related-head p { margin: 0.35rem 0 0; color: var(--ink-soft); }
  .related-head > a { flex: 0 0 auto; font-size: var(--step--1); font-weight: 600; }
  .related-list { margin: 0; padding: 0; list-style: none; border-top: 1px solid var(--line); }
  .related-list li { border-bottom: 1px solid var(--line); }
  .related-list a { display: grid; gap: 0.2rem; padding: var(--space-s) 0; text-decoration: none; color: inherit; transition: padding-left var(--dur) var(--ease-out), background var(--dur-fast) var(--ease); }
  .related-list a:hover, .related-list a:focus-visible { padding-left: var(--space-2xs); background: var(--accent-wash); }
  .related-topic { text-transform: uppercase; letter-spacing: var(--tracking-label); font-size: var(--step--2); font-weight: 500; color: var(--ink-faint); }
  .related-list strong { font-size: var(--step-1); font-weight: 600; letter-spacing: -0.015em; }
  .related-blurb { color: var(--ink-soft); font-size: var(--step--1); }

  @media (max-width: 800px) {
    .visual-intro { grid-template-columns: 1fr; gap: var(--space-s); }
    .related-head { align-items: start; flex-direction: column; gap: var(--space-2xs); }
    .answer-strip { grid-template-columns: 1fr; gap: .4rem; align-items: start; }
    .guide-outline { position: static; }
    .guide-outline ol { grid-template-columns: 1fr; }
  }
</style>
