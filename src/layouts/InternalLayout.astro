---
import '../styles/global.css';

interface Props { title: string; showLogout?: boolean; }
const { title, showLogout = true } = Astro.props;
const pathname = Astro.url.pathname;
const navItems = [
  { href: '/internal/', label: 'Dashboard' },
  { href: '/internal/today', label: 'Today' },
  { href: '/internal/leads', label: 'Leads' },
  { href: '/internal/follow-up', label: 'Follow-up' },
  { href: '/internal/quotes', label: 'Quotes' },
  { href: '/internal/invoices', label: 'Invoices' },
  { href: '/internal/jobs', label: 'Jobs' },
  { href: '/internal/schedule', label: 'Schedule' },
  { href: '/internal/payments', label: 'Payments' },
  { href: '/internal/tools', label: 'Tools' },
  { href: '/internal/ask-logs', label: 'Ask' },
];
const isActive = (href: string) => href === '/internal/' ? pathname === href : pathname.startsWith(href);
const mobileItems = navItems.filter((item) => ['/internal/today', '/internal/leads', '/internal/quotes', '/internal/jobs', '/internal/payments'].includes(item.href));
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title} · Clearview internal</title>
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#101113" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
  </head>
  <body class="internal">
    <header class="internal-header">
      <div class="internal-header-inner">
        <a class="internal-brand" href="/internal/" aria-label="Clearview Command Center">Clearview <span>Command Center</span></a>
        {showLogout && (
          <div class="internal-header-right">
            <nav class="internal-nav" aria-label="Internal navigation">
              {navItems.map((item) => (
                <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined} class:list={{ active: isActive(item.href) }}>{item.label}</a>
              ))}
            </nav>
            <form method="post" action="/internal/api/logout"><button class="internal-logout" type="submit">Log out</button></form>
          </div>
        )}
      </div>
    </header>

    {showLogout && (
      <nav class="internal-mobile-nav" aria-label="Primary mobile navigation">
        {mobileItems.map((item) => (
          <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined} class:list={{ active: isActive(item.href) }}>
            <span class="mobile-nav-icon" aria-hidden="true">
              {item.href === '/internal/today' && '◷'}
              {item.href === '/internal/leads' && '◉'}
              {item.href === '/internal/quotes' && '≡'}
              {item.href === '/internal/jobs' && '⌂'}
              {item.href === '/internal/payments' && '$'}
            </span>
            <span>{item.label}</span>
          </a>
        ))}
      </nav>
    )}

    <main class="internal-main"><slot /></main>

    <script>
      (() => {
        const MEASUREMENT_KEY = 'clearview:measurement-worksheet:v1';
        const normalize = (value) => String(value ?? '').toLowerCase().replace(/[^a-z0-9]+/g, ' ').trim();

        function mountMeasurementImport() {
          if (location.pathname !== '/internal/quotes/new') return;
          const form = document.getElementById('quote-form');
          if (!(form instanceof HTMLFormElement) || form.dataset.measurementImportReady === 'true') return;
          let worksheet;
          try { worksheet = JSON.parse(localStorage.getItem(MEASUREMENT_KEY) || 'null'); } catch { worksheet = null; }
          if (!worksheet || !Array.isArray(worksheet.openings) || worksheet.openings.length === 0) return;
          const submit = form.querySelector('[data-submit]');
          const anchor = submit?.closest('fieldset') || form.firstElementChild;
          if (!(anchor instanceof Element)) return;
          const bar = document.createElement('div'); bar.className = 'measurement-import-bar';
          bar.innerHTML = `<div><strong>Saved field measurements found</strong><span>${worksheet.openings.length} opening${worksheet.openings.length === 1 ? '' : 's'} ready to import.</span></div><button type="button" class="btn btn-ghost" data-import-measurements>Import measurements</button>`;
          anchor.before(bar); form.dataset.measurementImportReady = 'true';
          const button = bar.querySelector('[data-import-measurements]'); if (!(button instanceof HTMLButtonElement)) return;
          button.addEventListener('click', () => {
            if (!window.confirm(`Import ${worksheet.openings.length} measured opening${worksheet.openings.length === 1 ? '' : 's'} into this quote? Existing quote lines will be kept.`)) return;
            button.disabled = true; button.textContent = 'Importing…';
            const setIfBlank = (name, value) => { const field = form.elements.namedItem(name); if ((field instanceof HTMLInputElement || field instanceof HTMLTextAreaElement) && !field.value.trim()) field.value = String(value ?? ''); };
            setIfBlank('name', worksheet.jobName || ''); setIfBlank('address', worksheet.jobAddress || '');
            if (worksheet.jobNotes) { const notes = form.elements.namedItem('notes'); if (notes instanceof HTMLTextAreaElement && !notes.value.includes('Field measurement notes:')) notes.value = notes.value.trim() ? `${notes.value.trim()}\n\nField measurement notes:\n${worksheet.jobNotes}` : `Field measurement notes:\n${worksheet.jobNotes}`; }
            const openingSelect = form.querySelector('[data-catalog-opening]'); const qtyInput = form.querySelector('[data-catalog-qty]'); const addButton = form.querySelector('[data-catalog-add]'); const itemsBody = form.querySelector('[data-items-body]'); const options = openingSelect instanceof HTMLSelectElement ? Array.from(openingSelect.options) : [];
            let imported = 0; let skipped = 0;
            if (openingSelect instanceof HTMLSelectElement && qtyInput instanceof HTMLInputElement && addButton instanceof HTMLButtonElement && itemsBody instanceof HTMLElement) {
              for (const opening of worksheet.openings) {
                const target = normalize(opening.type);
                const option = options.find((candidate) => normalize(candidate.textContent) === target) || options.find((candidate) => normalize(candidate.textContent).includes(target) || target.includes(normalize(candidate.textContent)));
                if (!option) { skipped += 1; continue; }
                openingSelect.value = option.value; qtyInput.value = String(Math.max(1, Number(opening.quantity) || 1)); addButton.click();
                const rows = itemsBody.querySelectorAll('tr'); const lastRow = rows[rows.length - 1]; const labelInput = lastRow?.querySelector('td:first-child input');
                if (labelInput instanceof HTMLInputElement) { const width = opening.width === '' ? '?' : Number(opening.width).toLocaleString('en-US'); const height = opening.height === '' ? '?' : Number(opening.height).toLocaleString('en-US'); const room = opening.room ? `${opening.room} — ` : ''; labelInput.value = `${room}${opening.type} — ${width}\" W × ${height}\" H`; labelInput.dispatchEvent(new Event('input', { bubbles: true })); }
                imported += 1;
              }
            }
            const summary = bar.querySelector('span'); if (summary) summary.textContent = skipped ? `${imported} imported · ${skipped} skipped (not in price book)` : `${imported} opening${imported === 1 ? '' : 's'} imported into the quote.`;
            button.textContent = imported ? 'Imported' : 'Nothing imported';
          });
        }

        function mountFollowUpPrefill() {
          if (location.pathname !== '/internal/follow-up') return;
          const leadId = new URLSearchParams(location.search).get('leadId'); if (!leadId) return;
          const addButton = document.querySelector('[data-add-open]'); const leadField = document.querySelector('input[name="leadId"]');
          if (!(leadField instanceof HTMLInputElement)) return; leadField.value = leadId; if (addButton instanceof HTMLButtonElement) addButton.click();
        }

        function mountJobPhotoLink() {
          if (location.pathname !== '/internal/jobs/view') return;
          const id = new URLSearchParams(location.search).get('id'); if (!id) return;
          const actions = document.querySelector('.head-actions'); if (!(actions instanceof HTMLElement) || actions.querySelector('[data-job-photos-link]') || actions.querySelector('[data-photos-link]')) return;
          const link = document.createElement('a'); link.className = 'btn btn-ghost'; link.href = `/internal/tools/photos?jobId=${encodeURIComponent(id)}`; link.dataset.jobPhotosLink = 'true'; link.textContent = 'Job photos'; actions.insertBefore(link, actions.firstChild);
        }

        function mountQuoteInvoiceActions() {
          if (location.pathname !== '/internal/quotes/view') return;
          const id = new URLSearchParams(location.search).get('id');
          const actions = document.querySelector('.qv-toolbar-actions');
          if (!id || !(actions instanceof HTMLElement) || actions.dataset.invoiceReady === 'true') return;
          actions.dataset.invoiceReady = 'true';
          const status = document.createElement('span'); status.className = 'quote-invoice-status'; status.hidden = true; actions.prepend(status);
          fetch(`/internal/api/quotes/${encodeURIComponent(id)}`, { headers: { 'cache-control': 'no-cache' } })
            .then(async (response) => { const data = await response.json().catch(() => ({})); if (!response.ok) throw new Error(data.error || 'Could not load invoice status.'); return data; })
            .then((data) => {
              const quote = data.quote; const invoice = data.invoice;
              if (!quote || quote.status !== 'finalized' || !invoice) return;
              const view = document.createElement('a'); view.className = 'btn btn-ghost'; view.href = `/internal/invoices/view?id=${encodeURIComponent(invoice.id)}`; view.textContent = 'View invoice'; actions.insertBefore(view, actions.firstChild);
              if (invoice.status === 'paid') { status.hidden = false; status.textContent = `Paid ${invoice.paid_at ? new Date(invoice.paid_at).toLocaleDateString('en-US') : ''}`.trim(); }
              else if (invoice.status === 'sent') { status.hidden = false; status.textContent = `Sent ${invoice.sent_at ? new Date(invoice.sent_at).toLocaleDateString('en-US') : ''}`.trim(); }
              const email = document.createElement('button'); email.type = 'button'; email.className = 'btn btn-primary'; email.textContent = invoice.status === 'sent' || invoice.status === 'paid' ? 'Email invoice again' : 'Email invoice'; email.disabled = !invoice.customer_email; email.title = invoice.customer_email ? `Send to ${invoice.customer_email}` : 'Customer email is missing'; actions.insertBefore(email, view.nextSibling);
              email.addEventListener('click', async () => {
                if (!invoice.customer_email) return;
                if (!window.confirm(`Email ${invoice.invoice_number} to ${invoice.customer_email}?`)) return;
                email.disabled = true; email.textContent = 'Sending…'; status.hidden = true;
                try { const response = await fetch(`/internal/api/invoices/${encodeURIComponent(invoice.id)}`, { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ action: 'email' }) }); const result = await response.json().catch(() => ({})); if (!response.ok) throw new Error(result.error || 'Could not send the invoice.'); email.textContent = 'Email invoice again'; status.hidden = false; status.textContent = `Sent ${new Date(result.sentAt || Date.now()).toLocaleString('en-US')}`; email.disabled = false; }
                catch (error) { status.hidden = false; status.textContent = error instanceof Error ? error.message : 'Could not send the invoice.'; email.textContent = 'Email invoice'; email.disabled = false; }
              });
            }).catch(() => {});
        }

        function mountInternalEnhancements() { mountMeasurementImport(); mountFollowUpPrefill(); mountJobPhotoLink(); mountQuoteInvoiceActions(); }
        mountInternalEnhancements();
        document.addEventListener('astro:page-load', mountInternalEnhancements);
      })();
    </script>

    <style>
      .internal{background:var(--paper);min-height:100vh;padding-bottom:env(safe-area-inset-bottom)}
      .internal-header{position:sticky;top:0;z-index:40;background:color-mix(in srgb,var(--black) 97%,transparent);color:var(--on-dark);border-bottom:1px solid var(--dark-line);backdrop-filter:blur(14px)}
      .internal-header-inner{max-width:76rem;margin-inline:auto;padding:.68rem var(--space-m);display:flex;align-items:center;justify-content:space-between;gap:var(--space-m)}
      .internal-brand{color:var(--on-dark);font-weight:750;letter-spacing:-.02em;text-decoration:none;white-space:nowrap}.internal-brand span{color:var(--accent-bright);font-weight:550;margin-left:.35rem}
      .internal-header-right{display:flex;align-items:center;gap:var(--space-s);min-width:0}.internal-nav{display:flex;align-items:center;gap:.15rem;min-width:0;overflow-x:auto;scrollbar-width:none}.internal-nav::-webkit-scrollbar{display:none}
      .internal-nav a{position:relative;color:var(--on-dark-soft);text-decoration:none;font-size:var(--step--2);font-weight:650;padding:.48rem .58rem;border-radius:var(--radius);white-space:nowrap}.internal-nav a::after{content:'';position:absolute;left:.58rem;right:.58rem;bottom:.16rem;height:2px;border-radius:999px;background:var(--accent-bright);transform:scaleX(0);transform-origin:center;transition:transform 140ms ease}.internal-nav a:hover,.internal-nav a:focus-visible,.internal-nav a.active{color:var(--on-dark);background:rgb(255 255 255 / .08)}.internal-nav a.active::after{transform:scaleX(1)}
      .internal-logout{background:transparent;border:1px solid var(--dark-line-strong);color:var(--on-dark-soft);border-radius:var(--radius);padding:.48rem .78rem;font:inherit;font-size:var(--step--2);font-weight:650;cursor:pointer;white-space:nowrap}.internal-logout:hover{border-color:var(--accent-bright);color:var(--on-dark)}
      .internal-main{max-width:76rem;margin-inline:auto;padding:clamp(1.25rem,3vw,2rem) var(--space-m) clamp(5.5rem,8vw,7rem)}.internal-mobile-nav{display:none}
      .measurement-import-bar{margin:0 0 var(--space-m);padding:.9rem var(--space-m);border:1px solid color-mix(in srgb,var(--accent) 30%,var(--line));border-radius:var(--radius);background:var(--accent-wash);display:flex;justify-content:space-between;align-items:center;gap:var(--space-m)}.measurement-import-bar>div{display:grid;gap:.15rem}.measurement-import-bar span{color:var(--ink-soft);font-size:var(--step--2)}
      .quote-invoice-status{display:inline-flex;align-items:center;padding:.42rem .65rem;border:1px solid var(--line);border-radius:var(--radius);font-size:var(--step--2);color:var(--ink-soft);white-space:nowrap}
      @media(max-width:980px){.internal-header-inner{gap:var(--space-s)}.internal-header-right{flex:1;justify-content:flex-end}.internal-nav a{padding-inline:.45rem}.internal-nav a::after{left:.45rem;right:.45rem}.internal-brand span{display:none}}
      @media(max-width:680px){.internal-header-inner{padding:.72rem var(--space-s)}.internal-brand{font-size:.95rem}.internal-logout{padding:.5rem .68rem}.internal-nav{display:none}.internal-main{padding:1rem var(--space-s) 6.25rem}.internal-mobile-nav{position:fixed;left:0;right:0;bottom:0;z-index:50;display:grid;grid-template-columns:repeat(5,1fr);padding:.42rem .35rem calc(.42rem + env(safe-area-inset-bottom));background:color-mix(in srgb,var(--black) 98%,transparent);border-top:1px solid var(--dark-line-strong);box-shadow:0 -10px 30px rgb(0 0 0 / .12);backdrop-filter:blur(16px)}.internal-mobile-nav a{min-width:0;min-height:3.7rem;display:grid;place-items:center;align-content:center;gap:.16rem;color:var(--on-dark-soft);text-decoration:none;border-radius:.75rem;font-size:.64rem;font-weight:700;line-height:1.05}.internal-mobile-nav a.active{color:var(--on-dark);background:rgb(255 255 255 / .09)}.mobile-nav-icon{font-size:1.15rem;line-height:1;font-weight:500}.measurement-import-bar{align-items:flex-start;flex-direction:column;padding:.85rem}.measurement-import-bar .btn{width:100%}.quote-invoice-status{width:100%}}
      @media(max-width:420px){.internal-main{padding-inline:.7rem}.internal-logout{font-size:.7rem}.internal-mobile-nav a{min-height:3.55rem;font-size:.6rem}}
      @media(prefers-reduced-motion:reduce){.internal-nav a::after{transition:none}}
      @media print{.internal-header,.internal-mobile-nav{display:none}.internal-main{max-width:none;padding:0}.measurement-import-bar,.quote-invoice-status{display:none}}

      /* Runtime-rendered records are populated after page load, so these
         shared selectors intentionally bypass Astro component scoping. */
      :global(.internal .task-row),:global(.internal .lead-row),:global(.internal .quote-row),:global(.internal .job-row),:global(.internal .row),:global(.internal .task){display:grid;gap:.75rem;align-items:center;border-bottom:1px solid var(--line);min-width:0}
      :global(.internal .task-row),:global(.internal .lead-row){grid-template-columns:auto minmax(0,1fr) auto auto;padding:.85rem 0}
      :global(.internal .quote-row),:global(.internal .job-row){grid-template-columns:auto minmax(0,1fr) auto;padding:.85rem 0;color:inherit;text-decoration:none}
      :global(.internal .row){grid-template-columns:minmax(0,1fr) auto;padding:var(--space-m) 0;color:inherit;text-decoration:none}
      :global(.internal .task){grid-template-columns:minmax(0,1fr) auto;padding:var(--space-m) 0}
      :global(.internal .task-row:last-child),:global(.internal .lead-row:last-child),:global(.internal .quote-row:last-child),:global(.internal .job-row:last-child),:global(.internal .row:last-child),:global(.internal .task:last-child){border-bottom:0}
      :global(.internal .row:hover),:global(.internal .task-row:hover),:global(.internal .lead-row:hover),:global(.internal .quote-row:hover),:global(.internal .job-row:hover){background:linear-gradient(90deg,transparent,var(--accent-wash),transparent)}
      :global(.internal .row>div:first-child),:global(.internal .task-main){min-width:0;display:grid;gap:.18rem}
      :global(.internal .row-right),:global(.internal .task-actions){display:flex;gap:.55rem;align-items:center;justify-content:flex-end;flex-wrap:wrap}
      :global(.internal .row-right time),:global(.internal .row-right a),:global(.internal .row-right button),:global(.internal .task-actions a),:global(.internal .task-actions button){font:inherit;font-size:var(--step--2)}
      :global(.internal .row-right button),:global(.internal .task-actions button){border:1px solid var(--line);background:var(--paper);color:inherit;border-radius:999px;padding:.42rem .65rem;font-weight:700;cursor:pointer}
      :global(.internal .row-right button:hover),:global(.internal .task-actions button:hover){border-color:var(--line-strong)}
      :global(.internal .task-top){display:flex;justify-content:space-between;gap:var(--space-m);align-items:flex-start}
      :global(.internal .task-top time){font-size:var(--step--2);color:var(--ink-faint);white-space:nowrap}
      :global(.internal .task-lead){font-size:var(--step--1);color:var(--ink-soft)}
      :global(.internal .task p){margin:0;color:var(--ink-soft);font-size:var(--step--1)}
      :global(.internal .overdue),:global(.internal .is-overdue){border-left:3px solid var(--danger);padding-left:var(--space-s)}
      :global(.internal .empty),:global(.internal .muted){color:var(--ink-faint)}
      :global(.internal .insight-row){display:flex;justify-content:space-between;gap:var(--space-m);padding:.75rem 0;border-bottom:1px solid var(--line)}
      :global(.internal .insight-row:last-child){border-bottom:0}

      @media(max-width:700px){
        :global(.internal .task-row),:global(.internal .lead-row){grid-template-columns:auto minmax(0,1fr) auto}
        :global(.internal .row){grid-template-columns:minmax(0,1fr)}
        :global(.internal .task){grid-template-columns:minmax(0,1fr)}
        :global(.internal .row-right),:global(.internal .task-actions){justify-content:flex-start}
        :global(.internal .task-top){flex-direction:column;gap:.2rem}
      }
      @media(max-width:480px){
        :global(.internal .task-row),:global(.internal .lead-row),:global(.internal .quote-row),:global(.internal .job-row){gap:.55rem;padding:.82rem 0}
        :global(.internal .row),:global(.internal .task){padding:.85rem 0}
        :global(.internal .task-row .row-actions),:global(.internal .lead-row .row-actions){grid-column:2/-1;justify-content:flex-start}
        :global(.internal .row-right a),:global(.internal .row-right button),:global(.internal .task-actions a),:global(.internal .task-actions button){font-size:.72rem;padding:.45rem .55rem}
      }
    </style>
  </body>
</html>
