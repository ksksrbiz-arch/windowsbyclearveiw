---
import '../styles/global.css';

/**
 * Shell for the internal business tool. Deliberately not BaseLayout: that one
 * carries customer-facing navigation and marketing chrome that would be
 * confusing around screens where Mark works with customer records and quotes.
 * This shares the design tokens but owns the internal navigation and logout.
 *
 * noindex is set redundantly here and by the internal middleware. The session
 * cookie remains the actual access control.
 */
interface Props {
  title: string;
  /** Set false on the login page — there is no session to log out of yet. */
  showLogout?: boolean;
}
const { title, showLogout = true } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · Clearview internal</title>
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
  </head>
  <body class="internal">
    <header class="internal-header">
      <div class="internal-header-inner">
        <a class="internal-brand" href="/internal/" aria-label="Clearview Command Center">Clearview <span>Internal</span></a>
        {showLogout && (
          <div class="internal-header-right">
            <nav class="internal-nav" aria-label="Internal navigation">
              <a href="/internal/">Dashboard</a>
              <a href="/internal/leads">Leads</a>
              <a href="/internal/quotes">Quotes</a>
              <a href="/internal/ask-logs">Ask</a>
            </nav>
            <form method="post" action="/internal/api/logout">
              <button class="internal-logout" type="submit">Log out</button>
            </form>
          </div>
        )}
      </div>
    </header>
    <main class="internal-main">
      <slot />
    </main>

    <style>
      .internal {
        background: var(--paper);
        min-height: 100vh;
      }

      .internal-header {
        position: sticky;
        top: 0;
        z-index: 20;
        background: color-mix(in srgb, var(--black) 96%, transparent);
        color: var(--on-dark);
        border-bottom: 1px solid var(--dark-line);
        backdrop-filter: blur(10px);
      }

      .internal-header-inner {
        max-width: 68rem;
        margin-inline: auto;
        padding: 0.65rem var(--space-m);
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: var(--space-m);
      }

      .internal-brand {
        color: var(--on-dark);
        font-weight: 650;
        letter-spacing: -0.01em;
        text-decoration: none;
        white-space: nowrap;
      }

      .internal-brand span {
        color: var(--accent-bright);
        font-weight: 500;
      }

      .internal-header-right {
        display: flex;
        align-items: center;
        gap: var(--space-s);
        min-width: 0;
      }

      .internal-nav {
        display: flex;
        align-items: center;
        gap: 0.2rem;
      }

      .internal-nav a {
        color: var(--on-dark-soft);
        text-decoration: none;
        font-size: var(--step--2);
        font-weight: 600;
        padding: 0.42rem 0.55rem;
        border-radius: var(--radius);
      }

      .internal-nav a:hover,
      .internal-nav a:focus-visible {
        color: var(--on-dark);
        background: rgb(255 255 255 / 0.08);
      }

      .internal-logout {
        background: transparent;
        border: 1px solid var(--dark-line-strong);
        color: var(--on-dark-soft);
        border-radius: var(--radius);
        padding: 0.42rem 0.72rem;
        font: inherit;
        font-size: var(--step--2);
        cursor: pointer;
        white-space: nowrap;
      }

      .internal-logout:hover {
        border-color: var(--accent-bright);
        color: var(--on-dark);
      }

      .internal-main {
        max-width: 68rem;
        margin-inline: auto;
        padding: var(--space-l) var(--space-m) var(--space-3xl);
      }

      @media (max-width: 720px) {
        .internal-header-inner {
          gap: var(--space-s);
        }
        .internal-header-right {
          flex: 1;
          justify-content: flex-end;
        }
        .internal-nav {
          overflow-x: auto;
          scrollbar-width: none;
        }
        .internal-nav::-webkit-scrollbar {
          display: none;
        }
        .internal-nav a {
          padding-inline: 0.45rem;
        }
      }

      @media (max-width: 520px) {
        .internal-header-inner {
          padding-inline: var(--space-s);
        }
        .internal-brand span {
          display: none;
        }
        .internal-logout {
          padding-inline: 0.55rem;
        }
      }

      @media print {
        .internal-header {
          display: none;
        }
        .internal-main {
          max-width: none;
          padding: 0;
        }
      }
    </style>
  </body>
</html>
