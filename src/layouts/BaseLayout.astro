---
import { ClientRouter } from 'astro:transitions';
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileCtaBar from '../components/MobileCtaBar.astro';
import JsonLd from '../components/JsonLd.astro';
import { site } from '../data/site';
import { heroPhoto } from '../data/work';

interface Props {
  title: string;
  description?: string;
  path?: string;
  schema?: Record<string, unknown>;
  /** Breadcrumb trail above this page, root excluded. */
  crumbs?: { name: string; href: string }[];
  /**
   * Social card image for this page. Falls back to the hero elevation, which
   * is the strongest single photo on the site.
   */
  ogImageSrc?: ImageMetadata;
  ogImageAlt?: string;
}

const {
  title,
  description = site.description,
  path = Astro.url.pathname,
  schema,
  crumbs = [],
  ogImageSrc = heroPhoto.image,
  ogImageAlt = heroPhoto.alt,
} = Astro.props;

const canonical = new URL(path === '/' ? '/' : path, site.url).toString();

// A stable per-page hook. Without this there is no way to scope a style to one
// page except by editing a shared selector, which is what made every page look
// identical. Workers should prefer scoped <style> blocks, but this exists for
// the cases that genuinely need an ancestor.
const route = (path === '/' ? 'home' : path.replace(/^\/|\/$/g, '').replace(/\//g, '-')) || 'home';
const pageTitle = title.includes(site.shortName) ? title : `${title} | ${site.shortName}`;

// One shared social card. Facebook is where a local installer actually gets
// shared, and an unfurl with no image looks abandoned.
const ogImage = await getImage({
  src: ogImageSrc,
  width: 1200,
  height: 630,
  fit: 'cover',
  position: 'center',
  format: 'jpeg',
  quality: 76,
});
const ogImageUrl = new URL(ogImage.src, site.url).toString();

const breadcrumbSchema =
  crumbs.length > 0
    ? {
        '@context': 'https://schema.org',
        '@type': 'BreadcrumbList',
        itemListElement: [{ name: 'Home', href: '/' }, ...crumbs].map((crumb, index) => ({
          '@type': 'ListItem',
          position: index + 1,
          name: crumb.name,
          item: new URL(crumb.href, site.url).toString(),
        })),
      }
    : null;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta property="og:site_name" content={site.shortName} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <meta name="theme-color" content="#0b0c0e" />
    <meta name="geo.region" content="US-WA" />
    <meta name="geo.placename" content="Vancouver, Washington" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="192x192" href="/icon-192.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Same-origin and preloaded, so the face is usually in hand before first
         paint and the metric-matched fallback absorbs the rest. No preconnect
         needed: there is no longer a third-party origin to warm up. -->
    <link
      rel="preload"
      href="/fonts/outfit-latin-var.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <ClientRouter />
    <JsonLd extra={schema} />
    {breadcrumbSchema && (
      <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
    )}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main" tabindex="-1" data-route={route}>
      <slot />
    </main>
    <Footer />
    <MobileCtaBar />
    <script>
      // Gate the hidden state on JS actually running: if this script never
      // executes, `.reveal-ready` is never set and everything stays visible.
      function initReveal() {
        const targets = document.querySelectorAll('[data-reveal]:not(.is-revealed)');
        if (!targets.length) return;

        if (
          !('IntersectionObserver' in window) ||
          window.matchMedia('(prefers-reduced-motion: reduce)').matches
        ) {
          targets.forEach((el) => el.classList.add('is-revealed'));
          return;
        }

        document.documentElement.classList.add('reveal-ready');

        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              entry.target.classList.add('is-revealed');
              observer.unobserve(entry.target);
            }
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.05 },
        );

        targets.forEach((el) => observer.observe(el));

        // Anything already in view on load should not wait for a scroll.
        requestAnimationFrame(() => {
          targets.forEach((el) => {
            const box = el.getBoundingClientRect();
            if (box.top < window.innerHeight) el.classList.add('is-revealed');
          });
        });
      }

      initReveal();
      document.addEventListener('astro:page-load', initReveal);
    </script>
  </body>
</html>
